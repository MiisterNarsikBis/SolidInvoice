{#
    An inline message. Status text uses the -dark colour steps, which are the AA-safe ones.

        <twig:Si:Alert type="danger">{{ message }}</twig:Si:Alert>

    type: danger | success | warning | info
#}
{% props type = 'info' %}

{%- set styles = {
    danger: 'border-danger/30 bg-danger-light text-danger-dark',
    success: 'border-success/30 bg-success-light text-success-dark',
    warning: 'border-warning/40 bg-warning-light text-warning-dark',
    info: 'border-info/30 bg-info-light text-info-dark',
} -%}
{%- set icons = {
    danger: 'tabler:alert-circle',
    success: 'tabler:circle-check',
    warning: 'tabler:alert-triangle',
    info: 'tabler:info-circle',
} -%}

<div role="{{ type == 'danger' ? 'alert' : 'status' }}" {{ attributes.defaults({class: 'flex items-start gap-3 rounded-md border px-4 py-3 text-sm ' ~ styles[type]}) }}>
    {{ ux_icon(icons[type], {class: 'mt-0.5 size-5 shrink-0', 'aria-hidden': 'true'}) }}
    <div>{% block content %}{% endblock %}</div>
</div>
