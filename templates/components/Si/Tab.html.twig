{#
    One tab. With `target` it switches the panel with that id (inside <twig:Si:Tabs>); with `href` it
    is a link to another page, `active` marking the current one.

        <twig:Si:Tab target="quotes" icon="tabler:file-text" :count="3">Quotes</twig:Si:Tab>
        <twig:Si:Tab href="{{ path('_clients') }}" :active="view == 'clients'">Clients</twig:Si:Tab>

    count   a small number badge after the label
    The label is the content; it must already be translated.
#}
{% props target = null, href = null, active = false, icon = null, count = null %}

{%- set classes = '-mb-px inline-flex items-center gap-2 whitespace-nowrap border-b-2 border-transparent px-4 py-2.5 text-base font-medium text-fg-secondary transition-colors hover:text-fg aria-selected:border-primary aria-selected:text-primary-dark aria-[current=page]:border-primary aria-[current=page]:text-primary-dark pointer-coarse:min-h-11' -%}

{% if href %}
    <a href="{{ href }}" {{ attributes.defaults({class: classes}) }}{% if active %} aria-current="page"{% endif %}>
        {% if icon %}{{ ux_icon(icon, {class: 'size-4', 'aria-hidden': 'true'}) }}{% endif %}
        <span>{% block content %}{% endblock %}</span>
        {% if count is not null %}<span class="rounded-full bg-ink-100 px-1.5 text-xs font-semibold text-fg-secondary">{{ count }}</span>{% endif %}
    </a>
{% else %}
    <button
        type="button"
        role="tab"
        {{ attributes.defaults({class: classes}) }}
        aria-controls="{{ target }}"
        aria-selected="{{ active ? 'true' : 'false' }}"
        tabindex="{{ active ? '0' : '-1' }}"
        data-si-tabs-target="tab"
        data-action="si-tabs#select"
    >
        {% if icon %}{{ ux_icon(icon, {class: 'size-4', 'aria-hidden': 'true'}) }}{% endif %}
        <span>{{ block('content') }}</span>
        {% if count is not null %}<span class="rounded-full bg-ink-100 px-1.5 text-xs font-semibold text-fg-secondary">{{ count }}</span>{% endif %}
    </button>
{% endif %}
