{#
    A "nothing here yet" surface: an icon, a heading, a line of explanation and an optional call to
    action. The Tailwind counterpart of the `empty` / `empty-*` markup.

        <twig:Si:EmptyState icon="tabler:users" title="{{ 'client.empty.title'|trans }}" description="{{ 'client.empty.text'|trans }}">
            <twig:Si:Button href="{{ path('_clients_add') }}">{{ 'client.add'|trans }}</twig:Si:Button>
        </twig:Si:EmptyState>

    An empty state that is the result of a filter should say so and offer no "create" action; that
    is the caller's decision. Everything passed in is already translated.
#}
{% props title, description = null, icon = null %}
{%- set actions = block('content') is defined ? block('content')|trim : '' -%}

<div {{ attributes.defaults({class: 'flex flex-col items-center gap-2 px-4 py-12 text-center'}) }}>
    {% if icon %}
        <span class="mb-1 flex size-14 items-center justify-center rounded-full bg-ink-100 text-fg-muted">
            {{ ux_icon(icon, {class: 'size-7', 'aria-hidden': 'true'}) }}
        </span>
    {% endif %}
    <h3 class="text-lg font-semibold text-fg">{{ title }}</h3>
    {% if description %}<p class="max-w-md text-fg-muted">{{ description }}</p>{% endif %}
    {% if actions is not empty %}<div class="mt-2 flex flex-wrap items-center justify-center gap-2">{{ actions|raw }}</div>{% endif %}
</div>
