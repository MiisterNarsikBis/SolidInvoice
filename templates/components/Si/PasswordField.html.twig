{#
    A password input with a leading lock icon and a show/hide toggle.

        <twig:Si:PasswordField label="{{ 'Password'|trans }}" name="_password" autocomplete="current-password" required />

    It reuses Platform's `password-visibility` Stimulus controller, telling it to hide the
    inactive icon with Tailwind's `hidden` rather than Bootstrap's `d-none`. `label` and
    `toggleLabel` must already be translated.
#}
{% props label, name, toggleLabel, id = null, error = null %}
{%- set fieldId = id ?? ('field-' ~ name) -%}

<div {{ stimulus_controller('password-visibility', controllerClasses = {'hidden': 'hidden'}) }}>
    <label for="{{ fieldId }}" class="si-label">{{ label }}</label>
    <div class="relative">
        <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-fg-muted">
            {{ ux_icon('tabler:lock', {class: 'size-5', 'aria-hidden': 'true'}) }}
        </span>
        <input
            id="{{ fieldId }}"
            type="password"
            name="{{ name }}"
            {{ stimulus_target('password-visibility', 'input') }}
            {% if error %}aria-invalid="true"{% endif %}
            {{ attributes.defaults({class: 'si-control pl-10 pr-10'}) }}
        />
        <button
            type="button"
            class="absolute inset-y-0 right-0 flex items-center rounded-md px-3.5 text-fg-muted transition-colors hover:text-fg"
            aria-label="{{ toggleLabel }}"
            title="{{ toggleLabel }}"
            {{ stimulus_action('password-visibility', 'toggle') }}
        >
            <span {{ stimulus_target('password-visibility', 'icon') }}>{{ ux_icon('tabler:eye', {class: 'size-5', 'aria-hidden': 'true'}) }}</span>
            <span {{ stimulus_target('password-visibility', 'icon') }} class="hidden">{{ ux_icon('tabler:eye-closed', {class: 'size-5', 'aria-hidden': 'true'}) }}</span>
        </button>
    </div>
    {% if error %}
        <p class="si-error">{{ error }}</p>
    {% endif %}
</div>
