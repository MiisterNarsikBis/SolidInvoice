{#
    A disclosure menu: a trigger button and a floating panel. Behaviour lives in the
    `si-dropdown` Stimulus controller (outside click, Escape, aria-expanded).

        <twig:Si:Dropdown label="{{ 'layout.aria.open_create_menu'|trans }}" triggerClass="...">
            <twig:block name="trigger">+ Create</twig:block>
            <twig:Si:MenuItem href="...">...</twig:Si:MenuItem>
        </twig:Si:Dropdown>

    `label` is the already-translated accessible name of the trigger. `align` is `end` (panel
    grows leftwards from the trigger's right edge) or `start`. `panelClass` sets the panel width
    (default `min-w-52`). `up` opens the panel above the trigger (for a bar pinned to the bottom). `fixed` positions the panel with `position: fixed` so it escapes a
    clipping ancestor such as a scrolling table (it then closes on scroll).
#}
{% props label, align = 'end', triggerClass = '', panelClass = 'min-w-52', fixed = false, up = false %}

<div class="relative" data-controller="si-dropdown"{% if fixed %} data-si-dropdown-fixed-value="true"{% endif %}>
    <button
        type="button"
        class="{{ triggerClass }}"
        data-si-dropdown-target="trigger"
        data-action="si-dropdown#toggle"
        aria-haspopup="menu"
        aria-expanded="false"
        aria-label="{{ label }}"
    >{% block trigger %}{% endblock %}</button>

    <div
        data-si-dropdown-target="panel"
        role="menu"
        hidden
        class="absolute z-50 {{ up ? 'bottom-full mb-1.5' : 'mt-1.5' }} rounded-lg border border-line bg-surface p-1 shadow-md {{ panelClass }} {{ align == 'end' ? 'right-0' : 'left-0' }}"
    >{% block content %}{% endblock %}</div>
</div>
