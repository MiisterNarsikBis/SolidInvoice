{# Flash messages for Tailwind pages (flash.html.twig is the Bootstrap one). Use it inside a Live
   Component, where the shell's own flash block has already run for the page. #}
{% for type, flashMessages in app.session.flashbag.all() %}
    {% for message in flashMessages %}
        <twig:Si:Alert type="{{ type == 'error' ? 'danger' : type }}" data-flash="{{ type }}" class="mb-4 print:hidden">{{ message|trans }}</twig:Si:Alert>
    {% endfor %}
{% endfor %}
