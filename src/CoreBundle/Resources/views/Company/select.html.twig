{% extends "@SolidInvoiceCore/Layout/focus.html.twig" %}

{% block page_title %}{{ 'company.select.welcome_back'|trans({'%name%': app.user.firstName}) }}{% endblock page_title %}

{% block container_class %}max-w-4xl{% endblock %}

{% block content %}
    <p class="-mt-3 mb-6 text-center text-fg-muted">{{ 'company.select.subtitle'|trans }}</p>

    <twig:Si:Card :padded="true">
        <div class="grid gap-4 md:grid-cols-2">
            {% for company in companies %}
                <a href="{{ path('_switch_company', {'id': company.id}) }}" class="group flex items-center gap-4 rounded-lg border border-line bg-surface p-4 transition-colors hover:border-primary hover:bg-primary-lighter">
                    {% set companyLogo = app_logo('64', company) %}
                    {% if companyLogo is not empty and companyLogo != '' %}
                        <span class="flex size-16 shrink-0 items-center justify-center overflow-hidden rounded-full">{{ companyLogo }}</span>
                    {% else %}
                        {% set initials = company.name|split(' ')|map(word => word|first)|join('')|upper|slice(0, 3) %}
                        <span class="flex size-16 shrink-0 items-center justify-center rounded-full bg-primary text-lg font-semibold text-white" data-initials="{{ initials }}">{{ initials }}</span>
                    {% endif %}
                    <span class="min-w-0 flex-1">
                        <span class="block truncate text-lg font-semibold text-fg">{{ company }}</span>
                        <span class="block text-sm text-fg-muted">{{ 'company.select.click_to_access'|trans }}</span>
                    </span>
                    {{ ux_icon('tabler:chevron-right', {class: 'size-5 shrink-0 text-fg-muted transition-transform group-hover:translate-x-0.5', 'aria-hidden': 'true'}) }}
                </a>
            {% endfor %}
        </div>

        {# Create a new company #}
        <div class="mt-6 flex flex-wrap items-center gap-4 rounded-lg border border-dashed border-line bg-canvas p-4">
            <span class="flex size-12 shrink-0 items-center justify-center rounded-full bg-success-light text-success-dark">
                {{ ux_icon('tabler:plus', {class: 'size-6', 'aria-hidden': 'true'}) }}
            </span>
            <div class="min-w-0 flex-1">
                <h2 class="font-semibold text-fg">{{ 'company.select.create_new'|trans }}</h2>
                <p class="text-sm text-fg-muted">{{ 'company.select.create_new_help'|trans }}</p>
            </div>
            <twig:Si:Button href="{{ path('_create_company') }}">
                {{ ux_icon('tabler:building-plus', {class: 'size-4', 'aria-hidden': 'true'}) }}
                {{ 'company.select.create_button'|trans }}
            </twig:Si:Button>
        </div>
    </twig:Si:Card>
{% endblock %}
