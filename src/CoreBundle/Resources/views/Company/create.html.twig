{% extends "@SolidInvoiceCore/Layout/focus.html.twig" %}

{% form_theme form '@SolidInvoiceCore/Form/tailwind.html.twig' %}

{% block page_title %}{{ 'company.create.title'|trans }}{% endblock page_title %}

{% block container_class %}max-w-2xl{% endblock %}

{% block content %}
    <p class="-mt-3 mb-6 text-center text-fg-muted">{{ 'company.create.subtitle'|trans }}</p>

    {{ form_start(form) }}
        <twig:Si:Card>
            <div class="p-6 md:p-8">
                {{ form_row(form.name, {
                    'attr': {
                        'class': 'si-control h-11 text-lg',
                        'placeholder': 'company.create.name_placeholder'|trans,
                        'autofocus': 'autofocus'
                    },
                    'help': 'company.create.name_help'|trans,
                    'help_translation_domain': false,
                }) }}

                {{ form_row(form.currency, {
                    'help': 'company.create.currency_help'|trans,
                    'help_translation_domain': false,
                }) }}

                <hr class="my-6 border-line-light">

                {# What the account costs #}
                {% toggle 'saas_enabled' %}
                    {% set paidTrial = toggle('saas_paid_trial') %}
                    {% if not userHasTrial and planHasTrial %}
                        <twig:Si:Alert type="info">
                            <p class="font-semibold">{{ (paidTrial ? 'company.create.trial_title_paid' : 'company.create.trial_title')|trans }}</p>
                            <p class="mt-1">
                                {% set trial_label -%}
                                    {% if trialDuration.y > 0 %}{{ '{1} %count% year|]1,Inf[ %count% years'|trans({'%count%': trialDuration.y}, count=trialDuration.y) }} {% endif %}
                                    {% if trialDuration.m > 0 %}{{ '{1} %count% month|]1,Inf[ %count% months'|trans({'%count%': trialDuration.m}, count=trialDuration.m) }} {% endif %}
                                    {% if trialDuration.d > 0 %}{{ '{1} %count% day|]1,Inf[ %count% days'|trans({'%count%': trialDuration.d}, count=trialDuration.d) }}{% endif %}
                                {%- endset %}
                                {% if paidTrial %}
                                    {% trans with {'%duration%': trial_label|trim} %}Get full access for %duration%. We'll ask for your payment details to begin — cancel any time before the trial ends and you won't be charged.{% endtrans %}
                                {% else %}
                                    {% trans with {'%duration%': trial_label|trim} %}Get full access for %duration%, completely free. No credit card required.{% endtrans %}
                                {% endif %}
                            </p>
                            {% if planPrice %}
                                <p class="mt-2 flex flex-wrap items-center gap-2">
                                    <twig:Si:Badge tone="info">{{ 'company.create.then'|trans }} {{ planPrice }}/{{ 'company.create.month'|trans }}</twig:Si:Badge>
                                    <span class="text-xs">{{ 'company.create.cancel_anytime'|trans }}</span>
                                </p>
                            {% endif %}
                        </twig:Si:Alert>
                    {% else %}
                        <twig:Si:Alert type="warning">
                            <p class="font-semibold">{{ 'company.create.payment_required_title'|trans }}</p>
                            <p class="mt-1">
                                {% if userHasTrial %}
                                    {{ 'company.create.trial_used'|trans }}
                                    {{ 'company.create.checkout_after_create'|trans }}
                                {% else %}
                                    {{ 'company.create.payment_after_create'|trans }}
                                {% endif %}
                            </p>
                        </twig:Si:Alert>
                    {% endif %}
                {% else %}
                    <twig:Si:Alert type="success">
                        <p class="font-semibold">{{ 'company.create.self_hosted_title'|trans }}</p>
                        <p class="mt-1">{{ 'company.create.self_hosted_text'|trans }}</p>
                    </twig:Si:Alert>
                {% endtoggle %}
            </div>

            <twig:block name="footer">
                {% if allowCancel %}
                    <twig:Si:Button variant="ghost" size="lg" href="{{ path('_dashboard') }}" class="mr-auto">
                        {{ ux_icon('tabler:arrow-left', {class: 'size-5', 'aria-hidden': 'true'}) }}
                        {{ 'company.create.back'|trans }}
                    </twig:Si:Button>
                {% endif %}
                <twig:Si:Button type="submit" size="lg">
                    {{ ux_icon('tabler:rocket', {class: 'size-5', 'aria-hidden': 'true'}) }}
                    {{ 'company.create.create_button'|trans }}
                </twig:Si:Button>
            </twig:block>
        </twig:Si:Card>
    {{ form_end(form) }}

    <p class="mt-6 flex flex-wrap items-center justify-center gap-3 text-sm text-fg-secondary">
        <span class="inline-flex items-center gap-1.5">
            {{ ux_icon('tabler:help-circle', {class: 'size-4', 'aria-hidden': 'true'}) }}
            {{ 'company.create.need_help'|trans }}
        </span>
        <a href="https://solidinvoice.co/docs" target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-primary hover:underline">
            {{ 'company.create.view_docs'|trans }} {{ ux_icon('tabler:external-link', {class: 'size-3.5', 'aria-hidden': 'true'}) }}
        </a>
    </p>
{% endblock %}
