{% set rows = this.rows %}
{% set populated = rows|filter(row => row.raw is not null) %}
{% if populated|length > 0 %}
    {% set typeIcons = {
        text: 'tabler:cursor-text',
        textarea: 'tabler:align-left',
        number: 'tabler:number',
        date: 'tabler:calendar',
        email: 'tabler:mail',
        url: 'tabler:link',
        checkbox: 'tabler:checkbox',
        select: 'tabler:list',
        multi_select: 'tabler:list-check',
    } %}

    <div class="custom-fields-card my-4 rounded-lg border border-line-light bg-surface">
        <div class="flex items-center gap-2 border-b border-line-light px-4 py-2.5">
            {{ ux_icon('tabler:forms', {class: 'size-4 text-fg-muted', 'aria-hidden': 'true'}) }}
            <span class="font-medium text-fg">{{ 'custom_fields.label'|trans }}</span>
        </div>
        <dl class="custom-fields-list divide-y divide-line-light px-4">
            {% for row in populated %}
                {% set t = row.field.type.value %}
                <div class="custom-fields-item grid gap-1 py-2.5 sm:grid-cols-3 sm:gap-4">
                    <dt class="custom-fields-label flex items-center gap-2 text-fg-secondary">
                        {{ ux_icon(typeIcons[t]|default('tabler:tag'), {class: 'size-3.5 shrink-0 text-fg-muted', 'aria-hidden': 'true'}) }}
                        <span>{{ row.field.label }}</span>
                    </dt>
                    <dd class="custom-fields-value min-w-0 text-fg sm:col-span-2">
                        {% if t == 'url' %}
                            {% set safeUrl = row.raw matches '#^(https?:)?//#i' ? row.raw : null %}
                            {% if safeUrl %}
                                <a href="{{ safeUrl }}" target="_blank" rel="noopener noreferrer" class="break-all text-primary hover:underline">{{ row.raw }}</a>
                            {% else %}
                                {{ row.raw }}
                            {% endif %}
                        {% elseif t == 'email' %}
                            <a href="mailto:{{ row.raw }}" class="break-all text-primary hover:underline">{{ row.raw }}</a>
                        {% elseif t == 'date' %}
                            {{ row.raw|date('M d, Y') }}
                        {% elseif t == 'textarea' %}
                            <span class="whitespace-pre-wrap">{{ row.formatted|nl2br }}</span>
                        {% elseif t == 'checkbox' %}
                            {% if row.raw == '1' %}
                                {{ ux_icon('tabler:check', {class: 'size-4 text-success-dark', 'aria-hidden': 'true'}) }}
                            {% else %}
                                {{ ux_icon('tabler:x', {class: 'size-4 text-fg-muted', 'aria-hidden': 'true'}) }}
                            {% endif %}
                        {% elseif t == 'multi_select' %}
                            <span class="flex flex-wrap gap-1.5">
                                {% for label in row.formatted|split(', ') %}
                                    <twig:Si:Badge>{{ label }}</twig:Si:Badge>
                                {% endfor %}
                            </span>
                        {% elseif t == 'select' %}
                            <twig:Si:Badge>{{ row.formatted }}</twig:Si:Badge>
                        {% else %}
                            {{ row.formatted }}
                        {% endif %}
                    </dd>
                </div>
            {% endfor %}
        </dl>
    </div>
{% endif %}
