 # The Tailwind version of _gated_page.html.twig: a full-page "feature gated" card, rendered by every
 # gated full-page action when the current plan does not include the requested feature. Same
 # parameters (feature, icon, headline, description, bullets); see _gated_page.html.twig for their
 # meaning. A gated page switches its include to this file when it moves to the Tailwind shell, and
 # the Bootstrap one goes when the last caller has.
 #}
{% set plan_name = feature_required_plan_label(feature) %}
{% set _copy = feature_copy(feature) %}
{% set _icon = icon|default(_copy ? _copy.icon : 'tabler:lock') %}
{% set _headline = headline|default(_copy ? _copy.headline|trans : 'feature.upgrade_required'|trans) %}
{% set _description = description ?? (_copy ? _copy.description|trans : null) %}
{% set _bullets = bullets ?? (_copy ? _copy.bullets : []) %}
{% set _quote = _copy ? _copy.quote : null %}
{% set _quote_author = _copy ? _copy.quoteAuthor : null %}

<div class="mx-auto max-w-3xl rounded-lg border border-line-light bg-surface px-6 py-12 text-center shadow-sm">
    <span class="mx-auto mb-4 flex size-16 items-center justify-center rounded-full bg-primary-lighter text-primary">
        {{ ux_icon(_icon, {class: 'size-8', 'aria-hidden': 'true'}) }}
    </span>

    <h2 class="text-xl font-semibold text-fg">{{ _headline }}</h2>

    {% if plan_name %}
        <p class="mt-1 text-fg-secondary">{{ 'feature.available_on_plan'|trans({'%plan%': plan_name}) }}</p>
    {% endif %}

    {% if _description %}
        <p class="mx-auto mt-3 max-w-xl text-fg-muted">{{ _description }}</p>
    {% endif %}

    {% if _bullets is not empty %}
        <ul class="mx-auto mt-4 max-w-sm space-y-1.5 text-left">
            {% for bullet in _bullets %}
                <li class="flex items-start gap-2">
                    {{ ux_icon('tabler:check', {class: 'mt-0.5 size-[1.125rem] shrink-0 text-success-dark', 'aria-hidden': 'true'}) }}
                    <span>{{ bullet|trans }}</span>
                </li>
            {% endfor %}
        </ul>
    {% endif %}

    {% if _quote %}
        <blockquote class="mx-auto mt-5 max-w-lg">
            <p class="italic text-fg-secondary">&ldquo;{{ _quote|trans }}&rdquo;</p>
            {% if _quote_author %}<footer class="mt-1 text-sm text-fg-muted">{{ _quote_author }}</footer>{% endif %}
        </blockquote>
    {% endif %}

    <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        {% if plan_name %}
            <twig:Si:Button href="{{ path('saas_subscription_plans') }}">
                {{ ux_icon('tabler:arrow-up-circle', {class: 'size-4', 'aria-hidden': 'true'}) }}
                {{ 'feature.upgrade_to'|trans({'%plan%': plan_name}) }}
            </twig:Si:Button>
            <twig:Si:Button variant="ghost" href="{{ path('saas_subscription_plans') }}">{{ 'feature.view_all_plans'|trans }}</twig:Si:Button>
        {% else %}
            <p class="text-fg-muted">{{ 'feature.contact_admin'|trans }}</p>
        {% endif %}
    </div>
</div>
