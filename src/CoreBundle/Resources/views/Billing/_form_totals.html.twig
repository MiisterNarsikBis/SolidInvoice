{#
    The live totals beside the line items.

    Variables: dto, currency, hasTax (bool), discountAmount (Money), prefix ('quote' | 'invoice').
#}
<aside class="rounded-lg border border-line-light bg-surface shadow-sm lg:sticky lg:top-20">
    <header class="flex items-center gap-3 border-b border-line-light px-5 py-4">
        <span class="flex size-9 shrink-0 items-center justify-center rounded-md bg-primary-lighter text-primary-dark">
            {{ ux_icon('tabler:calculator', {class: 'size-5', 'aria-hidden': 'true'}) }}
        </span>
        <h2 class="text-lg font-semibold text-fg">{{ (prefix ~ '.totals.title')|trans }}</h2>
    </header>

    <dl class="space-y-2 p-5">
        <div class="flex justify-between">
            <dt class="text-fg-secondary">{{ 'billing.subtotal'|trans }}</dt>
            <dd class="tabular text-fg">{{ dto.baseTotal|formatCurrency(currency) }}</dd>
        </div>

        {% if hasTax %}
            <div class="flex justify-between">
                <dt class="text-fg-secondary">{{ 'billing.tax'|trans }}</dt>
                <dd class="tabular text-fg">{{ dto.tax|formatCurrency(currency) }}</dd>
            </div>
        {% endif %}

        <div class="flex justify-between text-success-dark">
            <dt>{{ 'billing.discount'|trans }}</dt>
            <dd class="tabular">{{ discountAmount|formatCurrency(currency) }}</dd>
        </div>

        <div class="flex justify-between border-t border-line pt-3 text-lg font-semibold text-fg">
            <dt>{{ 'billing.total'|trans }}</dt>
            <dd class="tabular">{{ dto.total|formatCurrency(currency) }}</dd>
        </div>
    </dl>
</aside>
