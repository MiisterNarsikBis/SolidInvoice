{#
    The global search box of the Tailwind shell (the Tabler layout keeps Menu/search.html.twig).
    The result dropdown, chips and rows are built by global-search_controller.ts, which emits the
    `search-*` classes styled in assets/tailwind/app.css. The help guide is a <twig:Si:Modal>.
#}
{% toggle 'meilisearch_search' %}
    <div class="flex flex-1 items-center justify-start px-3">
        <div class="global-search"
             data-controller="global-search"
             data-global-search-url-value="{{ path('_search') }}"
             data-global-search-suggestions-url-value="{{ path('_search_suggestions') }}"
        >
            <div class="search-chips-bar" data-global-search-target="chips"></div>
            <div class="global-search-input-wrapper">
                <span class="global-search-icon">
                    {{ ux_icon('tabler:search', {class: 'size-4', 'aria-hidden': 'true'}) }}
                </span>
                <input
                    type="search"
                    class="global-search-input"
                    placeholder="{{ 'search.placeholder'|trans }}"
                    aria-label="{{ 'search.placeholder'|trans }}"
                    autocomplete="off"
                    data-global-search-target="input"
                    data-action="input->global-search#onInput keydown->global-search#onKeydown"
                >
                <span class="global-search-actions">
                    <button type="button" class="search-help-trigger" data-si-modal-open="#searchHelpModal" aria-label="{{ 'search.guide'|trans }}" title="{{ 'search.guide'|trans }}">
                        {{ ux_icon('tabler:question-mark', {class: 'size-3.5', 'aria-hidden': 'true'}) }}
                    </button>
                    <span class="global-search-shortcut hidden xl:flex">
                        <kbd>Ctrl</kbd><kbd>K</kbd>
                    </span>
                </span>
            </div>
            <div class="search-suggestions" data-global-search-target="suggestions"></div>
            <div class="search-dropdown" data-global-search-target="dropdown">
                <div class="search-spinner" hidden data-global-search-target="spinner">
                    {{ ux_icon('tabler:loader-2', {class: 'size-4 animate-spin', 'aria-hidden': 'true'}) }}
                    <span>{{ 'search.searching'|trans }}</span>
                </div>
                <div class="search-results" data-global-search-target="results"></div>
            </div>
        </div>
    </div>

    <twig:Si:Modal id="searchHelpModal" size="lg" title="{{ 'search.guide_title'|trans }}">
        <div class="-m-5">
            <div class="border-b border-line-light bg-canvas px-5 py-3">
                <p class="text-fg-muted">{{ 'search.intro'|trans }}</p>
            </div>

            <div class="p-5">
                <h3 class="search-help-section-title">{{ 'search.available_qualifiers'|trans }}</h3>
                <div class="overflow-x-auto">
                    <table class="w-full text-base">
                        <thead>
                            <tr class="border-b border-line-light text-left text-xs font-semibold uppercase tracking-wide text-fg-muted">
                                <th class="w-32 py-2 pr-3">{{ 'search.qualifier'|trans }}</th>
                                <th class="py-2 pr-3">{{ 'search.description'|trans }}</th>
                                <th class="py-2">{{ 'search.values_syntax'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-line-light align-top">
                            <tr>
                                <td class="py-2 pr-3"><code class="search-help-op">in:</code></td>
                                <td class="py-2 pr-3">{{ 'search.limit_section'|trans }}</td>
                                <td class="py-2 text-sm text-fg-muted">invoices · quotes · payments · clients · contacts · recurring_invoices</td>
                            </tr>
                            <tr>
                                <td class="py-2 pr-3"><code class="search-help-op">status:</code></td>
                                <td class="py-2 pr-3">{{ 'search.filter_status'|trans }}</td>
                                <td class="py-2 text-sm text-fg-muted">draft · pending · paid · overdue · cancelled · active · paused · captured · refunded · failed</td>
                            </tr>
                            <tr>
                                <td class="py-2 pr-3"><code class="search-help-op">amount:</code></td>
                                <td class="py-2 pr-3">{{ 'search.filter_amount'|trans }}</td>
                                <td class="py-2 text-sm text-fg-muted">{{ 'search.supports_operators'|trans }}</td>
                            </tr>
                            <tr>
                                <td class="py-2 pr-3"><code class="search-help-op">client:</code></td>
                                <td class="py-2 pr-3">{{ 'search.filter_client'|trans }}</td>
                                <td class="py-2 text-sm text-fg-muted">client:Acme &nbsp;·&nbsp; client:"Acme Corp"</td>
                            </tr>
                            <tr>
                                <td class="py-2 pr-3"><code class="search-help-op">created:</code></td>
                                <td class="py-2 pr-3">{{ 'search.filter_created'|trans }}</td>
                                <td class="py-2 text-sm text-fg-muted">{{ 'search.supports_operators'|trans }}</td>
                            </tr>
                            <tr>
                                <td class="py-2 pr-3"><code class="search-help-op">sort:</code></td>
                                <td class="py-2 pr-3">{{ 'search.sort_results'|trans }}</td>
                                <td class="py-2 text-sm text-fg-muted">amount · amount_desc · date · date_desc</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="grid border-t border-line-light md:grid-cols-12">
                <div class="border-b border-line-light p-5 md:col-span-5 md:border-r md:border-b-0">
                    <h3 class="search-help-section-title">{{ 'search.comparison_operators'|trans }}</h3>
                    <p class="mb-3 text-sm text-fg-muted">{{ 'search.applies_to'|trans }} <code class="search-help-op">amount:</code> {{ 'search.and'|trans }} <code class="search-help-op">created:</code></p>
                    <div class="flex flex-col gap-2">
                        {% for op, label in {'100': 'search.exact_match', '>100': 'search.greater_than', '>=100': 'search.at_least', '<100': 'search.less_than', '<=100': 'search.at_most', '50..200': 'search.between_range'} %}
                            <div class="flex items-center gap-3">
                                <code class="search-help-op">{{ op }}</code>
                                <span class="text-sm text-fg-muted">{{ label|trans }}</span>
                            </div>
                        {% endfor %}
                    </div>
                </div>

                <div class="p-5 md:col-span-7">
                    <h3 class="search-help-section-title">{{ 'search.example_queries'|trans }}</h3>
                    <div class="flex flex-col gap-2">
                        {% for query, label in {
                            'status:overdue': 'search.example_overdue',
                            'in:invoices status:paid amount:>500': 'search.example_paid',
                            'client:"Acme Corp" status:pending': 'search.example_pending',
                            'in:payments sort:amount_desc': 'search.example_payments',
                            'created:>2024-01-01 in:quotes': 'search.example_quotes',
                        } %}
                            <div class="search-help-example">
                                <code>{{ query }}</code>
                                <span>{{ label|trans }}</span>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </twig:Si:Modal>
{% endtoggle %}
