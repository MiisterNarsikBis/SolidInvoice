{% set menuItem = 'data-export' %}

{% extends "@SolidInvoiceUser/Layout/profile.html.twig" %}

{% block title %}{{ 'export.title'|trans }}{% endblock title %}

{# Success and error flashes are rendered by the shell. #}

{% block profile_content %}
    <twig:Si:Card title="{{ 'export.request_title'|trans }}" :padded="true">
        <p class="mb-4 text-fg-muted">{{ 'export.request_help'|trans }}</p>
        <form method="post" action="{{ path('_export_request') }}" class="flex flex-wrap items-end gap-3">
            <div>
                <label for="export-format" class="si-label">{{ 'export.format'|trans }}</label>
                <select name="format" id="export-format" class="si-control w-auto" required>
                    {% for format in formats %}
                        <option value="{{ format.value }}">{{ format.value|upper }}</option>
                    {% endfor %}
                </select>
            </div>
            <input type="hidden" name="_token" value="{{ csrf_token('export.request') }}">
            <twig:Si:Button type="submit">
                {{ ux_icon('tabler:download', {class: 'size-4', 'aria-hidden': 'true'}) }}
                {{ 'export.request_button'|trans }}
            </twig:Si:Button>
        </form>
    </twig:Si:Card>

    <twig:Si:Card title="{{ 'export.history_title'|trans }}">
        {% if jobs is empty %}
            <twig:Si:EmptyState icon="tabler:database-off" title="{{ 'export.empty'|trans }}" />
        {% else %}
            <div class="overflow-x-auto">
                <table class="w-full text-base">
                    <thead>
                        <tr class="bg-canvas text-left text-xs font-semibold uppercase tracking-wide text-fg-muted">
                            <th class="px-4 py-2.5">{{ 'export.requested'|trans }}</th>
                            <th class="px-4 py-2.5">{{ 'export.format'|trans }}</th>
                            <th class="px-4 py-2.5">{{ 'export.status'|trans }}</th>
                            <th class="px-4 py-2.5">{{ 'export.size'|trans }}</th>
                            <th class="px-4 py-2.5">{{ 'export.completed'|trans }}</th>
                            <th class="px-4 py-2.5 text-right">{{ 'export.actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-line-light">
                        {% for job in jobs %}
                            {% set status = job.status.value %}
                            {% set tone = {'pending': 'info', 'processing': 'warning', 'completed': 'success', 'failed': 'danger'}[status] %}
                            <tr>
                                <td class="tabular px-4 py-2.5">{{ job.createdAt|date('Y-m-d H:i') }}</td>
                                <td class="px-4 py-2.5"><twig:Si:Badge class="uppercase">{{ job.format.value }}</twig:Si:Badge></td>
                                <td class="px-4 py-2.5">
                                    <twig:Si:Badge :tone="tone">{{ status|title|trans }}</twig:Si:Badge>
                                    {% if job.status.value == 'failed' and job.failureReason %}
                                        <div class="mt-1 text-sm text-fg-muted">{{ job.failureReason }}</div>
                                    {% endif %}
                                </td>
                                <td class="tabular px-4 py-2.5">
                                    {% if job.fileSize %}
                                        {{ (job.fileSize / 1024 / 1024)|number_format(2) }} MB
                                    {% else %}
                                        &mdash;
                                    {% endif %}
                                </td>
                                <td class="tabular px-4 py-2.5">
                                    {% if job.completedAt %}
                                        {{ job.completedAt|date('Y-m-d H:i') }}
                                    {% else %}
                                        &mdash;
                                    {% endif %}
                                </td>
                                <td class="px-4 py-2.5 text-right">
                                    {% if job.status.value == 'completed' %}
                                        <twig:Si:Button size="sm" href="{{ path('_export_download', {id: job.id.toBase58}) }}">
                                            {{ ux_icon('tabler:download', {class: 'size-4', 'aria-hidden': 'true'}) }}
                                            {{ 'export.download'|trans }}
                                        </twig:Si:Button>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </twig:Si:Card>
{% endblock profile_content %}
