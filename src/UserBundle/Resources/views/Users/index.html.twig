{% extends '@SolidInvoiceCore/Layout/shell.html.twig' %}

{% block page_title %}{{ 'users.title'|trans }}{% endblock page_title %}

{% block page_title_actions %}
    <twig:Si:Button href="{{ path('_user_invite') }}">
        {{ ux_icon('tabler:user-plus', {class: 'size-4', 'aria-hidden': 'true'}) }}
        {{ 'users.invite_user'|trans }}
    </twig:Si:Button>
{% endblock %}

{% block content %}
    {{ feature_usage_banner('team_seats', seatsUsage) }}

    {# KPI stats #}
    <div class="mb-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {% for stat in [
            {value: totalActiveUsers, label: 'users.stats.active_users', icon: 'tabler:users', tint: 'bg-primary-light text-primary-dark'},
            {value: totalPendingInvitations, label: 'users.stats.pending_invitations', icon: 'tabler:mail-forward', tint: 'bg-warning-light text-warning-dark'},
            {value: recentlyJoinedCount, label: 'users.stats.recently_joined', icon: 'tabler:user-check', tint: 'bg-info-light text-info-dark'},
        ] %}
            <div class="flex items-center gap-3.5 rounded-lg border border-line-light bg-surface p-4 shadow-sm">
                <span class="flex size-10 shrink-0 items-center justify-center rounded-md {{ stat.tint }}">
                    {{ ux_icon(stat.icon, {class: 'size-5', 'aria-hidden': 'true'}) }}
                </span>
                <div>
                    <div class="tabular text-2xl font-semibold leading-tight text-fg">{{ stat.value }}</div>
                    <div class="text-sm text-fg-secondary">{{ stat.label|trans }}</div>
                </div>
            </div>
        {% endfor %}
    </div>

    {# Users and invitations, in tabs #}
    <twig:Si:Tabs>
        <twig:block name="tabs">
            <twig:Si:Tab target="users-tab" :active="true" icon="tabler:users" :count="totalActiveUsers">{{ 'users.tabs.active_users'|trans }}</twig:Si:Tab>
            <twig:Si:Tab target="invitations-tab" icon="tabler:mail" :count="totalPendingInvitations">{{ 'users.tabs.pending_invitations'|trans }}</twig:Si:Tab>
        </twig:block>

        <div class="mt-4">
            <twig:Si:TabPanel id="users-tab" :active="true">
                {% if totalActiveUsers == 0 %}
                    <twig:Si:Card>
                        <twig:Si:EmptyState icon="tabler:users" title="{{ 'users.empty.title'|trans }}" description="{{ 'users.empty.description'|trans }}">
                            <twig:Si:Button href="{{ path('_user_invite') }}">
                                {{ ux_icon('tabler:user-plus', {class: 'size-4', 'aria-hidden': 'true'}) }}
                                {{ 'users.invite_user'|trans }}
                            </twig:Si:Button>
                        </twig:Si:EmptyState>
                    </twig:Si:Card>
                {% else %}
                    <twig:DataGrid name="users_list" />
                {% endif %}
            </twig:Si:TabPanel>

            <twig:Si:TabPanel id="invitations-tab">
                {% if totalPendingInvitations == 0 %}
                    <twig:Si:Card>
                        <twig:Si:EmptyState icon="tabler:mail-opened" title="{{ 'users.invitations.empty.title'|trans }}" description="{{ 'users.invitations.empty.description'|trans }}">
                            <twig:Si:Button href="{{ path('_user_invite') }}">
                                {{ ux_icon('tabler:user-plus', {class: 'size-4', 'aria-hidden': 'true'}) }}
                                {{ 'users.invite_user'|trans }}
                            </twig:Si:Button>
                        </twig:Si:EmptyState>
                    </twig:Si:Card>
                {% else %}
                    <twig:DataGrid name="user_invitations" />
                {% endif %}
            </twig:Si:TabPanel>
        </div>
    </twig:Si:Tabs>
{% endblock %}
