{% extends "@SolidInvoiceCore/Layout/shell.html.twig" %}

{% form_theme form '@SolidInvoiceCore/Form/tailwind.html.twig' %}

{% block page_title %}{{ 'users.invite.title'|trans }}{% endblock %}

{% block content %}
    {{ form_start(form) }}
    <div class="max-w-3xl">
        {{ form_errors(form) }}

        <p class="-mt-2 mb-5 text-fg-muted">{{ 'users.invite.subtitle'|trans }}</p>

        <div class="space-y-5">
            <twig:Si:FormSection id="invitation-details" title="{{ 'users.invite.details.title'|trans }}" description="{{ 'users.invite.details.description'|trans }}" icon="tabler:mail">
                {{ form_row(form.email, {
                    label: 'users.invite.email.label'|trans,
                    help: 'users.invite.email.help'|trans,
                    attr: {
                        placeholder: 'example@company.com',
                        autocomplete: 'email'
                    }
                }) }}
            </twig:Si:FormSection>

            <twig:Si:Alert type="info">{{ 'users.invite.info'|trans }}</twig:Si:Alert>
        </div>

        {{ form_rest(form) }}

        <twig:Si:FormActions>
            <twig:Si:Button variant="ghost" href="{{ path('_users_list') }}">
                {{ ux_icon('tabler:arrow-left', {class: 'size-4', 'aria-hidden': 'true'}) }}
                {{ 'profile.edit.cancel'|trans }}
            </twig:Si:Button>
            <twig:Si:Button type="submit">
                {{ ux_icon('tabler:send', {class: 'size-4', 'aria-hidden': 'true'}) }}
                {{ 'users.invite.send'|trans }}
            </twig:Si:Button>
        </twig:Si:FormActions>
    </div>
    {{ form_end(form) }}
{% endblock %}
