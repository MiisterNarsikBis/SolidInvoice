{% set menuItem = 'api-tokens' %}

{% extends "@SolidInvoiceUser/Layout/profile.html.twig" %}

{% block title %}{{ "profile.api.title"|trans }}{% endblock title %}

{% block profile_content %}
    {# Stats #}
    <twig:ApiTokenStats />

    {# The flash holding a freshly created token is rendered by the shell. #}

    <twig:Si:Card>
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-line-light px-5 py-3.5">
            <div class="flex items-center gap-2 text-info-dark">
                {{ ux_icon('tabler:info-circle', {class: 'size-5 shrink-0', 'aria-hidden': 'true'}) }}
                <span class="text-fg-secondary">{{ 'profile.api.doc_notice'|trans({'%link%': '<a href="' ~ path('api_doc') ~ '" target="_blank" rel="noopener noreferrer" class="font-medium text-primary hover:underline">' ~ 'profile.api.doc_link'|trans ~ '</a>'})|raw }}</span>
            </div>
            <twig:CreateApiToken />
        </div>

        <twig:ApiTokenList />
    </twig:Si:Card>

    {# History dialog #}
    <twig:ApiTokenHistoryModal :tokenId="app.request.query.get('view_history')" />
{% endblock profile_content %}
