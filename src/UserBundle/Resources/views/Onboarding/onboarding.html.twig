{% extends '@SolidInvoiceCore/Layout/focus.html.twig' %}

{% form_theme form '@SolidInvoiceCore/Form/tailwind.html.twig' %}

{% block page_title %}{{ 'onboarding.page_title'|trans({'%app_name%': app_name}) }}{% endblock %}

{# The card draws its own heading. #}
{% block page_heading %}{% endblock %}

{% block container_class %}max-w-xl{% endblock %}

{% block content %}
    <div class="rounded-lg border border-line-light bg-surface p-8 shadow-sm">
        <div class="mb-6 text-center">
            <span class="mb-4 inline-flex items-center gap-1.5 rounded-full bg-primary-light px-3 py-1 text-sm font-medium text-primary-dark">
                {{ ux_icon('tabler:sparkles', {class: 'size-4', 'aria-hidden': 'true'}) }}
                {{ 'onboarding.company.welcome'|trans({'%app_name%': app_name}) }}
            </span>
            <span class="mx-auto mb-4 flex size-16 items-center justify-center rounded-full bg-primary-lighter text-primary">
                {{ ux_icon('tabler:building', {class: 'size-8', 'aria-hidden': 'true'}) }}
            </span>
            <h2 class="mb-2 text-2xl font-semibold text-fg">{{ 'onboarding.company.title'|trans }}</h2>
            <p class="text-lg text-fg-muted">{{ 'onboarding.company.description'|trans }}</p>
        </div>

        {{ form_start(form) }}
            {{ form_row(form.companyName, {'attr': {'class': 'si-control h-11 text-lg'}}) }}
            {{ form_row(form.companyCurrency) }}

            <twig:Si:Button type="submit" size="lg" class="w-full">
                {{ 'onboarding.company.submit'|trans }}
                {{ ux_icon('tabler:arrow-right', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
            </twig:Si:Button>
        {{ form_end(form) }}
    </div>
{% endblock %}
