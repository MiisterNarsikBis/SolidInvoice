{# Create an API token. One dialog serves both states: the form, then the token shown once. The form
   wraps the dialog (as ClientCredit does) so the footer's submit button belongs to it. #}
{% form_theme form '@SolidInvoiceCore/Form/tailwind.html.twig' %}

{% set modalId = 'api-token-' ~ attributes.all.id %}

<div {{ attributes }}>
    <twig:Si:Button data-si-modal-open="#{{ modalId }}">
        {{ ux_icon('tabler:plus', {class: 'size-4', 'aria-hidden': 'true'}) }}
        {{ 'profile.api.create'|trans }}
    </twig:Si:Button>

    <div {{ stimulus_controller('api-token-modal') }}>
        {{ form_start(form, {
            attr: {
                'data-action': 'live#action:prevent',
                'data-live-action-param': 'save'
            }
        }) }}
        <twig:Si:Modal
            id="{{ modalId }}"
            title="{{ this.modalTitle|trans }}"
            status="{{ this.modalStatus }}"
            :show="this.shouldShowModal"
        >
            {% if not createdToken %}
                {{ form_row(form.name) }}
                {{ form_row(form.description, {attr: {rows: 3, placeholder: 'profile.api.form.description_placeholder'|trans}}) }}
            {% else %}
                {# Success: the token is shown once #}
                <twig:Si:Alert type="warning" class="mb-4">
                    <strong>{{ 'profile.api.form.token_important'|trans }}</strong>
                    {{ 'profile.api.form.token_copy_warning'|trans }}
                </twig:Si:Alert>

                <div class="mb-4">
                    <span class="si-label">{{ 'profile.api.form.token_name'|trans }}</span>
                    <div class="text-fg">{{ createdTokenName }}</div>
                </div>

                <div class="mb-4">
                    <span class="si-label">{{ 'profile.api.form.token_value'|trans }}</span>
                    <div class="si-group" {{ stimulus_controller('clipboard', {'success-content': 'Copied!'}) }}>
                        <input readonly="readonly" value="{{ createdToken }}" class="si-control font-mono" {{ stimulus_target('clipboard', 'source') }} />
                        <button class="si-btn si-btn--md si-btn--primary rounded-none" type="button" {{ stimulus_target('clipboard', 'button') }} {{ stimulus_action('clipboard', 'copy') }}>
                            {{ ux_icon('tabler:copy', {class: 'size-4', 'aria-hidden': 'true'}) }}
                            {{ 'profile.api.form.token_copy'|trans }}
                        </button>
                    </div>
                </div>

                <p class="text-sm text-fg-muted">{{ 'profile.api.form.token_usage'|trans }}</p>
            {% endif %}

            <twig:block name="footer">
                {% if not createdToken %}
                    <button type="button" class="si-btn si-btn--md si-btn--ghost" data-si-modal-close>{{ 'profile.api.history.actions.close'|trans }}</button>
                    <button type="submit" class="si-btn si-btn--md si-btn--primary">{{ 'profile.api.form.actions.save'|trans }}</button>
                {% else %}
                    <button type="button" class="si-btn si-btn--md si-btn--primary" {{ stimulus_action('api-token-modal', 'confirmAndClose') }}>
                        {{ 'profile.api.form.token_confirmed'|trans }}
                    </button>
                {% endif %}
            </twig:block>
        </twig:Si:Modal>
        {{ form_end(form) }}
    </div>
</div>
