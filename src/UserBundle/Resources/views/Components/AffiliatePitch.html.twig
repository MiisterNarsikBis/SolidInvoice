{# What the affiliate programme pays, how it works, and the button to join. #}
<div {{ attributes }}>
    <p class="mb-4 text-fg-secondary">{{ 'affiliate.pitch.lead'|trans({'%commission%': this.program.commission}) }}</p>

    <ol class="mb-4 space-y-2">
        {% for step in [
            {icon: 'user-plus', text: 'affiliate.pitch.steps.join'|trans},
            {icon: 'link', text: 'affiliate.pitch.steps.share'|trans},
            {icon: 'coins', text: 'affiliate.pitch.steps.earn'|trans({'%commission%': this.program.commission})},
        ] %}
            <li class="flex items-center gap-2.5">
                <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-primary-light text-primary-dark">{{ ux_icon('tabler:' ~ step.icon, {class: 'size-4', 'aria-hidden': 'true'}) }}</span>
                {{ step.text }}
            </li>
        {% endfor %}
    </ol>

    <a href="{{ path('_affiliate_join', {source: source}) }}"
       target="_blank"
       rel="noopener"
       class="si-btn si-btn--md si-btn--primary"
       {% if ctaAction is not empty %}data-action="{{ ctaAction }}"{% endif %}
    >
        {{ 'affiliate.pitch.cta'|trans }}
        {{ ux_icon('tabler:external-link', {class: 'size-4', 'aria-hidden': 'true'}) }}
    </a>
</div>
