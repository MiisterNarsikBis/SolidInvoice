{# The notification preferences (a Live Component): which events reach which channels. The
   `integration-badge` and `group-title` classes are hooks that the functional tests look for. #}
{% form_theme form '@SolidInvoiceCore/Form/tailwind.html.twig' %}

{# Inside a component slot `this` is that component, so the page component is captured here. #}
{% set prefs = this %}
{% set availableTransports = prefs.allTransports %}
{% set groupedNotifications = prefs.groupNotificationsByCategory() %}

<div {{ attributes }}>
    {{ form_start(form, {
        attr: {
            'data-action': 'live#action:prevent',
            'data-live-action-param': 'save'
        }
    }) }}

    <p class="-mt-2 mb-4 text-fg-muted">{{ 'notifications.subtitle'|trans }}</p>

    {# Channels #}
    <div class="mb-6 rounded-lg border border-line-light bg-surface p-5 shadow-sm" data-notification-channels>
        <div class="flex flex-wrap items-center gap-3">
            <span class="flex size-9 shrink-0 items-center justify-center rounded-md bg-primary-lighter text-primary-dark">
                {{ ux_icon('tabler:plug-connected', {class: 'size-5', 'aria-hidden': 'true'}) }}
            </span>
            <div class="min-w-0 flex-1">
                <h2 class="text-lg font-semibold text-fg" data-notification-channels-title>{{ 'notifications.notification_channels'|trans }}</h2>
                <p class="text-sm text-fg-muted">
                    {% if availableTransports|length > 0 %}
                        {{ 'notifications.integrations_count'|trans({'%count%': availableTransports|length + 1}) }}
                    {% else %}
                        {{ 'notifications.email_always_available'|trans }}
                    {% endif %}
                </p>
            </div>
            <twig:Si:Button href="{{ path('_notification_integration') }}">
                {{ ux_icon('tabler:plus', {class: 'size-4', 'aria-hidden': 'true'}) }}
                {{ 'notifications.manage_integrations'|trans }}
            </twig:Si:Button>
        </div>

        {% if availableTransports|length > 0 %}
            <div class="mt-4 flex flex-wrap gap-2" data-notification-channels-list>
                <span class="integration-badge inline-flex items-center gap-1.5 rounded-full bg-ink-100 px-3 py-1 text-sm text-fg-secondary">
                    {{ ux_icon('tabler:mail', {class: 'size-4', 'aria-hidden': 'true'}) }}
                    <span>{{ 'notifications.email_channel'|trans }}</span>
                </span>
                {% for transport in availableTransports %}
                    <span class="integration-badge inline-flex items-center gap-1.5 rounded-full bg-ink-100 px-3 py-1 text-sm text-fg-secondary">
                        {{ ux_icon(prefs.getTransportIcon(transport.transport), {class: 'size-4', 'aria-hidden': 'true'}) }}
                        <span>{{ transport.name }}</span>
                    </span>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    {# Events, grouped by category #}
    {% if groupedNotifications|length > 0 %}
        <div class="space-y-6" data-notification-groups>
            {% for category, events in groupedNotifications %}
                <section data-notification-group>
                    <h2 class="group-title mb-3 flex items-center gap-2 text-lg font-semibold text-fg">
                        {{ ux_icon(prefs.getCategoryIcon(category), {class: 'size-5 text-fg-muted', 'aria-hidden': 'true'}) }}
                        {{ category|trans }}
                    </h2>

                    <div class="space-y-3">
                        {% for event in events %}
                            <div class="flex flex-wrap items-start justify-between gap-4 rounded-lg border border-line-light bg-surface p-4 shadow-sm" data-notification-card>
                                <div class="flex min-w-0 flex-1 items-start gap-3">
                                    <span class="flex size-9 shrink-0 items-center justify-center rounded-md bg-ink-100 text-fg-secondary">
                                        {{ ux_icon(prefs.getEventIcon(event), {class: 'size-5', 'aria-hidden': 'true'}) }}
                                    </span>
                                    <div class="min-w-0">
                                        <h3 class="font-medium text-fg" data-notification-title>{{ prefs.getEventTitle(event)|trans }}</h3>
                                        <p class="text-sm text-fg-muted" data-notification-description>{{ prefs.getEventDescription(event)|trans }}</p>
                                    </div>
                                </div>
                                <div class="flex flex-wrap items-center gap-x-4 gap-y-1" data-notification-card-channels>
                                    {{ form_widget(attribute(form, event).transports) }}
                                    {{ form_widget(attribute(form, event).event) }}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </section>
            {% endfor %}
        </div>
    {% else %}
        <twig:Si:Card>
            <twig:Si:EmptyState icon="tabler:bell-off" title="{{ 'notifications.empty.title'|trans }}" description="{{ 'notifications.empty.description'|trans }}" />
        </twig:Si:Card>
    {% endif %}

    <twig:Si:FormActions width="max-w-none" :bleed="false">
        <twig:Si:Button variant="ghost" href="{{ path('_profile') }}">
            {{ ux_icon('tabler:arrow-left', {class: 'size-4', 'aria-hidden': 'true'}) }}
            {{ 'action.cancel'|trans }}
        </twig:Si:Button>
        <twig:Si:Button type="submit">
            {{ ux_icon('tabler:device-floppy', {class: 'size-4', 'aria-hidden': 'true'}) }}
            {{ 'notifications.save_preferences'|trans }}
        </twig:Si:Button>
    </twig:Si:FormActions>

    {{ form_end(form) }}
</div>
