<div {{ attributes }} class="mb-4 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    {% for stat in [
        {icon: 'tabler:key', tint: 'bg-primary-light text-primary-dark', label: 'profile.api.stats.active_tokens', value: stats.activeTokens},
        {icon: 'tabler:api', tint: 'bg-info-light text-info-dark', label: 'profile.api.stats.calls_month', value: stats.apiCallsThisMonth|number_format},
        {icon: 'tabler:clock', tint: 'bg-success-light text-success-dark', label: 'profile.api.stats.last_activity', value: stats.lastActivity ? stats.lastActivity|date('d M Y') : 'profile.api.tokens.used.never'|trans},
        {icon: 'tabler:star', tint: 'bg-warning-light text-warning-dark', label: 'profile.api.stats.most_used', value: stats.mostUsedToken|default('-')|u.truncate(18, '...')},
    ] %}
        <div class="flex items-center gap-3.5 rounded-lg border border-line-light bg-surface p-4 shadow-sm">
            <span class="flex size-10 shrink-0 items-center justify-center rounded-md {{ stat.tint }}">
                {{ ux_icon(stat.icon, {class: 'size-5', 'aria-hidden': 'true'}) }}
            </span>
            <div class="min-w-0">
                <div class="tabular truncate text-lg font-semibold leading-tight text-fg">{{ stat.value }}</div>
                <div class="text-sm text-fg-secondary">{{ stat.label|trans }}</div>
            </div>
        </div>
    {% endfor %}
</div>
