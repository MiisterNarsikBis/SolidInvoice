{# The request history of one API token. The dialog only exists when a token is selected; the
   `api-token-history-modal` controller opens it and removes `view_history` from the URL on close. #}
{# Inside a component slot `this` is that component, so the token is read once here. #}
{% set token = this.token %}
<div {{ attributes.defaults({
    'data-controller': 'api-token-history-modal'
}) }}>
    {% if token %}
        <twig:Si:Modal id="apiTokenHistoryModal" size="xl" :staticBackdrop="true" title="{{ 'profile.api.history.title'|trans ~ ' - ' ~ token.name }}">
            <div class="-m-5">
                <twig:Si:Alert type="info" class="m-4 mb-0">{{ 'profile.api.history.notice'|trans }}</twig:Si:Alert>
                <div class="p-4">
                    <twig:DataGrid
                            name="api_token_history_grid"
                            :context="{ token_id: token.id }"
                           
                    />
                </div>
            </div>

            <twig:block name="footer">
                <button type="button" class="si-btn si-btn--md si-btn--outline" data-si-modal-close>{{ 'profile.api.history.actions.close'|trans }}</button>
            </twig:block>
        </twig:Si:Modal>
    {% endif %}
</div>
