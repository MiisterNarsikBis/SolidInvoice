{# Two-factor authentication settings (a Live Component): e-mail codes, an authenticator app, backup
   codes and the trusted-device flag. Its two dialogs are <twig:Si:Modal>s; the `two-factor-modal`
   controller keeps the `showQrModal` / `showBackupCodes` flags in step with them. #}
{% form_theme form '@SolidInvoiceCore/Form/tailwind.html.twig' %}

{# A section: icon, heading, a status badge with a note, and the buttons that change it. #}
{% set row = 'flex flex-wrap items-center justify-between gap-4' %}

<div {{ attributes.defaults({'data-controller': 'two-factor-download two-factor-modal'}) }}>
    <div class="space-y-4">

        {# ----------------------------------------------------- e-mail authentication #}
        <twig:Si:FormSection title="{{ 'security.two_factor.settings.email.title'|trans }}" description="{{ 'security.two_factor.settings.email.description'|trans }}" icon="tabler:mail">
            <div class="{{ row }}">
                <div>
                    <twig:Si:Badge :tone="app.user.isEmailAuthEnabled ? 'success' : 'neutral'">
                        {{ app.user.isEmailAuthEnabled ? 'security.two_factor.settings.status.enabled'|trans : 'security.two_factor.settings.status.disabled'|trans }}
                    </twig:Si:Badge>
                    <p class="mt-2 text-sm text-fg-muted">
                        {{ 'security.two_factor.settings.email.codes_sent_to'|trans }}: <strong class="text-fg">{{ app.user.email }}</strong>
                    </p>
                </div>
                <div>
                    {% if app.user.isEmailAuthEnabled %}
                        <button type="button" class="si-btn si-btn--md si-btn--danger" {{ live_action('disableEmailAuth:prevent') }}>
                            {{ ux_icon('tabler:x', {class: 'size-4', 'aria-hidden': 'true'}) }}
                            {{ 'security.two_factor.settings.disable'|trans }}
                        </button>
                    {% else %}
                        <button type="button" class="si-btn si-btn--md si-btn--primary" {{ live_action('enableEmailAuth:prevent') }}>
                            {{ ux_icon('tabler:check', {class: 'size-4', 'aria-hidden': 'true'}) }}
                            {{ 'security.two_factor.settings.enable'|trans }}
                        </button>
                    {% endif %}
                </div>
            </div>
        </twig:Si:FormSection>

        {# ------------------------------------------------------ authenticator app (TOTP) #}
        <twig:Si:FormSection title="{{ 'security.two_factor.settings.totp.title'|trans }}" description="{{ 'security.two_factor.settings.totp.description'|trans }}" icon="tabler:device-mobile">
            <div class="{{ row }}">
                <div>
                    <twig:Si:Badge :tone="app.user.isTotpAuthenticationEnabled ? 'success' : 'neutral'">
                        {{ app.user.isTotpAuthenticationEnabled ? 'security.two_factor.settings.status.enabled'|trans : 'security.two_factor.settings.status.disabled'|trans }}
                    </twig:Si:Badge>
                    <p class="mt-2 text-sm text-fg-muted">
                        {{ app.user.isTotpAuthenticationEnabled ?
                            'security.two_factor.settings.totp.configured'|trans :
                            'security.two_factor.settings.totp.not_configured'|trans
                        }}
                    </p>
                </div>
                <div>
                    {% if app.user.isTotpAuthenticationEnabled %}
                        <button type="button" class="si-btn si-btn--md si-btn--danger" {{ live_action('disableTOTPAuth:prevent') }}>
                            {{ ux_icon('tabler:x', {class: 'size-4', 'aria-hidden': 'true'}) }}
                            {{ 'security.two_factor.settings.disable'|trans }}
                        </button>
                    {% else %}
                        <button type="button" class="si-btn si-btn--md si-btn--primary" data-si-modal-open="#totp-setup-modal">
                            {{ ux_icon('tabler:qrcode', {class: 'size-4', 'aria-hidden': 'true'}) }}
                            {{ 'security.two_factor.settings.set_up'|trans }}
                        </button>
                    {% endif %}
                </div>
            </div>
        </twig:Si:FormSection>

        {# --------------------------------------------------------------- backup codes #}
        {% if app.user.is2FaEnabled and app.user.backupCodes is not empty %}
            <twig:Si:FormSection title="{{ 'security.two_factor.settings.backup.title'|trans }}" description="{{ 'security.two_factor.settings.backup.description'|trans }}" icon="tabler:key">
                <div class="{{ row }}">
                    <div>
                        <twig:Si:Badge tone="success">{{ app.user.backupCodes|length }} {{ 'security.two_factor.settings.backup.available'|trans }}</twig:Si:Badge>
                        <p class="mt-2 flex items-center gap-1.5 text-sm text-fg-muted">
                            {{ ux_icon('tabler:alert-triangle', {class: 'size-4 text-warning-dark', 'aria-hidden': 'true'}) }}
                            {{ 'security.two_factor.settings.backup.store_safely'|trans }}
                        </p>
                    </div>
                    <div class="flex flex-wrap gap-2">
                        <button type="button" class="si-btn si-btn--md si-btn--ghost" data-si-modal-open="#backup-codes-modal">
                            {{ ux_icon('tabler:eye', {class: 'size-4', 'aria-hidden': 'true'}) }}
                            {{ 'security.two_factor.settings.backup.view'|trans }}
                        </button>
                        <button type="button" class="si-btn si-btn--md si-btn--outline" {{ live_action('downloadBackupCodes:prevent') }}>
                            {{ ux_icon('tabler:download', {class: 'size-4', 'aria-hidden': 'true'}) }}
                            {{ 'security.two_factor.settings.backup.download'|trans }}
                        </button>
                    </div>
                </div>
            </twig:Si:FormSection>
        {% endif %}

        {# ------------------------------------------------------------- trusted device #}
        {% if isDeviceTrusted %}
            <twig:Si:FormSection title="{{ 'security.two_factor.settings.trusted.title'|trans }}" description="{{ 'security.two_factor.settings.trusted.description'|trans }}" icon="tabler:devices-check">
                <div class="{{ row }}">
                    <div>
                        <twig:Si:Badge tone="success">{{ 'security.two_factor.settings.trusted.badge'|trans }}</twig:Si:Badge>
                        <p class="mt-2 text-sm text-fg-muted">{{ 'security.two_factor.settings.trusted.note'|trans }}</p>
                    </div>
                    <button type="button" class="si-btn si-btn--md si-btn--danger" {{ live_action('clearTrustedDevice:prevent') }}>
                        {{ ux_icon('tabler:x', {class: 'size-4', 'aria-hidden': 'true'}) }}
                        {{ 'security.two_factor.settings.trusted.revoke'|trans }}
                    </button>
                </div>
            </twig:Si:FormSection>
        {% endif %}
    </div>

    {# --------------------------------------------------------------- TOTP setup dialog #}
    {% if not app.user.isTotpAuthenticationEnabled %}
        {% set qrImage = this.qrContent %}

        <twig:Si:Modal id="totp-setup-modal" title="{{ 'security.two_factor.settings.modal.setup_title'|trans }}" size="lg" :show="showQrModal">
            <div class="grid gap-6 md:grid-cols-2">
                <div class="text-center">
                    <ol class="mb-4 flex items-center justify-center gap-4 text-sm">
                        <li class="flex items-center gap-2 font-semibold text-primary-dark">
                            <span class="flex size-6 items-center justify-center rounded-full bg-primary text-xs text-white">1</span>
                            {{ 'security.two_factor.settings.modal.scan_qr'|trans }}
                        </li>
                        <li class="flex items-center gap-2 text-fg-muted">
                            <span class="flex size-6 items-center justify-center rounded-full bg-ink-100 text-xs">2</span>
                            {{ 'security.two_factor.settings.modal.verify_code'|trans }}
                        </li>
                    </ol>

                    <img src="{{ qrImage }}" alt="{{ 'security.two_factor.settings.modal.qr_alt'|trans }}" class="mx-auto size-48 rounded-md border border-line bg-white p-2" />
                    <p class="mt-3 text-fg-muted">{{ 'security.two_factor.settings.modal.scan_instruction'|trans }}</p>

                    <details class="mt-4 text-left">
                        <summary class="cursor-pointer text-sm font-medium text-primary hover:underline">{{ 'security.two_factor.settings.modal.manual_entry'|trans }}</summary>
                        <div class="mt-2 rounded-md bg-canvas p-3">
                            <p class="mb-2 text-sm text-fg-muted">{{ 'security.two_factor.settings.modal.manual_instruction'|trans }}</p>
                            <code class="break-all font-mono text-sm text-fg">{{ totpSecret }}</code>
                        </div>
                    </details>
                </div>

                <div class="md:pt-10">
                    {{ form_start(form) }}
                        <label for="{{ form.code.vars.id }}" class="si-label">{{ 'security.two_factor.settings.modal.enter_code'|trans }}</label>
                        {{ form_widget(form.code, {
                            attr: {
                                class: 'si-control h-12 text-center text-xl tracking-widest',
                                placeholder: 'security.two_factor.code_placeholder'|trans,
                                maxlength: 6,
                                pattern: '[0-9]*',
                                inputmode: 'numeric',
                                autocomplete: 'one-time-code'
                            }
                        }) }}
                        {{ form_errors(form.code) }}
                        {{ form_row(form.secret) }}
                    {{ form_end(form) }}
                </div>
            </div>

            <twig:block name="footer">
                <button type="button" class="si-btn si-btn--md si-btn--ghost" data-si-modal-close>
                    {{ ux_icon('tabler:x', {class: 'size-4', 'aria-hidden': 'true'}) }}
                    {{ 'action.cancel'|trans }}
                </button>
                <button type="button" class="si-btn si-btn--md si-btn--primary" {{ live_action('enableTOTPAuth:prevent') }}>
                    {{ ux_icon('tabler:check', {class: 'size-4', 'aria-hidden': 'true'}) }}
                    {{ 'security.two_factor.settings.modal.verify_enable'|trans }}
                </button>
            </twig:block>
        </twig:Si:Modal>
    {% endif %}

    {# ------------------------------------------------------------- backup codes dialog #}
    <twig:Si:Modal id="backup-codes-modal" title="{{ 'security.two_factor.settings.backup.title'|trans }}" :show="showBackupCodes">
        <twig:Si:Alert type="warning" class="mb-4">
            <strong>{{ 'security.two_factor.settings.backup.important'|trans }}</strong>
            {{ 'security.two_factor.settings.backup.save_notice'|trans }}
        </twig:Si:Alert>

        <div class="grid grid-cols-2 gap-2">
            {% for code in app.user.backupCodes %}
                <div class="rounded-md bg-canvas px-3 py-2 text-center">
                    <code class="font-mono text-base text-fg">{{ code }}</code>
                </div>
            {% endfor %}
        </div>

        <button type="button" class="si-btn si-btn--md si-btn--outline mt-4 w-full" {{ live_action('downloadBackupCodes:prevent') }}>
            {{ ux_icon('tabler:download', {class: 'size-4', 'aria-hidden': 'true'}) }}
            {{ 'security.two_factor.settings.backup.download_text'|trans }}
        </button>

        <twig:block name="footer">
            <button type="button" class="si-btn si-btn--md si-btn--ghost" data-si-modal-close>{{ 'action.close'|trans }}</button>
            <button type="button" class="si-btn si-btn--md si-btn--secondary" {{ live_action('regenerateBackupCodes:prevent') }}>
                {{ ux_icon('tabler:refresh', {class: 'size-4', 'aria-hidden': 'true'}) }}
                {{ 'security.two_factor.settings.backup.regenerate'|trans }}
            </button>
        </twig:block>
    </twig:Si:Modal>
</div>
