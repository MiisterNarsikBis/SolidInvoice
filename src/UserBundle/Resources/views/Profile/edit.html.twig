{% set menuItem = 'profile' %}

{% extends "@SolidInvoiceUser/Layout/profile.html.twig" %}

{% form_theme form '@SolidInvoiceCore/Form/tailwind.html.twig' %}

{% block title %}{{ "profile.edit.title"|trans }}{% endblock title %}

{% block profile_content %}
    {{ form_start(form) }}
    {{ form_errors(form) }}

    <p class="-mt-2 mb-4 text-fg-muted">{{ 'profile.edit.subtitle'|trans }}</p>

    <twig:Si:FormSection id="profile-details" title="{{ 'profile.edit.section.personal.title'|trans }}" description="{{ 'profile.edit.section.personal.description'|trans }}" icon="tabler:settings">
        {# Every field the configured profile form type declares, in its order. #}
        {{ form_widget(form) }}
    </twig:Si:FormSection>

    <twig:Si:FormActions width="max-w-none" :bleed="false">
        <twig:Si:Button variant="ghost" href="{{ path('_profile') }}">
            {{ ux_icon('tabler:arrow-left', {class: 'size-4', 'aria-hidden': 'true'}) }}
            {{ 'profile.edit.cancel'|trans }}
        </twig:Si:Button>
        <twig:Si:Button type="submit">
            {{ ux_icon('tabler:device-floppy', {class: 'size-4', 'aria-hidden': 'true'}) }}
            {{ 'profile.edit.submit'|trans }}
        </twig:Si:Button>
    </twig:Si:FormActions>
    {{ form_end(form) }}
{% endblock profile_content %}
