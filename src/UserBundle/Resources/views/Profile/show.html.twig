{% set menuItem = 'profile' %}

{% extends "@SolidInvoiceUser/Layout/profile.html.twig" %}

{% block title %}{{ "profile.show.title"|trans({"%username%" : app.user.userIdentifier}) }}{% endblock title %}

{% block profile_content %}
    {# Header: avatar, name, e-mail #}
    <div class="flex items-center gap-4 rounded-lg border border-line-light bg-surface p-5 shadow-sm">
        {% set initials = (app.user.firstName|slice(0, 1) ~ app.user.lastName|slice(0, 1))|upper %}
        <span class="flex size-14 shrink-0 items-center justify-center rounded-full bg-primary-light text-xl font-semibold text-primary-dark">{{ initials }}</span>
        <div class="min-w-0">
            <h2 class="truncate text-xl font-semibold text-fg">{{ app.user.firstName }} {{ app.user.lastName }}</h2>
            <p class="truncate text-fg-muted">{{ app.user.email }}</p>
        </div>
    </div>

    {# Personal information #}
    <twig:Si:Card title="{{ 'profile.show.personal.title'|trans }}" subtitle="{{ 'profile.show.personal.description'|trans }}" icon="tabler:user" iconColor="primary">
        <dl class="grid gap-x-6 gap-y-4 p-5 sm:grid-cols-2">
            <div>
                <dt class="text-sm text-fg-muted">{{ 'profile.show.first_name'|trans }}</dt>
                <dd class="mt-0.5 font-medium text-fg">{{ app.user.firstName }}</dd>
            </div>
            <div>
                <dt class="text-sm text-fg-muted">{{ 'profile.show.last_name'|trans }}</dt>
                <dd class="mt-0.5 font-medium text-fg">{{ app.user.lastName }}</dd>
            </div>
            <div class="sm:col-span-2">
                <dt class="text-sm text-fg-muted">{{ 'profile.show.email'|trans }}</dt>
                <dd class="mt-0.5 font-medium text-fg">{{ app.user.email }}</dd>
            </div>
            {% if app.user.mobile %}
                <div class="sm:col-span-2">
                    <dt class="text-sm text-fg-muted">{{ 'profile.show.mobile'|trans }}</dt>
                    <dd class="mt-0.5 font-medium text-fg">{{ app.user.mobile }}</dd>
                </div>
            {% endif %}
        </dl>

        <twig:block name="footer">
            <twig:Si:Button href="{{ path('_edit_profile') }}">
                {{ ux_icon('tabler:pencil', {class: 'size-4', 'aria-hidden': 'true'}) }}
                {{ 'profile.show.update_profile'|trans }}
            </twig:Si:Button>
        </twig:block>
    </twig:Si:Card>

    {# Security #}
    <twig:Si:Card title="{{ 'profile.show.security.title'|trans }}" subtitle="{{ 'profile.show.security.description'|trans }}" icon="tabler:shield" iconColor="primary">
        <div class="divide-y divide-line-light">
            {# Email verification #}
            {% if is_email_verification_gated() %}
                <twig:Si:SettingRow icon="tabler:mail-exclamation" iconColor="warning" title="{{ 'email_verification.profile.title'|trans }}" description="{{ 'email_verification.profile.description'|trans }}">
                    {% include '@SolidInvoiceUser/EmailVerification/_resend_form.html.twig' %}
                </twig:Si:SettingRow>
            {% endif %}

            {# Two-factor authentication #}
            <twig:Si:SettingRow
                :icon="app.user.is2FaEnabled ? 'tabler:shield-check' : 'tabler:shield-x'"
                :iconColor="app.user.is2FaEnabled ? 'success' : 'warning'"
                title="{{ 'security.two_factor.title'|trans }}"
                description="{{ app.user.is2FaEnabled ? 'profile.show.security.2fa_enabled'|trans : 'security.two_factor.subtitle'|trans }}"
            >
                <twig:Si:Button variant="outline" size="sm" href="{{ path('_2fa_list') }}">
                    {{ app.user.is2FaEnabled ? 'profile.show.security.manage'|trans : 'profile.show.security.enable'|trans }}
                </twig:Si:Button>
            </twig:Si:SettingRow>

            {% toggle 'google_oauth_login' %}
                {# Google account linking #}
                <twig:Si:SettingRow
                    :icon="app.user.googleId is not empty ? 'tabler:brand-google' : 'tabler:unlink'"
                    :iconColor="app.user.googleId is not empty ? 'success' : 'warning'"
                    title="{{ 'profile.show.security.google.title'|trans }}"
                    description="{{ app.user.googleId is not empty ? 'profile.show.security.google.linked'|trans : 'profile.show.security.google.link'|trans }}"
                >
                    {% if app.user.googleId is empty %}
                        <twig:Si:Button variant="outline" size="sm" href="{{ path('_oauth_connect', {'service': 'google'}) }}">
                            {{ ux_icon('tabler:brand-google', {class: 'size-4', 'aria-hidden': 'true'}) }}
                            {{ 'profile.show.security.google.sign_in'|trans }}
                        </twig:Si:Button>
                    {% else %}
                        <twig:Si:Badge tone="success">{{ 'profile.show.security.google.badge'|trans }}</twig:Si:Badge>
                    {% endif %}
                </twig:Si:SettingRow>
            {% endtoggle %}

            {# Password #}
            <twig:Si:SettingRow
                icon="tabler:lock"
                iconColor="success"
                title="{{ 'profile.show.security.password.title'|trans }}"
                description="{{ 'profile.show.security.password.description'|trans }}"
            >
                <twig:Si:Button variant="outline" size="sm" href="{{ path('_change_password') }}">{{ 'profile.nav.change_password'|trans }}</twig:Si:Button>
            </twig:Si:SettingRow>
        </div>
    </twig:Si:Card>
{% endblock profile_content %}
