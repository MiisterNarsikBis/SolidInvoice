{#
    The login screen, on the Tailwind auth layout. It does not extend Platform's Tabler-based
    `@Ui/Security/login.html.twig`. `error`, `last_username` and `options` are supplied by
    Platform's login controller; flash messages (for example "your password has been changed")
    are rendered by the layout.
#}
{% extends '@SolidInvoiceCore/Layout/auth.html.twig' %}

{% block page_title %}{{ 'security.login.login'|trans }}{% endblock %}

{% block contents %}
    <h1 class="mb-6 text-center text-xl font-semibold text-fg">{{ 'Login to your account'|trans }}</h1>

    {% if error %}
        <twig:Si:Alert type="danger" class="mb-5">{{ error.messageKey|trans(error.messageData, 'security') }}</twig:Si:Alert>
    {% endif %}

    <form action="{{ options.check_path starts with '/' ? options.check_path : url(options.check_path) }}" method="post" class="space-y-5">
        <twig:Si:Field
            label="{{ 'Email address'|trans }}"
            name="{{ options.username_parameter }}"
            type="email"
            icon="tabler:mail"
            placeholder="your@email.com"
            autocomplete="username"
            value="{{ last_username }}"
            required
            autofocus
        />

        <twig:Si:PasswordField
            label="{{ 'Password'|trans }}"
            toggleLabel="{{ 'Show password'|trans }}"
            name="{{ options.password_parameter }}"
            placeholder="{{ 'Your password'|trans }}"
            autocomplete="current-password"
            required
        />

        {% if options.always_remember_me is same as(false) and options.remember_me_parameter is not empty %}
            <label class="flex items-center gap-2.5 text-sm text-fg-secondary">
                <input type="checkbox" name="{{ options.remember_me_parameter }}" class="si-check">
                {{ 'Remember me on this device'|trans }}
            </label>
        {% endif %}

        {% if options.enable_csrf %}
            <input type="hidden" {{ stimulus_controller('csrf-protection') }} name="{{ options.csrf_parameter }}" value="{{ csrf_token(options.csrf_token_id) }}">
        {% endif %}

        <twig:Si:Button type="submit" size="lg" class="w-full">{{ 'Sign in'|trans }}</twig:Si:Button>
    </form>

    {% toggle 'google_oauth_login' %}
        <div class="my-6 flex items-center gap-3 text-sm text-fg-muted">
            <span class="h-px flex-1 bg-line"></span>
            {{ 'security.login.or'|trans }}
            <span class="h-px flex-1 bg-line"></span>
        </div>

        <twig:Si:Button variant="outline" href="{{ path('_oauth_connect', {'service': 'google'}) }}" class="w-full">
            {{ ux_icon('tabler:brand-google', {class: 'size-5', 'aria-hidden': 'true'}) }}
            {{ 'security.login.login_with_google'|trans }}
        </twig:Si:Button>
    {% endtoggle %}
{% endblock contents %}

{% block below_card %}
    {% toggle 'allow_registration' %}
        <p class="mt-6 rounded-md bg-surface/95 px-4 py-2 text-sm text-fg-secondary shadow-sm">
            {{ 'security.login.no_account'|trans }}
            <a href="{{ path('_register') }}" class="font-medium text-primary hover:text-primary-dark hover:underline">{{ 'security.login.register_now'|trans }}</a>
        </p>
    {% endtoggle %}
{% endblock below_card %}
