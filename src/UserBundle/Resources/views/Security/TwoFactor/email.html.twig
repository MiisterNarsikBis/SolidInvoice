{% extends '@SolidInvoiceCore/Layout/focus.html.twig' %}

{% block page_title %}{{ 'security.two_factor.email.title'|trans }}{% endblock %}

{% block page_heading %}{% endblock %}

{% block container_class %}max-w-md{% endblock %}

{% block content %}
    {% embed '@SolidInvoiceUser/Security/TwoFactor/_login_card.html.twig' with {icon: 'mail', title: 'security.two_factor.email.title', description: 'security.two_factor.email.description', success: true} %}
        {% block hint %}{{ 'security.two_factor.email.check_inbox'|trans }}{% endblock hint %}

        {% block after_form %}
            <div class="mt-5 text-center text-sm">
                <p class="text-fg-secondary">
                    {{ 'security.two_factor.email.no_code'|trans }}
                    <a href="{{ path('_solidworx_platform_security_two_factor_resend') }}" class="font-medium text-primary hover:underline">{{ 'security.two_factor.email.resend'|trans }}</a>
                </p>
                <p class="mt-1 flex items-center justify-center gap-1 text-fg-muted">
                    {{ ux_icon('tabler:clock', {class: 'size-3.5', 'aria-hidden': 'true'}) }}
                    {{ 'security.two_factor.email.expires'|trans }}
                </p>
            </div>
        {% endblock after_form %}
    {% endembed %}
{% endblock content %}
