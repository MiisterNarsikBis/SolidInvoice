{% extends '@SolidInvoiceCore/Layout/focus.html.twig' %}

{% block page_title %}{{ 'security.two_factor.title'|trans }}{% endblock %}

{% block page_heading %}{% endblock %}

{% block container_class %}max-w-md{% endblock %}

{% block content %}
    {% embed '@SolidInvoiceUser/Security/TwoFactor/_login_card.html.twig' with {icon: 'shield-lock', title: 'security.two_factor.title', description: 'security.two_factor.totp.description'} %}
        {% block hint %}
            {{ 'security.two_factor.lost_authenticator'|trans }}
            {{ 'security.two_factor.backup_code'|trans }}
            {{ 'security.two_factor.instead'|trans }}
        {% endblock hint %}
    {% endembed %}
{% endblock content %}
