{% extends "@SolidInvoiceCore/Layout/auth.html.twig" %}

{% form_theme form '@SolidInvoiceCore/Form/tailwind.html.twig' %}

{% block page_title %}{{ "forgot_password.request.title"|trans }}{% endblock page_title %}

{% block contents %}
    <h1 class="mb-2 text-center text-xl font-semibold text-fg">{{ 'forgot_password.request.heading'|trans }}</h1>
    <p class="mb-6 text-center text-fg-muted">{{ 'forgot_password.request.description'|trans }}</p>

    {{ form_start(form) }}
        {{ form_row(form.email) }}
        <twig:Si:Button type="submit" size="lg" class="w-full">
            {{ ux_icon('tabler:lock', {class: 'size-5', 'aria-hidden': 'true'}) }}
            {{ 'forgot_password.request.submit'|trans }}
        </twig:Si:Button>
    {{ form_end(form) }}
{% endblock contents %}

{% block below_card %}
    <a href="{{ path('_login_main') }}" class="mt-6 inline-flex items-center justify-center gap-1 rounded-md bg-surface/95 px-4 py-2 text-sm text-fg-secondary shadow-sm hover:text-primary">
        {{ ux_icon('tabler:arrow-left', {class: 'size-4', 'aria-hidden': 'true'}) }}
        {{ 'forgot_password.request.back_to_login'|trans }}
    </a>
{% endblock below_card %}
