{% extends "@SolidInvoiceCore/Layout/auth.html.twig" %}

{% block page_title %}{{ "forgot_password.check_email.title"|trans }}{% endblock page_title %}

{% block contents %}
    <div class="text-center">
        <span class="mx-auto mb-4 flex size-16 items-center justify-center rounded-full bg-success-light text-success-dark">
            {{ ux_icon('tabler:mail-check', {class: 'size-8', 'aria-hidden': 'true'}) }}
        </span>
        <h1 class="mb-2 text-xl font-semibold text-fg">{{ 'forgot_password.check_email.heading'|trans }}</h1>
        <p class="mb-3 text-fg-secondary">{{ 'forgot_password.check_email.content'|trans }}</p>
        <p class="mb-6 text-sm text-fg-muted">
            {{ 'forgot_password.check_email.expiry'|trans({'%tokenLifetime%': resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle')}) }}
        </p>
        <twig:Si:Button size="lg" href="{{ path('_login_main') }}" class="w-full">
            {{ ux_icon('tabler:arrow-left', {class: 'size-5', 'aria-hidden': 'true'}) }}
            {{ 'security.login.login'|trans }}
        </twig:Si:Button>
    </div>
{% endblock contents %}
