{% extends "@SolidInvoiceCore/Layout/auth.html.twig" %}

{% form_theme form '@SolidInvoiceCore/Form/tailwind.html.twig' %}

{% block page_title %}{{ 'forgot_password.reset.title'|trans }}{% endblock page_title %}

{% block contents %}
    <h1 class="mb-6 text-center text-xl font-semibold text-fg">{{ 'forgot_password.reset.heading'|trans }}</h1>

    {{ form_start(form) }}
        {{ form_row(form) }}
        <div class="flex gap-2">
            <twig:Si:Button type="submit" size="lg" class="flex-1">
                {{ ux_icon('tabler:lock', {class: 'size-5', 'aria-hidden': 'true'}) }}
                {{ 'forgot_password.request.submit'|trans }}
            </twig:Si:Button>
            <twig:Si:Button variant="ghost" size="lg" href="{{ path('_login_main') }}">
                {{ ux_icon('tabler:arrow-left', {class: 'size-5', 'aria-hidden': 'true'}) }}
                {{ 'security.login.login'|trans }}
            </twig:Si:Button>
        </div>
    {{ form_end(form) }}
{% endblock contents %}
