{% extends "@SolidInvoiceUser/Layout/profile.html.twig" %}

{% set program = affiliate_program() %}

{% block title %}{{ 'profile.nav.refer_and_earn'|trans }}{% endblock title %}

{% block profile_content %}
    <twig:Si:Card title="{{ 'affiliate.pitch.title'|trans({'%earnings%': program.yearlyEarnings}) }}" :padded="true">
        <twig:AffiliatePitch source="page" />
    </twig:Si:Card>

    <twig:Si:Card title="{{ 'affiliate.page.details.title'|trans }}" :padded="true">
        <div class="grid gap-6 md:grid-cols-3">
            {% for detail in [
                {icon: 'users', title: 'affiliate.page.details.who.title'|trans, text: 'affiliate.page.details.who.text'|trans},
                {icon: 'coins', title: 'affiliate.page.details.commission.title'|trans, text: 'affiliate.page.details.commission.text'|trans({'%commission%': program.commission, '%earnings%': program.yearlyEarnings})},
                {icon: 'cash', title: 'affiliate.page.details.payout.title'|trans, text: 'affiliate.page.details.payout.text'|trans},
            ] %}
                <div>
                    <span class="mb-3 flex size-10 items-center justify-center rounded-md bg-primary-light text-primary-dark">{{ ux_icon('tabler:' ~ detail.icon, {class: 'size-5', 'aria-hidden': 'true'}) }}</span>
                    <h4 class="mb-1 font-semibold text-fg">{{ detail.title }}</h4>
                    <p class="text-fg-secondary">{{ detail.text }}</p>
                </div>
            {% endfor %}
        </div>

        {% if program.termsUrl is not empty %}
            <div class="mt-6 border-t border-line-light pt-4">
                <a href="{{ program.termsUrl }}" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-fg-secondary hover:text-primary hover:underline">
                    {{ ux_icon('tabler:file-text', {class: 'size-4', 'aria-hidden': 'true'}) }}
                    {{ 'affiliate.page.details.terms.link'|trans }}
                    {{ ux_icon('tabler:external-link', {class: 'size-3.5', 'aria-hidden': 'true'}) }}
                </a>
            </div>
        {% endif %}
    </twig:Si:Card>
{% endblock profile_content %}
