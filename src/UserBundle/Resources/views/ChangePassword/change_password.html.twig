{% set menuItem = 'change-password' %}

{% extends "@SolidInvoiceUser/Layout/profile.html.twig" %}

{% form_theme form '@SolidInvoiceCore/Form/tailwind.html.twig' %}

{% block title %}{{ 'profile.nav.change_password'|trans }}{% endblock title %}

{% block profile_content %}
    {{ form_start(form) }}
    {{ form_errors(form) }}

    <p class="-mt-2 mb-4 text-fg-muted">{{ 'change_password.subtitle'|trans }}</p>

    <div class="space-y-4">
        {# Password requirements #}
        <div class="flex gap-3 rounded-lg border border-info/30 bg-info-light px-4 py-3 text-info-dark">
            {{ ux_icon('tabler:info-circle', {class: 'mt-0.5 size-5 shrink-0', 'aria-hidden': 'true'}) }}
            <div>
                <h3 class="font-semibold">{{ 'change_password.requirements.title'|trans }}</h3>
                <ul class="mt-1 list-disc space-y-0.5 pl-5 text-sm">
                    <li>{{ 'change_password.requirements.length'|trans }}</li>
                    <li>{{ 'change_password.requirements.mix'|trans }}</li>
                    <li>{{ 'change_password.requirements.breach'|trans }}</li>
                </ul>
            </div>
        </div>

        <twig:Si:FormSection id="password-details" title="{{ 'change_password.section.title'|trans }}" description="{{ 'change_password.section.description'|trans }}" icon="tabler:shield-lock">
            {% if form.currentPassword is defined %}
                {{ form_row(form.currentPassword) }}
            {% endif %}

            {% set newPassword = form.newPassword is defined ? form.newPassword : (form.plainPassword is defined ? form.plainPassword : null) %}
            {% if newPassword %}
                {{ form_row(newPassword.first) }}
                {{ form_row(newPassword.second) }}
            {% endif %}
        </twig:Si:FormSection>
    </div>

    {{ form_rest(form) }}

    <twig:Si:FormActions width="max-w-none" :bleed="false">
        <twig:Si:Button variant="ghost" href="{{ path('_profile') }}">
            {{ ux_icon('tabler:arrow-left', {class: 'size-4', 'aria-hidden': 'true'}) }}
            {{ 'profile.edit.cancel'|trans }}
        </twig:Si:Button>
        <twig:Si:Button type="submit">
            {{ ux_icon('tabler:device-floppy', {class: 'size-4', 'aria-hidden': 'true'}) }}
            {{ 'change_password.submit'|trans }}
        </twig:Si:Button>
    </twig:Si:FormActions>
    {{ form_end(form) }}
{% endblock profile_content %}
