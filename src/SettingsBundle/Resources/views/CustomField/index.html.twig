{% extends '@SolidInvoiceCore/Layout/shell.html.twig' %}

{% block page_title %}{{ 'custom_field.title'|trans }}{% endblock %}

{% block page_title_actions %}
    <twig:Si:Button href="{{ path('_settings_custom_fields_create') }}">
        {{ ux_icon('tabler:plus', {class: 'size-4', 'aria-hidden': 'true'}) }}
        {{ 'custom_field.add'|trans }}
    </twig:Si:Button>
{% endblock %}

{% block content %}
    {% set groups = {'client': client, 'contact': contact, 'invoice': invoice, 'quote': quote} %}
    {% set icons = {'client': 'tabler:building', 'contact': 'tabler:user', 'invoice': 'tabler:file-invoice', 'quote': 'tabler:file-text'} %}

    <twig:Si:Tabs>
        <twig:block name="tabs">
            {% for tabId in groups|keys %}
                <twig:Si:Tab target="tab-{{ tabId }}" :active="loop.first" icon="{{ icons[tabId] }}">{{ ('custom_field.tab.' ~ tabId)|trans }}</twig:Si:Tab>
            {% endfor %}
        </twig:block>

        <div class="mt-4 max-w-4xl rounded-lg border border-line-light bg-surface shadow-sm">
            {% for tabId, rows in groups %}
                <twig:Si:TabPanel id="tab-{{ tabId }}" :active="loop.first">
                    {% if rows is empty %}
                        <p class="px-5 py-8 text-center text-fg-muted">{{ 'custom_field.empty'|trans }}</p>
                    {% else %}
                        <ul class="divide-y divide-line-light"
                            {{ stimulus_controller('custom-field-reorder', {
                                url: path('_settings_custom_fields_reorder'),
                                csrfToken: csrf_token('custom_field_reorder'),
                            }) }}>
                            {% for row in rows %}
                                <li class="flex items-center gap-3 px-4 py-3" data-id="{{ row.field.id }}">
                                    <span class="cursor-grab text-fg-muted hover:text-fg-secondary" data-handle title="{{ 'custom_field.reorder.handle'|trans }}" aria-label="{{ 'custom_field.reorder.handle'|trans }}">
                                        {{ ux_icon('tabler:grip-vertical', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
                                    </span>
                                    <div class="min-w-0 flex-1">
                                        <div class="flex flex-wrap items-center gap-1.5">
                                            <strong class="font-semibold text-fg">{{ row.field.label }}</strong>
                                            <twig:Si:Badge>{{ row.field.type.label }}</twig:Si:Badge>
                                            {% if row.field.required %}<twig:Si:Badge tone="warning">{{ 'label.required'|trans }}</twig:Si:Badge>{% endif %}
                                            {% if row.field.visibility is not null %}
                                                {% if row.field.visibility.value == 'CLIENT_VISIBLE' %}
                                                    <twig:Si:Badge tone="info">{{ 'custom_field.badge.client_visible'|trans }}</twig:Si:Badge>
                                                {% else %}
                                                    <twig:Si:Badge>{{ 'custom_field.badge.internal'|trans }}</twig:Si:Badge>
                                                {% endif %}
                                            {% endif %}
                                        </div>
                                        <div class="mt-0.5 text-sm text-fg-muted">{{ row.count }} {{ 'custom_field.values'|trans }}</div>
                                    </div>
                                    <div class="flex items-center gap-1">
                                        <a href="{{ path('_settings_custom_fields_edit', {id: row.field.id}) }}"
                                           class="si-btn si-btn--sm si-btn--ghost"
                                           title="{{ 'action.edit'|trans }}"
                                           aria-label="{{ 'action.edit'|trans }}">
                                            {{ ux_icon('tabler:pencil', {class: 'size-4', 'aria-hidden': 'true'}) }}
                                        </a>
                                        <form method="post" action="{{ path('_settings_custom_fields_delete', {id: row.field.id}) }}" onsubmit="return confirm('{{ 'custom_field.delete_confirm'|trans({'%label%': row.field.label, '%count%': row.count})|e('js') }}')">
                                            <input type="hidden" name="_token" value="{{ csrf_token('cf_delete_' ~ row.field.id) }}">
                                            <button class="si-btn si-btn--sm si-btn--danger-ghost" type="submit"
                                                    title="{{ 'action.delete'|trans }}"
                                                    aria-label="{{ 'action.delete'|trans }}">
                                                {{ ux_icon('tabler:trash', {class: 'size-4', 'aria-hidden': 'true'}) }}
                                            </button>
                                        </form>
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>
                        {% if rows|length > 1 %}
                            <div class="flex items-center gap-2 border-t border-line-light px-4 py-2 text-sm text-fg-muted">
                                {{ ux_icon('tabler:arrows-sort', {class: 'size-4', 'aria-hidden': 'true'}) }}
                                {{ 'custom_field.reorder.hint'|trans }}
                            </div>
                        {% endif %}
                    {% endif %}
                </twig:Si:TabPanel>
            {% endfor %}
        </div>
    </twig:Si:Tabs>
{% endblock %}
