{#
 # The application settings page (a Live Component): a tab per section, the section's form in a
 # card, and for the system section the company tax identifiers and the danger zone below it.
 #
 # Built with plain elements rather than <twig:Si:Card>: the macro below is not visible inside a
 # component slot.
 #}
{% form_theme form '@SolidInvoiceSettings/Form/tailwind.html.twig' %}

{# A section heading: an icon, a title and an optional line of help. #}
{% macro head(icon, title, help = null) %}
    <h3 class="mb-3 flex items-center gap-2 text-lg font-semibold text-fg">
        {{ ux_icon(icon, {class: 'size-5 text-primary', 'aria-hidden': 'true'}) }}
        {{ title }}
    </h3>
    {% if help %}<p class="-mt-1 mb-4 text-sm text-fg-muted">{{ help }}</p>{% endif %}
{% endmacro %}
{% import _self as ui %}

{# Tab metadata for navigation #}
{% set tabMeta = {
    'system': {'title': 'settings.page.tab.system'|trans, 'icon': 'tabler:building'},
    'invoice': {'title': 'settings.page.tab.invoice'|trans, 'icon': 'tabler:file-invoice'},
    'quote': {'title': 'settings.page.tab.quote'|trans, 'icon': 'tabler:file-text'},
    'email': {'title': 'settings.page.tab.email'|trans, 'icon': 'tabler:mail'},
    'design': {'title': 'settings.page.tab.design'|trans, 'icon': 'tabler:palette'}
} %}
{% set sectionBox = 'mb-6 border-b border-line-light pb-6' %}

<div {{ attributes }}>
    <nav class="mb-5 flex flex-wrap gap-x-1 border-b border-line" role="tablist">
        {% for settingsSection, setting in appSettings %}
            {% set meta = tabMeta[settingsSection]|default({
                'title': settingsSection|replace({'_': ' '})|title|trans,
                'icon': 'tabler:settings'
            }) %}
            <twig:Si:Tab href="{{ path('_settings', {section: settingsSection}) }}" :active="settingsSection is same as section" icon="{{ meta.icon }}">{{ meta.title }}</twig:Si:Tab>
        {% endfor %}
    </nav>

    {{ form_start(form, {
        attr: {
            'data-action': 'live#action:prevent',
            'data-live-action-param': 'prevent|files|save'
        }
    }) }}

    <div class="max-w-4xl rounded-lg border border-line-light bg-surface shadow-sm">
        <div class="p-6">
            {% if section == 'system' %}
                {% if form.company is defined %}
                    <div class="{{ sectionBox }}">
                        {{ ui.head('tabler:building', 'settings.page.company.profile'|trans) }}
                        {% if form.company.company_name is defined %}
                            {{ form_row(form.company.company_name, {
                                label: 'settings.page.company.name'|trans,
                                attr: {placeholder: 'settings.page.company.name_placeholder'|trans}
                            }) }}
                        {% endif %}
                        {% if form.company.logo is defined %}
                            {{ form_row(form.company.logo, {label: 'settings.page.company.logo'|trans}) }}
                        {% endif %}
                    </div>

                    <div class="{{ sectionBox }}">
                        {{ ui.head('tabler:file-text', 'settings.page.company.business_details'|trans) }}
                        <div class="grid gap-x-4 md:grid-cols-2">
                            {% if form.company.currency is defined %}
                                <div>
                                    {{ form_row(form.company.currency, {
                                        label: 'settings.page.company.currency'|trans,
                                        help: 'settings.page.company.currency_help'|trans
                                    }) }}
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    {% if form.company.contact_details is defined %}
                        <div class="{{ sectionBox }}">
                            {{ ui.head('tabler:map-pin', 'settings.page.company.contact_details'|trans, 'settings.page.company.contact_help'|trans) }}
                            <div class="grid gap-x-4 md:grid-cols-2">
                                {% if form.company.contact_details.email is defined %}
                                    <div>
                                        {{ form_row(form.company.contact_details.email, {
                                            label: 'settings.page.company.contact_email'|trans,
                                            attr: {placeholder: 'settings.page.company.contact_email_placeholder'|trans}
                                        }) }}
                                    </div>
                                {% endif %}
                                {% if form.company.contact_details.phone_number is defined %}
                                    <div>
                                        {{ form_row(form.company.contact_details.phone_number, {
                                            label: 'settings.page.company.phone'|trans,
                                            attr: {placeholder: 'settings.page.company.phone_placeholder'|trans}
                                        }) }}
                                    </div>
                                {% endif %}
                            </div>
                            {% if form.company.contact_details.address is defined %}
                                <span class="si-label">{{ 'settings.page.company.business_address'|trans }}</span>
                                {{ form_widget(form.company.contact_details.address) }}
                            {% endif %}
                        </div>
                    {% endif %}
                {% endif %}

                {% if form.domain is defined and form.domain.custom_domain is defined %}
                    <div class="{{ sectionBox }}">
                        {{ ui.head('tabler:world', 'settings.page.domain.title'|trans, 'settings.page.domain.subtitle'|trans) }}
                        {{ form_row(form.domain.custom_domain, {
                            label: 'settings.page.domain.custom_domain'|trans,
                            attr: {placeholder: 'invoices.yourcompany.com'}
                        }) }}

                        {% if custom_domain_dns_record is not empty %}
                            <div class="flex gap-3 rounded-md border border-info/30 bg-info-light px-4 py-3 text-info-dark" role="alert">
                                {{ ux_icon('tabler:info-circle', {class: 'mt-0.5 size-5 shrink-0', 'aria-hidden': 'true'}) }}
                                <div class="min-w-0 flex-1">
                                    <h4 class="font-semibold">{{ 'settings.page.domain.dns_title'|trans }}</h4>
                                    <p class="mt-1 mb-3">{{ 'settings.page.domain.dns_help'|trans }}</p>
                                    <div class="overflow-x-auto rounded-md border border-info/30 bg-surface text-fg">
                                        <table class="w-full text-base">
                                            <thead>
                                                <tr class="border-b border-line-light text-left text-xs font-semibold uppercase tracking-wide text-fg-muted">
                                                    <th scope="col" class="px-3 py-2">{{ 'settings.page.domain.dns_type'|trans }}</th>
                                                    <th scope="col" class="px-3 py-2">{{ 'settings.page.domain.dns_name'|trans }}</th>
                                                    <th scope="col" class="px-3 py-2">{{ 'settings.page.domain.dns_value'|trans }}</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td class="px-3 py-2"><code class="font-mono text-sm">CNAME</code></td>
                                                    <td class="px-3 py-2"><code class="font-mono text-sm">{{ form.domain.custom_domain.vars.value|default('invoices.yourcompany.com') }}</code></td>
                                                    <td class="px-3 py-2"><code class="font-mono text-sm">{{ custom_domain_dns_record }}</code></td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                    <p class="mt-2 text-sm">{{ 'settings.page.domain.dns_footer'|trans }}</p>
                                </div>
                            </div>
                        {% endif %}
                    </div>
                {% endif %}

                {% if form.general is defined %}
                    <div>
                        {{ ui.head('tabler:settings', 'settings.page.general.title'|trans) }}
                        {{ form_widget(form.general) }}
                    </div>
                {% endif %}

            {% elseif section == 'invoice' or section == 'quote' %}
                <div class="{{ sectionBox }}">
                    {{ ui.head('tabler:eye', 'settings.page.display.title'|trans) }}
                    {% if form.watermark is defined %}
                        {{ form_row(form.watermark, {
                            label: 'settings.page.display.watermark'|trans,
                            help: 'settings.watermark.help'|trans({'%type%': ('label.' ~ section)|trans})
                        }) }}
                    {% endif %}
                </div>

                {% if form.payment_terms is defined %}
                    <div class="{{ sectionBox }}">
                        {{ ui.head('tabler:calendar-event', 'settings.page.payment_terms.title'|trans) }}
                        {{ form_row(form.payment_terms, {
                            label: 'settings.page.payment_terms.label'|trans,
                            help: 'settings.page.payment_terms.help'|trans
                        }) }}
                    </div>
                {% endif %}

                <div class="{{ sectionBox }}">
                    {{ ui.head('tabler:mail', 'settings.page.email.notifications'|trans) }}
                    {% if form.email_subject is defined %}
                        {{ form_row(form.email_subject, {
                            label: 'settings.page.email.subject'|trans,
                            help: 'settings.email_subject.help'|trans({'%type%': ('label.' ~ section)|trans}),
                            attr: {placeholder: 'settings.email_subject.placeholder'|trans({'%type%': ('label.' ~ section)|trans|title})}
                        }) }}
                    {% endif %}
                    {% if form.bcc_address is defined %}
                        {{ form_row(form.bcc_address, {
                            label: 'settings.page.email.bcc'|trans,
                            help: 'settings.bcc_address.help'|trans({'%type%': ('label.' ~ section)|trans}),
                            attr: {placeholder: 'bcc@yourcompany.com'}
                        }) }}
                    {% endif %}
                </div>

                {% if form.id_generation is defined %}
                    <div class="{{ section == 'invoice' and form.reminder is defined ? sectionBox : '' }}">
                        {{ ui.head('tabler:hash', 'settings.page.numbering.title'|trans, 'settings.numbering.description'|trans({'%type%': ('label.' ~ section)|trans})) }}
                        {% if form.id_generation.strategy is defined %}
                            {{ form_row(form.id_generation.strategy, {
                                label: 'settings.page.numbering.strategy'|trans,
                                help: 'settings.numbering_strategy.help'|trans({'%type%': ('label.' ~ section)|trans})
                            }) }}
                        {% endif %}
                        <div class="grid gap-x-4 md:grid-cols-2">
                            {% if form.id_generation.id_prefix is defined %}
                                <div>
                                    {{ form_row(form.id_generation.id_prefix, {
                                        label: 'settings.page.numbering.prefix'|trans,
                                        help: 'settings.page.numbering.prefix_help'|trans,
                                        attr: {placeholder: section == 'invoice' ? 'INV-' : 'QUO-'}
                                    }) }}
                                </div>
                            {% endif %}
                            {% if form.id_generation.id_suffix is defined %}
                                <div>
                                    {{ form_row(form.id_generation.id_suffix, {
                                        label: 'settings.page.numbering.suffix'|trans,
                                        help: 'settings.page.numbering.suffix_help'|trans,
                                        attr: {placeholder: '-2024'}
                                    }) }}
                                </div>
                            {% endif %}
                        </div>

                        <div class="flex items-center gap-2 rounded-lg bg-canvas px-4 py-3">
                            <span class="text-sm text-fg-muted">{{ 'settings.page.numbering.example'|trans }}</span>
                            <code class="font-mono text-base text-fg">
                                {% set prefix = form.id_generation.id_prefix.vars.value|default('') %}
                                {% set suffix = form.id_generation.id_suffix.vars.value|default('') %}
                                {{ prefix }}001{{ suffix }}
                            </code>
                        </div>
                    </div>
                {% endif %}

                {% if section == 'invoice' and form.reminder is defined %}
                    <div class="mt-6">
                        {{ ui.head('tabler:bell', 'settings.page.reminder.title'|trans, 'settings.page.reminder.subtitle'|trans) }}

                        {% if form.reminder.enabled is defined %}
                            {{ form_row(form.reminder.enabled, {
                                label: 'settings.page.reminder.enable'|trans,
                                help: 'settings.page.reminder.enable_help'|trans
                            }) }}
                        {% endif %}

                        <div class="space-y-5 rounded-lg bg-canvas p-5">
                            <div class="flex items-start gap-3 border-b border-line pb-5">
                                {{ ux_icon('tabler:calendar-event', {class: 'mt-0.5 size-5 shrink-0 text-primary', 'aria-hidden': 'true'}) }}
                                <div class="min-w-0 flex-1">
                                    <h4 class="font-semibold text-fg">{{ 'settings.page.reminder.pre_due.title'|trans }}</h4>
                                    <p class="mt-1 mb-3 text-sm text-fg-muted">{{ 'settings.page.reminder.pre_due.subtitle'|trans }}</p>

                                    {% if form.reminder.pre_due_enabled is defined %}
                                        {{ form_row(form.reminder.pre_due_enabled, {label: 'settings.page.reminder.pre_due.enable'|trans}) }}
                                    {% endif %}

                                    {% if form.reminder.pre_due_days is defined %}
                                        {{ form_row(form.reminder.pre_due_days, {
                                            label: 'settings.page.reminder.pre_due.days'|trans,
                                            help: 'settings.page.reminder.pre_due.days_help'|trans,
                                            attr: {min: 0, max: 30, placeholder: '3'}
                                        }) }}
                                    {% endif %}
                                </div>
                            </div>

                            <div class="flex items-start gap-3">
                                {{ ux_icon('tabler:clock-exclamation', {class: 'mt-0.5 size-5 shrink-0 text-warning-dark', 'aria-hidden': 'true'}) }}
                                <div class="min-w-0 flex-1">
                                    <h4 class="font-semibold text-fg">{{ 'settings.page.reminder.overdue.title'|trans }}</h4>
                                    <p class="mt-1 mb-3 text-sm text-fg-muted">{{ 'settings.page.reminder.overdue.subtitle'|trans }}</p>

                                    <div class="flex items-start gap-2 rounded-md border border-info/30 bg-info-light px-3 py-2.5 text-sm text-info-dark" role="status">
                                        {{ ux_icon('tabler:info-circle', {class: 'mt-0.5 size-5 shrink-0', 'aria-hidden': 'true'}) }}
                                        <div>
                                            <strong>{{ 'settings.page.reminder.overdue.tone_label'|trans }}</strong>
                                            {{ 'settings.page.reminder.overdue.tone_help'|trans }}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4 flex items-start gap-2 rounded-md border border-primary/25 bg-primary-lighter px-3 py-2.5 text-sm text-primary-dark" role="status">
                            {{ ux_icon('tabler:info-circle', {class: 'mt-0.5 size-5 shrink-0', 'aria-hidden': 'true'}) }}
                            <div>
                                <strong>{{ 'settings.page.reminder.how_label'|trans }}</strong>
                                {{ 'settings.page.reminder.how_help'|trans }}
                            </div>
                        </div>
                    </div>
                {% endif %}

            {% elseif section == 'email' %}
                <div class="{{ sectionBox }}">
                    {{ ui.head('tabler:user', 'settings.page.email.sender.title'|trans, 'settings.page.email.sender.subtitle'|trans) }}
                    <div class="grid gap-x-4 md:grid-cols-2">
                        {% if form.from_name is defined %}
                            <div>
                                {{ form_row(form.from_name, {
                                    label: 'settings.page.email.sender.from_name'|trans,
                                    help: 'settings.page.email.sender.from_name_help'|trans,
                                    attr: {placeholder: 'settings.page.email.sender.from_name_placeholder'|trans}
                                }) }}
                            </div>
                        {% endif %}
                        {% if form.from_address is defined %}
                            <div>
                                {{ form_row(form.from_address, {
                                    label: 'settings.page.email.sender.from_address'|trans,
                                    help: 'settings.page.email.sender.from_address_help'|trans,
                                    attr: {placeholder: 'no-reply@yourcompany.com'}
                                }) }}
                            </div>
                        {% endif %}
                    </div>
                </div>

                {% if form.sending_options is defined %}
                    <div>
                        {{ ui.head('tabler:server', 'settings.page.email.delivery.title'|trans, 'settings.page.email.delivery.subtitle'|trans) }}
                        {{ form_widget(form.sending_options) }}
                    </div>
                {% endif %}

            {% elseif section == 'design' and form.template is defined %}
                <div>
                    {{ ui.head('tabler:palette', 'settings.page.design.template.title'|trans, 'settings.page.design.template.subtitle'|trans) }}

                    {% if form.template.vars.feature_gated_active|default(false) %}
                        {{ upgrade_prompt(constant('SolidInvoice\\SaasBundle\\Feature\\Feature::CustomTemplates').value) }}
                    {% endif %}

                    {{ form_widget(form.template) }}
                </div>
            {% else %}
                {{ form_widget(form) }}
            {% endif %}
        </div>

        <div class="flex justify-end rounded-b-lg border-t border-line-light px-6 py-3">
            <button type="submit" class="si-btn si-btn--md si-btn--primary" aria-label="{{ 'settings.page.save'|trans }}">
                {{ ux_icon('tabler:device-floppy', {class: 'size-4', 'aria-hidden': 'true'}) }}
                {{ 'settings.page.save'|trans }}
            </button>
        </div>
    </div>

    {{ form_end(form) }}

    {% if section is same as('system') %}
        <div class="mt-6 max-w-4xl rounded-lg border border-line-light bg-surface p-6 shadow-sm">
            <twig:CompanyTaxIdentifiers />
        </div>

        {# Danger zone: deleting the company asks for its name to be typed first. #}
        <div class="mt-6 max-w-4xl" role="region" aria-labelledby="danger-zone-heading"
             {{ stimulus_controller('delete-company', {'company-name': company_name()}) }}>
            <div class="overflow-hidden rounded-lg border border-danger/50 bg-surface shadow-sm">
                <div class="flex items-center gap-2 border-b border-danger/30 bg-danger-light px-5 py-3 text-danger-dark">
                    {{ ux_icon('tabler:alert-triangle', {class: 'size-5', 'aria-hidden': 'true'}) }}
                    <h2 class="font-semibold" id="danger-zone-heading">{{ 'settings.page.danger.title'|trans }}</h2>
                </div>
                <div class="flex flex-col gap-3 p-5 sm:flex-row sm:items-center sm:justify-between">
                    <div>
                        <h3 class="font-semibold text-fg">{{ 'settings.page.danger.delete'|trans }}</h3>
                        <p class="text-fg-muted">{{ 'settings.page.danger.delete_help'|trans }}</p>
                    </div>
                    <button type="button" class="si-btn si-btn--md si-btn--outline shrink-0 border-danger/50 text-danger-dark" aria-label="{{ 'settings.page.danger.delete'|trans }}" {{ stimulus_action('delete-company', 'showModal', 'click') }}>
                        {{ ux_icon('tabler:trash', {class: 'size-4', 'aria-hidden': 'true'}) }}
                        {{ 'settings.page.danger.delete'|trans }}
                    </button>
                </div>
            </div>

            <twig:Si:Modal id="deleteCompanyModal" size="sm" status="danger" title="{{ 'settings.page.danger.modal.title'|trans }}" data-delete-company-target="modal">
                <twig:Si:Alert type="danger" class="mb-4">
                    <strong>{{ 'settings.page.danger.modal.warning'|trans }}</strong>
                    {{ 'settings.page.danger.modal.warning_help'|trans }}
                </twig:Si:Alert>
                <p class="mb-2 text-fg-secondary">{{ 'settings.page.danger.modal.confirm_prompt'|trans }}</p>
                <p class="mb-4 font-mono text-lg font-bold text-danger-dark" aria-label="{{ 'settings.page.danger.modal.company_name_aria'|trans }}">{{ company_name() }}</p>
                <label for="companyNameConfirmation" class="si-label">{{ 'settings.page.company.name'|trans }}</label>
                <input
                    type="text"
                    class="si-control"
                    id="companyNameConfirmation"
                    name="company_name"
                    form="deleteCompanyForm"
                    autocomplete="off"
                    aria-required="true"
                    {{ stimulus_target('delete-company', 'companyNameInput') }}
                    {{ stimulus_action('delete-company', 'validateInput', 'input') }}
                    placeholder="{{ 'settings.page.danger.modal.input_placeholder'|trans }}"
                >

                <twig:block name="footer">
                    <button type="button" class="si-btn si-btn--md si-btn--ghost" data-si-modal-close>{{ 'action.cancel'|trans }}</button>
                    <form id="deleteCompanyForm" action="{{ path('_delete_company') }}" method="post">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('delete_company') }}">
                        <button type="submit" class="si-btn si-btn--md si-btn--danger" aria-label="{{ 'settings.page.danger.delete'|trans }}" {{ stimulus_target('delete-company', 'confirmButton') }} disabled>
                            {{ ux_icon('tabler:trash', {class: 'size-4', 'aria-hidden': 'true'}) }}
                            {{ 'settings.page.danger.delete'|trans }}
                        </button>
                    </form>
                </twig:block>
            </twig:Si:Modal>
        </div>
    {% endif %}
</div>
