{% form_theme form '@SolidInvoiceCore/Form/tailwind.html.twig' %}

{% set mode = this.mode %}
{% set usageCount = this.usageCount %}

<div {{ attributes.defaults({class: 'max-w-3xl rounded-lg border border-line-light bg-surface p-6 shadow-sm'}) }}>
    {{ form_start(form, {
        attr: {
            'data-action': 'live#action:prevent',
            'data-live-action-param': 'save',
        }
    }) }}
        {# Radio groups laid out in a row, with the group label above #}
        {% for group in [form.target, form.visibility is defined ? form.visibility : null] %}
            {% if group is not null %}
                <div class="mb-4">
                    {{ form_label(group) }}
                    <div class="flex flex-wrap gap-x-6 gap-y-2">
                        {% for child in group %}
                            <div class="flex items-center gap-2">
                                {{ form_widget(child) }}
                                {{ form_label(child) }}
                            </div>
                        {% endfor %}
                    </div>
                    {{ form_help(group) }}
                    {{ form_errors(group) }}
                </div>
            {% endif %}
        {% endfor %}

        <div class="grid gap-x-4 md:grid-cols-2">
            <div>{{ form_row(form.label) }}</div>
            <div>
                {% if mode == 'edit' and usageCount > 0 %}
                    <twig:Si:Alert type="info" class="mb-3">{{ 'custom_field.form.type.locked'|trans({'%count%': usageCount}) }}</twig:Si:Alert>
                    {{ form_row(form.type, {attr: {disabled: 'disabled'}}) }}
                {% else %}
                    {{ form_row(form.type) }}
                {% endif %}
            </div>
            <div>{{ form_row(form.required) }}</div>
            {% if form.defaultValue is defined %}
                <div>{{ form_row(form.defaultValue) }}</div>
            {% endif %}
        </div>

        {% if form.options is defined %}
            <div class="mt-4">
                <div class="mb-2 flex flex-wrap items-baseline gap-2">
                    <h4 class="font-semibold text-fg">{{ 'label.options'|trans }}</h4>
                    <span class="text-sm text-fg-muted">{{ 'custom_field.form.option.hint'|trans }}</span>
                </div>

                <div class="space-y-2">
                    {% for option in form.options %}
                        <div class="flex items-center gap-2">
                            <div class="flex-1">{{ form_widget(option) }}</div>
                            {{ form_widget(option.vars.button_delete, {
                                label: ux_icon('tabler:trash', {class: 'size-[1.125rem]', 'aria-hidden': 'true'})|raw,
                                label_html: true,
                                attr: {
                                    'aria-label': 'custom_field.form.option.delete'|trans,
                                    title: 'custom_field.form.option.delete'|trans,
                                },
                            }) }}
                        </div>
                    {% endfor %}
                </div>

                <div class="mt-3">{{ form_widget(form.options.vars.button_add) }}</div>
                {{ form_errors(form.options) }}
            </div>
        {% endif %}

        <div class="mt-6 flex items-center justify-between border-t border-line-light pt-4">
            <a class="si-btn si-btn--md si-btn--outline" href="{{ path('_settings_custom_fields') }}">{{ 'action.cancel'|trans }}</a>
            <button class="si-btn si-btn--md si-btn--primary" type="submit" aria-label="{{ 'action.save'|trans }}">
                {{ ux_icon('tabler:device-floppy', {class: 'size-4', 'aria-hidden': 'true'}) }}
                {{ 'action.save'|trans }}
            </button>
        </div>
    {{ form_end(form) }}
</div>
