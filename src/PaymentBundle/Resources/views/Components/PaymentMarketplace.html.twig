{#
 # The payment methods page (a Live Component): a marketplace of gateways on the left, the active
 # methods on the right, and a configuration dialog over the top when a gateway is selected. On
 # small screens only one panel shows, chosen by the `view` tabs.
 #
 # The dialog is not a native <dialog>: the server renders it whenever `selectedGateway` is set, so
 # it follows the Live state. Its `payment-modal` controller closes it on Escape by clicking the
 # `.payment-modal-close` link.
 #}

{% macro gateway_card(gateway) %}
    <div class="flex items-start gap-3 rounded-lg border bg-surface p-4 shadow-xs {{ gateway.isConfigured ? 'border-success/40' : 'border-line' }}" data-gateway="{{ gateway.name }}">
        <span class="flex size-11 shrink-0 items-center justify-center rounded-md bg-ink-100 text-fg-secondary">
            {{ ux_icon(gateway.icon, {class: 'size-6', 'aria-hidden': 'true'}) }}
        </span>
        <div class="min-w-0 flex-1">
            <div class="mb-1 flex flex-wrap items-center gap-2">
                <h3 class="font-semibold text-fg">{{ gateway.displayName }}</h3>
                {% if gateway.recommended %}
                    <twig:Si:Badge tone="primary">{{ 'payment.gateway.badge.recommended'|trans }}</twig:Si:Badge>
                {% elseif gateway.advanced %}
                    <twig:Si:Badge>{{ 'payment.gateway.badge.advanced'|trans }}</twig:Si:Badge>
                {% endif %}
                {% if gateway.isConfigured %}
                    <span class="inline-flex items-center rounded-full bg-success-light p-0.5 text-success-dark">
                        {{ ux_icon('tabler:check', {class: 'size-3', 'aria-hidden': 'true'}) }}
                        <span class="sr-only">{{ 'payment.marketplace.badge.configured'|trans }}</span>
                    </span>
                {% endif %}
            </div>
            <p class="mb-3 text-sm text-fg-muted">{{ gateway.tagline }}</p>
            <a href="{{ path('_payment_settings_index', {selectedGateway: gateway.name}) }}" class="si-btn si-btn--sm si-btn--outline">
                {% if gateway.isConfigured %}
                    {{ ux_icon('tabler:edit', {class: 'size-3.5', 'aria-hidden': 'true'}) }}
                    {{ 'action.edit'|trans }}
                {% else %}
                    {{ ux_icon('tabler:plus', {class: 'size-3.5', 'aria-hidden': 'true'}) }}
                    {{ 'payment.marketplace.action.configure'|trans }}
                {% endif %}
            </a>
        </div>
    </div>
{% endmacro %}

{% macro group_heading(title, subtitle) %}
    <h3 class="text-xs font-semibold tracking-wide text-fg-muted uppercase">{{ title }}</h3>
    <p class="text-sm text-fg-muted">{{ subtitle }}</p>
{% endmacro %}

<div {{ attributes }}>
    {% include "@SolidInvoiceCore/flash.html.twig" %}

    {# Small screens: which panel to show #}
    <nav class="mb-4 flex flex-wrap border-b border-line md:hidden" role="tablist">
        <twig:Si:Tab href="{{ path('_payment_settings_index', {view: 'marketplace'}) }}" :active="view == 'marketplace'" icon="tabler:apps">{{ 'payment.marketplace.tab.marketplace'|trans }}</twig:Si:Tab>
        <twig:Si:Tab href="{{ path('_payment_settings_index', {view: 'active'}) }}" :active="view == 'active'" icon="tabler:list-check" :count="activeMethods|length">{{ 'payment.marketplace.tab.active'|trans }}</twig:Si:Tab>
    </nav>

    <div class="grid gap-6 md:grid-cols-12">
        {# ------------------------------------------------------ left: marketplace #}
        <div class="md:col-span-5 lg:col-span-4 {{ view == 'active' ? 'hidden md:block' : '' }}">
            <h2 class="flex items-center gap-2 text-lg font-semibold text-fg">
                {{ ux_icon('tabler:apps', {class: 'size-5 text-primary', 'aria-hidden': 'true'}) }}
                {{ 'payment.marketplace.gateways.title'|trans }}
            </h2>
            <p class="mt-1 mb-4 text-sm text-fg-muted">{{ 'payment.gateway.marketplace.subtitle'|trans }}</p>

            <div class="relative">
                <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-fg-muted">
                    {{ ux_icon('tabler:search', {class: 'size-4', 'aria-hidden': 'true'}) }}
                </span>
                <input
                    type="text"
                    class="si-control pr-9 pl-9"
                    placeholder="{{ 'payment.marketplace.search.placeholder'|trans }}"
                    data-model="searchQuery"
                    aria-label="{{ 'payment.marketplace.search.aria'|trans }}"
                >
                {% if searchQuery %}
                    <button type="button" class="absolute inset-y-0 right-0 flex items-center px-3 text-fg-muted hover:text-fg" data-action="live#action" data-live-action-param="clearSearch" aria-label="{{ 'payment.marketplace.search.clear'|trans }}">
                        {{ ux_icon('tabler:x', {class: 'size-4', 'aria-hidden': 'true'}) }}
                    </button>
                {% endif %}
            </div>

            <div class="mt-5 space-y-6">
                {% if filteredGateways|length > 0 %}
                    {# Online gateways, then offline / manual methods #}
                    {% for group in [
                        {items: gatewayGroups.online, title: 'payment.gateway.section.online.title', subtitle: 'payment.gateway.section.online.subtitle'},
                        {items: gatewayGroups.offline, title: 'payment.gateway.section.offline.title', subtitle: 'payment.gateway.section.offline.subtitle'},
                    ] %}
                        {% if group.items|length > 0 %}
                            <section>
                                <div class="mb-3">{{ _self.group_heading(group.title|trans, group.subtitle|trans) }}</div>
                                <div class="space-y-3">
                                    {% for gateway in group.items %}
                                        {{ _self.gateway_card(gateway) }}
                                    {% endfor %}
                                </div>
                            </section>
                        {% endif %}
                    {% endfor %}

                    {# Legacy / advanced processors, tucked away #}
                    {% if gatewayGroups.more|length > 0 %}
                        <details{{ searchQuery ? ' open' : '' }}>
                            <summary class="mb-3 cursor-pointer">
                                <span class="inline-flex items-center gap-2 text-xs font-semibold tracking-wide text-fg-muted uppercase">
                                    {{ 'payment.gateway.section.more.title'|trans }}
                                    <twig:Si:Badge>{{ gatewayGroups.more|length }}</twig:Si:Badge>
                                </span>
                                <span class="block text-sm text-fg-muted">{{ 'payment.gateway.section.more.subtitle'|trans }}</span>
                            </summary>
                            <div class="space-y-3">
                                {% for gateway in gatewayGroups.more %}
                                    {{ _self.gateway_card(gateway) }}
                                {% endfor %}
                            </div>
                        </details>
                    {% endif %}
                {% else %}
                    <twig:Si:EmptyState icon="tabler:search-off" title="{{ 'payment.marketplace.empty.no_gateways'|trans }}" />
                {% endif %}
            </div>
        </div>

        {# ------------------------------------------------- right: active methods #}
        <div class="md:col-span-7 lg:col-span-8 {{ view == 'marketplace' ? 'hidden md:block' : '' }}">
            <div class="mb-4 flex items-center justify-between">
                <h2 class="flex items-center gap-2 text-lg font-semibold text-fg">
                    {{ ux_icon('tabler:list-check', {class: 'size-5 text-primary', 'aria-hidden': 'true'}) }}
                    {{ 'payment.marketplace.active.title'|trans }}
                </h2>
                <span class="rounded-full bg-ink-100 px-2 py-0.5 text-xs font-semibold text-fg-secondary">{{ activeMethods|length }}</span>
            </div>

            {% if activeMethods|length > 0 %}
                {# Inside a component slot `this` is that component, so the page component is captured here. #}
                {% set marketplace = this %}
                <div class="space-y-3">
                    {% for method in activeMethods %}
                        <div class="flex items-start justify-between gap-3 rounded-lg border border-line-light bg-surface p-4 shadow-sm">
                            <div class="flex min-w-0 items-start gap-3">
                                <span class="flex size-10 shrink-0 items-center justify-center rounded-md bg-ink-100 text-fg-secondary">
                                    {{ ux_icon(marketplace.iconFor(method.factoryName), {class: 'size-6', 'aria-hidden': 'true'}) }}
                                </span>
                                <div class="min-w-0">
                                    <h3 class="truncate font-semibold text-fg">{{ method.name }}</h3>
                                    <div class="mt-1.5 flex flex-wrap items-center gap-2">
                                        <twig:Si:Badge :tone="method.enabled ? 'success' : 'neutral'">{{ method.enabled ? 'payment.marketplace.badge.enabled'|trans : 'payment.marketplace.badge.disabled'|trans }}</twig:Si:Badge>
                                        {% if method.config.sandbox|default(false) %}
                                            <twig:Si:Badge tone="warning">
                                                {{ ux_icon('tabler:flask', {class: 'size-3', 'aria-hidden': 'true'}) }}
                                                {{ 'payment.marketplace.badge.test_mode'|trans }}
                                            </twig:Si:Badge>
                                        {% endif %}
                                        {% if method.isInternal %}
                                            <twig:Si:Badge tone="info">{{ 'payment.method.offline'|trans }}</twig:Si:Badge>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                            <a href="{{ path('_payment_settings_index', {selectedGateway: method.gatewayName}) }}" class="si-btn si-btn--sm si-btn--outline shrink-0" aria-label="{{ 'payment.marketplace.edit_aria'|trans({'%name%': method.name}) }}">
                                {{ ux_icon('tabler:edit', {class: 'size-4', 'aria-hidden': 'true'}) }}
                            </a>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <twig:Si:Card>
                    <twig:Si:EmptyState icon="tabler:credit-card-off" title="{{ 'payment.marketplace.empty.no_methods'|trans }}" description="{{ 'payment.marketplace.empty.no_methods_hint'|trans }}">
                        <twig:Si:Button href="{{ path('_payment_settings_index', {view: 'marketplace'}) }}">
                            {{ ux_icon('tabler:plus', {class: 'size-4', 'aria-hidden': 'true'}) }}
                            {{ 'payment.marketplace.empty.browse'|trans }}
                        </twig:Si:Button>
                    </twig:Si:EmptyState>
                </twig:Si:Card>
            {% endif %}
        </div>
    </div>

    {# ------------------------------------------------------- configuration dialog #}
    {% if selectedGateway is not empty %}
        <div class="fixed inset-0 z-50 bg-ink-900/55" role="presentation" data-action="click->live#action" data-live-action-param="closeModal"></div>
        <div class="pointer-events-none fixed inset-0 z-50 flex items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="payment-modal-title" data-controller="payment-modal">
            <div class="pointer-events-auto flex max-h-full w-full max-w-2xl flex-col overflow-hidden rounded-xl bg-surface shadow-lg">
                <div class="flex shrink-0 items-center justify-between gap-3 border-b border-line-light px-5 py-4">
                    <h2 id="payment-modal-title" class="text-lg font-semibold text-fg">{{ 'payment.marketplace.modal.title'|trans }}</h2>
                    <a href="{{ path('_payment_settings_index') }}" class="payment-modal-close inline-flex size-8 items-center justify-center rounded-md text-fg-muted hover:bg-surface-hover hover:text-fg" aria-label="{{ 'action.close'|trans }}" title="{{ 'payment.marketplace.modal.close_title'|trans }}">
                        {{ ux_icon('tabler:x', {class: 'size-5', 'aria-hidden': 'true'}) }}
                    </a>
                </div>
                <div class="min-h-0 flex-1 overflow-y-auto p-5">
                    <twig:PaymentSettings method="{{ selectedGateway }}" />
                </div>
            </div>
        </div>
    {% endif %}
</div>
