{# Inside a component slot `this` is the slot's component, so the selected method is captured here. #}
{% set selectedMethod = this.method %}

<div {{ attributes }}>
    {% include "@SolidInvoiceCore/flash.html.twig" %}
    <div class="grid gap-6 md:grid-cols-12">
        <aside class="md:col-span-3">
            <twig:Si:Card :padded="true">
                <div class="mb-4">
                    <twig:Si:Dropdown label="{{ 'payment.method.add'|trans }}" align="start" triggerClass="si-btn si-btn--outline si-btn--md w-full" panelClass="w-full">
                        <twig:block name="trigger">
                            {{ ux_icon('tabler:circle-plus', {class: 'size-4', 'aria-hidden': 'true'}) }}
                            {{ 'payment.method.add'|trans }}
                        </twig:block>
                        {% for method in availablePaymentMethods %}
                            <twig:Si:MenuItem href="?method={{ method }}">{{ method|humanize|title }}</twig:Si:MenuItem>
                        {% endfor %}
                    </twig:Si:Dropdown>
                </div>
                <p class="mb-2 text-sm text-fg-muted">{{ 'payment.methods.available'|trans }}</p>
                <ul class="space-y-0.5" role="tablist">
                    {% for method in paymentMethods %}
                        <li>
                            <a href="?method={{ method.gatewayName }}" aria-controls="{{ method.gatewayName }}" data-method="{{ method.gatewayName }}" class="flex items-center gap-2 rounded-md px-2.5 py-1.5 text-sm hover:bg-surface-hover {{ method.gatewayName is same as(selectedMethod) ? 'bg-primary-light font-medium text-primary-dark' : 'text-fg-secondary' }}">
                                {% if method.isEnabled == 'enabled' %}
                                    {{ ux_icon('tabler:circle-check', {class: 'size-4 text-success-dark', 'aria-hidden': 'true'}) }}
                                {% else %}
                                    {{ ux_icon('tabler:circle-x', {class: 'size-4 text-fg-muted', 'aria-hidden': 'true'}) }}
                                {% endif %}
                                {{ method.name }}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </twig:Si:Card>
        </aside>
        <section class="md:col-span-9">
            {% if selectedMethod is not empty %}
                <twig:PaymentSettings method="{{ selectedMethod }}" />
            {% endif %}
        </section>
    </div>
</div>
