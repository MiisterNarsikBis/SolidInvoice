{# The settings of one payment gateway (a Live Component), shown in the marketplace dialog. #}
{% form_theme form '@SolidInvoiceCore/Form/tailwind.html.twig' %}

<div {{ attributes }}>
    <twig:Si:Card>
        <twig:block name="header">
            <div class="flex items-center justify-between gap-3">
                <div class="min-w-0">
                    <h3 class="flex items-center gap-2 text-lg font-semibold text-fg">
                        {{ ux_icon(gatewayInfo.icon, {class: 'size-5 text-primary', 'aria-hidden': 'true'}) }}
                        {{ paymentMethod.name|default(gatewayInfo.displayName|trans) }}
                    </h3>
                    <p class="text-sm text-fg-muted">{{ gatewayInfo.tagline|trans }}</p>
                </div>
                <a href="{{ path('_payment_settings_index') }}" class="si-btn si-btn--ghost si-btn--sm" aria-label="{{ 'action.close'|trans }}">
                    {{ ux_icon('tabler:x', {class: 'size-5', 'aria-hidden': 'true'}) }}
                </a>
            </div>
        </twig:block>

        <div class="p-5">
            {# About this gateway: what it is, which variant to pick, and where to get the keys #}
            {% if gatewayInfo.hasGuidance %}
                <twig:Si:Alert type="info" class="mb-5">
                    <p class="font-semibold">{{ 'payment.gateway.about.title'|trans }}</p>
                    {% if gatewayInfo.overview %}
                        <p class="mt-1">{{ gatewayInfo.overview|trans }}</p>
                    {% endif %}
                    {% if gatewayInfo.comparison %}
                        <details class="mt-2">
                            <summary class="cursor-pointer font-semibold">{{ 'payment.gateway.compare.title'|trans }}</summary>
                            <p class="mt-1">{{ gatewayInfo.comparison|trans }}</p>
                        </details>
                    {% endif %}
                    {% if gatewayInfo.setupUrl %}
                        <a href="{{ gatewayInfo.setupUrl }}" class="si-btn si-btn--sm si-btn--outline mt-3" target="_blank" rel="noopener noreferrer">
                            {{ ux_icon('tabler:external-link', {class: 'size-3.5', 'aria-hidden': 'true'}) }}
                            {{ (gatewayInfo.setupUrlLabel ?? 'payment.gateway.setup.default_label')|trans }}
                        </a>
                    {% endif %}
                </twig:Si:Alert>
            {% endif %}

            {{ form_start(form, {
                attr: {
                    'data-action': 'live#action:prevent',
                    'data-live-action-param': 'save'
                }
            }) }}
                {# Form-level / non-field errors (e.g. the UniqueEntity gatewayName violation, which maps to the root form) #}
                {{ form_errors(form) }}

                {# Details: how this method is identified inside SolidInvoice #}
                <section class="mb-6">
                    <h4 class="mb-1 flex items-center gap-2 text-base font-semibold text-fg">
                        {{ ux_icon('tabler:tag', {class: 'size-[1.125rem] text-fg-muted', 'aria-hidden': 'true'}) }}
                        {{ 'payment.gateway.section.details.title'|trans }}
                    </h4>
                    <p class="mb-4 text-sm text-fg-muted">{{ 'payment.gateway.section.details.subtitle'|trans }}</p>

                    {{ form_row(form.name) }}
                    {{ form_row(form.enabled) }}
                    {% if form.internal is defined %}
                        {{ form_row(form.internal) }}
                    {% endif %}
                </section>

                {# Credentials: the gateway-specific keys / API details #}
                {% if form.config is defined %}
                    <section class="mb-2">
                        <h4 class="mb-1 flex items-center gap-2 text-base font-semibold text-fg">
                            {{ ux_icon('tabler:key', {class: 'size-[1.125rem] text-fg-muted', 'aria-hidden': 'true'}) }}
                            {{ 'payment.gateway.section.credentials.title'|trans }}
                        </h4>
                        <p class="mb-4 text-sm text-fg-muted">{{ 'payment.gateway.section.credentials.subtitle'|trans }}</p>

                        {# Compound-level errors on the config field itself (not rendered by form_widget) #}
                        {{ form_errors(form.config) }}
                        {{ form_widget(form.config) }}
                    </section>
                {% endif %}

                {{ form_rest(form) }}
            {{ form_end(form) }}
        </div>

        <twig:block name="footer">
            <div class="flex items-center w-full justify-between gap-3">
                {% if paymentMethod.id is not empty %}
                    <twig:Si:Button type="button" variant="danger-ghost" data-action="live#action" data-live-action-param="showDeleteConfirmation" aria-label="{{ 'payment.settings.delete_aria'|trans }}">
                        {{ ux_icon('tabler:trash', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
                        {{ 'action.delete'|trans }}
                    </twig:Si:Button>
                {% else %}
                    <twig:Si:Button variant="ghost" href="{{ path('_payment_settings_index') }}">
                        {{ ux_icon('tabler:x', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
                        {{ 'action.close'|trans }}
                    </twig:Si:Button>
                {% endif %}
                <twig:Si:Button type="submit" data-action="live#action" data-live-action-param="save" data-loading="addAttribute(disabled)" aria-label="{{ 'payment.settings.save_aria'|trans }}">
                    {{ ux_icon('tabler:device-floppy', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
                    {{ 'payment.settings.save'|trans }}
                </twig:Si:Button>
            </div>
        </twig:block>
    </twig:Si:Card>

    {# Delete confirmation, stacked above the settings dialog #}
    {% if showDeleteConfirmation %}
        <div class="fixed inset-0 z-[60] bg-ink-900/55" role="presentation" aria-hidden="true" data-action="click->live#action" data-live-action-param="cancelDelete"></div>
        <div class="pointer-events-none fixed inset-0 z-[60] flex items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="delete-modal-title" data-delete-confirmation>
            <div class="pointer-events-auto w-full max-w-md overflow-hidden rounded-xl bg-surface shadow-lg">
                <div class="flex items-center gap-3 border-b border-line-light px-5 py-4">
                    <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-danger-light text-danger-dark">
                        {{ ux_icon('tabler:alert-triangle', {class: 'size-6', 'aria-hidden': 'true'}) }}
                    </span>
                    <div>
                        <h4 id="delete-modal-title" class="text-lg font-semibold text-fg">{{ 'payment.settings.delete_modal.title'|trans }}</h4>
                        <p class="text-sm text-fg-muted">{{ 'payment.settings.delete_modal.subtitle'|trans }}</p>
                    </div>
                </div>
                <p class="px-5 py-4 text-fg-secondary">
                    {{ 'payment.settings.delete_modal.confirm_prefix'|trans }} <strong>{{ paymentMethod.name }}</strong>?
                    {{ 'payment.settings.delete_modal.confirm_suffix'|trans }}
                </p>
                <div class="flex justify-end gap-2 border-t border-line-light bg-surface-hover px-5 py-3">
                    <twig:Si:Button type="button" variant="ghost" data-action="live#action" data-live-action-param="cancelDelete">{{ 'action.cancel'|trans }}</twig:Si:Button>
                    <twig:Si:Button type="button" variant="danger" data-action="live#action" data-live-action-param="confirmDelete" data-loading="addAttribute(disabled)">
                        {{ ux_icon('tabler:trash', {class: 'size-4', 'aria-hidden': 'true'}) }}
                        {{ 'payment.settings.delete_modal.title'|trans }}
                    </twig:Si:Button>
                </div>
            </div>
        </div>
    {% endif %}
</div>
