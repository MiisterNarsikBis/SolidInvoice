{% extends "@SolidInvoiceCore/Layout/focus.html.twig" %}

{# The page a payment gateway renders its own checkout into (the Payum layout). #}
{% block page_title %}{{ 'payment.action.pay'|trans }}{% endblock page_title %}

{% block stylesheets %}
    {{ parent() }}
    {{ block('payum_stylesheets') is defined ? block('payum_stylesheets') }}
{% endblock stylesheets %}

{% block content %}
    <div class="rounded-lg border border-line-light bg-surface p-6 shadow-sm">
        {{ block('payum_body') is defined ? block('payum_body') }}
    </div>
{% endblock content %}

{% block javascripts %}
    {{ parent() }}
    {{ block('payum_javascripts') is defined ? block('payum_javascripts') }}
{% endblock javascripts %}
