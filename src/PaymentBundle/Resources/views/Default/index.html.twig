{% extends "@SolidInvoiceCore/Layout/shell.html.twig" %}

{% block page_title %}{{ 'payment.list.title'|trans }}{% endblock page_title %}

{% block content %}
    {# KPI statistics #}
    <div class="mb-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {% for stat in [
            {icon: 'tabler:currency-dollar', tint: 'bg-success-light text-success-dark', label: 'payment.stats.total_received', money: stats.total_income},
            {icon: 'tabler:calendar-month', tint: 'bg-primary-light text-primary-dark', label: 'payment.stats.this_month', money: stats.this_month},
            {icon: 'tabler:clock', tint: 'bg-warning-light text-warning-dark', label: 'payment.stats.pending', count: stats.pending_count},
            {icon: 'tabler:alert-circle', tint: 'bg-danger-light text-danger-dark', label: 'payment.stats.failed', count: stats.failed_count},
        ] %}
            <div class="flex items-center gap-3.5 rounded-lg border border-line-light bg-surface p-4 shadow-sm">
                <span class="flex size-10 shrink-0 items-center justify-center rounded-md {{ stat.tint }}">
                    {{ ux_icon(stat.icon, {class: 'size-5', 'aria-hidden': 'true'}) }}
                </span>
                <div class="min-w-0">
                    <div class="tabular text-xl font-semibold leading-tight text-fg">
                        {% if stat.money is defined %}
                            {% for currency, data in stat.money %}
                                <div>{{ data.amount|formatCurrency(data.currency) }}</div>
                            {% else %}
                                -
                            {% endfor %}
                        {% else %}
                            {{ stat.count }}
                        {% endif %}
                    </div>
                    <div class="text-sm text-fg-secondary">{{ stat.label|trans }}</div>
                </div>
            </div>
        {% endfor %}
    </div>

    <twig:Si:Card>
        <twig:DataGrid name="payments_grid" />
    </twig:Si:Card>
{% endblock content %}
