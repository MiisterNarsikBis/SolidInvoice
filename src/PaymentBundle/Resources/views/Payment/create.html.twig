{# Pay an invoice. Shown inside the app to a signed-in user, and on the customer-facing page otherwise. #}
{% extends '@SolidInvoiceCore/Layout/' ~ (app.user is not empty ? 'shell' : 'focus') ~ '.html.twig' %}

{% form_theme form '@SolidInvoiceCore/Form/tailwind.html.twig' %}

{% block page_title %}{{ 'payment.create.title'|trans({"%id%" : invoice.invoiceId}) }}{% endblock page_title %}

{% block container_class %}{{ app.user is not empty ? 'max-w-[88rem]' : 'max-w-5xl' }}{% endblock %}

{% block content %}
    {% set captured = enum('SolidInvoice\\PaymentBundle\\Enum\\PaymentStatus').Captured %}
    {% set failed = enum('SolidInvoice\\PaymentBundle\\Enum\\PaymentStatus').Failed %}
    {% set has_balance_payments = invoice.payments|length > 0 and not invoice.balance.isZero %}

    <p class="-mt-2 mb-5 text-fg-muted">{{ 'payment.create.subtitle'|trans }}</p>

    {{ form_start(form) }}
    <div class="grid items-start gap-6 lg:grid-cols-5">
        {# ------------------------------------------------------- left: invoice summary #}
        <div class="space-y-6 lg:col-span-2">
            <twig:Si:Card title="{{ 'payment.invoice_summary'|trans }}" icon="tabler:file-invoice" iconColor="primary" :padded="true">
                <div class="space-y-5">
                    {# Client #}
                    <div>
                        <div class="mb-1.5 flex items-center gap-1.5 text-xs font-semibold tracking-wide text-fg-muted uppercase">
                            {{ ux_icon('tabler:building', {class: 'size-4', 'aria-hidden': 'true'}) }}
                            {{ 'payment.client'|trans }}
                        </div>
                        <div class="flex flex-wrap items-center gap-2">
                            {% if app.user is not empty %}
                                <a href="{{ path('_clients_view', {id: invoice.client.id}) }}" class="inline-flex items-center gap-1 font-medium text-primary hover:underline">
                                    {{ invoice.client.name }}
                                    {{ ux_icon('tabler:external-link', {class: 'size-3.5', 'aria-hidden': 'true'}) }}
                                </a>
                                {{ client_label(invoice.client.status) }}
                            {% else %}
                                <span class="font-medium text-fg">{{ invoice.client.name }}</span>
                            {% endif %}
                        </div>
                        {% if app.user is not empty and invoice.client.credit.value is not empty %}
                            <p class="mt-2 inline-flex items-center gap-1.5 rounded-md bg-success-light px-2.5 py-1 text-sm text-success-dark">
                                {{ ux_icon('tabler:wallet', {class: 'size-3.5', 'aria-hidden': 'true'}) }}
                                {{ 'payment.create.credit'|trans }}
                                <strong>{{ invoice.client.credit.value|formatCurrency(invoice.client.currency) }}</strong>
                            </p>
                        {% endif %}
                    </div>

                    {# Invoice details #}
                    <div>
                        <div class="mb-1.5 flex items-center gap-1.5 text-xs font-semibold tracking-wide text-fg-muted uppercase">
                            {{ ux_icon('tabler:receipt', {class: 'size-4', 'aria-hidden': 'true'}) }}
                            {{ 'payment.invoice_details'|trans }}
                        </div>
                        <dl class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
                            <div>
                                <dt class="text-fg-muted">{{ 'invoice.label'|trans }}</dt>
                                <dd class="font-medium text-fg">
                                    {% if app.user is not empty %}
                                        <a href="{{ path('_invoices_view', {id: invoice.id}) }}" class="inline-flex items-center gap-1 text-primary hover:underline">
                                            {{ invoice.invoiceId }}
                                            {{ ux_icon('tabler:external-link', {class: 'size-3', 'aria-hidden': 'true'}) }}
                                        </a>
                                    {% else %}
                                        {{ invoice.invoiceId }}
                                    {% endif %}
                                </dd>
                            </div>
                            <div>
                                <dt class="text-fg-muted">{{ 'payment.create.invoice_date'|trans }}</dt>
                                <dd class="font-medium text-fg">{{ invoice.invoiceDate|date('d M Y') }}</dd>
                            </div>
                            {% if invoice.due is not empty %}
                                <div>
                                    <dt class="text-fg-muted">{{ 'billing.due_date'|trans }}</dt>
                                    <dd class="font-medium {{ invoice.due < date() ? 'text-danger-dark' : 'text-fg' }}">{{ invoice.due|date('d M Y') }}</dd>
                                </div>
                            {% endif %}
                            <div>
                                <dt class="text-fg-muted">{{ 'payment.list.grid.status'|trans }}</dt>
                                <dd>{{ invoice_label(invoice.status) }}</dd>
                            </div>
                        </dl>
                    </div>

                    {# Line items #}
                    <div>
                        <div class="mb-1.5 flex items-center gap-1.5 text-xs font-semibold tracking-wide text-fg-muted uppercase">
                            {{ ux_icon('tabler:list-details', {class: 'size-4', 'aria-hidden': 'true'}) }}
                            {{ 'payment.line_items'|trans }}
                        </div>
                        <ul class="divide-y divide-line-light text-sm">
                            {% for item in invoice.lines %}
                                <li class="flex justify-between gap-3 py-1.5">
                                    <span class="min-w-0 text-fg-secondary">{{ item.name|u.truncate(40, '...') }}</span>
                                    <span class="tabular shrink-0 text-fg">{{ item.total|formatCurrency(invoice.currency) }}</span>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>

                    {# Totals #}
                    <dl class="space-y-1.5 border-t border-line-light pt-4 text-sm">
                        <div class="flex justify-between">
                            <dt class="text-fg-secondary">{{ 'invoice.subtotal'|trans }}</dt>
                            <dd class="tabular text-fg">{{ invoice.baseTotal|formatCurrency(invoice.currency) }}</dd>
                        </div>
                        {% if invoice.tax.positive %}
                            <div class="flex justify-between">
                                <dt class="text-fg-secondary">{{ 'invoice.tax'|trans }}</dt>
                                <dd class="tabular text-fg">{{ invoice.tax|formatCurrency(invoice.currency) }}</dd>
                            </div>
                        {% endif %}
                        {% if invoice.hasDiscount %}
                            <div class="flex justify-between text-success-dark">
                                <dt>{{ 'invoice.discount'|trans }}</dt>
                                <dd class="tabular">-{{ discount(invoice)|formatCurrency(invoice.currency) }}</dd>
                            </div>
                        {% endif %}
                        {% if has_balance_payments %}
                            {% for payment in invoice.payments|filter((v) => v.status == captured) %}
                                <div class="flex justify-between text-fg-secondary">
                                    <dt>{{ 'payment.create.payment_label'|trans }}: {{ payment.method.name }}</dt>
                                    <dd class="tabular">-{{ payment.amount.amount|formatCurrency(invoice.currency) }}</dd>
                                </div>
                            {% endfor %}
                        {% endif %}
                        <div class="flex justify-between border-t border-line pt-2 text-base font-semibold text-fg">
                            <dt>{{ has_balance_payments ? 'invoice.balance'|trans : 'invoice.total'|trans }}</dt>
                            <dd class="tabular">{{ (has_balance_payments ? invoice.balance : invoice.total)|formatCurrency(invoice.currency) }}</dd>
                        </div>
                    </dl>
                </div>
            </twig:Si:Card>

            {# Payment history #}
            {% if invoice.payments|length > 0 %}
                <twig:Si:Card title="{{ 'payment.history.title'|trans }}" icon="tabler:history" :padded="true">
                    <twig:block name="actions"><twig:Si:Badge>{{ invoice.payments|length }}</twig:Si:Badge></twig:block>
                    <ul class="space-y-3">
                        {% for payment in invoice.payments %}
                            <li class="rounded-md border border-line-light border-l-4 p-3 {{ payment.status == captured ? 'border-l-success' : (payment.status == failed ? 'border-l-danger' : 'border-l-ink-300') }}">
                                <div class="mb-1.5 flex items-center justify-between gap-2">
                                    <span class="tabular font-semibold text-fg">{{ payment.totalAmount|formatCurrency(invoice.currency) }}</span>
                                    {{ payment_label(payment.status) }}
                                </div>
                                <div class="space-y-1 text-sm text-fg-secondary">
                                    {% if payment.method is not empty %}
                                        <div class="flex items-center gap-1.5">{{ ux_icon('tabler:credit-card', {class: 'size-3.5 text-fg-muted', 'aria-hidden': 'true'}) }}<span>{{ payment.method.name }}</span></div>
                                    {% endif %}
                                    {% if payment.completed is not empty %}
                                        <div class="flex items-center gap-1.5">{{ ux_icon('tabler:calendar', {class: 'size-3.5 text-fg-muted', 'aria-hidden': 'true'}) }}<span>{{ payment.completed|date('M d, Y \\a\\t H:i') }}</span></div>
                                    {% endif %}
                                    {% if payment.reference is not empty %}
                                        <div class="flex items-center gap-1.5">{{ ux_icon('tabler:hash', {class: 'size-3.5 text-fg-muted', 'aria-hidden': 'true'}) }}<span>{{ payment.reference }}</span></div>
                                    {% endif %}
                                    {% if payment.message is not empty %}
                                        <p class="text-fg-muted">{{ payment.message }}</p>
                                    {% endif %}
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                </twig:Si:Card>
            {% endif %}
        </div>

        {# ------------------------------------------------------------ right: payment form #}
        <div class="lg:col-span-3">
            <twig:Si:Card title="{{ 'payment.details'|trans }}" icon="tabler:wallet" iconColor="primary">
                <div class="p-5" {{ stimulus_controller('payment-method-select') }}>
                    {# Payment method #}
                    <fieldset class="mb-5">
                        <legend class="si-label">{{ 'payment.method.label'|trans }}<span class="text-danger-dark" aria-hidden="true"> *</span></legend>
                        <div class="grid gap-3 sm:grid-cols-2">
                            {% for choice in form.payment_method.vars.choices %}
                                {% set method = choice.data %}
                                {% set isOffline = method.offline %}
                                <label class="block cursor-pointer" {{ stimulus_target('payment-method-select', 'card') }} data-offline="{{ isOffline ? 'true' : 'false' }}">
                                    <input
                                        type="radio"
                                        name="{{ form.payment_method.vars.full_name }}"
                                        value="{{ choice.value }}"
                                        class="peer sr-only"
                                        {{ stimulus_action('payment-method-select', 'select') }}
                                        {% if form.payment_method.vars.data and form.payment_method.vars.data.id.toString() == choice.value %}checked{% endif %}
                                        required
                                    >
                                    <span class="relative flex h-full items-center gap-3 rounded-lg border border-line bg-surface p-3.5 transition-colors hover:border-primary-light peer-checked:border-primary peer-checked:bg-primary-lighter peer-focus-visible:ring-2 peer-focus-visible:ring-primary/40 peer-checked:[&_.check]:opacity-100">
                                        <span class="flex size-10 shrink-0 items-center justify-center rounded-md bg-ink-100 text-fg-secondary">
                                            {{ ux_icon(method.gatewayName == 'credit' ? 'tabler:wallet' : (isOffline ? 'tabler:cash' : 'tabler:credit-card'), {class: 'size-6', 'aria-hidden': 'true'}) }}
                                        </span>
                                        <span class="min-w-0 flex-1">
                                            <span class="block truncate font-medium text-fg">{{ choice.label }}</span>
                                            {% if method.gatewayName == 'credit' %}
                                                <twig:Si:Badge tone="success" class="mt-1">{{ 'payment.method.credit'|trans }}</twig:Si:Badge>
                                            {% elseif isOffline %}
                                                <twig:Si:Badge class="mt-1">{{ 'payment.method.offline'|trans }}</twig:Si:Badge>
                                            {% else %}
                                                <twig:Si:Badge tone="primary" class="mt-1">{{ 'payment.method.online'|trans }}</twig:Si:Badge>
                                            {% endif %}
                                        </span>
                                        <span class="check text-primary opacity-0 transition-opacity">{{ ux_icon('tabler:check', {class: 'size-5', 'aria-hidden': 'true'}) }}</span>
                                    </span>
                                </label>
                            {% endfor %}
                        </div>
                        {% do form.payment_method.setRendered %}
                        {{ form_errors(form.payment_method) }}
                    </fieldset>

                    {# Amount #}
                    <div class="mb-5">
                        <div class="flex flex-wrap items-baseline justify-between gap-2">
                            {{ form_label(form.amount, 'payment.amount.label'|trans) }}
                            <span class="text-sm text-fg-muted">
                                {{ 'payment.balance_remaining'|trans }}:
                                <strong class="tabular text-fg">{{ invoice.balance|formatCurrency(invoice.currency) }}</strong>
                            </span>
                        </div>
                        {{ form_widget(form.amount) }}
                        {{ form_errors(form.amount) }}
                        <p class="si-help">{{ 'payment.amount.help'|trans }}</p>
                    </div>

                    {% if form.capture_online is defined %}
                        <div {{ stimulus_target('payment-method-select', 'captureOnline') }}>
                            {{ form_row(form.capture_online, {label: 'payment.capture_online.label'|trans, help: 'payment.capture_online.help'|trans, translation_domain: false}) }}
                        </div>
                    {% endif %}

                    {% if form.reference is defined %}
                        {{ form_row(form.reference, {label: 'payment.reference.label'|trans, help: 'payment.reference.help'|trans, attr: {placeholder: 'payment.reference.placeholder'|trans}, translation_domain: false}) }}
                    {% endif %}

                    {% if form.notes is defined %}
                        {{ form_row(form.notes, {label: 'payment.notes.label'|trans, help: 'payment.notes.help'|trans, attr: {placeholder: 'payment.notes.placeholder'|trans, rows: 3}, translation_domain: false}) }}
                    {% endif %}
                </div>

                <twig:block name="footer">
                    <a href="javascript:history.go(-1)" class="si-btn si-btn--ghost si-btn--md mr-auto">
                        {{ ux_icon('tabler:arrow-left', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
                        {{ 'action.cancel'|trans }}
                    </a>
                    <twig:Si:Button type="submit" size="lg">
                        {{ ux_icon('tabler:credit-card', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
                        {{ 'payment.action.pay'|trans }}
                    </twig:Si:Button>
                </twig:block>
            </twig:Si:Card>
        </div>
    </div>
    {{ form_end(form) }}
{% endblock %}
