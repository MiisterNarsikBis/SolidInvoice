{% extends '@SolidInvoiceCore/Layout/auth.html.twig' %}

{% block page_title %}{{ app_name }} - {{ 'mcp.consent.title'|trans({}) }}{% endblock %}

{% block contents %}
    <h1 class="mb-3 text-center text-xl font-semibold text-fg">{{ 'mcp.consent.heading'|trans({'%client%': client.name}) }}</h1>

    {% if client.redirectUris|length > 0 %}
        <p class="mb-4 text-center text-sm break-all text-fg-muted">{{ 'mcp.consent.redirect'|trans({'%uri%': client.redirectUris|first}) }}</p>
    {% endif %}

    <form method="post" action="{{ path('mcp_oauth_authorize') }}{% if app.request.queryString %}?{{ app.request.queryString }}{% endif %}">
        <input type="hidden" name="state" value="{{ state|default('')|e('html_attr') }}">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token(csrf_token_id) }}">

        <div class="mb-4">
            <label class="si-label" for="mcp-company">{{ 'mcp.consent.company'|trans({}) }}</label>

            {% if companies|length == 1 %}
                {% set company = companies|first %}
                <div id="mcp-company" class="si-control flex items-center bg-canvas"><strong>{{ company.name }}</strong></div>
                <input type="hidden" name="company_id" value="{{ company.id }}">
            {% else %}
                <select id="mcp-company" class="si-control" name="company_id" required>
                    {% for company in companies %}
                        <option value="{{ company.id }}" {% if active_company_id and company.id == active_company_id %}selected{% endif %}>{{ company.name }}</option>
                    {% endfor %}
                </select>
            {% endif %}
        </div>

        <h2 class="mb-2 text-base font-semibold text-fg">{{ 'mcp.consent.permissions'|trans({}) }}</h2>

        <ul class="mb-4 space-y-2">
            <li>
                <label class="flex items-center gap-2 text-fg-secondary">
                    <input class="si-check" type="checkbox" checked disabled>
                    {{ ux_icon('tabler:eye', {class: 'size-[1.125rem] text-fg-muted', 'aria-hidden': 'true'}) }}
                    {{ 'mcp.consent.scope.read'|trans({}) }}
                </label>
            </li>

            {% if supports_write %}
                <li>
                    <label class="flex cursor-pointer items-center gap-2 text-fg-secondary">
                        <input class="si-check" type="checkbox" name="grant_write" value="1" checked>
                        {{ ux_icon('tabler:pencil', {class: 'size-[1.125rem] text-fg-muted', 'aria-hidden': 'true'}) }}
                        {{ 'mcp.consent.scope.write'|trans({}) }}
                    </label>
                </li>
            {% endif %}
        </ul>

        <label class="mb-5 flex cursor-pointer items-center gap-2 text-fg-secondary">
            <input class="si-check" type="checkbox" name="remember" value="1">
            {{ 'mcp.consent.remember'|trans({}) }}
        </label>

        <div class="flex gap-2">
            <button type="submit" name="action" value="deny" class="si-btn si-btn--ghost si-btn--lg flex-1">{{ 'mcp.consent.cancel'|trans({}) }}</button>
            <button type="submit" name="action" value="approve" class="si-btn si-btn--primary si-btn--lg flex-1">{{ 'mcp.consent.authorize'|trans({}) }}</button>
        </div>
    </form>

    <p class="mt-4 text-center text-sm text-fg-muted">
        {{ 'mcp.consent.revoke_hint'|trans({}) }}
        <a href="{{ path('mcp_connected_apps_list') }}" class="text-primary hover:underline">{{ 'mcp.consent.revoke_hint_link'|trans({}) }}</a>.
    </p>
{% endblock %}
