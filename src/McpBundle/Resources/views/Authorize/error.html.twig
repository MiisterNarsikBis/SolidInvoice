{% extends '@SolidInvoiceCore/Layout/auth.html.twig' %}

{% block page_title %}{{ app_name }} - {{ 'mcp.error.title'|trans({}) }}{% endblock %}

{% block contents %}
    <div class="text-center">
        {{ ux_icon('tabler:alert-circle', {class: 'mx-auto size-12 text-danger', 'aria-hidden': 'true'}) }}
        <h1 class="mt-3 mb-3 text-xl font-semibold text-fg">{{ 'mcp.error.title'|trans({}) }}</h1>
        <p class="mb-2 font-semibold text-fg-secondary">{{ error }}</p>
        <p class="text-fg-muted">{{ error_description }}</p>
    </div>
{% endblock %}
