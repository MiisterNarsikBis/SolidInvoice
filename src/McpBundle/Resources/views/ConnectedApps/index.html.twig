{% extends '@SolidInvoiceUser/Layout/profile.html.twig' %}

{% set menuItem = 'connected-apps' %}

{% block title %}{{ 'mcp.connected_apps.title'|trans({}) }}{% endblock %}

{% block profile_content %}
    {% if connected_apps is empty %}
        <twig:Si:Card>
            <twig:Si:EmptyState icon="tabler:plug-connected" title="{{ 'mcp.connected_apps.empty'|trans({}) }}" />
        </twig:Si:Card>
    {% else %}
        <div class="grid gap-4 md:grid-cols-2">
            {% for app in connected_apps %}
                <twig:Si:Card class="flex items-start justify-between gap-3 p-5">
                    <div class="min-w-0">
                        <h3 class="truncate font-semibold text-fg">{{ app.client.name }}</h3>

                        <div class="mt-2 flex flex-wrap items-center gap-1.5 text-sm text-fg-muted">
                            {{ 'mcp.connected_apps.scopes'|trans({}) }}:
                            {% for scope in app.scopes %}
                                <twig:Si:Badge tone="info">{{ scope }}</twig:Si:Badge>
                            {% endfor %}
                        </div>

                        <div class="mt-2 text-sm text-fg-muted">{{ app.company.name }}</div>

                        <div class="mt-1 text-sm text-fg-muted">
                            {% if app.last_used %}
                                {{ 'mcp.connected_apps.last_used'|trans({}) }}: {{ app.last_used|date('Y-m-d H:i') }}
                            {% else %}
                                {{ 'mcp.connected_apps.never_used'|trans({}) }}
                            {% endif %}
                        </div>
                    </div>

                    <form method="post" action="{{ path('mcp_connected_apps_revoke', {'id': app.client.id}) }}" class="shrink-0">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('mcp_connected_apps_revoke') }}">
                        <button type="submit" class="si-btn si-btn--sm si-btn--danger-ghost">
                            {{ ux_icon('tabler:x', {class: 'size-4', 'aria-hidden': 'true'}) }}
                            {{ 'mcp.connected_apps.revoke'|trans({}) }}
                        </button>
                    </form>
                </twig:Si:Card>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
