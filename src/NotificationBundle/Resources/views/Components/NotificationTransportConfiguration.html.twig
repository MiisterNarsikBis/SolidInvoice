{# The configuration form shown inside the marketplace dialog. #}
{% form_theme form '@SolidInvoiceCore/Form/tailwind.html.twig' %}

<div {{ attributes }}>
    <div class="mb-4 flex items-start justify-between gap-3">
        <div>
            <h3 class="flex items-center gap-2 text-lg font-semibold text-fg">
                {{ ux_icon('tabler:bell-ringing', {class: 'size-5 text-primary', 'aria-hidden': 'true'}) }}
                {% if not isNewSetting %}
                    {{ transportSetting.name }}
                {% else %}
                    {{ 'notification.integration.add'|trans({'%type%': notificationType}) }}
                {% endif %}
            </h3>
            <p class="mt-0.5 text-sm text-fg-muted">{{ 'notification.integration.configure_credentials'|trans }}</p>
        </div>
    </div>

    {{ form_start(form, {
        attr: {
            'data-action': 'live#action:prevent',
            'data-live-action-param': 'save'
        }
    }) }}
        <div class="mb-4">
            {{ form_widget(form) }}
        </div>
    {{ form_end(form) }}

    <div class="flex items-center justify-between gap-3 border-t border-line-light pt-4">
        {% if not isNewSetting %}
            <button
                type="button"
                class="si-btn si-btn--md si-btn--danger-ghost"
                data-action="live#action"
                data-live-action-param="showDeleteConfirmation"
                aria-label="{{ 'notification.integration.delete'|trans }}"
            >
                {{ ux_icon('tabler:trash', {class: 'size-4', 'aria-hidden': 'true'}) }}
                {{ 'action.delete'|trans }}
            </button>
        {% else %}
            <a href="{{ path('_notification_integration') }}" class="si-btn si-btn--md si-btn--ghost">
                {{ ux_icon('tabler:x', {class: 'size-4', 'aria-hidden': 'true'}) }}
                {{ 'action.cancel'|trans }}
            </a>
        {% endif %}
        <button
            type="submit"
            class="si-btn si-btn--md si-btn--primary"
            data-action="live#action"
            data-live-action-param="save"
            data-loading="addAttribute(disabled)"
            aria-label="{{ 'notification.integration.save'|trans }}"
        >
            {{ ux_icon('tabler:device-floppy', {class: 'size-4', 'aria-hidden': 'true'}) }}
            {{ 'notification.integration.save_button'|trans }}
        </button>
    </div>

    {# Delete confirmation, stacked above the configuration dialog while `showDeleteConfirmation` is set #}
    {% if showDeleteConfirmation %}
        <div class="fixed inset-0 z-[60] bg-ink-900/55" role="presentation" aria-hidden="true" data-action="click->live#action" data-live-action-param="cancelDelete"></div>
        <div class="pointer-events-none fixed inset-0 z-[60] flex items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="delete-modal-title">
            <div class="pointer-events-auto w-full max-w-md overflow-hidden rounded-xl bg-surface shadow-lg">
                <div class="h-1 bg-danger" aria-hidden="true"></div>
                <div class="flex items-start gap-3 px-5 pt-5">
                    <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-danger-light text-danger-dark">
                        {{ ux_icon('tabler:alert-triangle', {class: 'size-5', 'aria-hidden': 'true'}) }}
                    </span>
                    <div>
                        <h4 id="delete-modal-title" class="text-lg font-semibold text-fg">{{ 'notification.integration.delete_title'|trans }}</h4>
                        <p class="text-sm text-fg-muted">{{ 'notification.integration.delete_undone'|trans }}</p>
                    </div>
                </div>
                <p class="px-5 py-4 text-fg-secondary">
                    {{ 'notification.integration.delete_confirm'|trans }} <strong class="text-fg">{{ transportSetting.name }}</strong>?
                    {{ 'notification.integration.delete_warning'|trans }}
                </p>
                <div class="flex justify-end gap-2 border-t border-line-light px-5 py-3">
                    <button type="button" class="si-btn si-btn--md si-btn--ghost" data-action="live#action" data-live-action-param="cancelDelete">{{ 'action.cancel'|trans }}</button>
                    <button type="button" class="si-btn si-btn--md si-btn--danger" data-action="live#action" data-live-action-param="confirmDelete" data-loading="addAttribute(disabled)">
                        {{ ux_icon('tabler:trash', {class: 'size-4', 'aria-hidden': 'true'}) }}
                        {{ 'notification.integration.delete_title'|trans }}
                    </button>
                </div>
            </div>
        </div>
    {% endif %}
</div>
