<div class="py-3">
    {% if client.quotes|length > 0 %}
        <twig:DataGrid name="quote_grid" context="{{ {'client_id': client.id} }}" />
    {% else %}
        <twig:Si:EmptyState icon="tabler:file-text" title="{{ 'client.quotes.empty.title'|trans }}" description="{{ 'client.quotes.empty.description'|trans }}">
            <twig:Si:Button href="{{ path('_quotes_create', {'client': client.id}) }}">
                {{ ux_icon('tabler:plus', {class: 'size-4', 'aria-hidden': 'true'}) }}
                {{ 'client.view.actions.create_quote'|trans }}
            </twig:Si:Button>
        </twig:Si:EmptyState>
    {% endif %}
</div>
