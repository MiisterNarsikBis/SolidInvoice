{% form_theme form '@SolidInvoiceCore/Form/tailwind.html.twig' %}

{# Inside a component slot `this` and `computed` are the slot's component, so capture them here. #}
{% set address = computed.address %}
{% set editing = this.edit %}

<div {{ attributes }}>
    <twig:Si:Card class="h-full">
        <twig:block name="header">
            <div class="flex items-center justify-between gap-2 border-b border-line-light px-4 py-3">
                <span class="flex items-center gap-2">
                    <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-primary-light text-primary-dark">
                        {{ ux_icon('tabler:map-pin', {class: 'size-4', 'aria-hidden': 'true'}) }}
                    </span>
                    <span class="font-medium text-fg">{{ 'client.address.label'|trans }}</span>
                </span>
                <div class="flex shrink-0 gap-1">
                    <button type="button" class="si-btn si-btn--ghost si-btn--sm" title="{{ 'client.address.edit'|trans }}" aria-label="{{ 'client.address.edit'|trans }}" data-model="edit" data-value="true" data-action="live#update:prevent">
                        {{ ux_icon('tabler:pencil', {class: 'size-4', 'aria-hidden': 'true'}) }}
                    </button>
                    <button type="button" class="si-btn si-btn--danger-ghost si-btn--sm" title="{{ 'client.address.delete'|trans }}" aria-label="{{ 'client.address.delete'|trans }}" data-si-modal-open="#delete-address-{{ address.id }}">
                        {{ ux_icon('tabler:trash', {class: 'size-4', 'aria-hidden': 'true'}) }}
                    </button>
                </div>
            </div>
        </twig:block>

        <div class="p-4">
            {% if editing %}
                {{ form_start(form, {attr: {
                    'data-action': 'live#action:prevent',
                    'data-live-action-param': 'save'
                }}) }}

                {{ form_row(form) }}

                <div class="flex justify-end gap-2">
                    <twig:Si:Button type="button" variant="ghost" data-model="edit" data-value="false" data-action="live#update:prevent">{{ 'action.cancel'|trans }}</twig:Si:Button>
                    <twig:Si:Button type="submit">
                        {{ ux_icon('tabler:device-floppy', {class: 'size-4', 'aria-hidden': 'true'}) }}
                        {{ 'action.save'|trans }}
                    </twig:Si:Button>
                </div>
                {{ form_end(form) }}
            {% else %}
                <div class="whitespace-pre-line text-fg-secondary">{{ address }}</div>
                <a href="https://maps.google.com/?q={{ address.street1 }}+{{ address.street2 }}+{{ address.city }}+{{ address.state }}+{{ address.zip }}+{{ address.country }}" target="_blank" rel="external noreferrer noopener" class="si-btn si-btn--ghost si-btn--sm mt-3">
                    {{ ux_icon('tabler:map', {class: 'size-3.5', 'aria-hidden': 'true'}) }}
                    {{ 'client.address.view_map'|trans }}
                </a>
            {% endif %}
        </div>
    </twig:Si:Card>

    <twig:Si:Modal id="delete-address-{{ address.id }}" title="{{ 'action.confirm'|trans }}" status="danger" size="sm">
        <div class="py-3 text-center">
            {{ ux_icon('tabler:map-pin-off', {class: 'mx-auto mb-3 size-12 text-danger', 'aria-hidden': 'true'}) }}
            <p class="text-fg-secondary">{{ 'client.address.delete_confirm_inline'|trans }}</p>
        </div>

        <twig:block name="footer">
            <twig:Si:Button type="button" variant="ghost" data-si-modal-close>{{ 'action.cancel'|trans }}</twig:Si:Button>
            <twig:Si:Button type="button" variant="danger" data-action="live#action:prevent" data-live-action-param="delete">
                {{ ux_icon('tabler:trash', {class: 'size-4', 'aria-hidden': 'true'}) }}
                {{ 'action.confirm'|trans }}
            </twig:Si:Button>
        </twig:block>
    </twig:Si:Modal>
</div>
