{% form_theme form '@SolidInvoiceCore/Form/tailwind.html.twig' %}

<div {{ attributes }} class="mb-6">
    <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
        <h3 class="flex items-center gap-2 text-lg font-semibold text-fg">
            {{ ux_icon('tabler:map-pin', {class: 'size-5 text-primary', 'aria-hidden': 'true'}) }}
            {{ 'client.heading.addresses'|trans }}
            <twig:Si:Badge>{{ client.addresses|length }}</twig:Si:Badge>
        </h3>
        <twig:Si:Button type="button" size="sm" data-si-modal-open="#add-address">
            {{ ux_icon('tabler:plus', {class: 'size-4', 'aria-hidden': 'true'}) }}
            {{ 'client.address.add'|trans }}
        </twig:Si:Button>
    </div>

    <div class="grid gap-4 md:grid-cols-2">
        {% for entry in client.addresses %}
            <twig:AddressInfo :address="entry" :key="entry.id" />
        {% else %}
            <div class="md:col-span-2">
                <twig:Si:EmptyState icon="tabler:map-pin-off" title="{{ 'client.addresses.empty.title'|trans }}" description="{{ 'client.addresses.empty.description'|trans }}">
                    <twig:Si:Button type="button" data-si-modal-open="#add-address">
                        {{ ux_icon('tabler:plus', {class: 'size-4', 'aria-hidden': 'true'}) }}
                        {{ 'client.address.add'|trans }}
                    </twig:Si:Button>
                </twig:Si:EmptyState>
            </div>
        {% endfor %}
    </div>

    {# The add dialog #}
    {{ form_start(form, {
        attr: {
            'data-action': 'live#action:prevent',
            'data-live-action-param': 'save'
        }
    }) }}
    <twig:Si:Modal id="add-address" title="{{ 'client.address.add'|trans }}">
        {{ form_row(form) }}

        <twig:block name="footer">
            <twig:Si:Button type="button" variant="ghost" data-si-modal-close>{{ 'action.cancel'|trans }}</twig:Si:Button>
            <twig:Si:Button type="submit">
                {{ ux_icon('tabler:device-floppy', {class: 'size-4', 'aria-hidden': 'true'}) }}
                {{ 'action.save'|trans }}
            </twig:Si:Button>
        </twig:block>
    </twig:Si:Modal>
    {{ form_end(form) }}
</div>
