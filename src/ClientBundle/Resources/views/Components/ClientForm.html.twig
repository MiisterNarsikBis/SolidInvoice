{# The add / edit client form (a Live Component). The page heading belongs to the page. #}
{% form_theme form '@SolidInvoiceCore/Form/tailwind.html.twig' %}

<div {{ attributes }}>
    {{ form_start(form, {
        attr: {
            'data-action': 'live#action:prevent',
            'data-live-action-param': 'save',
            'class': 'client-form max-w-3xl space-y-5'
        }
    }) }}

    {{ form_errors(form) }}

    {% if client is empty %}
        <p class="-mt-2 text-fg-muted">{{ 'client.form.subtitle'|trans }}</p>
    {% endif %}

    {# Business details #}
    <twig:Si:FormSection id="client-info" title="{{ 'client.info'|trans }}" description="{{ 'client.form.info_description'|trans }}" icon="tabler:building">
        <div class="grid gap-x-4 sm:grid-cols-2">
            <div class="sm:col-span-2">
                {{ form_row(form.name, {attr: {placeholder: 'client.form.name.placeholder'|trans}}) }}
            </div>

            <div>
                {{ form_row(form.website, {attr: {placeholder: 'https://example.com'}}) }}
            </div>

            <div>
                {{ form_row(form.currencyCode) }}
                {%- if form.currencyCode.vars.feature_gated_active ?? false %}
                    <p class="feature-gated-hint -mt-2 mb-4 text-sm text-fg-muted">
                        {%- if form.currencyCode.vars.feature_gated_plan ?? null %}
                            {{ 'client.form.feature_gated.with_plan'|trans({'%plan%': form.currencyCode.vars.feature_gated_plan}) }}
                        {%- else %}
                            {{ 'client.form.feature_gated.generic'|trans }}
                        {%- endif %}
                        <a href="{{ path('saas_subscription_plans') }}" class="ml-1 text-primary hover:underline">{{ 'client.form.feature_gated.upgrade'|trans }}</a>
                    </p>
                {%- endif %}
            </div>

            <div>
                {{ form_row(form.paymentTerms) }}
            </div>
        </div>
    </twig:Si:FormSection>

    {# Contacts #}
    <twig:Si:FormSection id="client-contacts-collection" title="{{ 'client.contact.info'|trans }}" description="{{ 'client.form.contact_description'|trans }}" icon="tabler:users">
        <div class="contacts-list">
            {% for contact in form.contacts %}
                {{ form_row(contact) }}
            {% else %}
                <p class="mb-4 text-fg-muted">{{ 'client.contact.empty_hint'|trans }}</p>
            {% endfor %}
        </div>

        {{ form_errors(form.contacts) }}

        {{ form_widget(form.contacts.vars.button_add, {
            label: 'client.contact.add'|trans,
            attr: {class: 'si-btn si-btn--outline si-btn--md'}
        }) }}
    </twig:Si:FormSection>

    {# Tax identifiers (optional) #}
    <twig:Si:FormSection id="client-tax-identifiers-collection" title="{{ 'client.tax_identifiers.info'|trans }}" description="{{ 'client.form.tax_identifiers_description'|trans }}" icon="tabler:receipt-tax">
        <div class="tax-identifiers-list">
            {% for taxIdentifier in form.taxIdentifiers %}
                {{ form_row(taxIdentifier) }}
            {% endfor %}
        </div>

        {{ form_errors(form.taxIdentifiers) }}

        {{ form_widget(form.taxIdentifiers.vars.button_add, {
            label: 'client.tax_identifiers.add'|trans,
            attr: {class: 'si-btn si-btn--outline si-btn--md'}
        }) }}
    </twig:Si:FormSection>

    {# Addresses (optional) #}
    <twig:Si:FormSection id="client-address-collection" title="{{ 'client.address.info'|trans }}" description="{{ 'client.form.address_description'|trans }}" icon="tabler:map-pin">
        <div class="addresses-list">
            {% for address in form.addresses %}
                {{ form_row(address) }}
            {% else %}
                <p class="mb-4 text-fg-muted">{{ 'client.address.empty_hint'|trans }}</p>
            {% endfor %}
        </div>

        {{ form_errors(form.addresses) }}

        {{ form_widget(form.addresses.vars.button_add, {
            label: 'client.address.add'|trans,
            attr: {class: 'si-btn si-btn--outline si-btn--md'}
        }) }}
    </twig:Si:FormSection>

    {# Custom fields (optional) #}
    {% if form.customFields is defined and form.customFields|length > 0 %}
        <twig:Si:FormSection id="client-custom-fields" title="{{ 'client.custom_fields'|trans }}" icon="tabler:forms">
            {{ form_widget(form.customFields) }}
        </twig:Si:FormSection>
    {% endif %}

    {{ form_rest(form) }}

    <twig:Si:FormActions>
        <twig:Si:Button type="button" variant="ghost" onclick="history.back()">
            {{ ux_icon('tabler:arrow-left', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
            {{ 'client.cancel'|trans }}
        </twig:Si:Button>
        <twig:Si:Button type="submit">
            {{ ux_icon('tabler:device-floppy', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
            {{ 'client.save'|trans }}
        </twig:Si:Button>
    </twig:Si:FormActions>

    {{ form_end(form) }}
</div>
