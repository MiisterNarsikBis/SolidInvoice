{% form_theme form '@SolidInvoiceCore/Form/tailwind.html.twig' %}

{# Inside a component slot `this` and `computed` are the slot's component, so capture them here. #}
{% set contact = computed.contact %}
{% set canDelete = this.canDelete %}
{% set editing = this.edit %}

<div {{ attributes }}>
    <twig:Si:Card class="h-full">
        <twig:block name="header">
            <div class="flex items-center justify-between gap-2 border-b border-line-light px-4 py-3">
                <div class="flex min-w-0 items-center gap-2">
                    <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-primary-light text-primary-dark">
                        {{ ux_icon('tabler:user', {class: 'size-4', 'aria-hidden': 'true'}) }}
                    </span>
                    <span class="truncate font-medium text-fg">{{ contact }}</span>
                </div>
                <div class="flex shrink-0 gap-1">
                    <button type="button" class="si-btn si-btn--ghost si-btn--sm" title="{{ 'contact_edit'|trans }}" aria-label="{{ 'contact_edit'|trans }}" data-model="edit" data-value="true" data-action="live#update:prevent">
                        {{ ux_icon('tabler:pencil', {class: 'size-4', 'aria-hidden': 'true'}) }}
                    </button>
                    {% if canDelete %}
                        <button type="button" class="si-btn si-btn--danger-ghost si-btn--sm" title="{{ 'contact_delete'|trans }}" aria-label="{{ 'contact_delete'|trans }}" data-si-modal-open="#delete-contact-{{ contact.id }}">
                            {{ ux_icon('tabler:trash', {class: 'size-4', 'aria-hidden': 'true'}) }}
                        </button>
                    {% endif %}
                </div>
            </div>
        </twig:block>

        <div class="p-4">
            {% if editing %}
                {{ form_start(form, {attr: {
                    'data-action': 'live#action:prevent',
                    'data-live-action-param': 'save'
                }}) }}

                {{ form_row(form) }}

                <div class="flex justify-end gap-2">
                    <twig:Si:Button type="button" variant="ghost" data-model="edit" data-value="false" data-action="live#update:prevent">{{ 'action.cancel'|trans }}</twig:Si:Button>
                    <twig:Si:Button type="submit">
                        {{ ux_icon('tabler:device-floppy', {class: 'size-4', 'aria-hidden': 'true'}) }}
                        {{ 'action.save'|trans }}
                    </twig:Si:Button>
                </div>
                {{ form_end(form) }}
            {% else %}
                <div class="flex items-start gap-3">
                    <span class="mt-0.5 text-fg-muted">{{ ux_icon('tabler:mail', {class: 'size-4', 'aria-hidden': 'true'}) }}</span>
                    <div class="min-w-0">
                        <div class="text-xs font-semibold tracking-wide text-fg-muted uppercase">{{ 'client.contact.details.email'|trans }}</div>
                        <a href="mailto:{{ contact.email }}" class="break-all text-primary hover:underline">{{ contact.email }}</a>
                    </div>
                </div>

                <twig:CustomFieldsList :target="enum('SolidInvoice\\CoreBundle\\Enum\\CustomFieldTarget').CONTACT" :recordId="contact.id" />
            {% endif %}
        </div>
    </twig:Si:Card>

    {% if canDelete %}
        <twig:Si:Modal id="delete-contact-{{ contact.id }}" title="{{ 'action.confirm'|trans }}" status="danger" size="sm">
            <div class="py-3 text-center">
                {{ ux_icon('tabler:user-minus', {class: 'mx-auto mb-3 size-12 text-danger', 'aria-hidden': 'true'}) }}
                <p class="text-fg-secondary">{{ 'client.contact.delete_confirm_inline'|trans }}</p>
            </div>

            <twig:block name="footer">
                <twig:Si:Button type="button" variant="ghost" data-si-modal-close>{{ 'action.cancel'|trans }}</twig:Si:Button>
                <twig:Si:Button type="button" variant="danger" data-action="live#action:prevent" data-live-action-param="delete">
                    {{ ux_icon('tabler:trash', {class: 'size-4', 'aria-hidden': 'true'}) }}
                    {{ 'action.confirm'|trans }}
                </twig:Si:Button>
            </twig:block>
        </twig:Si:Modal>
    {% endif %}
</div>
