{% extends "@SolidInvoiceCore/Layout/shell.html.twig" %}

{% block page_title %}{{ 'clients'|trans }}{% endblock page_title %}

{% block page_title_actions %}
    <twig:Si:Button href="{{ path('_clients_add') }}">
        {{ ux_icon('tabler:user-plus', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
        {{ 'client_create'|trans }}
    </twig:Si:Button>
{% endblock %}

{% block content %}
    {{ feature_usage_banner('total_clients', totalClients) }}

    {# Stats #}
    <div class="mb-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {% for stat in [
            {value: totalActiveClients, label: 'client.stats.active_clients', icon: 'tabler:users', tint: 'bg-primary-light text-primary-dark'},
            {value: totalArchivedClients, label: 'client.stats.archived_clients', icon: 'tabler:archive', tint: 'bg-ink-100 text-fg-secondary'},
            {value: totalContacts, label: 'client.stats.total_contacts', icon: 'tabler:address-book', tint: 'bg-info-light text-info-dark'},
            {outstanding: totalOutstanding, label: 'client.stats.outstanding_balance', icon: 'tabler:currency-dollar', tint: 'bg-warning-light text-warning-dark'},
        ] %}
            <div class="flex items-center gap-3.5 rounded-lg border border-line-light bg-surface p-4 shadow-sm">
                <span class="flex size-10 shrink-0 items-center justify-center rounded-md {{ stat.tint }}">
                    {{ ux_icon(stat.icon, {class: 'size-5', 'aria-hidden': 'true'}) }}
                </span>
                <div class="min-w-0">
                    <div class="tabular text-xl font-semibold leading-tight text-fg">
                        {% if stat.outstanding is defined %}
                            {% for currency, amount in stat.outstanding %}
                                <div>{{ amount|formatCurrency(currency) }}</div>
                            {% else %}
                                {{ 0|formatCurrency }}
                            {% endfor %}
                        {% else %}
                            {{ stat.value }}
                        {% endif %}
                    </div>
                    <div class="text-sm text-fg-secondary">{{ stat.label|trans }}</div>
                </div>
            </div>
        {% endfor %}
    </div>

    {# Client list #}
    <twig:Si:Card>
        <twig:block name="header">
            <nav class="flex flex-wrap border-b border-line px-2" role="tablist">
                <twig:Si:Tab href="{{ path('_clients_index') }}" :active="not isArchived" icon="tabler:users" :count="totalActiveClients">{{ 'client.tabs.active'|trans }}</twig:Si:Tab>
                <twig:Si:Tab href="{{ path('_clients_index', {archived: 1}) }}" :active="isArchived" icon="tabler:archive" :count="totalArchivedClients">{{ 'client.tabs.archived'|trans }}</twig:Si:Tab>
            </nav>
        </twig:block>

        {% if isArchived %}
            <twig:DataGrid name="archived_client_grid" />
        {% else %}
            <twig:DataGrid name="client_grid" />
        {% endif %}
    </twig:Si:Card>
{% endblock %}
