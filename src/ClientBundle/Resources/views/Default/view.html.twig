{% set currency = client.currency %}

{% extends "@SolidInvoiceCore/Layout/shell.html.twig" %}

{% block page_title %}{{ client.name }}{% endblock page_title %}

{% block page_title_actions %}
    <twig:Si:Button variant="outline" href="{{ path('_quotes_create', {'client': client.id}) }}">
        {{ ux_icon('tabler:file-text', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
        {{ 'client.view.actions.create_quote'|trans }}
    </twig:Si:Button>
    <twig:Si:Button href="{{ path('_invoices_create', {'client': client.id}) }}">
        {{ ux_icon('tabler:file-invoice', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
        {{ 'client.view.actions.create_invoice'|trans }}
    </twig:Si:Button>
    <twig:Si:Dropdown label="{{ 'client.view.more_actions'|trans }}" triggerClass="si-btn si-btn--outline si-btn--md">
        <twig:block name="trigger">{{ ux_icon('tabler:dots-vertical', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}</twig:block>
        <twig:Si:MenuItem href="{{ path('_clients_edit', {'id': client.id}) }}" icon="tabler:pencil">{{ 'client.view.actions.edit'|trans }}</twig:Si:MenuItem>
        <div class="my-1 h-px bg-line-light" role="separator"></div>
        <a class="flex items-center gap-2 rounded-md px-2.5 py-1.5 text-base text-danger-dark transition-colors hover:bg-danger-light" href="#" role="menuitem" data-si-modal-open="#delete-client-modal">
            {{ ux_icon('tabler:trash', {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
            {{ 'client.view.actions.delete'|trans }}
        </a>
    </twig:Si:Dropdown>
{% endblock page_title_actions %}

{% block content %}
    {# Status and the key facts of the client #}
    <div class="-mt-2 mb-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-fg-secondary">
        {{ client_label(client.status) }}
        {% if client.website %}
            {% set website_url = client.website starts with 'http://' or client.website starts with 'https://' ? client.website : 'https://' ~ client.website %}
            <a href="{{ website_url }}" class="inline-flex items-center gap-1.5 hover:text-primary hover:underline" rel="external noreferrer noopener" target="_blank">
                {{ ux_icon('tabler:world', {class: 'size-4', 'aria-hidden': 'true'}) }}
                <span>{{ client.website }}</span>
                {{ ux_icon('tabler:external-link', {class: 'size-3.5', 'aria-hidden': 'true'}) }}
            </a>
        {% endif %}
        {% if client.currencyCode %}
            <span class="inline-flex items-center gap-1.5">
                {{ ux_icon('tabler:currency-dollar', {class: 'size-4', 'aria-hidden': 'true'}) }}
                <span>{{ client.currencyCode }}</span>
            </span>
        {% endif %}
        {% for identifier in tax_identifiers(client) %}
            <span class="inline-flex items-center gap-1.5">
                {{ ux_icon('tabler:receipt-tax', {class: 'size-4', 'aria-hidden': 'true'}) }}
                <span>{{ identifier.label }}: {{ identifier.value }}</span>
            </span>
        {% endfor %}
    </div>

    {# Metrics #}
    <div class="mb-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-lg border border-line-light bg-surface p-4 shadow-sm">
            <div class="text-sm text-fg-secondary">{{ 'client.stats.income'|trans }}</div>
            <div class="tabular mt-1 text-2xl font-semibold text-success-dark">{{ total_income(client)|formatCurrency(client.currency) }}</div>
        </div>

        <div class="rounded-lg border border-line-light bg-surface p-4 shadow-sm">
            <div class="text-sm text-fg-secondary">{{ 'client.stats.outstanding'|trans }}</div>
            <div class="tabular mt-1 text-2xl font-semibold text-warning-dark">{{ total_outstanding(client)|formatCurrency(client.currency) }}</div>
        </div>

        <div class="rounded-lg border border-line-light bg-surface p-4 shadow-sm">
            <div class="text-sm text-fg-secondary">{{ 'client.stats.invoices'|trans }}</div>
            <div class="tabular mt-1 text-2xl font-semibold text-fg">{{ client.invoices|length }}</div>
            <div class="mt-2 flex flex-wrap gap-2">
                <twig:Si:Badge tone="success" title="{{ 'client.stats.tooltip.total_paid'|trans }}">{{ total_invoices_paid }} {{ 'paid'|trans }}</twig:Si:Badge>
                <twig:Si:Badge tone="warning" title="{{ 'client.stats.tooltip.total_outstanding'|trans }}">{{ total_invoices_pending }} {{ 'pending'|trans }}</twig:Si:Badge>
            </div>
        </div>

        <div class="rounded-lg border border-line-light bg-surface p-4 shadow-sm">
            <div class="text-sm text-fg-secondary">{{ 'client.stats.quotes'|trans }}</div>
            <div class="tabular mt-1 text-2xl font-semibold text-fg">{{ client.quotes|length }}</div>
        </div>
    </div>

    {# Credit #}
    <div class="mb-5 flex items-center gap-4 rounded-lg border border-line-light bg-surface p-4 shadow-sm">
        <span class="flex size-12 shrink-0 items-center justify-center rounded-lg bg-info-light text-info-dark">
            {{ ux_icon('tabler:wallet', {class: 'size-6', 'aria-hidden': 'true'}) }}
        </span>
        <div class="min-w-0 flex-1">
            <div class="text-sm text-fg-secondary">{{ 'client.stats.credit'|trans }}</div>
            <twig:ClientCredit :client="client" />
        </div>
    </div>

    {# Tabs #}
    <twig:Si:Card>
        <twig:Si:Tabs tabsClass="px-2">
            <twig:block name="tabs">
                <twig:Si:Tab target="client-info" :active="true" icon="tabler:info-circle">{{ 'client.view.tabs.info'|trans }}</twig:Si:Tab>
                <twig:Si:Tab target="quotes" icon="tabler:file-text" :count="client.quotes|length">{{ 'client.view.tabs.quotes'|trans }}</twig:Si:Tab>
                <twig:Si:Tab target="invoices" icon="tabler:file-invoice" :count="client.invoices|length">{{ 'client.view.tabs.invoices'|trans }}</twig:Si:Tab>
                {% if payments|length > 0 %}
                    <twig:Si:Tab target="payments" icon="tabler:credit-card" :count="payments|length">{{ 'client.view.tabs.payments'|trans }}</twig:Si:Tab>
                {% endif %}
            </twig:block>

            <div class="p-5">
                <twig:Si:TabPanel id="client-info" :active="true">
                    <twig:CustomFieldsList :target="enum('SolidInvoice\\CoreBundle\\Enum\\CustomFieldTarget').CLIENT" :recordId="client.id" />
                    <twig:ContactCollection :client="client" count="{{ client.contacts|length }}" />
                    <twig:AddressCollection :client="client" count="{{ client.addresses|length }}" />
                </twig:Si:TabPanel>

                <twig:Si:TabPanel id="quotes">
                    {% include "@SolidInvoiceClient/quote_list.html.twig" %}
                </twig:Si:TabPanel>

                <twig:Si:TabPanel id="invoices">
                    {% include "@SolidInvoiceClient/invoice_list.html.twig" %}
                </twig:Si:TabPanel>

                {% if payments|length > 0 %}
                    <twig:Si:TabPanel id="payments">
                        {% include "@SolidInvoicePayment/Payment/list.html.twig" with {"data": {'client': client.id}} only %}
                    </twig:Si:TabPanel>
                {% endif %}
            </div>
        </twig:Si:Tabs>
    </twig:Si:Card>

    {# Delete client #}
    <twig:Si:Modal id="delete-client-modal" title="{{ 'action.confirm'|trans }}" status="danger" size="sm">
        <div class="py-3 text-center">
            {{ ux_icon('tabler:alert-triangle', {class: 'mx-auto mb-3 size-12 text-danger', 'aria-hidden': 'true'}) }}
            <h3 class="mb-1 text-lg font-semibold text-fg">{{ 'client.delete.confirm.title'|trans({'%name%': client.name}) }}</h3>
            <p class="text-fg-muted">{{ 'client.delete.confirm.message'|trans }}</p>
        </div>

        <twig:block name="footer">
            <twig:Si:Button type="button" variant="ghost" data-si-modal-close>{{ 'action.cancel'|trans }}</twig:Si:Button>
            <form method="post" action="{{ path('_clients_delete', {'id': client.id}) }}" class="inline">
                <input type="hidden" name="_method" value="DELETE">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ client.id) }}">
                <twig:Si:Button type="submit" variant="danger">
                    {{ ux_icon('tabler:trash', {class: 'size-4', 'aria-hidden': 'true'}) }}
                    {{ 'client.view.actions.delete'|trans }}
                </twig:Si:Button>
            </form>
        </twig:block>
    </twig:Si:Modal>
{% endblock content %}
