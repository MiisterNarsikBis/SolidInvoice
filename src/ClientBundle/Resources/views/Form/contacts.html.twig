{{ form_errors(form) }}

<div class="mb-4 rounded-lg border border-line bg-surface">
    <div class="flex items-center gap-3 border-b border-line-light px-4 py-3">
        <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-primary-light text-primary-dark">
            {{ ux_icon('tabler:user', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
        </span>
        <span class="font-medium text-fg">{{ 'client.contact.label'|trans }}</span>
    </div>

    <div class="p-4">
        <div class="grid grid-cols-1 gap-x-4 sm:grid-cols-2">
            <div>{{ form_row(form.firstName, {attr: {placeholder: 'client.contact.firstName.placeholder'|trans}}) }}</div>
            <div>{{ form_row(form.lastName, {attr: {placeholder: 'client.contact.lastName.placeholder'|trans}}) }}</div>
            <div class="sm:col-span-2">{{ form_row(form.email, {attr: {placeholder: 'john.doe@example.com'}}) }}</div>
        </div>

        {% if form.customFields is defined and form.customFields|length > 0 %}
            <div class="mt-2">
                <strong class="mb-1 block text-fg">{{ 'client.custom_fields'|trans }}</strong>
                {{ form_widget(form.customFields) }}
            </div>
        {% endif %}
    </div>
</div>
