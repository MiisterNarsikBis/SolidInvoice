{# @var paginator \Pagerfanta\Pagerfanta #}
{# @var grid \SolidInvoice\DataGridBundle\GridInterface #}

{#
 # The data grid (a Live Component): search, filters, sortable columns, bulk actions, pagination.
 #
 # Menus use `si-dropdown` and the confirmation modals use <twig:Si:Modal>.
 #
 # Cells are produced by PHP formatters that emit semantic classes (`datagrid-status`,
 # `col-money`...); they are styled by selector in assets/tailwind/app.css.
 #}
{% form_theme form '@SolidInvoiceCore/Form/tailwind.html.twig' '@SolidInvoiceDataGrid/Form/fields.html.twig' %}

{# Inside a component slot `this` is that component, so the grid is captured once here. #}
{% set gridComponent = this %}
{% set colCount = gridComponent.getVisibleColumns()|length + (grid.batchActions|length > 0 ? 1 : 0) + (grid.hasRowDetails() ? 1 : 0) + (grid.actions|length > 0 or grid.batchActions|length > 0 ? 1 : 0) %}
{% set iconBtn = 'inline-flex size-8 items-center justify-center rounded-md text-fg-muted transition-colors hover:bg-ink-100 hover:text-fg pointer-coarse:size-11' %}
{% set toolBtn = 'inline-flex h-8 items-center gap-1.5 rounded-md px-2.5 text-sm font-medium text-fg-secondary transition-colors hover:bg-ink-100 hover:text-fg pointer-coarse:h-11' %}

<div {{ attributes.defaults({class: 'si-datagrid'}) }}>
    {% for flashType, flashMessages in app.session.flashbag.all() %}
        {% for flashMessage in flashMessages %}
            <twig:Si:Alert type="{{ flashType == 'error' ? 'danger' : flashType }}" class="mb-3 print:hidden">{{ flashMessage|trans }}</twig:Si:Alert>
        {% endfor %}
    {% endfor %}

    <div class="rounded-lg border border-line-light bg-surface shadow-sm">
        {# ------------------------------------------------------------------ toolbar #}
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-line-light px-4 py-3">
            <div class="flex min-w-0 flex-1 flex-wrap items-center gap-2">
                <div class="relative w-full max-w-xs">
                    <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-fg-muted">
                        {{ ux_icon('tabler:search', {class: 'size-4', 'aria-hidden': 'true'}) }}
                    </span>
                    <input
                        type="search"
                        class="si-control pl-9"
                        placeholder="{{ 'datagrid.search.placeholder'|trans }}"
                        aria-label="{{ 'datagrid.search.label'|trans }}"
                        value="{{ search }}"
                        data-model="debounce(300)|search"
                    >
                </div>

                {# Active filter chips #}
                {% for key, value in gridFilters %}
                    {% set displayValue = value %}
                    {% if value is iterable %}
                        {% if value.start is defined or value.end is defined %}
                            {% set parts = [] %}
                            {% if value.start is defined and value.start %}
                                {% set parts = parts|merge(['From: ' ~ value.start]) %}
                            {% endif %}
                            {% if value.end is defined and value.end %}
                                {% set parts = parts|merge(['To: ' ~ value.end]) %}
                            {% endif %}
                            {% set displayValue = parts|join(' ') %}
                        {% else %}
                            {% set displayValue = value|join(', ') %}
                        {% endif %}
                    {% endif %}

                    <button
                        type="button"
                        class="inline-flex items-center gap-1.5 rounded-full bg-primary-light px-2.5 py-1 text-xs text-primary-dark transition-colors hover:bg-primary-light/70"
                        data-action="live#action:prevent"
                        data-live-action-param="removeFilter"
                        data-live-filter-key-param="{{ key }}"
                        title="{{ 'datagrid.filter.remove'|trans }}"
                    >
                        <span class="font-semibold">{{ key|replace({'_': ' '})|title }}</span>
                        <span>{{ displayValue }}</span>
                        {{ ux_icon('tabler:x', {class: 'size-3.5', 'aria-hidden': 'true'}) }}
                    </button>
                {% endfor %}
            </div>

            <div class="flex items-center gap-1">
                {# Advanced filters #}
                {% if grid.filters|length > 0 %}
                    <twig:Si:Dropdown
                        label="{{ 'datagrid.filters'|trans }}"
                        panelClass="w-80 p-0"
                        triggerClass="{{ toolBtn }} {{ gridFilters is not empty ? 'bg-primary-light text-primary-dark' : '' }}"
                    >
                        <twig:block name="trigger">
                            {{ ux_icon('tabler:filter', {class: 'size-4', 'aria-hidden': 'true'}) }}
                            <span class="hidden sm:inline">{{ 'datagrid.filters'|trans }}</span>
                            {% if gridFilters is not empty %}
                                <span class="rounded-full bg-primary px-1.5 text-xs text-white">{{ gridFilters|length }}</span>
                            {% endif %}
                        </twig:block>

                        <div class="border-b border-line-light px-4 py-3">
                            <h3 class="flex items-center gap-2 text-base font-semibold text-fg">
                                {{ ux_icon('tabler:filter', {class: 'size-4 text-fg-muted', 'aria-hidden': 'true'}) }}
                                {{ 'datagrid.filters'|trans }}
                            </h3>
                        </div>

                        <div class="max-h-96 overflow-y-auto p-4">
                            {{ form_start(form, {attr: {class: 'space-y-4', 'data-model': 'norender'}}) }}
                            {% for child in form.children|filter(c => c.vars.name != '_token') %}
                                <div>
                                    <label class="si-label">{{ child.vars.name|replace({'_': ' '})|title }}</label>
                                    {% if child.vars.expanded is defined and child.vars.expanded %}
                                        <div class="space-y-2">
                                            {% for choice in child.children %}
                                                <div class="flex items-center gap-2">
                                                    {{ form_widget(choice, {attr: {class: 'si-check'}}) }}
                                                    <label class="text-base text-fg" for="{{ choice.vars.id }}">{{ choice.vars.label }}</label>
                                                </div>
                                            {% endfor %}
                                        </div>
                                    {% else %}
                                        {{ form_widget(child) }}
                                    {% endif %}
                                    {{ form_errors(child) }}
                                </div>
                            {% endfor %}

                            {{ form_rest(form) }}

                            <div class="flex gap-2 pt-2">
                                <button type="button" class="si-btn si-btn--md si-btn--ghost flex-1" data-action="live#action:prevent" data-live-action-param="clearFilters">
                                    {{ 'datagrid.clear'|trans }}
                                </button>
                                <button type="submit" class="si-btn si-btn--md si-btn--primary flex-1" data-action="live#action:prevent" data-live-action-param="applyFilters">
                                    {{ ux_icon('tabler:check', {class: 'size-4', 'aria-hidden': 'true'}) }}
                                    {{ 'datagrid.apply'|trans }}
                                </button>
                            </div>
                            {{ form_end(form) }}
                        </div>
                    </twig:Si:Dropdown>
                {% endif %}

                {# Export #}
                {% set exportQuery = {
                    grid: name,
                    sort: sort,
                    search: search,
                    gridFilters: gridFilters,
                    context: context|json_encode,
                } %}
                {% set exportFormats = [
                    {value: 'csv',  label: 'datagrid.export.format.csv.label',  icon: 'tabler:file-type-csv',  hint: 'datagrid.export.format.csv.hint'},
                    {value: 'json', label: 'datagrid.export.format.json.label', icon: 'tabler:braces',         hint: 'datagrid.export.format.json.hint'},
                    {value: 'xml',  label: 'datagrid.export.format.xml.label',  icon: 'tabler:file-type-xml',  hint: 'datagrid.export.format.xml.hint'},
                ] %}
                <twig:Si:Dropdown label="{{ 'datagrid.export.label'|trans }}" panelClass="w-72 p-0" triggerClass="{{ toolBtn }}">
                    <twig:block name="trigger">
                        {{ ux_icon('tabler:download', {class: 'size-4', 'aria-hidden': 'true'}) }}
                        <span class="hidden sm:inline">{{ 'datagrid.export.label'|trans }}</span>
                    </twig:block>

                    <div class="border-b border-line-light px-4 py-3">
                        <h3 class="flex items-center gap-2 text-base font-semibold text-fg">
                            {{ ux_icon('tabler:download', {class: 'size-4 text-fg-muted', 'aria-hidden': 'true'}) }}
                            {{ 'datagrid.export.label'|trans }}
                        </h3>
                        <p class="mt-0.5 text-sm text-fg-muted">{{ 'datagrid.export.subtitle'|trans }}</p>
                    </div>
                    <div class="p-1">
                        {% for format in exportFormats %}
                            <a
                                href="{{ path('_datagrid_export', exportQuery|merge({format: format.value})) }}"
                                class="flex items-center gap-3 rounded-md px-3 py-2 transition-colors hover:bg-surface-hover"
                                target="_blank"
                                rel="noopener"
                                role="menuitem"
                            >
                                <span class="flex size-9 shrink-0 items-center justify-center rounded-md bg-ink-100 text-fg-secondary">
                                    {{ ux_icon(format.icon, {class: 'size-5', 'aria-hidden': 'true'}) }}
                                </span>
                                <span class="flex flex-col">
                                    <span class="font-medium text-fg">{{ format.label|trans }}</span>
                                    <span class="text-sm text-fg-muted">{{ format.hint|trans }}</span>
                                </span>
                            </a>
                        {% endfor %}
                    </div>
                </twig:Si:Dropdown>

                {# Column picker #}
                {% block column_picker %}
                    {% if grid.columns|length > 3 %}
                        <twig:Si:Dropdown label="{{ 'datagrid.columns.label'|trans }}" panelClass="w-56" triggerClass="{{ iconBtn }}">
                            <twig:block name="trigger">
                                {{ ux_icon('tabler:columns-3', {class: 'size-4', 'aria-hidden': 'true'}) }}
                            </twig:block>

                            {% for column in grid.columns %}
                                <label class="flex cursor-pointer items-center gap-2.5 rounded-md px-2.5 py-1.5 text-base text-fg-secondary hover:bg-surface-hover">
                                    <input
                                        type="checkbox"
                                        class="si-check"
                                        {{ gridComponent.isColumnVisible(column.getField()) ? 'checked' : '' }}
                                        data-action="live#action:prevent"
                                        data-live-action-param="toggleColumn"
                                        data-live-field-param="{{ column.getField() }}"
                                    >
                                    {{ column.getLabel|trans }}
                                </label>
                            {% endfor %}
                            {% if hiddenColumns|length > 0 %}
                                <div class="my-1 h-px bg-line-light" role="separator"></div>
                                <a href="#" class="flex items-center gap-2 rounded-md px-2.5 py-1.5 text-base font-medium text-primary hover:bg-primary-lighter" data-action="live#action:prevent" data-live-action-param="resetColumns">
                                    {{ ux_icon('tabler:refresh', {class: 'size-4', 'aria-hidden': 'true'}) }}
                                    {{ 'datagrid.columns.reset'|trans }}
                                </a>
                            {% endif %}
                        </twig:Si:Dropdown>
                    {% endif %}
                {% endblock %}
            </div>
        </div>

        {# ------------------------------------------------------------------- table #}
        <div class="overflow-x-auto">
            <table class="w-full text-base" {{ stimulus_controller('checkbox-select-all') }}>
                <thead>
                    <tr class="bg-canvas text-left text-xs font-semibold uppercase tracking-wide text-fg-muted">
                        {% if grid.batchActions|length > 0 %}
                            <th class="w-10 px-4 py-2.5">
                                <input
                                    type="checkbox"
                                    class="si-check"
                                    {{ stimulus_target('checkbox-select-all', 'checkboxAll') }}
                                    data-model="selectedAll"
                                    aria-label="{{ 'datagrid.select_all'|trans }}"
                                />
                            </th>
                        {% endif %}

                        {% if grid.hasRowDetails() %}
                            <th class="w-10 px-2 py-2.5"><span class="sr-only">{{ 'datagrid.expand'|trans }}</span></th>
                        {% endif %}

                        {% for column in gridComponent.getVisibleColumns() %}
                            <th class="px-4 py-2.5{% if column.getCellClass() %} {{ column.getCellClass() }}{% endif %}">
                                {% if column.isSortable %}
                                    <a
                                        href="#"
                                        class="inline-flex items-center gap-1 transition-colors hover:text-fg {{ sortField is same as column.getSortableField ? 'text-fg' : '' }}"
                                        data-model="sort"
                                        data-value="{{ column.getSortableField }},{{ sortDir is same as('asc') ? 'desc' : 'asc'}}"
                                        data-action="live#update:prevent"
                                    >
                                        {{ column.getLabel|trans }}
                                        {% if sortField is same as column.getSortableField %}
                                            {{ ux_icon(sortDir is same as('asc') ? 'tabler:chevron-up' : 'tabler:chevron-down', {class: 'size-3.5', 'aria-hidden': 'true'}) }}
                                        {% else %}
                                            {{ ux_icon('tabler:selector', {class: 'size-3.5 text-ink-300', 'aria-hidden': 'true'}) }}
                                        {% endif %}
                                    </a>
                                {% else %}
                                    {{ column.getLabel|trans }}
                                {% endif %}
                            </th>
                        {% endfor %}

                        {% if grid.actions|length > 0 or grid.batchActions|length > 0 %}
                            <th class="w-24 px-4 py-2.5"><span class="sr-only">{{ 'datagrid.actions'|trans }}</span></th>
                        {% endif %}
                    </tr>
                </thead>
                <tbody class="divide-y divide-line-light">
                    {% if paginator.nbResults is same as(0) %}
                        <tr>
                            <td colspan="{{ colCount }}">
                                {% set is_filtered = search is not empty or gridFilters is not empty %}
                                {% include '@SolidInvoiceDataGrid/Components/_empty_state.html.twig' with {
                                    icon: 'tabler:database-off',
                                    title: is_filtered ? 'datagrid.no_results.label' : grid.getEmptyTitle(),
                                    message: is_filtered ? 'datagrid.no_results.filtered' : grid.getEmptyDescription(),
                                    action_route: is_filtered ? null : grid.getCreateRoute(),
                                    action_label: grid.getCreateLabel(),
                                } only %}
                            </td>
                        </tr>
                    {% else %}
                        {% for row in paginator %}
                            <tr class="transition-colors {{ gridComponent.entityId(row) in selectedItems ? 'bg-primary-lighter' : 'hover:bg-surface-hover' }}" {% if grid.hasRowDetails() %}{{ stimulus_controller('datagrid-row-expand') }}{% endif %}>
                                {% if grid.batchActions|length > 0 %}
                                    <td class="px-4 py-2.5">
                                        <input
                                            type="checkbox"
                                            class="si-check"
                                            {{ stimulus_target('checkbox-select-all', 'checkbox') }}
                                            value="{{ gridComponent.entityId(row) }}"
                                            data-model="selectedItems"
                                            {{ gridComponent.entityId(row) in selectedItems ? 'checked' : '' }}
                                            aria-label="{{ 'datagrid.select_row'|trans }}"
                                        />
                                    </td>
                                {% endif %}

                                {% if grid.hasRowDetails() %}
                                    <td class="px-2 py-2.5">
                                        <button type="button" class="{{ iconBtn }}" {{ stimulus_action('datagrid-row-expand', 'toggle') }} aria-label="{{ 'datagrid.expand_row'|trans }}">
                                            <span {{ stimulus_target('datagrid-row-expand', 'expandIcon') }}>
                                                {{ ux_icon('tabler:chevron-right', {class: 'size-4', 'aria-hidden': 'true'}) }}
                                            </span>
                                        </button>
                                    </td>
                                {% endif %}

                                {% for column in gridComponent.getVisibleColumns() %}
                                    <td class="px-4 py-2.5{% if column.getCellClass() %} {{ column.getCellClass() }}{% endif %}">{{ gridComponent.renderfield(column, row)|raw }}</td>
                                {% endfor %}

                                {% if grid.actions|length > 0 or grid.batchActions|length > 0 %}
                                    <td class="px-4 py-2.5">
                                        <div class="flex items-center justify-end gap-0.5">
                                            {# Primary actions as icon buttons #}
                                            {% for action in grid.actions %}
                                                {% if action.isPrimary() %}
                                                    {% set params = {} %}
                                                    {% for p, v in action.parameters %}
                                                        {% set params = params|merge({(p): attribute(row, v)}) %}
                                                    {% endfor %}
                                                    <a
                                                        href="{{ path(action.getRoute, params) }}"
                                                        class="{{ iconBtn }} action-{{ action.getLabel|lower|replace({' ': '-'}) }}"
                                                        title="{{ action.getLabel|trans }}"
                                                        aria-label="{{ action.getLabel|trans }}"
                                                    >
                                                        {{ ux_icon('tabler:' ~ action.getIcon, {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
                                                    </a>
                                                {% endif %}
                                            {% endfor %}

                                            {# Secondary actions and batch actions for a single row #}
                                            {% set menuActions = grid.actions|filter(a => not a.isPrimary()) %}
                                            {% if menuActions|length > 0 or grid.batchActions|length > 0 %}
                                                <twig:Si:Dropdown label="{{ 'datagrid.more_actions'|trans }}" :fixed="true" triggerClass="{{ iconBtn }}">
                                                    <twig:block name="trigger">
                                                        {{ ux_icon('tabler:dots-vertical', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
                                                    </twig:block>

                                                    {% for action in menuActions %}
                                                        {% set params = {} %}
                                                        {% for p, v in action.parameters %}
                                                            {% set params = params|merge({(p): attribute(row, v)}) %}
                                                        {% endfor %}
                                                        <a href="{{ path(action.getRoute, params) }}" role="menuitem" class="flex items-center gap-2 rounded-md px-2.5 py-1.5 text-base transition-colors hover:bg-surface-hover {{ action.getColor == 'danger' ? 'text-danger-dark' : 'text-fg-secondary hover:text-fg' }}">
                                                            {% if action.getIcon %}{{ ux_icon('tabler:' ~ action.getIcon, {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}{% endif %}
                                                            {{ action.getLabel|trans }}
                                                        </a>
                                                    {% endfor %}

                                                    {% if menuActions|length > 0 and grid.batchActions|length > 0 %}
                                                        <div class="my-1 h-px bg-line-light" role="separator"></div>
                                                    {% endif %}

                                                    {% for action in grid.batchActions %}
                                                        {% if action.shouldConfirm %}
                                                            {% set modalId = 'row_modal_' ~ action.getLabel|u.snake ~ '_' ~ loop.index ~ '_' ~ gridComponent.entityId(row) %}
                                                            <button type="button" role="menuitem" class="flex w-full items-center gap-2 rounded-md px-2.5 py-1.5 text-left text-base transition-colors hover:bg-surface-hover {{ action.getColor == 'danger' ? 'text-danger-dark' : 'text-fg-secondary hover:text-fg' }}" data-si-modal-open="#{{ modalId }}">
                                                                {% if action.getIcon %}{{ ux_icon('tabler:' ~ action.getIcon, {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}{% endif %}
                                                                {{ action.getLabel|trans }}
                                                            </button>
                                                        {% else %}
                                                            <button
                                                                type="button"
                                                                role="menuitem"
                                                                class="flex w-full items-center gap-2 rounded-md px-2.5 py-1.5 text-left text-base transition-colors hover:bg-surface-hover {{ action.getColor == 'danger' ? 'text-danger-dark' : 'text-fg-secondary hover:text-fg' }}"
                                                                data-action="live#action"
                                                                data-live-action-param="executeSingle"
                                                                data-live-action-name-param="{{ action.getLabel }}"
                                                                data-live-entity-id-param="{{ gridComponent.entityId(row) }}"
                                                            >
                                                                {% if action.getIcon %}{{ ux_icon('tabler:' ~ action.getIcon, {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}{% endif %}
                                                                {{ action.getLabel|trans }}
                                                            </button>
                                                        {% endif %}
                                                    {% endfor %}
                                                </twig:Si:Dropdown>
                                            {% endif %}
                                        </div>
                                    </td>
                                {% endif %}
                            </tr>

                            {# Expandable row detail #}
                            {% if grid.hasRowDetails() %}
                                <tr class="datagrid-detail-row hidden">
                                    <td colspan="{{ colCount }}" class="bg-canvas px-4 py-3">
                                        {% include grid.getRowDetailTemplate() with {token: gridComponent.entityId(row)} %}
                                    </td>
                                </tr>
                            {% endif %}
                        {% endfor %}
                    {% endif %}
                </tbody>
            </table>
        </div>

        {# ------------------------------------------------------------------ footer #}
        {% if paginator.nbResults > 0 %}
            <div class="flex flex-wrap items-center justify-between gap-3 border-t border-line-light px-4 py-3 text-sm text-fg-muted">
                <div>
                    {{ 'datagrid.footer.showing'|trans({
                        '%start%': paginator.currentPageOffsetStart,
                        '%end%': paginator.currentPageOffsetEnd,
                        '%total%': paginator.nbResults
                    }) }}
                </div>

                <label class="flex items-center gap-2">
                    <span>{{ 'datagrid.per_page'|trans }}</span>
                    <select class="si-control min-h-8 w-auto py-0.5 text-sm" data-model="perPage" aria-label="{{ 'datagrid.items_per_page'|trans }}">
                        <option value="10" {{ perPage == 10 ? 'selected' : '' }}>10</option>
                        <option value="25" {{ perPage == 25 ? 'selected' : '' }}>25</option>
                        <option value="50" {{ perPage == 50 ? 'selected' : '' }}>50</option>
                        <option value="{{ paginator.nbResults }}" {{ perPage == paginator.nbResults ? 'selected' : '' }}>{{ 'datagrid.all'|trans }}</option>
                    </select>
                </label>

                <div>
                    {{ pagerfanta(paginator, 'twig', {
                        'template': '@SolidInvoiceDataGrid/pagination.html.twig',
                        'prev_message': ux_icon('tabler:chevron-left', {class: 'size-4', 'aria-hidden': 'true'}),
                        'next_message': ux_icon('tabler:chevron-right', {class: 'size-4', 'aria-hidden': 'true'})
                    }) }}
                </div>
            </div>
        {% endif %}
    </div>

    {# ------------------------------------------------------ floating bulk-action bar #}
    {% if grid.batchActions|length > 0 %}
        <div class="pointer-events-none fixed inset-x-0 bottom-6 z-40 flex justify-center px-4 {{ selectedItems|length > 0 ? '' : 'hidden' }}" role="toolbar" aria-label="{{ 'datagrid.bulk_actions'|trans }}">
            <div class="pointer-events-auto flex flex-wrap items-center gap-3 rounded-xl bg-ink-900 px-4 py-2.5 text-white shadow-lg">
                <div class="text-base"><span class="font-semibold">{{ selectedItems|length }}</span> {{ 'datagrid.selected'|trans }}</div>
                <div class="h-5 w-px bg-white/20" aria-hidden="true"></div>

                <div class="flex flex-wrap items-center gap-1">
                    {% for action in grid.batchActions %}
                        {% set modalId = 'modal_' ~ action.getLabel|u.snake %}
                        {% set bulkBtn = 'inline-flex h-8 items-center gap-1.5 rounded-md px-2.5 text-sm font-medium transition-colors ' ~ (action.getColor == 'danger' ? 'bg-danger text-white hover:bg-danger-hover' : 'text-white hover:bg-white/10') %}

                        {% if action.shouldConfirm %}
                            <button type="button" class="{{ bulkBtn }}" data-si-modal-open="#{{ modalId }}">
                                {% if action.getIcon is not empty %}{{ ux_icon('tabler:' ~ action.getIcon, {class: 'size-4', 'aria-hidden': 'true'}) }}{% endif %}
                                {{ action.getLabel|trans }}
                            </button>
                        {% else %}
                            <button
                                type="button"
                                class="{{ bulkBtn }}"
                                data-action="live#action"
                                data-live-action-name-param="{{ action.getLabel }}"
                                data-live-action-param="debounce(300)|executeBatch"
                            >
                                {% if action.getIcon is not empty %}{{ ux_icon('tabler:' ~ action.getIcon, {class: 'size-4', 'aria-hidden': 'true'}) }}{% endif %}
                                {{ action.getLabel|trans }}
                            </button>
                        {% endif %}
                    {% endfor %}
                </div>

                <div class="h-5 w-px bg-white/20" aria-hidden="true"></div>

                <button type="button" class="inline-flex size-8 items-center justify-center rounded-md text-white/80 hover:bg-white/10 hover:text-white" data-action="live#action:prevent" data-live-action-param="clearSelection" aria-label="{{ 'datagrid.clear_selection'|trans }}">
                    {{ ux_icon('tabler:x', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
                </button>
            </div>
        </div>

        {# Confirmation modals for batch actions #}
        {% for action in grid.batchActions %}
            {% if action.shouldConfirm %}
                {% set modalId = 'modal_' ~ action.getLabel|u.snake %}
                <twig:Si:Modal id="{{ modalId }}" size="sm" title="{{ 'action.confirm'|trans }}" status="{{ action.getColor|default('primary') }}">
                    <p class="text-fg-secondary">{{ action.getConfirmMessage|default('datagrid.confirm.batch')|trans|nl2br }}</p>

                    <twig:block name="footer">
                        <button type="button" class="si-btn si-btn--md si-btn--ghost" data-si-modal-close>{{ 'action.cancel'|trans }}</button>
                        <button
                            type="button"
                            class="si-btn si-btn--md {{ action.getColor == 'danger' ? 'si-btn--danger' : 'si-btn--primary' }}"
                            data-si-modal-close
                            data-action="live#action"
                            data-live-action-name-param="{{ action.getLabel }}"
                            data-live-action-param="debounce(300)|executeBatch"
                        >{{ 'action.confirm'|trans }}</button>
                    </twig:block>
                </twig:Si:Modal>
            {% endif %}
        {% endfor %}

        {# Confirmation modals for single-row actions #}
        {% for row in paginator %}
            {% for action in grid.batchActions %}
                {% if action.shouldConfirm %}
                    {% set modalId = 'row_modal_' ~ action.getLabel|u.snake ~ '_' ~ loop.index ~ '_' ~ gridComponent.entityId(row) %}
                    <twig:Si:Modal id="{{ modalId }}" size="sm" title="{{ 'action.confirm'|trans }}" status="{{ action.getColor|default('primary') }}">
                        <p class="text-fg-secondary">{{ action.getConfirmMessage|default('datagrid.confirm.single')|trans|nl2br }}</p>

                        <twig:block name="footer">
                            <button type="button" class="si-btn si-btn--md si-btn--ghost" data-si-modal-close>{{ 'action.cancel'|trans }}</button>
                            <button
                                type="button"
                                class="si-btn si-btn--md {{ action.getColor == 'danger' ? 'si-btn--danger' : 'si-btn--primary' }}"
                                data-si-modal-close
                                data-action="live#action"
                                data-live-action-param="executeSingle"
                                data-live-action-name-param="{{ action.getLabel }}"
                                data-live-entity-id-param="{{ gridComponent.entityId(row) }}"
                            >{{ 'action.confirm'|trans }}</button>
                        </twig:block>
                    </twig:Si:Modal>
                {% endif %}
            {% endfor %}
        {% endfor %}
    {% endif %}
</div>
