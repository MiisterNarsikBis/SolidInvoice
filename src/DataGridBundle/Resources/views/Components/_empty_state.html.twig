 # The "nothing here yet" surface (all parameters run through |trans, so each accepts a key or a
 # TranslatableMessage):
 #   icon, title, message, action_route, action_label, action_icon
 #}
<div class="flex flex-col items-center gap-2 px-4 py-14 text-center">
    <span class="flex size-14 items-center justify-center rounded-full bg-ink-100 text-fg-muted">
        {{ ux_icon(icon|default('tabler:database-off'), {class: 'size-7', 'aria-hidden': 'true'}) }}
    </span>
    <h3 class="text-lg font-semibold text-fg">{{ title|default('datagrid.no_results.label')|trans }}</h3>
    {% if message is defined and message %}
        <p class="max-w-md text-fg-muted">{{ message|trans }}</p>
    {% endif %}
    {% if action_route is defined and action_route %}
        <twig:Si:Button href="{{ path(action_route) }}" class="mt-2">
            {{ ux_icon(action_icon|default('tabler:plus'), {class: 'size-4', 'aria-hidden': 'true'}) }}
            {{ action_label|default('action.create')|trans }}
        </twig:Si:Button>
    {% endif %}
</div>
