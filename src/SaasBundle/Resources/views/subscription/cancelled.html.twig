{% extends '@SolidInvoiceCore/Layout/focus.html.twig' %}

{% block page_title %}{{ 'saas.cancelled.title'|trans }}{% endblock %}

{% block page_heading %}{% endblock %}

{% block container_class %}max-w-2xl{% endblock %}

{% block content %}
    {% set availableCompanies = app.user.companies|filter(v => v.id != company_id()) %}

    <div class="subscription-cancelled-page text-center">
        {% include '@SolidInvoiceSaas/subscription/_hero.html.twig' with {
            icon: 'tabler:refresh',
            tone: 'warning',
            title: 'saas.cancelled.title'|trans,
            subtitle: 'saas.cancelled.subtitle'|trans({'%price%': subscription.plan.price|formatCurrency('USD')}),
        } only %}

        {% include '@SolidInvoiceSaas/subscription/_benefits.html.twig' with {
            heading: 'saas.cancelled.features_heading'|trans,
            items: [
                'saas.cancelled.feature_invoices'|trans,
                'saas.cancelled.feature_payments'|trans,
                'saas.cancelled.feature_history'|trans,
                'saas.cancelled.feature_clients'|trans,
                'saas.cancelled.feature_recurring'|trans,
            ],
        } only %}

        <div class="flex flex-wrap justify-center gap-3">
            <twig:Si:Button size="lg" href="{{ path('saas_subscription_plans') }}">
                {{ ux_icon('tabler:arrow-back-up', {class: 'size-5', 'aria-hidden': 'true'}) }}
                {{ 'saas.cancelled.reactivate'|trans }}
            </twig:Si:Button>
            <twig:Si:Button variant="ghost" size="lg" href="https://solidinvoice.co/contact" target="_blank" rel="external noreferrer noopener">
                {{ ux_icon('tabler:help', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
                {{ 'saas.action.contact_support'|trans }}
            </twig:Si:Button>
        </div>

        <twig:Si:Alert type="info" class="mt-6 text-left">
            <strong>{{ 'saas.cancelled.changed_mind'|trans }}</strong>
            {{ 'saas.cancelled.data_safe'|trans }}
        </twig:Si:Alert>

        {% if availableCompanies|length > 0 %}
            {% include '@SolidInvoiceSaas/subscription/_switch_company.html.twig' with {
                message: 'saas.company.access_other'|trans,
                linkLabel: 'saas.company.switch_to'|trans({'%company%': availableCompanies|first}),
                companyId: (availableCompanies|first).id,
            } only %}
        {% endif %}
    </div>
{% endblock content %}
