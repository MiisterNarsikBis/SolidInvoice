{% extends '@SolidInvoiceCore/Layout/focus.html.twig' %}

{% block page_title %}{{ 'saas.trial_expired.title'|trans }}{% endblock %}

{% block page_heading %}{% endblock %}

{% block container_class %}max-w-2xl{% endblock %}

{% block content %}
    {% set availableCompanies = app.user.companies|filter(v => v.id != company_id()) %}
    {% set hasCoupon = coupon_code|default('') is not empty %}

    <div class="subscription-expired-page text-center">
        {% include '@SolidInvoiceSaas/subscription/_hero.html.twig' with {
            icon: 'tabler:clock-hour-4',
            tone: 'warning',
            title: 'saas.trial_expired.title'|trans,
            subtitle: 'saas.trial_expired.subtitle'|trans({'%days%': subscription.startDate.diff(subscription.endDate).days|abs, '%date%': subscription.endDate|date('F j, Y'), '%price%': subscription.plan.price|formatCurrency('USD')}),
        } only %}

        {% include '@SolidInvoiceSaas/subscription/_benefits.html.twig' with {
            heading: 'saas.trial_expired.features_heading'|trans,
            icon: 'tabler:check',
            tone: 'text-success-dark',
            items: [
                'saas.trial_expired.feature_invoices'|trans,
                'saas.trial_expired.feature_payments'|trans,
                'saas.trial_expired.feature_clients'|trans,
                'saas.trial_expired.feature_reports'|trans,
                'saas.trial_expired.feature_recurring'|trans,
            ],
        } only %}

        {# A limited-time promo to entice activation #}
        {% if hasCoupon %}
            <div class="subscription-coupon mb-6 flex flex-wrap items-center gap-4 rounded-xl border border-primary/30 bg-primary-lighter p-5 text-left">
                <span class="text-primary">{{ ux_icon('tabler:gift', {class: 'size-8', 'aria-hidden': 'true'}) }}</span>
                <div class="min-w-0 flex-1">
                    <div class="text-xl font-semibold text-fg">{{ 'saas.trial_expired.promo_heading'|trans({'%percent%': coupon_percent}) }}</div>
                    <div class="text-fg-secondary">{{ 'saas.trial_expired.promo_message'|trans({'%code%': coupon_code|e, '%percent%': coupon_percent})|raw }}</div>
                </div>
                <div class="text-center">
                    <div class="mb-1 text-xs font-semibold tracking-wide text-fg-muted uppercase">{{ 'saas.trial_expired.promo_code'|trans }}</div>
                    <span class="rounded-md bg-surface px-3 py-1.5 font-mono text-xl font-semibold text-primary-dark">{{ coupon_code }}</span>
                </div>
            </div>
        {% endif %}

        <div class="flex flex-wrap justify-center gap-3">
            <twig:Si:Button size="lg" href="{{ path('saas_subscription_plans') }}">
                {{ ux_icon('tabler:credit-card', {class: 'size-5', 'aria-hidden': 'true'}) }}
                {% if hasCoupon %}
                    {{ 'saas.trial_expired.activate_save'|trans({'%percent%': coupon_percent}) }}
                {% else %}
                    {{ 'saas.trial_expired.activate'|trans }}
                {% endif %}
            </twig:Si:Button>
            <twig:Si:Button variant="ghost" size="lg" href="https://solidinvoice.co/contact" target="_blank" rel="external noreferrer noopener">
                {{ ux_icon('tabler:help', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
                {{ 'saas.action.contact_support'|trans }}
            </twig:Si:Button>
        </div>

        {% if availableCompanies|length > 0 %}
            {% include '@SolidInvoiceSaas/subscription/_switch_company.html.twig' with {
                message: 'saas.company.access_other'|trans,
                linkLabel: 'saas.company.switch_to'|trans({'%company%': availableCompanies|first}),
                companyId: (availableCompanies|first).id,
            } only %}
        {% endif %}
    </div>
{% endblock content %}
