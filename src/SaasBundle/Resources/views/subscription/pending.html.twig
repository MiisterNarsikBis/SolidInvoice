{% extends '@SolidInvoiceCore/Layout/focus.html.twig' %}

{% block page_title %}{{ 'saas.pending.title'|trans }}{% endblock %}

{% block page_heading %}{% endblock %}

{% block container_class %}max-w-6xl{% endblock %}

{% block content %}
    {% set availableCompanies = app.user.companies|filter(v => v.id != company_id()) %}
    {% set paidTrial = toggle('saas_paid_trial') %}

    <div class="subscription-pending-page text-center">
        {% include '@SolidInvoiceSaas/subscription/_hero.html.twig' with {
            icon: 'tabler:rocket',
            tone: 'info',
            title: (paidTrial ? 'saas.pending.title_paid_trial' : 'saas.pending.title')|trans,
            subtitle: (paidTrial ? 'saas.pending.subtitle_paid_trial' : 'saas.pending.subtitle')|trans,
        } only %}

        {# Plan picker #}
        {% if plans|default([])|length > 0 %}
            <div class="mb-2 mt-8">
                {% include '@SolidInvoiceSaas/subscription/_plans_grid.html.twig' with { plans: plans } only %}
            </div>
            <p class="mt-4 flex items-center justify-center gap-1 text-sm text-fg-muted">
                {{ ux_icon('tabler:lock', {class: 'size-3.5', 'aria-hidden': 'true'}) }}
                {{ (paidTrial ? 'saas.pending.secure_checkout_paid_trial' : 'saas.pending.secure_checkout')|trans }}
            </p>
        {% else %}
            {# No plans configured: keep the original CTA so the user can still complete activation. #}
            <div class="mt-6">
                <twig:Si:Button size="lg" href="{{ path('saas_subscription_checkout') }}">
                    {{ ux_icon('tabler:credit-card', {class: 'size-5', 'aria-hidden': 'true'}) }}
                    {{ 'saas.pending.activate'|trans }}
                </twig:Si:Button>
            </div>
        {% endif %}

        <div class="mx-auto max-w-2xl">
            {# Just completed payment #}
            <twig:Si:Alert type="info" class="mt-6 text-left">
                <strong class="block">{{ 'saas.pending.just_completed_title'|trans }}</strong>
                {{ 'saas.pending.just_completed_message'|trans }}
            </twig:Si:Alert>

            {% if availableCompanies|length > 0 %}
                {% include '@SolidInvoiceSaas/subscription/_switch_company.html.twig' with {
                    message: 'saas.pending.already_activated'|trans,
                    linkLabel: 'saas.pending.switch_company'|trans,
                    companyId: (availableCompanies|first).id,
                } only %}
            {% endif %}

            <p class="mt-6 text-sm text-fg-muted">
                {{ 'saas.pending.need_help'|trans }}
                <a href="https://solidinvoice.co/contact" target="_blank" rel="external noreferrer noopener" class="text-primary hover:underline">{{ 'saas.action.contact_support_short'|trans }}</a>
            </p>
        </div>
    </div>
{% endblock content %}
