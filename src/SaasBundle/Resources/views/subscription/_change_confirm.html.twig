{#
 # Variables:
 #   - subscription: Subscription
 #   - currentPlan: Plan
 #   - newPlan: Plan
 #}
{% extends '@SolidInvoiceCore/Layout/shell.html.twig' %}

{% block page_title %}{{ 'saas.confirm.title'|trans }}{% endblock %}

{% import _self as macros %}

{% set currentKeys = currentPlan.features|reduce((acc, f) => acc|merge({(f.featureKey): f}), {}) %}
{% set newKeys = newPlan.features|reduce((acc, f) => acc|merge({(f.featureKey): f}), {}) %}

{% block content %}
    {% set currentKeys = currentPlan.features|reduce((acc, f) => acc|merge({(f.featureKey): f}), {}) %}
    {% set newKeys = newPlan.features|reduce((acc, f) => acc|merge({(f.featureKey): f}), {}) %}

    {# Macros are not visible inside a component slot, so the rows are prepared here. #}
    {% set rows = [] %}
    {% for key, current in currentKeys %}
        {% set new = newKeys[key]|default(null) %}
        {% set rows = rows|merge([{
            label: current.description ?: key,
            current: macros.format_value(current),
            new: new is null ? 'saas.plan.not_included'|trans : macros.format_value(new),
            missing: new is null,
        }]) %}
    {% endfor %}

    <div class="mx-auto max-w-3xl">
        <twig:Si:Card title="{{ 'saas.confirm.heading'|trans({'%plan%': newPlan.name}) }}" icon="tabler:arrow-down" iconColor="warning">
            <div class="p-5">
                <p class="text-fg-secondary">
                    {% if newPlan.isFree() %}
                        {{ 'saas.confirm.free_notice'|trans }}
                    {% else %}
                        {{ 'saas.confirm.paid_notice'|trans({'%plan%': newPlan.name}) }}
                    {% endif %}
                </p>

                <h4 class="mt-6 mb-2 font-semibold text-fg">{{ 'saas.confirm.what_changes'|trans }}</h4>
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="border-b border-line text-left text-xs font-semibold tracking-wide text-fg-muted uppercase">
                                <th class="py-2 pr-3">{{ 'saas.confirm.feature'|trans }}</th>
                                <th class="px-3 py-2">{{ currentPlan.name }}</th>
                                <th class="py-2 pl-3">{{ newPlan.name }}</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-line-light">
                            {% for row in rows %}
                                <tr>
                                    <td class="py-2.5 pr-3 text-fg">{{ row.label }}</td>
                                    <td class="px-3 py-2.5 text-fg-secondary">{{ row.current }}</td>
                                    <td class="py-2.5 pl-3 {{ row.missing ? 'text-fg-muted' : 'text-fg-secondary' }}">{{ row.new }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            <twig:block name="footer">
                <twig:Si:Button variant="outline" href="{{ path('saas_subscription_change') }}">{{ 'action.cancel'|trans }}</twig:Si:Button>
                <form method="post" action="{{ path('saas_subscription_change_confirm') }}">
                    <input type="hidden" name="plan" value="{{ newPlan.planId }}">
                    <input type="hidden" name="confirmed" value="1">
                    <input type="hidden" name="_token" value="{{ csrf_token('change_plan') }}">
                    <twig:Si:Button type="submit">
                        {{ ux_icon('tabler:arrow-down-circle', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
                        {{ 'saas.confirm.title'|trans }}
                    </twig:Si:Button>
                </form>
            </twig:block>
        </twig:Si:Card>
    </div>
{% endblock %}

{% macro format_value(feature) %}
    {% set value = feature.value %}
    {% set isBool = feature.type.value == 'boolean' %}
    {% if isBool %}
        {% set isEnabled = value matches '/^(1|true)$/i' or value is same as(true) %}
        {{ isEnabled ? 'saas.plan.included'|trans : 'saas.plan.not_included'|trans }}
    {% elseif value is iterable %}
        {{ value|join(', ') }}
    {% elseif value == -1 %}
        {{ 'saas.plan.unlimited'|trans }}
    {% else %}
        {{ value }}
    {% endif %}
{% endmacro %}
