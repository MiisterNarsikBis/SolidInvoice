{#
 # Variables:
 #   - subscription: Subscription
 #   - plan: Plan
 #   - isTrial, isFree, isPastDue, isPaused, hasExternalBilling: bool
 #   - trialDaysRemaining: int|null
 #}
{% extends '@SolidInvoiceCore/Layout/shell.html.twig' %}

{% set status = subscription.status.value %}
{% set statusBadge = {
    'active':    {label: 'saas.overview.status.active',    tone: 'success'},
    'trial':     {label: 'saas.overview.status.trial',     tone: 'info'},
    'pending':   {label: 'saas.overview.status.pending',   tone: 'neutral'},
    'past_due':  {label: 'saas.overview.status.past_due',  tone: 'danger'},
    'paused':    {label: 'saas.overview.status.paused',    tone: 'warning'},
    'cancelled': {label: 'saas.overview.status.cancelled', tone: 'neutral'},
    'expired':   {label: 'saas.overview.status.expired',   tone: 'neutral'},
    'unpaid':    {label: 'saas.overview.status.unpaid',    tone: 'danger'},
    'inactive':  {label: 'saas.overview.status.inactive',  tone: 'neutral'},
}[status] ?? {label: status|capitalize, tone: 'neutral'} %}

{% block page_title %}{{ 'saas.overview.title'|trans }}{% endblock %}

{% block content %}
    {% from '@SolidInvoiceSaas/subscription/_plans_grid.html.twig' import feature_list %}
    {# Macros are not visible inside a component slot, so the list is rendered here. #}
    {% set featuresList = feature_list(plan.features) %}

    <div class="space-y-4">
        {% if subscription.hasPendingPlanChange() %}
            <twig:Si:Alert type="warning">
                <div class="flex flex-wrap items-center gap-3">
                    <div class="min-w-0 flex-1">
                        <strong>{{ 'saas.overview.pending_change_title'|trans }}</strong> —
                        {{ 'saas.overview.pending_change_message'|trans({
                            '%plan%': subscription.pendingPlan.name,
                            '%date%': subscription.pendingPlanChangeAt|date('M j, Y'),
                        }) }}
                    </div>
                    <form method="post" action="{{ path('saas_subscription_cancel_downgrade') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('cancel_downgrade') }}">
                        <twig:Si:Button type="submit" size="sm" variant="outline">{{ 'saas.overview.cancel_change'|trans }}</twig:Si:Button>
                    </form>
                </div>
            </twig:Si:Alert>
        {% endif %}

        {% if isTrial %}
            <twig:Si:Alert type="info">
                {% if trialDaysRemaining is not null and trialDaysRemaining > 0 %}
                    <strong>{{ 'saas.overview.trial_days_left'|trans({'%count%': trialDaysRemaining}) }}</strong> —
                    {{ 'saas.overview.trial_keep_features'|trans }}
                {% else %}
                    <strong>{{ 'saas.overview.trial_ended'|trans }}</strong>
                    {{ 'saas.overview.choose_to_continue'|trans }}
                {% endif %}
            </twig:Si:Alert>
        {% endif %}

        {% if isPastDue %}
            <twig:Si:Alert type="danger">
                <strong>{{ 'saas.overview.past_due_title'|trans }}.</strong>
                {{ 'saas.overview.past_due_message'|trans }}
            </twig:Si:Alert>
        {% endif %}

        {% if isPaused %}
            <twig:Si:Alert type="warning">{{ 'saas.overview.paused_message'|trans }}</twig:Si:Alert>
        {% endif %}

        <div class="grid items-start gap-6 lg:grid-cols-3">
            <div class="lg:col-span-2">
                <twig:Si:Card title="{{ 'saas.overview.current_plan'|trans }}">
                    <twig:block name="actions"><twig:Si:Badge :tone="statusBadge.tone">{{ statusBadge.label|trans }}</twig:Si:Badge></twig:block>

                    <div class="p-5">
                        <div class="mb-3 flex flex-wrap items-baseline gap-3">
                            <h2 class="text-2xl font-semibold text-fg">{{ plan.name }}</h2>
                            {% if isFree %}
                                <span class="text-fg-muted">{{ 'saas.overview.free'|trans }}</span>
                            {% else %}
                                <span class="text-fg-muted">
                                    <span class="text-sm">USD</span>
                                    <strong class="tabular text-lg text-fg">{{ plan.price|formatCurrencyAmount('USD') }}</strong>{{ 'saas.plan.per_month'|trans }}
                                </span>
                            {% endif %}
                        </div>

                        {% if plan.description is not empty %}
                            <p class="mb-4 text-fg-muted">{{ plan.description }}</p>
                        {% endif %}

                        <dl class="grid gap-x-4 gap-y-2 text-sm sm:grid-cols-3">
                            <dt class="text-fg-muted">{{ 'saas.overview.started'|trans }}</dt>
                            <dd class="text-fg sm:col-span-2">{{ subscription.startDate|date('M j, Y') }}</dd>

                            {% if isTrial %}
                                <dt class="text-fg-muted">{{ 'saas.overview.trial_ends'|trans }}</dt>
                                <dd class="text-fg sm:col-span-2">{{ subscription.endDate|date('M j, Y') }}</dd>
                            {% elseif isFree %}
                                <dt class="text-fg-muted">{{ 'saas.overview.renewal'|trans }}</dt>
                                <dd class="text-fg sm:col-span-2">{{ 'saas.overview.renewal_none'|trans }}</dd>
                            {% else %}
                                <dt class="text-fg-muted">{{ 'saas.overview.next_renewal'|trans }}</dt>
                                <dd class="text-fg sm:col-span-2">{{ subscription.endDate|date('M j, Y') }}</dd>
                            {% endif %}
                        </dl>

                        {# Per-feature usage bars are wired here once feature gates land. #}
                    </div>

                    <twig:block name="footer">
                        <twig:Si:Button href="{{ path('saas_subscription_change') }}" class="mr-auto">
                            {{ ux_icon('tabler:arrows-exchange', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
                            {{ 'saas.overview.change_plan'|trans }}
                        </twig:Si:Button>
                        {% if hasExternalBilling %}
                            <twig:Si:Button variant="outline" href="{{ path('saas_customer_portal') }}">
                                {{ ux_icon('tabler:credit-card', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
                                {{ 'saas.overview.manage_payment_method'|trans }}
                            </twig:Si:Button>
                        {% endif %}
                    </twig:block>
                </twig:Si:Card>
            </div>

            <twig:Si:Card title="{{ 'saas.overview.plan_features'|trans }}" :padded="true">
                {{ featuresList }}
            </twig:Si:Card>
        </div>
    </div>
{% endblock %}
