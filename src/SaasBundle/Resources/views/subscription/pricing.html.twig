{% extends '@SolidInvoiceCore/Layout/focus.html.twig' %}

{% block page_title %}{{ 'saas.pricing.title'|trans }}{% endblock %}

{% block page_heading %}{% endblock %}

{% block container_class %}max-w-6xl{% endblock %}

{% block content %}
    <div class="subscription-pricing-page text-center">
        <h1 class="mb-2 text-3xl font-semibold tracking-tight text-fg">{{ 'saas.pricing.title'|trans }}</h1>
        <p class="mx-auto mb-8 max-w-xl text-lg text-fg-secondary">{{ 'saas.pricing.subtitle'|trans }}</p>

        {% include '@SolidInvoiceSaas/subscription/_plans_grid.html.twig' with { plans: plans } only %}
    </div>
{% endblock content %}
