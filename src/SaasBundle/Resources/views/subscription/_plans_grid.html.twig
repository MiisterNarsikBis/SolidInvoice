 #
 # Renders the plan picker grid. Expects:
 #   - plans: list<Plan>
 # Optional:
 #   - currentPlanId: string|null  (planId of the user's current plan; that card is disabled)
 #   - actionRoute: string         (form action route name; defaults to saas_subscription_choose)
 #   - csrfToken: string           (CSRF intent; defaults to choose_plan)
 #}

{#
 # Renders the plan picker grid. Expects:
 #   - plans: list<Plan>
 # Optional:
 #   - currentPlanId: string|null  (planId of the user's current plan; that card is disabled)
 #   - actionRoute: string         (form action route name; defaults to saas_subscription_choose)
 #   - csrfToken: string           (CSRF intent; defaults to choose_plan)
 #}
{% import _self as macros %}
{% set currentPlanId = currentPlanId|default(null) %}
{% set actionRoute = actionRoute|default('saas_subscription_choose') %}
{% set csrfToken = csrfToken|default('choose_plan') %}

{# When a card is required up front, the CTA promises the trial the payment
 # provider will actually grant — or plain "Subscribe" when there is none. #}
{% set paidTrial = toggle('saas_paid_trial') %}

{# Free plan rendered separately below the main grid. #}
{% set freePlan = null %}
{% set paidPlans = [] %}
{% for plan in plans %}
    {% if plan.isFree() %}
        {% set freePlan = plan %}
    {% else %}
        {% set paidPlans = paidPlans|merge([plan]) %}
    {% endif %}
{% endfor %}

{# Highlight the second-to-last paid plan as recommended (e.g. middle of 3, third of 4). #}
{% set recommendedIndex = paidPlans|length >= 2 ? paidPlans|length - 2 : -1 %}

<div class="grid justify-center gap-6 md:grid-cols-2 lg:grid-cols-3">
    {% for plan in paidPlans %}
        {% set isRecommended = loop.index0 == recommendedIndex %}
        {% set isCurrent = currentPlanId is not null and plan.planId == currentPlanId %}

        <div class="plan-card relative flex flex-col rounded-xl border bg-surface shadow-sm {{ isCurrent ? 'plan-card-current border-success' : (isRecommended ? 'plan-card-recommended border-primary ring-1 ring-primary' : 'border-line') }}">
            {% if isCurrent %}
                <div class="plan-card-banner flex items-center justify-center gap-1.5 rounded-t-xl bg-success py-1 text-sm font-semibold text-white">
                    {{ ux_icon('tabler:check', {class: 'size-3.5', 'aria-hidden': 'true'}) }}
                    {{ 'saas.plan.current'|trans }}
                </div>
            {% elseif isRecommended %}
                <div class="plan-card-banner flex items-center justify-center gap-1.5 rounded-t-xl bg-primary py-1 text-sm font-semibold text-white">
                    {{ ux_icon('tabler:star-filled', {class: 'size-3.5', 'aria-hidden': 'true'}) }}
                    {{ 'saas.plan.recommended'|trans }}
                </div>
            {% endif %}

            <div class="flex flex-1 flex-col p-6 text-left">
                <h2 class="mb-3 text-xl font-semibold text-fg">{{ plan.name }}</h2>

                <div class="plan-card-price mb-3 flex items-baseline gap-1.5">
                    <span class="text-sm font-medium text-fg-muted">USD</span>
                    <strong class="tabular text-4xl font-semibold text-fg">{{ plan.price|formatCurrencyAmount('USD') }}</strong>
                    <span class="text-fg-muted">{{ 'saas.plan.per_month'|trans }}</span>
                </div>

                {% if plan.description is not empty %}
                    <p class="mb-4 text-fg-muted">{{ plan.description }}</p>
                {% endif %}

                {{ macros.feature_list(plan.features) }}

                {% if isCurrent %}
                    <button type="button" class="si-btn si-btn--md si-btn--outline mt-auto w-full" disabled>{{ 'saas.plan.current'|trans }}</button>
                {% else %}
                    <form method="post" action="{{ path(actionRoute) }}" class="mt-auto">
                        <input type="hidden" name="plan" value="{{ plan.planId }}">
                        <input type="hidden" name="_token" value="{{ csrf_token(csrfToken) }}">
                        <button type="submit" class="si-btn si-btn--md w-full {{ isRecommended ? 'si-btn--primary' : 'si-btn--outline' }}">
                            {{ ux_icon('tabler:credit-card', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
                            {% if paidTrial %}
                                {% set planTrialDays = saas_plan_trial_days(plan) %}
                                {% if planTrialDays %}
                                    {{ 'saas.plan.start_trial'|trans({'%days%': planTrialDays, '%count%': planTrialDays}) }}
                                {% else %}
                                    {{ 'saas.plan.subscribe'|trans }}
                                {% endif %}
                            {% else %}
                                {{ 'saas.plan.choose'|trans }}
                            {% endif %}
                        </button>
                    </form>
                {% endif %}
            </div>
        </div>
    {% endfor %}
</div>

{% if freePlan is not null %}
    {% set freeIsCurrent = currentPlanId is not null and freePlan.planId == currentPlanId %}
    <div class="plan-card-free mx-auto mt-6 max-w-5xl rounded-xl border bg-surface p-6 shadow-sm {{ freeIsCurrent ? 'border-success' : 'border-line' }}">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-center">
            <div class="text-center lg:w-56 lg:shrink-0 lg:text-left">
                <div class="mb-1 text-xs font-semibold tracking-wide text-fg-muted uppercase">
                    {{ freeIsCurrent ? 'saas.plan.your_current_plan'|trans : 'saas.plan.just_getting_started'|trans }}
                </div>
                <h3 class="text-lg font-semibold text-fg">{{ freePlan.name }}</h3>
                <div class="text-sm text-fg-muted">{{ 'saas.plan.no_credit_card'|trans }}</div>
            </div>

            <div class="flex-1">
                {{ macros.feature_list_inline(freePlan.features) }}
            </div>

            <div class="text-center lg:text-right">
                {% if freeIsCurrent %}
                    <button type="button" class="si-btn si-btn--md si-btn--outline" disabled>{{ 'saas.plan.current'|trans }}</button>
                {% else %}
                    <form method="post" action="{{ path(actionRoute) }}">
                        <input type="hidden" name="plan" value="{{ freePlan.planId }}">
                        <input type="hidden" name="_token" value="{{ csrf_token(csrfToken) }}">
                        <button type="submit" class="si-btn si-btn--md si-btn--ghost">
                            {{ ux_icon('tabler:gift', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
                            {{ 'saas.plan.continue_free'|trans }}
                        </button>
                    </form>
                {% endif %}
            </div>
        </div>
    </div>
{% endif %}

{% macro feature_list(features) %}
    {% import _self as macros %}
    {% if features|length > 0 %}
        <ul class="plan-card-features mb-6 space-y-2">
            {% for feature in features|sort((a, b) => b.featureKey <=> a.featureKey)|sort((a, b) => b.toFeatureValue.enabled <=> a.toFeatureValue.enabled) %}
                {% set isBool = feature.type.value == 'boolean' %}
                {% set isEnabled = feature.toFeatureValue.enabled %}
                <li class="flex items-start gap-2">
                    {% if isBool and not isEnabled %}
                        {{ ux_icon('tabler:x', {class: 'mt-0.5 size-[1.125rem] shrink-0 text-fg-muted', 'aria-hidden': 'true'}) }}
                    {% else %}
                        {{ ux_icon('tabler:check', {class: 'mt-0.5 size-[1.125rem] shrink-0 text-success-dark', 'aria-hidden': 'true'}) }}
                    {% endif %}
                    <span>{{ macros.feature_label(feature, isBool, isEnabled) }}</span>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
{% endmacro %}

{% macro feature_list_inline(features) %}
    {% import _self as macros %}
    {% if features|length > 0 %}
        <ul class="plan-card-features-inline grid gap-x-6 gap-y-1.5 text-sm sm:grid-cols-2">
            {% for feature in features|sort((a, b) => b.featureKey <=> a.featureKey)|sort((a, b) => b.toFeatureValue.enabled <=> a.toFeatureValue.enabled) %}
                {% set isBool = feature.type.value == 'boolean' %}
                {% set isEnabled = feature.toFeatureValue.enabled %}
                <li class="flex items-start gap-2">
                    {% if isBool and not isEnabled %}
                        {{ ux_icon('tabler:x', {class: 'mt-0.5 size-4 shrink-0 text-fg-muted', 'aria-hidden': 'true'}) }}
                    {% else %}
                        {{ ux_icon('tabler:check', {class: 'mt-0.5 size-4 shrink-0 text-success-dark', 'aria-hidden': 'true'}) }}
                    {% endif %}
                    <span>{{ macros.feature_label(feature, isBool, isEnabled) }}</span>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
{% endmacro %}

{% macro feature_label(feature, isBool, isEnabled) %}
    {% set label = feature.description ?: feature.featureKey %}
    {% set value = feature.value %}
    {% if isBool %}
        {% if isEnabled %}
            <strong class="font-semibold text-fg">{{ label }}</strong>
        {% else %}
            <span class="text-fg-muted">{{ label }}</span>
        {% endif %}
    {% elseif value is iterable %}
        <strong class="font-semibold text-fg">{{ label }}:</strong> {{ value|join(', ') }}
    {% elseif value == -1 %}
        <strong class="font-semibold text-fg">{{ 'saas.plan.unlimited'|trans }} {{ label }}</strong>
    {% else %}
        <strong class="font-semibold text-fg">{{ label }}:</strong> {{ value }}
    {% endif %}
{% endmacro %}
