{#
 # The card-required onboarding activation page. Expects:
 #   - subscription: Subscription (PENDING)
 #   - plan: Plan (the default plan the subscription will activate on)
 #}
{% extends '@SolidInvoiceCore/Layout/focus.html.twig' %}

{% block page_title %}{{ 'saas.welcome.title_no_name'|trans }}{% endblock %}

{% block page_heading %}{% endblock %}

{% block container_class %}max-w-3xl{% endblock %}

{% block content %}
    {% import '@SolidInvoiceSaas/subscription/_plans_grid.html.twig' as grid %}

    {% set availableCompanies = app.user.companies|filter(v => v.id != company_id()) %}
    {% set trialDays = saas_plan_trial_days(plan) %}
    {% set firstName = app.user.firstName|default('') %}
    {% set price = plan.price|formatCurrency('USD') %}

    <div class="subscription-welcome-page text-center">
        {% include '@SolidInvoiceSaas/subscription/_hero.html.twig' with {
            icon: 'tabler:rocket',
            tone: 'info',
            title: trialDays
                ? (firstName is not empty ? 'saas.welcome.title' : 'saas.welcome.title_no_name')|trans({'%name%': firstName})
                : 'saas.welcome.title_no_trial'|trans,
            subtitle: trialDays
                ? 'saas.welcome.subtitle'|trans({'%days%': trialDays, '%count%': trialDays})
                : 'saas.welcome.subtitle_no_trial'|trans,
        } only %}

        {# The one plan on offer — shown, not chosen. #}
        <div class="welcome-plan mb-6 rounded-xl border border-line-light bg-surface p-6 text-left shadow-sm">
            <div class="mb-4 flex flex-wrap items-start justify-between gap-4">
                <div>
                    <div class="mb-1 text-xs font-semibold tracking-wide text-fg-muted uppercase">{{ 'saas.welcome.plan_label'|trans }}</div>
                    <h2 class="text-2xl font-semibold text-fg">{{ plan.name }}</h2>
                </div>
                <div class="text-right">
                    {% if trialDays %}
                        <div class="text-xl font-semibold text-primary">{{ 'saas.welcome.plan_free_for'|trans({'%days%': trialDays, '%count%': trialDays}) }}</div>
                        <div class="text-sm text-fg-muted">{{ 'saas.welcome.plan_then'|trans({'%price%': price}) }}</div>
                    {% else %}
                        <div class="tabular text-xl font-semibold text-fg">{{ price }}</div>
                        <div class="text-sm text-fg-muted">{{ 'saas.plan.per_month'|trans }}</div>
                    {% endif %}
                </div>
            </div>

            {% if plan.description is not empty %}
                <p class="mb-4 text-fg-muted">{{ plan.description }}</p>
            {% endif %}

            {% if plan.features|length > 0 %}
                <div class="mb-2 text-xs font-semibold tracking-wide text-fg-muted uppercase">{{ 'saas.welcome.included_heading'|trans }}</div>
                {{ grid.feature_list(plan.features) }}
            {% endif %}
        </div>

        {# Reassurance: the three things that melt card hesitation. #}
        <div class="welcome-reassure mb-6 grid gap-4 text-left md:grid-cols-3">
            {% for item in [
                {icon: 'shield-check', title: 'saas.welcome.no_charge', detail: trialDays ? 'saas.welcome.no_charge_detail' : null},
                {icon: 'calendar-x', title: 'saas.welcome.cancel_anytime', detail: 'saas.welcome.cancel_anytime_detail'},
                {icon: 'lock', title: 'saas.welcome.secure_checkout', detail: 'saas.welcome.secure_checkout_detail'},
            ] %}
                <div class="flex gap-3">
                    <span class="mt-0.5 text-primary">{{ ux_icon('tabler:' ~ item.icon, {class: 'size-[1.375rem]', 'aria-hidden': 'true'}) }}</span>
                    <div>
                        <div class="font-semibold text-fg">{{ item.title|trans }}</div>
                        {% if item.detail %}<div class="text-sm text-fg-muted">{{ item.detail|trans }}</div>{% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>

        {# The only choice on the page. #}
        <twig:Si:Button size="lg" href="{{ path('saas_subscription_checkout') }}">
            {{ ux_icon('tabler:credit-card', {class: 'size-5', 'aria-hidden': 'true'}) }}
            {% if trialDays %}
                {{ 'saas.welcome.cta_trial'|trans({'%days%': trialDays, '%count%': trialDays}) }}
            {% else %}
                {{ 'saas.welcome.cta_no_trial'|trans }}
            {% endif %}
        </twig:Si:Button>

        {% if trialDays %}
            <p class="mt-2 flex items-center justify-center gap-1 text-sm text-fg-muted">
                {{ ux_icon('tabler:lock', {class: 'size-3.5', 'aria-hidden': 'true'}) }}
                {{ 'saas.welcome.cta_caption'|trans }}
            </p>
        {% endif %}

        {# The user just came back from checkout and the webhook is still in flight. #}
        <twig:Si:Alert type="info" class="mt-6 text-left">
            <strong class="block">{{ 'saas.welcome.just_completed_title'|trans }}</strong>
            {{ 'saas.welcome.just_completed_message'|trans }}
        </twig:Si:Alert>

        {% if availableCompanies|length > 0 %}
            {% include '@SolidInvoiceSaas/subscription/_switch_company.html.twig' with {
                message: 'saas.company.access_other'|trans,
                linkLabel: 'saas.company.switch_to'|trans({'%company%': availableCompanies|first}),
                companyId: (availableCompanies|first).id,
            } only %}
        {% endif %}

        <p class="mt-6 text-sm text-fg-muted">
            {{ 'saas.welcome.need_help'|trans }}
            <a href="https://solidinvoice.co/contact" target="_blank" rel="external noreferrer noopener" class="text-primary hover:underline">{{ 'saas.action.contact_support_short'|trans }}</a>
        </p>
    </div>
{% endblock content %}
