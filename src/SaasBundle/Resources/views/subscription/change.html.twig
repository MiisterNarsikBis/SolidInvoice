{#
 # Variables:
 #   - plans: list<Plan>
 #   - subscription: Subscription
 #   - currentPlanId: string
 #}
{% extends '@SolidInvoiceCore/Layout/shell.html.twig' %}

{% block page_title %}{{ 'saas.change.title'|trans }}{% endblock %}

{% block page_title_actions %}
    <twig:Si:Button variant="outline" href="{{ path('billing_index') }}">
        {{ ux_icon('tabler:arrow-left', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
        {{ 'saas.action.back'|trans }}
    </twig:Si:Button>
{% endblock %}

{% block content %}
    <div class="-mt-2 mb-6">
        <h2 class="text-xl font-semibold text-fg">{{ 'saas.change.heading'|trans }}</h2>
        <p class="text-fg-muted">{{ 'saas.change.description'|trans }}</p>
    </div>

    {% include '@SolidInvoiceSaas/subscription/_plans_grid.html.twig' with {
        plans: plans,
        currentPlanId: currentPlanId,
        actionRoute: 'saas_subscription_change_confirm',
        csrfToken: 'change_plan',
    } only %}
{% endblock %}
