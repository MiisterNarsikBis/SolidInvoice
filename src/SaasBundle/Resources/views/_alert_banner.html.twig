 # Subscription alert banner component
 # Displays subscription warnings/notifications at the top of pages
 #
 # @param string type - alert type (warning, danger, info)
 # @param string icon - Tabler icon name (e.g., 'tabler:clock-hour-4')
 # @param string title - bold title text
 # @param string message - main message text
 # @param string|null cta_label - optional button text (omit for no CTA)
 # @param string|null cta_url - optional button URL (omit for no CTA)
 # @param string|null code - optional coupon code, rendered as a badge
 #}

{#
 # Subscription alert banner. Injected at the top of every page (after the `page-wrapper` anchor of
 # the shell) to warn about the trial or the subscription.
 #
 # @param string type - alert type (warning, danger, info)
 # @param string icon - Tabler icon name (e.g., 'tabler:clock-hour-4')
 # @param string title - bold title text
 # @param string message - main message text
 # @param string|null cta_label - optional button text (omit for no CTA)
 # @param string|null cta_url - optional button URL (omit for no CTA)
 # @param string|null code - optional coupon code, rendered as a badge
 #}
{% set styles = {
    warning: 'border-warning/40 bg-warning-light text-warning-dark',
    danger: 'border-danger/30 bg-danger-light text-danger-dark',
    info: 'border-info/30 bg-info-light text-info-dark',
} %}
<div class="alert-banner border-b px-4 py-2.5 print:hidden lg:px-8 {{ styles[type]|default(styles.info) }}" role="alert">
    <div class="mx-auto flex max-w-[88rem] flex-wrap items-center gap-3">
        {{ ux_icon(icon, {class: 'size-6 shrink-0', 'aria-hidden': 'true'}) }}
        <div class="min-w-0 flex-1 text-sm">
            <strong class="font-semibold">{{ title }}</strong> - {{ message }}
            {% if code is defined and code %}
                <span class="ml-2 rounded bg-surface px-2 py-0.5 font-mono text-xs font-semibold">{{ code }}</span>
            {% endif %}
        </div>
        {% if cta_label is defined and cta_url is defined and cta_label and cta_url %}
            <a href="{{ cta_url }}" class="si-btn si-btn--sm si-btn--outline bg-surface">{{ cta_label }}</a>
        {% endif %}
    </div>
</div>
