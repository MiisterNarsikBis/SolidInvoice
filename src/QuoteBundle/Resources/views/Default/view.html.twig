{% extends "@SolidInvoiceCore/Layout/shell.html.twig" %}

{% block page_title %}{{ "quote.title"|trans({"%id%" : quote.quoteId}) }}{% endblock page_title %}

{% block page_title_actions %}
    {% import '@SolidInvoiceInvoice/Default/_send_gate.html.twig' as send_gate %}
    {% set gated = is_email_verification_gated() %}
    {% set QuoteStatus = enum('SolidInvoice\\QuoteBundle\\Enum\\QuoteStatus') %}

    {# Always available #}
    <button type="button" onclick="window.print()" class="si-btn si-btn--ghost si-btn--md" title="{{ 'quote.action.print'|trans }}" aria-label="{{ 'quote.action.print'|trans }}">
        {{ ux_icon('tabler:printer', {class: 'size-5', 'aria-hidden': 'true'}) }}
    </button>
    {% if can_print_pdf() %}
        <a href="{{ path('_quotes_view', {'id': quote.id, '_format': 'pdf'}) }}" target="_blank" class="si-btn si-btn--ghost si-btn--md" title="{{ 'quote.action.pdf'|trans }}" aria-label="{{ 'quote.action.pdf'|trans }}">
            {{ ux_icon('tabler:file-type-pdf', {class: 'size-5', 'aria-hidden': 'true'}) }}
        </a>
    {% endif %}

    <twig:Si:Dropdown label="{{ 'quote.view.toolbar.more_actions'|trans }}" triggerClass="si-btn si-btn--ghost si-btn--md">
        <twig:block name="trigger">{{ ux_icon('tabler:dots-vertical', {class: 'size-5', 'aria-hidden': 'true'}) }}</twig:block>
        {% if quote.invoice is not null %}
            <twig:Si:MenuItem href="{{ path('_invoices_view', {'id' : quote.invoice.id}) }}" icon="tabler:file-invoice">{{ "quote.view.toolbar.view_invoice"|trans }}</twig:Si:MenuItem>
            <div class="my-1 h-px bg-line-light" role="separator"></div>
        {% endif %}

        <twig:Si:MenuItem href="{{ path('_quotes_clone', {'id' : quote.id}) }}" icon="tabler:copy">{{ "quote.view.toolbar.clone"|trans }}</twig:Si:MenuItem>

        {% if quote.status != QuoteStatus.Accepted %}
            <twig:Si:MenuItem href="{{ path('_quotes_edit', {'id' : quote.id}) }}" icon="tabler:pencil">{{ "quote.view.toolbar.edit"|trans }}</twig:Si:MenuItem>
        {% endif %}

        {% if workflow_can(quote, 'reopen') %}
            <twig:Si:MenuItem href="{{ path('_transition_quote', {'action': 'reopen', 'id' : quote.id}) }}" icon="tabler:refresh">{{ "quote.view.toolbar.reopen"|trans }}</twig:Si:MenuItem>
        {% endif %}

        {% if workflow_can(quote, 'archive') %}
            <div class="my-1 h-px bg-line-light" role="separator"></div>
            <twig:Si:MenuItem href="{{ path('_transition_quote', {'action' : 'archive', 'id' : quote.id}) }}" icon="tabler:archive">{{ "quote.view.toolbar.archive"|trans }}</twig:Si:MenuItem>
        {% endif %}

        {% if workflow_can(quote, 'cancel') %}
            <div class="my-1 h-px bg-line-light" role="separator"></div>
            <twig:Si:MenuItem href="{{ path('_transition_quote', {'action': 'cancel', 'id' : quote.id}) }}" icon="tabler:x" class="text-danger-dark">{{ "quote.view.toolbar.cancel"|trans }}</twig:Si:MenuItem>
        {% endif %}
    </twig:Si:Dropdown>

    {# The main action depends on where the quote is in its life #}
    {% if workflow_can(quote, 'accept') %}
        <twig:Si:Button variant="danger-ghost" href="{{ path('_transition_quote', {'action': 'decline', 'id' : quote.id}) }}">
            {{ ux_icon('tabler:x', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
            {{ "quote.view.toolbar.decline"|trans }}
        </twig:Si:Button>
        <a href="{{ path('_transition_quote', {'action' : 'accept', 'id' : quote.id}) }}" class="si-btn si-btn--md bg-success text-white hover:bg-success-dark">
            {{ ux_icon('tabler:check', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
            {{ "quote.view.toolbar.accept"|trans }}
        </a>
        {% if gated %}
            {{ send_gate.hint('quote.send.verify_hint') }}
            <twig:Si:Button type="button" disabled aria-describedby="send-gated-hint">
                {{ ux_icon('tabler:send', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
                {{ "quote.view.toolbar.send"|trans }}
            </twig:Si:Button>
        {% else %}
            <twig:Si:Button href="{{ path('_send_quote', {'id' : quote.id}) }}">
                {{ ux_icon('tabler:send', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
                {{ "quote.view.toolbar.send"|trans }}
            </twig:Si:Button>
        {% endif %}
    {% elseif workflow_can(quote, 'publish') %}
        {% if gated %}
            {{ send_gate.hint('quote.send.verify_hint') }}
        {% endif %}
        <div class="inline-flex">
            <a href="{{ path('_transition_quote', {'action' : 'publish', 'id' : quote.id}) }}" class="si-btn si-btn--primary si-btn--md rounded-r-none">
                {{ ux_icon('tabler:check', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
                {{ 'quote.save.publish'|trans }}
            </a>
            <twig:Si:Dropdown label="{{ 'quote.view.toolbar.toggle_dropdown'|trans }}" triggerClass="si-btn si-btn--primary si-btn--md rounded-l-none border-l border-white/30 px-2">
                <twig:block name="trigger">{{ ux_icon('tabler:chevron-down', {class: 'size-4', 'aria-hidden': 'true'}) }}</twig:block>
                {% if gated %}
                    <button type="button" role="menuitem" class="flex w-full items-center gap-2 px-2.5 py-1.5 text-left text-base text-fg-muted" disabled aria-describedby="send-gated-hint">
                        {{ ux_icon('tabler:send', {class: 'size-4', 'aria-hidden': 'true'}) }}
                        {{ 'quote.view.toolbar.publish_and_send'|trans }}
                    </button>
                {% else %}
                    <twig:Si:MenuItem href="{{ path('_send_quote', {'id' : quote.id}) }}" icon="tabler:send">{{ 'quote.view.toolbar.publish_and_send'|trans }}</twig:Si:MenuItem>
                {% endif %}
            </twig:Si:Dropdown>
        </div>
    {% elseif quote.status == QuoteStatus.Accepted and quote.invoice is not null %}
        <twig:Si:Button href="{{ path('_invoices_view', {'id' : quote.invoice.id}) }}">
            {{ ux_icon('tabler:file-invoice', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
            {{ "quote.view.toolbar.view_invoice"|trans }}
        </twig:Si:Button>
    {% endif %}
{% endblock page_title_actions %}

{% block content %}
    {% import '@SolidInvoiceInvoice/Default/_send_gate.html.twig' as send_gate %}
    {% set currency = quote.currency %}

    <div class="-mt-2 mb-5 flex flex-wrap items-center gap-x-4 gap-y-1 text-fg-secondary print:hidden">
        {{ quote_label(quote.status) }}
        <span class="inline-flex items-center gap-1.5">
            {{ ux_icon('tabler:calendar', {class: 'size-3.5', 'aria-hidden': 'true'}) }}
            {{ 'quote.created'|trans }}: {{ quote.created|date('M d, Y') }}
        </span>
    </div>

    <div class="grid items-start gap-6 xl:grid-cols-[minmax(0,1fr)_20rem]">
        <div class="min-w-0">
            {% if documentTemplate|default(null) is not empty %}
                {% include documentTemplate %}
            {% else %}
                {% include '@SolidInvoiceCore/Billing/_document.html.twig' with {
                    doc: quote,
                    type: 'quote',
                    currency: currency,
                    target: enum('SolidInvoice\\CoreBundle\\Enum\\CustomFieldTarget').QUOTE,
                } only %}
            {% endif %}
        </div>

        {# Sidebar #}
        <div class="space-y-4 print:hidden">
            <twig:Si:Card title="{{ 'quote.client.title'|trans }}" icon="tabler:building" iconColor="primary" :padded="true">
                <a href="{{ path('_clients_view', {'id': quote.client.id}) }}" class="font-semibold text-primary hover:underline">{{ quote.client }}</a>

                {% if quote.users|length > 0 %}
                    <ul class="mt-3 space-y-2">
                        {% for user in quote.users %}
                            <li class="text-sm">
                                <div class="text-fg">{{ user }}</div>
                                <div class="flex items-center gap-1 text-fg-muted">
                                    {{ ux_icon('tabler:mail', {class: 'size-3', 'aria-hidden': 'true'}) }}
                                    {{ user.email }}
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </twig:Si:Card>

            <twig:Si:Card title="{{ 'quote.summary'|trans }}" icon="tabler:receipt" iconColor="primary" :padded="true">
                <dl class="space-y-3 text-sm">
                    <div class="flex items-center justify-between gap-3">
                        <dt class="text-fg-secondary">{{ 'label.status'|trans }}</dt>
                        <dd>{{ quote_label(quote.status) }}</dd>
                    </div>
                    <div class="flex items-center justify-between gap-3">
                        <dt class="text-fg-secondary">{{ 'quote.total'|trans }}</dt>
                        <dd class="tabular text-base font-semibold text-fg">{{ quote.total|formatCurrency(currency) }}</dd>
                    </div>
                    <div class="flex items-center justify-between gap-3">
                        <dt class="text-fg-secondary">{{ 'quote.created'|trans }}</dt>
                        <dd class="text-fg">{{ quote.created|date('M d, Y') }}</dd>
                    </div>
                </dl>
            </twig:Si:Card>

            {% if quote.invoice is not null %}
                <twig:Si:Card title="{{ 'quote.view.related_invoice'|trans }}" icon="tabler:file-invoice" iconColor="success" status="success" :padded="true">
                    <a href="{{ path('_invoices_view', {'id' : quote.invoice.id}) }}" class="inline-flex items-center gap-1 font-medium text-primary hover:underline">
                        {{ ux_icon('tabler:external-link', {class: 'size-3.5', 'aria-hidden': 'true'}) }}
                        {{ 'invoice.title'|trans({'%id%': quote.invoice.invoiceId}) }}
                    </a>
                    <div class="mt-2">{{ invoice_label(quote.invoice.status) }}</div>
                </twig:Si:Card>
            {% endif %}
        </div>
    </div>

    {% if is_email_verification_gated() %}
        {{ send_gate.resend_form() }}
    {% endif %}
{% endblock content %}
