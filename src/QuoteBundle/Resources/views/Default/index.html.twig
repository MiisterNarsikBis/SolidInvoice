{% extends "@SolidInvoiceCore/Layout/shell.html.twig" %}

{% block page_title %}{{ 'quote.list.title'|trans }}{% endblock page_title %}

{% block page_title_actions %}
    <twig:Si:Button href="{{ path('_quotes_create') }}">
        {{ ux_icon('tabler:plus', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
        {{ 'quote.create.title'|trans }}
    </twig:Si:Button>
{% endblock %}

{% block content %}
    {# Stats #}
    <div class="mb-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <twig:Si:Stat icon="tabler:file-text" label="{{ 'quote.stats.total_quotes'|trans }}">{{ totalActiveQuotes }}</twig:Si:Stat>
        <twig:Si:Stat icon="tabler:clock" tone="warning" label="{{ 'quote.stats.pending_quotes'|trans }}">{{ pendingCount }}</twig:Si:Stat>
        <twig:Si:Stat icon="tabler:check" tone="success" label="{{ 'quote.stats.accepted_quotes'|trans }}">{{ acceptedCount }}</twig:Si:Stat>
        <twig:Si:Stat icon="tabler:x" tone="danger" label="{{ 'quote.stats.declined_quotes'|trans }}">{{ declinedCount }}</twig:Si:Stat>
    </div>

    {# Quote list #}
    <twig:Si:Card>
        <twig:block name="header">
            <nav class="flex flex-wrap border-b border-line px-2" role="tablist" aria-label="{{ 'quote.tabs.label'|trans }}">
                <twig:Si:Tab href="{{ path('_quotes_index') }}" :active="not isArchived" icon="tabler:file-text" :count="totalActiveQuotes">{{ 'quote.tabs.active'|trans }}</twig:Si:Tab>
                <twig:Si:Tab href="{{ path('_quotes_index', {archived: 1}) }}" :active="isArchived" icon="tabler:archive" :count="totalArchivedQuotes">{{ 'quote.tabs.archived'|trans }}</twig:Si:Tab>
            </nav>
        </twig:block>

        {% if isArchived %}
            <twig:DataGrid name="archived_quote_grid" />
        {% else %}
            <twig:DataGrid name="quote_grid" />
        {% endif %}
    </twig:Si:Card>
{% endblock content %}
