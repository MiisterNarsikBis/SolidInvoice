{% extends "@SolidInvoiceCore/Layout/shell.html.twig" %}

{% block page_title %}{{ 'quote.create.title'|trans }}{% endblock %}

{% block content %}
    <twig:Si:Alert type="warning">
        <p class="flex flex-wrap items-center gap-1 font-semibold">
            {{ ux_icon('tabler:alert-triangle', {class: 'size-5', 'aria-hidden': 'true'}) }}
            {{ 'quote.client.empty'|trans }} <a href="{{ url('_clients_add') }}" class="underline">{{ 'quote.client.create'|trans }}</a>
        </p>
    </twig:Si:Alert>
{% endblock %}
