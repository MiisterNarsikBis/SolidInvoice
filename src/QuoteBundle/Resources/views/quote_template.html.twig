{% set currency = quote.currency %}

{% embed '@SolidInvoiceCore/Billing/_external_page.html.twig' with {type: 'quote', pdfUrl: path('_view_quote_external', {'uuid': quote.uuid, '_format': 'pdf'})} %}
    {% block document %}
        {% if documentTemplate|default(null) is not empty %}
            {% include documentTemplate %}
        {% else %}
            {% include '@SolidInvoiceCore/Billing/_document.html.twig' with {
                doc: quote,
                type: 'quote',
                currency: currency,
                target: enum('SolidInvoice\\CoreBundle\\Enum\\CustomFieldTarget').QUOTE,
                external: true,
            } only %}
        {% endif %}
    {% endblock document %}
{% endembed %}
