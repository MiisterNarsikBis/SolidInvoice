{# The add / edit quote form (a Live Component). The page heading belongs to the page. #}
{% form_theme form '@SolidInvoiceCore/Form/tailwind.html.twig' %}

<div {{ attributes }}>
    {% set currency = dto.client ? dto.client.currency : null %}
    {% set hasTax = this.hasTax %}
    {% set hasTermsOrNotes = this.hasTermsOrNotes %}
    {% set discountAmount = this.discountAmount %}

    {{ form_start(form) }}

    {% if not isEdit %}
        <p class="-mt-2 mb-5 text-fg-muted">{{ 'quote.create.subtitle'|trans }}</p>
    {% endif %}

    <div class="space-y-6">
        {# Client, quote number and discount #}
        <section class="grid gap-6 rounded-lg border border-line-light bg-surface p-5 shadow-sm md:grid-cols-2">
            <div class="space-y-4">
                {# Client #}
                <div class="client-selection">
                    <div class="client-mode-toggle mb-3{{ not this.hasClients() ? ' hidden' }}">
                        {{ form_row(form.clientMode, {'attr': {'class': 'flex flex-wrap gap-x-5 gap-y-1'}}) }}
                    </div>

                    {% set mode = form.clientMode.vars.data %}

                    {% if mode.value == 'existing' %}
                        {# Existing client (the autocomplete, or the card of the one picked) #}
                        <div{{ form.client is defined and form.client.vars.data is not empty ? ' class="hidden"' }}>
                            {% if form.client is defined %}
                                {{ form_row(form.client, {attr: {'data-action': 'live#$render'}}) }}
                            {% endif %}
                        </div>
                        {% if form.client is defined and form.client.vars.data %}
                            {% include "@SolidInvoiceClient/Ajax/info.html.twig" with {'client': form.client.vars.data, 'form': form} %}
                        {% endif %}
                    {% else %}
                        {# New client, inline #}
                        <div class="inline-client-form rounded-lg border border-line bg-canvas p-4">
                            <h3 class="mb-3 flex items-center gap-2 text-base font-semibold text-fg">
                                {{ ux_icon('tabler:user-plus', {class: 'size-5 text-primary', 'aria-hidden': 'true'}) }}
                                {{ 'quote.client.create_new'|trans }}
                            </h3>

                            <div class="grid gap-x-3 md:grid-cols-2">
                                <div class="md:col-span-2">{{ form_row(form.newClientName) }}</div>
                                <div>{{ form_row(form.newContactFirstName) }}</div>
                                <div>{{ form_row(form.newContactLastName) }}</div>
                                <div class="md:col-span-2">{{ form_row(form.newContactEmail) }}</div>
                            </div>

                            <twig:Si:Alert type="info">{{ 'quote.client.inline.currency_note'|trans }}</twig:Si:Alert>
                        </div>
                    {% endif %}
                </div>

                {# Quote number #}
                {% include '@SolidInvoiceCore/Billing/_billing_id.html.twig' with {
                    id_field: form.quoteId,
                    label: 'quote.label'|trans,
                    editLabel: 'quote.id.edit'|trans,
                    saveLabel: 'quote.id.save'|trans,
                    cancelLabel: 'quote.id.cancel'|trans,
                    canEdit: editQuoteId is not defined or editQuoteId is not same as(false),
                } only %}
            </div>

            <div>
                {{ form_row(form.discount) }}
            </div>
        </section>

        {# Line items and totals #}
        <div class="grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_20rem]">
            {% include '@SolidInvoiceCore/Billing/_form_lines.html.twig' with {form: form, prefix: 'quote', currency: currency, hasTax: hasTax} only %}
            {% include '@SolidInvoiceCore/Billing/_form_totals.html.twig' with {dto: dto, prefix: 'quote', currency: currency, hasTax: hasTax, discountAmount: discountAmount} only %}
        </div>

        {% include '@SolidInvoiceCore/Billing/_form_extras.html.twig' with {form: form, prefix: 'quote', customFieldsLabel: 'quote.custom_fields.title', hasTermsOrNotes: hasTermsOrNotes} only %}
    </div>

    {# Hidden fields #}
    {{ form_widget(form.total) }}
    {{ form_widget(form.baseTotal) }}
    {{ form_widget(form.tax) }}

    <twig:Si:FormActions width="max-w-none">
        <twig:Si:Button variant="ghost" href="{{ path('_quotes_index') }}">
            {{ ux_icon('tabler:arrow-left', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
            {{ 'quote.save.cancel'|trans }}
        </twig:Si:Button>

        {# Save, with the other ways of saving in the caret menu #}
        <div class="save-button-group inline-flex">
            <button type="button" class="btn-save-primary si-btn si-btn--primary si-btn--md rounded-r-none" data-action="live#action" data-live-action-param="{{ isEdit ? 'saveUpdate' : 'saveDraft' }}">
                {{ ux_icon('tabler:device-floppy', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
                {{ (isEdit ? 'quote.save.update' : 'quote.save.draft')|trans }}
            </button>
            <twig:Si:Dropdown label="{{ 'quote.view.toolbar.toggle_dropdown'|trans }}" up triggerClass="si-btn si-btn--primary si-btn--md rounded-l-none border-l border-white/30 px-2">
                <twig:block name="trigger">{{ ux_icon('tabler:chevron-up', {class: 'size-4', 'aria-hidden': 'true'}) }}</twig:block>
                <button type="button" role="menuitem" class="flex w-full items-center gap-2 rounded-md px-2.5 py-1.5 text-left text-base text-fg-secondary hover:bg-surface-hover hover:text-fg" data-action="live#action" data-live-action-param="savePublish">
                    {{ ux_icon('tabler:check', {class: 'size-4 text-fg-muted', 'aria-hidden': 'true'}) }}
                    {{ 'quote.save.publish'|trans }}
                </button>
                {% if not is_email_verification_gated() %}
                    <button type="button" role="menuitem" class="flex w-full items-center gap-2 rounded-md px-2.5 py-1.5 text-left text-base text-fg-secondary hover:bg-surface-hover hover:text-fg" data-action="live#action" data-live-action-param="saveSend">
                        {{ ux_icon('tabler:send', {class: 'size-4 text-fg-muted', 'aria-hidden': 'true'}) }}
                        {{ 'quote.save.send'|trans }}
                    </button>
                {% endif %}
            </twig:Si:Dropdown>
        </div>
    </twig:Si:FormActions>

    {{ form_end(form) }}
</div>
