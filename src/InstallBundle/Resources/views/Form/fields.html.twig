{#
    The wizard's form theme. It is applied after the Tailwind form theme, so only what is
    specific to the installer is spelled out here: the user-account and database steps, the
    review step, the driver picker and the flow buttons.
#}
{% block user_account_step_widget %}
    <div class="grid gap-x-4 sm:grid-cols-2">
        {% if form.locale is defined %}
            <div class="sm:col-span-2">{{ form_row(form.locale) }}</div>
        {% endif %}
        {% if form.applicationUrl is defined %}
            <div class="sm:col-span-2">{{ form_row(form.applicationUrl) }}</div>
        {% endif %}
        <div>{{ form_row(form.firstName) }}</div>
        <div>{{ form_row(form.lastName) }}</div>
        <div class="sm:col-span-2">{{ form_row(form.emailAddress) }}</div>
        <div class="sm:col-span-2">{{ form_row(form.password) }}</div>
    </div>

    <div class="mt-2">
        <label class="flex cursor-pointer items-start gap-2 text-fg">
            {{ form_widget(form.telemetryEnabled) }}
        </label>
        <p class="mt-1 text-sm text-fg-muted">{{ 'installation.user_account.telemetry_help'|trans }}</p>
        <details class="mt-2 rounded-md border border-line-light bg-canvas">
            <summary class="cursor-pointer px-3 py-2 text-sm text-primary">{{ 'installation.user_account.telemetry_collect_link'|trans }}</summary>
            <div class="space-y-2 border-t border-line-light p-3 text-sm text-fg-secondary">
                <p><strong>{{ 'installation.user_account.telemetry_send_title'|trans }}</strong></p>
                <ul class="list-disc pl-5">
                    {% for n in 1..5 %}<li>{{ ('installation.user_account.telemetry_send_' ~ n)|trans }}</li>{% endfor %}
                </ul>
                <p><strong>{{ 'installation.user_account.telemetry_never_title'|trans }}</strong></p>
                <ul class="list-disc pl-5">
                    {% for n in 1..2 %}<li>{{ ('installation.user_account.telemetry_never_' ~ n)|trans }}</li>{% endfor %}
                </ul>
            </div>
        </details>
    </div>
{% endblock user_account_step_widget %}

{% block _installation_review_widget %}
    {{ form_widget(form.token) }}

    <twig:Si:Alert type="info" class="mb-6">
        <h4 class="mb-1 font-semibold">{{ 'installation.review.heading'|trans }}</h4>
        {{ 'installation.review.intro'|trans }}
    </twig:Si:Alert>

    {% set db = form.vars.data.databaseConfig %}
    {% set user = form.vars.data.userAccount %}

    <div class="grid gap-6 lg:grid-cols-2">
        {# Database #}
        <section class="rounded-lg border border-line-light bg-surface">
            <h3 class="flex items-center gap-2 border-b border-line-light px-4 py-3 text-base font-semibold text-fg">
                {{ ux_icon('tabler:database', {class: 'size-5 text-fg-muted', 'aria-hidden': 'true'}) }}
                {{ 'installation.review.database_title'|trans }}
            </h3>
            <dl class="divide-y divide-line-light px-4">
                {% set _value %}<twig:Si:Badge tone="info">{{ db.driver|upper }}</twig:Si:Badge>{% endset %}{% include '@SolidInvoiceInstall/Form/_review_row.html.twig' with {label: 'installation.review.label.driver'|trans, value: _value} only %}
                {% if db.driver != 'sqlite' %}
                    {% if db.host %}
                        {% set _value %}<code>{{ db.host }}{% if db.port %}:{{ db.port }}{% endif %}</code>{% endset %}{% include '@SolidInvoiceInstall/Form/_review_row.html.twig' with {label: 'installation.review.label.host'|trans, value: _value} only %}
                    {% endif %}
                    {% if db.name %}
                        {% set _value %}<code>{{ db.name }}</code>{% endset %}{% include '@SolidInvoiceInstall/Form/_review_row.html.twig' with {label: 'installation.review.label.database_name'|trans, value: _value} only %}
                    {% endif %}
                    {% if db.user %}
                        {% set _value %}<code>{{ db.user }}</code>{% endset %}{% include '@SolidInvoiceInstall/Form/_review_row.html.twig' with {label: 'installation.review.label.username'|trans, value: _value} only %}
                    {% endif %}
                    {% if db.password %}
                        {% set _value %}
                            <span class="password-toggle-container inline-flex items-center gap-2">
                                <code class="password-masked" data-password="{{ db.password }}">••••••••</code>
                                <button type="button" class="si-btn si-btn--sm si-btn--ghost" onclick="togglePassword(this)" aria-label="{{ 'installation.review.show_password'|trans }}">
                                    <span class="icon-eye">{{ ux_icon('tabler:eye', {class: 'size-4', 'aria-hidden': 'true'}) }}</span>
                                    <span class="icon-eye-off hidden">{{ ux_icon('tabler:eye-off', {class: 'size-4', 'aria-hidden': 'true'}) }}</span>
                                </button>
                            </span>
                        {% endset %}{% include '@SolidInvoiceInstall/Form/_review_row.html.twig' with {label: 'installation.review.label.password'|trans, value: _value} only %}
                    {% endif %}
                {% endif %}
            </dl>
        </section>

        {# Administrator #}
        <section class="rounded-lg border border-line-light bg-surface">
            <h3 class="flex items-center gap-2 border-b border-line-light px-4 py-3 text-base font-semibold text-fg">
                {{ ux_icon('tabler:user', {class: 'size-5 text-fg-muted', 'aria-hidden': 'true'}) }}
                {{ 'installation.review.admin_title'|trans }}
            </h3>
            <dl class="divide-y divide-line-light px-4">
                {% if user.firstName or user.lastName %}
                    {% set _value %}<strong>{{ user.firstName }} {{ user.lastName }}</strong>{% endset %}{% include '@SolidInvoiceInstall/Form/_review_row.html.twig' with {label: 'installation.review.label.name'|trans, value: _value} only %}
                {% endif %}
                {% if user.emailAddress %}
                    {% set _value %}<code>{{ user.emailAddress }}</code>{% endset %}{% include '@SolidInvoiceInstall/Form/_review_row.html.twig' with {label: 'installation.review.label.email'|trans, value: _value} only %}
                {% endif %}
                {% if user.locale %}
                    {% set _value %}<code>{{ user.locale|upper }}</code>{% endset %}{% include '@SolidInvoiceInstall/Form/_review_row.html.twig' with {label: 'installation.review.label.language'|trans, value: _value} only %}
                {% endif %}
                {% if user.password %}
                    {% set _value %}
                        <span class="password-toggle-container inline-flex items-center gap-2">
                            <code class="password-masked" data-password="{{ user.password }}">••••••••</code>
                            <button type="button" class="si-btn si-btn--sm si-btn--ghost" onclick="togglePassword(this)" aria-label="{{ 'installation.review.show_password'|trans }}">
                                <span class="icon-eye">{{ ux_icon('tabler:eye', {class: 'size-4', 'aria-hidden': 'true'}) }}</span>
                                <span class="icon-eye-off hidden">{{ ux_icon('tabler:eye-off', {class: 'size-4', 'aria-hidden': 'true'}) }}</span>
                            </button>
                        </span>
                    {% endset %}{% include '@SolidInvoiceInstall/Form/_review_row.html.twig' with {label: 'installation.review.label.password'|trans, value: _value} only %}
                {% endif %}
                {% set _value %}
                    {% if form.vars.data.telemetryEnabled %}
                        <twig:Si:Badge tone="success">{{ 'installation.review.state.enabled'|trans }}</twig:Si:Badge>
                    {% else %}
                        <twig:Si:Badge>{{ 'installation.review.state.disabled'|trans }}</twig:Si:Badge>
                    {% endif %}
                {% endset %}{% include '@SolidInvoiceInstall/Form/_review_row.html.twig' with {label: 'installation.review.label.usage_statistics'|trans, value: _value} only %}
            </dl>
        </section>
    </div>

    <script>
        function togglePassword(button) {
            const container = button.closest('.password-toggle-container');
            const passwordElement = container.querySelector('.password-masked');
            const eyeIcon = button.querySelector('.icon-eye');
            const eyeOffIcon = button.querySelector('.icon-eye-off');
            const masked = passwordElement.textContent === '••••••••';

            passwordElement.textContent = masked ? passwordElement.getAttribute('data-password') : '••••••••';
            eyeIcon.classList.toggle('hidden', masked);
            eyeOffIcon.classList.toggle('hidden', !masked);
        }
    </script>
{% endblock _installation_review_widget %}

{% block _installation_database_config_driver_widget %}
    {% set childCount = form.children|length %}
    {% set cols = childCount == 1 ? 'md:grid-cols-1' : (childCount == 2 or childCount == 4 ? 'md:grid-cols-2' : 'md:grid-cols-3') %}

    <twig:Si:Alert type="info" class="mb-6">
        <h4 class="mb-1 font-semibold">{{ 'installation.database.choose_title'|trans }}</h4>
        {{ 'installation.database.choose_text'|trans|raw }}
    </twig:Si:Alert>

    <div class="mb-6 grid gap-4 {{ cols }}">
        {% for child in form.children %}
            {% set isSqlite = child.vars.value|lower == 'sqlite' %}
            <label class="relative block cursor-pointer" data-testid="database-driver-{{ child.vars.value|lower }}">
                {{ form_widget(child, {'attr_class': 'peer sr-only'}) }}
                <span class="relative flex h-full flex-col items-center justify-center rounded-lg border border-line bg-surface p-6 text-center transition-colors hover:border-primary-light peer-checked:border-primary peer-checked:bg-primary-lighter peer-checked:ring-4 peer-checked:ring-primary/10 peer-focus-visible:ring-2 peer-focus-visible:ring-primary/40">
                    <img src="{{ asset("/img/" ~ child.vars.value|lower) }}-icon.png" alt="{{ child.vars.value }}" class="mb-3 max-h-14" />
                    <span class="mb-1 block text-lg font-semibold text-fg">{{- form_label(child, null, {widget: ''}) -}}</span>
                    {% if form_help(child) %}
                        <span class="block text-sm text-fg-muted">{{- form_help(child) -}}</span>
                    {% endif %}
                    {% if isSqlite %}
                        <span class="absolute right-2 bottom-2"><twig:Si:Badge tone="primary">{{ 'installation.database.recommended'|trans }}</twig:Si:Badge></span>
                    {% endif %}
                </span>
            </label>
        {% endfor %}
    </div>
{% endblock _installation_database_config_driver_widget %}

{%- block _installation_database_config_driver_entry_widget -%}
    {%- set attr_class = attr_class|default(attr.class|default('')) -%}
    {%- set attr = attr|merge({class: attr_class|trim}) -%}
    <input type="radio" {{ block('widget_attributes') }}{% if value is defined %} value="{{ value }}"{% endif %}{% if checked %} checked="checked"{% endif %}>
{%- endblock _installation_database_config_driver_entry_widget %}

{# The wizard's navigation buttons; `icon` is rendered inside the button. #}
{% block button_flow_widget %}
    {% if icon is defined %}
        {% set label_html = true %}
        {% set label_text = label|default(name|humanize) %}
        {%- set label -%}
            {{ icon|raw }}
            {%- if label_text is defined -%}
                {{- label_text -}}
            {%- endif -%}
        {%- endset -%}
    {% endif %}
    {{ block('submit_widget') }}
{% endblock %}

{% block database_config_step_widget %}
    <div class="mb-4">
        {{ form_widget(form.driver) }}
        {{ form_errors(form.driver) }}
    </div>

    {% if form.host is defined %}
        <div class="grid gap-x-4 md:grid-cols-3">
            <div class="md:col-span-2">{{ form_row(form.host) }}</div>
            {% if form.port is defined %}
                <div>{{ form_row(form.port) }}</div>
            {% endif %}
        </div>
    {% endif %}

    {% if form.user is defined %}
        <div class="grid gap-x-4 md:grid-cols-2">
            <div>{{ form_row(form.user) }}</div>
            {% if form.password is defined %}
                <div>{{ form_row(form.password) }}</div>
            {% endif %}
        </div>
    {% endif %}

    {% if form.database_name is defined %}
        {{ form_row(form.database_name) }}
    {% endif %}

    {{ form_rest(form) }}
{% endblock database_config_step_widget %}
