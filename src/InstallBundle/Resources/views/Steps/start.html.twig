{% do form.start.setRendered() %}

<div class="min-w-0 flex-1 bg-canvas p-6 lg:px-12 lg:py-10">
    <div class="min-h-[26rem]">
        {# Welcome #}
        <div class="mb-8 text-center">
            <h2 class="mb-1 text-xl font-semibold text-fg">{{ 'installation.start.welcome'|trans }}</h2>
            <h1 class="mb-3 flex items-center justify-center gap-3 text-4xl font-semibold text-primary">{{ app_logo(showDefault: true) }}{{ app_name }}</h1>
            <p class="text-lg text-fg-muted">{{ 'installation.start.tagline'|trans }}</p>
        </div>

        <hr class="mb-8 border-line">

        <p class="mb-8 text-center text-lg text-fg">
            {{ 'installation.start.thank_you'|trans }}
            <br />
            {{ 'installation.start.intro'|trans }}
        </p>

        <div class="mb-8 grid gap-6 md:grid-cols-2">
            {% for feature in [
                {icon: 'file-invoice', tone: 'text-primary', key: 'invoicing'},
                {icon: 'credit-card', tone: 'text-success-dark', key: 'payments'},
                {icon: 'users', tone: 'text-info-dark', key: 'clients'},
                {icon: 'chart-bar', tone: 'text-warning-dark', key: 'insights'},
            ] %}
                <div class="flex gap-3">
                    <span class="{{ feature.tone }}">{{ ux_icon('tabler:' ~ feature.icon, {class: 'size-8', 'aria-hidden': 'true'}) }}</span>
                    <div>
                        <h5 class="mb-1 font-semibold text-fg">{{ ('installation.start.feature.' ~ feature.key ~ '.title')|trans }}</h5>
                        <p class="text-sm text-fg-muted">{{ ('installation.start.feature.' ~ feature.key ~ '.description')|trans }}</p>
                    </div>
                </div>
            {% endfor %}
        </div>

        <twig:Si:Alert type="info">
            <h4 class="mb-1 font-semibold">{{ 'installation.start.setup.title'|trans }}</h4>
            <p class="text-sm">
                {{ 'installation.start.setup.line1'|trans }}
                <br />
                {{ 'installation.start.setup.line2'|trans }}
            </p>
        </twig:Si:Alert>

        <div class="mt-8 text-center">
            <p class="mb-4 text-fg-muted">{{ 'installation.start.ready'|trans }}</p>
            {{ form_widget(form.navigator.next, {
                attr: {class: 'si-btn si-btn--lg si-btn--primary px-8'},
                label: 'installation.start.begin'|trans,
            }) }}
        </div>
    </div>
</div>
