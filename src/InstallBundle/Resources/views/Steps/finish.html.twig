{% do form.finish.setRendered() %}

<div class="relative min-w-0 flex-1 overflow-hidden bg-canvas p-6 lg:px-12 lg:py-10">
    <canvas id="confetti-canvas" class="pointer-events-none absolute inset-0 z-[1] size-full" aria-hidden="true"></canvas>

    <div class="relative z-[2] min-h-[26rem]">
        <div class="mb-6 text-center">
            <span class="mx-auto flex size-20 items-center justify-center rounded-full bg-success-light text-success-dark">
                {{ ux_icon('tabler:check', {class: 'size-12', 'aria-hidden': 'true'}) }}
            </span>
        </div>

        <div class="mb-8 text-center">
            <h1 class="mb-3 flex items-center justify-center gap-2 text-3xl font-semibold text-success-dark">
                {{ ux_icon('tabler:confetti', {class: 'size-9', 'aria-hidden': 'true'}) }}
                {{ 'installation.finish_page.title'|trans }}
            </h1>
            <p class="text-lg text-fg-secondary">{{ 'installation.finish_page.subtitle'|trans }}</p>
        </div>

        <hr class="mb-6 border-line">

        <h4 class="mb-4 text-center text-lg font-semibold text-fg">{{ 'installation.finish_page.whats_next'|trans }}</h4>
        <div class="mb-6 grid gap-4 md:grid-cols-3">
            {% for next in [
                {icon: 'users-plus', tone: 'text-primary', border: 'border-primary/40', key: 'add_clients'},
                {icon: 'file-invoice', tone: 'text-info-dark', border: 'border-info/40', key: 'create_invoice'},
                {icon: 'settings', tone: 'text-success-dark', border: 'border-success/40', key: 'configure_settings'},
            ] %}
                <div class="rounded-lg border bg-surface p-5 text-center shadow-sm {{ next.border }}">
                    <span class="{{ next.tone }}">{{ ux_icon('tabler:' ~ next.icon, {class: 'mx-auto mb-3 size-12', 'aria-hidden': 'true'}) }}</span>
                    <h5 class="mb-1 font-semibold text-fg">{{ ('installation.finish_page.' ~ next.key ~ '.title')|trans }}</h5>
                    <p class="text-sm text-fg-muted">{{ ('installation.finish_page.' ~ next.key ~ '.description')|trans }}</p>
                </div>
            {% endfor %}
        </div>

        <twig:Si:Alert type="success">
            <h5 class="mb-1 font-semibold">{{ 'installation.finish_page.summary.title'|trans }}</h5>
            <ul class="list-disc space-y-0.5 pl-5 text-sm">
                <li>{{ 'installation.finish_page.summary.database'|trans }}</li>
                <li>{{ 'installation.finish_page.summary.migrations'|trans }}</li>
                <li>{{ 'installation.finish_page.summary.admin'|trans }}</li>
                <li>{{ 'installation.finish_page.summary.secret'|trans }}</li>
            </ul>
        </twig:Si:Alert>

        <div class="mt-8 flex flex-col items-center">
            <p class="mb-3 text-center text-fg-muted">{{ 'installation.finish_page.all_set'|trans }}</p>
            {{ form_widget(form.navigator.finish, {
                attr: {class: 'si-btn si-btn--lg si-btn--primary px-8 shadow-md'},
                label: 'installation.finish_page.launch'|trans,
                icon: ux_icon('tabler:rocket', {class: 'size-6', 'aria-hidden': 'true'}),
            }) }}
        </div>
    </div>
</div>

<script>
// Confetti
(function () {
    const canvas = document.getElementById('confetti-canvas');
    if (!canvas || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const ctx = canvas.getContext('2d');
    canvas.width = canvas.offsetWidth;
    canvas.height = canvas.offsetHeight;

    const confettiCount = 150;
    const gravity = 0.5;
    const terminalVelocity = 5;
    const drag = 0.075;
    const colors = [
        { front: '#1d4ed8', back: '#1e40af' },
        { front: '#16a34a', back: '#15803d' },
        { front: '#dc2626', back: '#b91c1c' },
        { front: '#f59e0b', back: '#d97706' },
        { front: '#0ea5e9', back: '#0284c7' },
    ];

    let confetti = [];

    const randomRange = (min, max) => Math.random() * (max - min) + min;

    class ConfettiPiece {
        constructor() {
            this.x = randomRange(0, canvas.width);
            this.y = randomRange(-canvas.height, 0);
            this.w = randomRange(8, 16);
            this.h = randomRange(6, 12);
            this.vx = randomRange(-4, 4);
            this.vy = randomRange(-2, 0);
            this.rotation = randomRange(0, 2 * Math.PI);
            this.rotationSpeed = randomRange(-0.2, 0.2);
            this.color = colors[Math.floor(randomRange(0, colors.length))];
            this.front = true;
        }

        update() {
            this.vy += gravity;
            this.vy = Math.min(this.vy, terminalVelocity);
            this.vx *= (1 - drag);
            this.vy *= (1 - drag);
            this.x += this.vx;
            this.y += this.vy;
            this.rotation += this.rotationSpeed;

            if (Math.abs(this.vx) < 0.1) {
                this.front = !this.front;
            }
        }

        draw() {
            ctx.save();
            ctx.translate(this.x, this.y);
            ctx.rotate(this.rotation);
            ctx.scale(Math.cos(this.rotation * 2), 1);
            ctx.fillStyle = this.front ? this.color.front : this.color.back;
            ctx.fillRect(-this.w / 2, -this.h / 2, this.w, this.h);
            ctx.restore();
        }

        isOffScreen() {
            return this.y > canvas.height + 20;
        }
    }

    function render() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        confetti = confetti.filter((piece) => {
            piece.update();
            piece.draw();

            return !piece.isOffScreen();
        });

        if (confetti.length > 0) {
            requestAnimationFrame(render);
        }
    }

    for (let i = 0; i < confettiCount; i++) {
        confetti.push(new ConfettiPiece());
    }

    render();

    window.addEventListener('resize', () => {
        canvas.width = canvas.offsetWidth;
        canvas.height = canvas.offsetHeight;
    });
})();
</script>
