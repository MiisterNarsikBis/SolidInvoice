{% from _self import requirementCheck %}

{% macro requirementCheck(requirement) %}
    <div class="flex items-start gap-3 border-b border-line-light py-3 last:border-b-0">
        <span class="shrink-0">
            {% if requirement.fulfilled %}
                <span class="flex size-7 items-center justify-center rounded-full bg-success-light text-success-dark">{{ ux_icon('tabler:check', {class: 'size-4', 'aria-hidden': 'true'}) }}</span>
            {% elseif not requirement.optional %}
                <span class="flex size-7 items-center justify-center rounded-full bg-danger-light text-danger-dark">{{ ux_icon('tabler:x', {class: 'size-4', 'aria-hidden': 'true'}) }}</span>
            {% else %}
                <span class="flex size-7 items-center justify-center rounded-full bg-warning-light text-warning-dark">{{ ux_icon('tabler:alert-circle', {class: 'size-4', 'aria-hidden': 'true'}) }}</span>
            {% endif %}
        </span>
        <div class="min-w-0 flex-1">
            <div class="font-medium text-fg [overflow-wrap:anywhere]">{{ requirement.testMessage }}</div>
            {% if not requirement.fulfilled %}
                <div class="text-sm text-fg-muted">{{ requirement.helpHtml|raw }}</div>
            {% endif %}
        </div>
        <span class="shrink-0">
            {% if requirement.fulfilled %}
                <twig:Si:Badge tone="success">{{ 'installation.requirements_page.status.passed'|trans }}</twig:Si:Badge>
            {% elseif requirement.optional %}
                <twig:Si:Badge tone="warning">{{ 'installation.requirements_page.status.warning'|trans }}</twig:Si:Badge>
            {% else %}
                <twig:Si:Badge tone="danger">{{ 'installation.requirements_page.status.failed'|trans }}</twig:Si:Badge>
            {% endif %}
        </span>
    </div>
{% endmacro %}

{% set progress = (((form.vars.cursor.steps|filter(v => v is same as(form.vars.cursor.currentStep))|keys|first+1)/form.vars.cursor.steps|length)*100)|round %}
{% set failed = computed.appRequirements.failedRequirements|length > 0 %}
{# Inside a component slot `this` and `computed` are the slot's component, so what is needed from them is captured here. #}
{% set requirements = computed.appRequirements %}
{% set info = this %}

{% include '@SolidInvoiceInstall/Steps/_sidebar.html.twig' %}

<div class="min-w-0 flex-1">
    <div class="h-1 bg-ink-100" role="progressbar" aria-valuenow="{{ progress }}" aria-valuemin="0" aria-valuemax="100">
        <div class="h-full bg-primary" style="width: {{ progress }}%"></div>
        <span class="sr-only">{{ 'installation.progress_complete'|trans({'%progress%': progress}) }}</span>
    </div>

    {% set current_step = form.vars.cursor.currentStep %}

    <div class="flex h-full flex-col p-6 lg:px-10 lg:py-8">
        <div class="min-h-[26rem] flex-1">
            <h4 class="text-xl font-semibold text-fg">{{ field_label(form[current_step]) }}</h4>
            <p class="mb-4 text-fg-muted">{{ field_help(form[current_step]) }}</p>

            <hr class="mb-6 border-line-light">

            {% if failed %}
                <twig:Si:Alert type="danger" class="mb-6" data-requirements-alert="danger">
                    <strong class="block">{{ 'installation.requirements.not_met'|trans }}</strong>
                    {{ 'installation.requirements.message'|trans }}
                </twig:Si:Alert>
            {% else %}
                <twig:Si:Alert type="success" class="mb-6">
                    <strong class="block">{{ 'installation.requirements.all_met'|trans }}</strong>
                    {{ 'installation.requirements.all_met_message'|trans }}
                </twig:Si:Alert>
            {% endif %}

            <div class="mb-6 grid gap-4 md:grid-cols-2">
                <div class="flex items-center justify-between rounded-lg border border-primary/40 bg-surface p-4">
                    <div>
                        <div class="text-xs font-semibold tracking-wide text-fg-muted uppercase">{{ 'installation.requirements_page.required'|trans }}</div>
                        <div class="tabular text-2xl font-semibold text-fg">{{ requirements.requirements|filter(r => r.fulfilled)|length }} / {{ requirements.requirements|length }}</div>
                    </div>
                    <span class="text-primary">{{ ux_icon('tabler:shield-check', {class: 'size-10', 'aria-hidden': 'true'}) }}</span>
                </div>
                <div class="flex items-center justify-between rounded-lg border border-info/40 bg-surface p-4">
                    <div>
                        <div class="text-xs font-semibold tracking-wide text-fg-muted uppercase">{{ 'installation.requirements_page.recommended'|trans }}</div>
                        <div class="tabular text-2xl font-semibold text-fg">{{ requirements.recommendations|filter(r => r.fulfilled)|length }} / {{ requirements.recommendations|length }}</div>
                    </div>
                    <span class="text-info-dark">{{ ux_icon('tabler:star', {class: 'size-10', 'aria-hidden': 'true'}) }}</span>
                </div>
            </div>

            {# The checks, in two collapsible lists #}
            <div class="mb-6 divide-y divide-line-light rounded-lg border border-line-light">
                <details id="mandatory-requirements" class="group"{{ failed ? ' open' }}>
                    <summary class="flex cursor-pointer list-none items-center gap-2 px-4 py-3 [&::-webkit-details-marker]:hidden">
                        <span class="{{ failed ? 'text-danger-dark' : 'text-primary' }}">{{ ux_icon('tabler:checkbox', {class: 'size-5', 'aria-hidden': 'true'}) }}</span>
                        <strong class="flex-1 {{ failed ? 'text-danger-dark' : 'text-primary' }}">{{ 'installation.requirements.mandatory'|trans }}</strong>
                        {{ ux_icon('tabler:chevron-down', {class: 'size-5 text-fg-muted transition-transform group-open:rotate-180', 'aria-hidden': 'true'}) }}
                    </summary>
                    <div class="px-4 pb-2">
                        {% for requirement in requirements.requirements %}
                            {{ requirementCheck(requirement) }}
                        {% endfor %}
                    </div>
                </details>

                <details id="optional-requirements" class="group">
                    <summary class="flex cursor-pointer list-none items-center gap-2 px-4 py-3 [&::-webkit-details-marker]:hidden">
                        <span class="text-info-dark">{{ ux_icon('tabler:info-circle', {class: 'size-5', 'aria-hidden': 'true'}) }}</span>
                        <strong class="flex-1 text-info-dark">{{ 'installation.requirements.optional'|trans }}</strong>
                        {{ ux_icon('tabler:chevron-down', {class: 'size-5 text-fg-muted transition-transform group-open:rotate-180', 'aria-hidden': 'true'}) }}
                    </summary>
                    <div class="px-4 pb-2">
                        {% for requirement in requirements.recommendations %}
                            {{ requirementCheck(requirement) }}
                        {% endfor %}
                    </div>
                </details>
            </div>

            {# System information #}
            <div class="flex gap-3 rounded-lg bg-canvas p-5">
                <span class="shrink-0 text-primary">{{ ux_icon('tabler:info-circle', {class: 'size-8', 'aria-hidden': 'true'}) }}</span>
                <div class="min-w-0 flex-1">
                    <h5 class="mb-3 font-semibold text-fg">{{ 'installation.requirements_page.system_information'|trans }}</h5>
                    <dl class="space-y-2 text-sm">
                        {% for item in [
                            {label: 'installation.requirements_page.operating_system', value: constant('PHP_OS') ~ ' (' ~ constant('PHP_OS_FAMILY') ~ ')'},
                            {label: 'installation.requirements_page.web_server', value: app.request.server.get('SERVER_SOFTWARE', 'Unknown')},
                            {label: 'installation.requirements_page.current_user', value: info.getCurrentUser()},
                            {label: 'installation.requirements_page.php_version', value: constant('PHP_VERSION')},
                            {label: 'installation.requirements_page.php_config_file', value: requirements.getPhpIniPath(), hint: 'installation.requirements_page.edit_config_hint'},
                            {label: 'installation.requirements_page.memory_limit', value: info.iniGet('memory_limit')},
                            {label: 'installation.requirements_page.max_execution_time', value: info.iniGet('max_execution_time') ~ 's'},
                            {label: 'installation.requirements_page.upload_max_size', value: info.iniGet('upload_max_filesize')},
                            {label: 'installation.requirements_page.config_directory', value: info.configDir},
                            {label: 'installation.requirements_page.cache_directory', value: info.cacheDir},
                            {label: 'installation.requirements_page.log_directory', value: info.logsDir},
                        ] %}
                            {% if item.value %}
                                <div class="flex flex-wrap items-start gap-x-3">
                                    <dt class="w-44 shrink-0 font-semibold text-fg-muted">{{ item.label|trans }}:</dt>
                                    <dd class="min-w-0 flex-1">
                                        <code class="text-fg [overflow-wrap:anywhere]">{{ item.value }}</code>
                                        {% if item.hint is defined %}<div class="mt-1 text-fg-muted">{{ item.hint|trans }}</div>{% endif %}
                                    </dd>
                                </div>
                            {% endif %}
                        {% endfor %}
                    </dl>
                </div>
            </div>
        </div>

        {% include '@SolidInvoiceInstall/Steps/_nav.html.twig' with {nextDisabled: failed} %}
    </div>
</div>
