{% embed '@SolidInvoiceInstall/Steps/default.html.twig' %}
    {% block content %}
        <div class="mb-6 h-6 overflow-hidden rounded-full bg-ink-100" id="installation-progress" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
            <div class="flex h-full w-0 animate-pulse items-center justify-center bg-primary text-xs font-bold text-white transition-[width] duration-300" data-install-progress-bar>
                <span>0%</span>
            </div>
        </div>

        <div class="mb-6 space-y-3" id="installation-steps">
            {% for step in this.installationSteps %}
                {% set stepId = step.label|u.snake %}
                <div class="rounded-lg border border-line bg-surface p-4" id="step-{{ stepId }}-card">
                    <div class="flex items-start gap-3">
                        <span class="shrink-0 text-fg-muted" id="step-{{ stepId }}-status">
                            {{ ux_icon('tabler:circle-dashed', {class: 'size-6', 'aria-hidden': 'true'}) }}
                        </span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center justify-between gap-2">
                                <h5 class="font-semibold text-fg">{{ step.label }}</h5>
                                <div class="flex gap-2">
                                    <button type="button" class="si-btn si-btn--sm si-btn--danger hidden" id="step-{{ stepId }}-retry" onclick="retryStep('{{ stepId }}')">
                                        {{ ux_icon('tabler:refresh', {class: 'size-4', 'aria-hidden': 'true'}) }}
                                        <span>{{ 'installation.process_page.retry'|trans }}</span>
                                    </button>
                                    <button type="button" class="si-btn si-btn--sm si-btn--ghost hidden" id="step-{{ stepId }}-toggle" onclick="toggleLogs('{{ stepId }}')" aria-expanded="false" aria-controls="step-{{ stepId }}-output">
                                        {{ ux_icon('tabler:chevron-down', {class: 'size-5', 'aria-hidden': 'true'}) }}
                                        <span>{{ 'installation.process_page.view_logs'|trans }}</span>
                                    </button>
                                </div>
                            </div>
                            <div class="mt-2 hidden" id="step-{{ stepId }}-output">
                                <pre class="max-h-40 overflow-auto rounded-md bg-ink-900 p-3 text-sm whitespace-pre-wrap text-white break-all"><code id="step-{{ stepId }}-output-content"></code></pre>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endblock content %}
{% endembed %}

<script defer>
    const steps = [
        {% for step in this.installationSteps -%}
        '{{- step.label|u.snake -}}',
        {% endfor -%}
    ];

    const icons = {
        pending: '{{ ux_icon('tabler:circle-dashed', {class: 'size-6'})|e('js') }}',
        running: '<span class="inline-block size-5 animate-spin rounded-full border-2 border-primary border-t-transparent" role="status"></span>',
        done: '<span class="text-success-dark">{{ ux_icon('tabler:circle-check-filled', {class: 'size-6'})|e('js') }}</span>',
        failed: '<span class="text-danger-dark">{{ ux_icon('tabler:circle-x-filled', {class: 'size-6'})|e('js') }}</span>',
        up: '{{ ux_icon('tabler:chevron-up', {class: 'size-5'})|e('js') }}',
        down: '{{ ux_icon('tabler:chevron-down', {class: 'size-5'})|e('js') }}',
    };

    const logLabels = {
        show: {{ 'installation.process_page.view_logs'|trans|json_encode|raw }},
        hide: {{ 'installation.process_page.hide_logs'|trans|json_encode|raw }},
    };

    function runStep(index) {
        if (index >= steps.length) {
            // All steps completed
            nextBtn.innerHTML = originalBtnText;
            nextBtn.disabled = false;
            document.querySelector('#install-title')?.replaceChildren({{ 'installation.finish_page.title'|trans|json_encode|raw }});
            setProgress(100);
            progressBar.classList.remove('animate-pulse', 'bg-primary');
            progressBar.classList.add('bg-success');
            return;
        }

        executeStep(steps[index], index);
    }

    function executeStep(stepId, index) {
        const stepCard = document.querySelector(`#step-${stepId}-card`);
        const outputPanel = document.querySelector(`#step-${stepId}-output`);
        const outputContent = document.querySelector(`#step-${stepId}-output-content`);
        const toggleBtn = document.querySelector(`#step-${stepId}-toggle`);
        const retryBtn = document.querySelector(`#step-${stepId}-retry`);

        // Clear previous output and reset state
        outputContent.textContent = '';
        retryBtn.classList.add('hidden');
        currentStepText?.classList.remove('text-danger-dark');
        updateStatus(stepId, 'running');

        // Scroll the current step into view
        stepCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

        const eventSource = new EventSource(
            `{{ path('_system_install') }}?action=${stepId}&token={{ csrf_token('system_installation') }}`,
        );

        eventSource.addEventListener('message', (event) => {
            // Server sends plain text messages
            const message = event.data.trim();

            if (message) {
                toggleBtn.classList.remove('hidden');

                outputContent.textContent = outputContent.textContent ? outputContent.textContent + '\n' + message : message;

                // Keep the newest line in view while the logs are open
                if (!outputPanel.classList.contains('hidden')) {
                    const pre = outputContent.parentElement;
                    pre.scrollTop = pre.scrollHeight;
                }
            }
        });

        eventSource.addEventListener('complete', (event) => {
            eventSource.close();

            const data = JSON.parse(event.data);

            if (data.status === 'success') {
                updateStatus(stepId, 'done');
                updateProgress(index + 1);
                currentStep++;

                // Small delay before next step for better UX
                setTimeout(() => runStep(currentStep), 300);
            }
        });

        eventSource.addEventListener('error', (event) => {
            eventSource.close();

            let errorData;

            try {
                errorData = JSON.parse(event.data);
            } catch (e) {
                // Connection error, not a step error
                errorData = {
                    status: 'error',
                    message: {{ 'installation.process_page.connection_lost'|trans|json_encode|raw }},
                    trace: '',
                };
            }

            failStep(stepId, errorData.message);
        });

        eventSource.onerror = () => {
            // Already handled by the error event when the stream is closed
            if (eventSource.readyState === EventSource.CLOSED) {
                return;
            }

            eventSource.close();
            failStep(stepId, {{ 'installation.process_page.connection_lost'|trans|json_encode|raw }});
        };
    }

    function failStep(stepId, message) {
        const outputPanel = document.querySelector(`#step-${stepId}-output`);
        const outputContent = document.querySelector(`#step-${stepId}-output-content`);
        const toggleBtn = document.querySelector(`#step-${stepId}-toggle`);
        const retryBtn = document.querySelector(`#step-${stepId}-retry`);

        updateStatus(stepId, 'failed');

        if (outputContent.textContent) {
            outputContent.textContent += '\n\n';
        }

        toggleBtn.classList.remove('hidden');
        outputContent.textContent += '❌ {{ 'installation.process_page.error_prefix'|trans|e('js') }}: ' + message;

        // Show the error, and a way to try again
        setLogs(stepId, true);
        outputPanel.firstElementChild.scrollTop = outputPanel.firstElementChild.scrollHeight;
        retryBtn.classList.remove('hidden');

        // Stop the progress bar animation and turn it red
        progressBar.classList.remove('animate-pulse', 'bg-primary');
        progressBar.classList.add('bg-danger');
        currentStepText?.classList.add('text-danger-dark');
    }

    function retryStep(stepId) {
        const index = steps.indexOf(stepId);

        if (index !== -1) {
            progressBar.classList.add('animate-pulse', 'bg-primary');
            progressBar.classList.remove('bg-danger', 'bg-success');
            executeStep(stepId, index);
        }
    }

    function setLogs(stepId, open) {
        const outputPanel = document.querySelector(`#step-${stepId}-output`);
        const toggleBtn = document.querySelector(`#step-${stepId}-toggle`);

        outputPanel.classList.toggle('hidden', !open);
        toggleBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
        toggleBtn.innerHTML = (open ? icons.up : icons.down) + '<span>' + (open ? logLabels.hide : logLabels.show) + '</span>';
    }

    function toggleLogs(stepId) {
        setLogs(stepId, document.querySelector(`#step-${stepId}-output`).classList.contains('hidden'));
    }

    function updateStatus(stepId, status) {
        const statusElement = document.querySelector(`#step-${stepId}-status`);
        const card = document.querySelector(`#step-${stepId}-card`);
        const border = { running: 'border-primary', done: 'border-success', failed: 'border-danger' };

        if (!statusElement) {
            return;
        }

        statusElement.innerHTML = icons[status];
        card.classList.remove('border-primary', 'border-success', 'border-danger');
        card.classList.add(border[status]);
    }

    function setProgress(progress) {
        progressBar.style.width = `${progress}%`;
        progressText.textContent = `${progress}%`;
        progressBar.parentElement.setAttribute('aria-valuenow', progress);
    }

    function updateProgress(completedSteps) {
        setProgress(Math.round((completedSteps / steps.length) * 100));
    }

    let currentStep = 0;
    let progressBar = null;
    let progressText = null;
    let currentStepText = null;
    let nextBtn = null;
    let originalBtnText = null;

    window.addEventListener('DOMContentLoaded', function () {
        progressBar = document.querySelector('[data-install-progress-bar]');
        progressText = progressBar.querySelector('span');
        currentStepText = document.querySelector('#current_step_text');
        nextBtn = document.querySelector('#installation_navigator_next');

        originalBtnText = nextBtn.innerHTML;
        nextBtn.innerHTML = '<span class="inline-block size-4 animate-spin rounded-full border-2 border-white border-t-transparent" role="status"></span> ' + {{ 'installation.process.title.busy'|trans|json_encode|raw }};
        nextBtn.disabled = true;

        // Auto-start installation when page loads
        runStep(currentStep);
    });
</script>
