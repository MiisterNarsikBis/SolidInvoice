{% extends "@SolidInvoiceCore/Layout/shell.html.twig" %}

{% form_theme form '@SolidInvoiceCore/Form/tailwind.html.twig' %}

{% block page_title %}{{ form.vars.data.name is not empty ? 'tax.rates.edit'|trans : 'tax.rates.add'|trans }}{% endblock %}

{% block content %}
    {{ form_start(form) }}
    <div class="max-w-3xl">
        {{ form_errors(form) }}

        {% if form.vars.data.name is empty %}
            <p class="-mt-2 mb-5 text-fg-muted">{{ 'tax.rates.form.subtitle'|trans }}</p>
        {% endif %}

        <twig:Si:FormSection id="tax-details" title="{{ 'tax.rates.details'|trans }}" description="{{ 'tax.rates.form.description'|trans }}" icon="tabler:settings">
            <div class="grid gap-x-4 sm:grid-cols-2">
                <div class="sm:col-span-2">{{ form_row(form.name) }}</div>
                <div>{{ form_row(form.rate) }}</div>
                <div>{{ form_row(form.type) }}</div>
                <div class="sm:col-span-2">{{ form_row(form.category) }}</div>
                <div class="sm:col-span-2">{{ form_row(form.compound) }}</div>
            </div>
        </twig:Si:FormSection>

        {{ form_rest(form) }}

        <twig:Si:FormActions>
            <twig:Si:Button variant="ghost" href="{{ path('_tax_rates') }}">
                {{ ux_icon('tabler:arrow-left', {class: 'size-4', 'aria-hidden': 'true'}) }}
                {{ 'tax.rates.cancel'|trans }}
            </twig:Si:Button>
            <twig:Si:Button type="submit">
                {{ ux_icon('tabler:device-floppy', {class: 'size-4', 'aria-hidden': 'true'}) }}
                {{ 'tax.rates.save'|trans }}
            </twig:Si:Button>
        </twig:Si:FormActions>
    </div>
    {{ form_end(form) }}
{% endblock %}
