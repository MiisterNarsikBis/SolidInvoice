{# The company's tax identifiers (VAT number and so on), a Live Component shown on the settings page. #}
{% form_theme form '@SolidInvoiceCore/Form/tailwind.html.twig' %}

<div {{ attributes }}>
    <h3 class="mb-1 flex items-center gap-2 text-lg font-semibold text-fg">
        {{ ux_icon('tabler:receipt-tax', {class: 'size-5 text-primary', 'aria-hidden': 'true'}) }}
        {{ 'tax.company_identifiers.title'|trans }}
    </h3>
    <p class="mb-4 text-sm text-fg-muted">{{ 'tax.company_identifiers.description'|trans }}</p>

    {{ form_start(form, {
        attr: {
            'data-action': 'live#action:prevent',
            'data-live-action-param': 'save'
        }
    }) }}

    <div class="mb-4">
        {% for identifier in form.identifiers %}
            <div class="mb-2 grid items-end gap-x-3 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)_auto_auto]">
                {{ form_row(identifier.label, {label: 'tax.company_identifiers.label'|trans}) }}
                {{ form_row(identifier.value, {label: 'tax.company_identifiers.value'|trans}) }}
                {{ form_row(identifier.primary, {label: 'tax.company_identifiers.primary'|trans}) }}
                <div class="mb-4">
                    <button type="button"
                            class="si-btn si-btn--md si-btn--danger-ghost"
                            data-action="live#action"
                            data-live-action-param="removeCollectionItem"
                            data-live-name-param="{{ form.identifiers.vars.full_name }}"
                            data-live-index-param="{{ loop.index0 }}"
                            title="{{ 'tax.company_identifiers.remove'|trans }}"
                            aria-label="{{ 'tax.company_identifiers.remove'|trans }}">
                        {{ ux_icon('tabler:trash', {class: 'size-4', 'aria-hidden': 'true'}) }}
                    </button>
                </div>
            </div>
        {% else %}
            <p class="mb-2 text-sm text-fg-muted">{{ 'tax.company_identifiers.empty'|trans }}</p>
        {% endfor %}
    </div>

    {{ form_errors(form.identifiers) }}

    <div class="flex items-center justify-between">
        {{ form_widget(form.identifiers.vars.button_add, {
            label: 'tax.company_identifiers.add'|trans,
            attr: {class: 'si-btn si-btn--sm si-btn--ghost'}
        }) }}

        <button type="submit" class="si-btn si-btn--sm si-btn--primary">
            {{ ux_icon('tabler:device-floppy', {class: 'size-4', 'aria-hidden': 'true'}) }}
            {{ 'tax.company_identifiers.save'|trans }}
        </button>
    </div>

    {{ form_end(form) }}
</div>
