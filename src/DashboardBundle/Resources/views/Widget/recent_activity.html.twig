{#
 # One row per activity type: the icon, the badge tone and label, and the sentence. The
 # sentence puts the document link first or last depending on the translation, so each type
 # keeps its own small block instead of being forced through a shared one.
 #}
<twig:Si:Card title="{{ 'dashboard.activity.title'|trans }}">
    <twig:block name="actions">
        <a href="{{ path('_invoices_index') }}" class="inline-flex items-center gap-1 rounded-md px-2 py-1 text-sm font-medium text-primary hover:bg-primary-lighter hover:text-primary-dark">
            {{ 'dashboard.activity.view_all'|trans }}
            {{ ux_icon('tabler:arrow-right', {class: 'size-3.5', 'aria-hidden': 'true'}) }}
        </a>
    </twig:block>

    {% if not hasActivities %}
        <div class="flex flex-col items-center gap-3 px-4 py-10 text-center">
            {{ ux_icon('tabler:activity', {class: 'size-10 text-ink-300', 'aria-hidden': 'true'}) }}
            <p class="text-fg-secondary">{{ 'dashboard.activity.no_activity'|trans }}</p>
            <twig:Si:Button size="sm" href="{{ path('_invoices_create') }}">
                {{ ux_icon('tabler:plus', {class: 'size-4', 'aria-hidden': 'true'}) }}
                {{ 'dashboard.actions.create_invoice'|trans }}
            </twig:Si:Button>
        </div>
    {% else %}
        {% set docLink = 'font-medium text-primary hover:text-primary-dark hover:underline' %}
        <ul class="divide-y divide-line-light">
            {% for activity in activities %}
                <li class="flex gap-3 px-5 py-3">
                    {# The icon says the type; the badge says it again in words. #}
                    <span class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-full bg-ink-100 text-fg-secondary">
                        {% if activity.type == 'payment' %}
                            {{ ux_icon('tabler:cash', {class: 'size-4', 'aria-hidden': 'true'}) }}
                        {% elseif activity.type == 'invoice_sent' %}
                            {{ ux_icon('tabler:send', {class: 'size-4', 'aria-hidden': 'true'}) }}
                        {% elseif activity.type == 'quote_accepted' %}
                            {{ ux_icon('tabler:circle-check', {class: 'size-4', 'aria-hidden': 'true'}) }}
                        {% elseif activity.type == 'quote_declined' %}
                            {{ ux_icon('tabler:circle-x', {class: 'size-4', 'aria-hidden': 'true'}) }}
                        {% elseif activity.type == 'recurring_generated' %}
                            {{ ux_icon('tabler:repeat', {class: 'size-4', 'aria-hidden': 'true'}) }}
                        {% else %}
                            {{ ux_icon('tabler:file-invoice', {class: 'size-4', 'aria-hidden': 'true'}) }}
                        {% endif %}
                    </span>

                    <div class="min-w-0 flex-1">
                        <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                            {% if activity.type == 'payment' %}
                                <twig:Si:Badge tone="success">{{ 'dashboard.activity.label.payment'|trans }}</twig:Si:Badge>
                                <span class="text-fg">
                                    {{ 'dashboard.activity.payment_for_invoice'|trans }}
                                    <a href="{{ path('_invoices_view', {id: activity.invoiceUlid}) }}" class="{{ docLink }}">#{{ activity.invoiceId }}</a>
                                </span>
                            {% elseif activity.type == 'invoice_sent' %}
                                <twig:Si:Badge tone="primary">{{ 'dashboard.activity.label.invoice'|trans }}</twig:Si:Badge>
                                <span class="text-fg">
                                    <a href="{{ path('_invoices_view', {id: activity.id}) }}" class="{{ docLink }}">#{{ activity.invoiceId }}</a>
                                    {{ 'dashboard.activity.sent_to_client'|trans }}
                                </span>
                            {% elseif activity.type == 'quote_accepted' %}
                                <twig:Si:Badge tone="success">{{ 'dashboard.activity.label.quote'|trans }}</twig:Si:Badge>
                                <span class="text-fg">
                                    <a href="{{ path('_quotes_view', {id: activity.id}) }}" class="{{ docLink }}">#{{ activity.quoteId }}</a>
                                    {{ 'dashboard.activity.was_accepted'|trans }}
                                </span>
                            {% elseif activity.type == 'quote_declined' %}
                                <twig:Si:Badge tone="danger">{{ 'dashboard.activity.label.quote'|trans }}</twig:Si:Badge>
                                <span class="text-fg">
                                    <a href="{{ path('_quotes_view', {id: activity.id}) }}" class="{{ docLink }}">#{{ activity.quoteId }}</a>
                                    {{ 'dashboard.activity.was_declined'|trans }}
                                </span>
                            {% elseif activity.type == 'recurring_generated' %}
                                <twig:Si:Badge tone="info">{{ 'dashboard.activity.label.recurring'|trans }}</twig:Si:Badge>
                                <span class="text-fg">
                                    <a href="{{ path('_invoices_view', {id: activity.id}) }}" class="{{ docLink }}">#{{ activity.invoiceId }}</a>
                                    {{ 'dashboard.activity.generated_from_recurring'|trans }}
                                </span>
                            {% else %}
                                <twig:Si:Badge tone="neutral">{{ 'dashboard.activity.label.invoice'|trans }}</twig:Si:Badge>
                                <span class="text-fg">
                                    <a href="{{ path('_invoices_view', {id: activity.id}) }}" class="{{ docLink }}">#{{ activity.invoiceId }}</a>
                                    {{ 'dashboard.activity.was_created'|trans }}
                                </span>
                            {% endif %}
                        </div>

                        <div class="mt-1 flex flex-wrap items-center gap-x-2 text-sm text-fg-muted">
                            <a href="{{ path('_clients_view', {id: activity.clientId}) }}" class="inline-flex items-center gap-1 text-fg-secondary hover:text-primary hover:underline">
                                {{ ux_icon('tabler:user', {class: 'size-3.5', 'aria-hidden': 'true'}) }}
                                {{ activity.client }}
                            </a>
                            <span aria-hidden="true">&middot;</span>
                            {#
                             # `paid` only on a payment row, and only because the "Payment" badge above
                             # states it in words. Every other row is money that has not been received
                             # (sent, created, quoted) or was never money at all (declined), so it
                             # stays neutral.
                             #}
                            <twig:Si:Money :amount="activity.amount" :currency="activity.currency" :tone="activity.type == 'payment' ? 'paid' : 'neutral'" />
                            <span aria-hidden="true">&middot;</span>
                            <span>{{ activity.date|diff }}</span>
                        </div>
                    </div>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</twig:Si:Card>
