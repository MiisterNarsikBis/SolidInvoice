{#
 # Imported here, not at the top of the file: the default slot of a component compiles as its
 # own template, so a top-level import is out of scope by the time the sections render.
 # `row` is the shared look of one document line; every section only varies the heading.
 #}
<twig:Si:Card title="{{ 'dashboard.attention.title'|trans }}" icon="tabler:bell">
    {% import '@SolidInvoiceDashboard/Widget/_attention_sections.html.twig' as section %}
    {% set row = 'flex items-center justify-between gap-3 px-5 py-2.5 transition-colors hover:bg-surface-hover' %}
    {% set heading = 'flex items-center gap-2 border-b border-line-light bg-canvas px-5 py-2 text-xs font-semibold uppercase tracking-wide' %}

    {% if not hasItems %}
        <div class="flex flex-col items-center gap-2 px-4 py-10 text-center">
            <span class="flex size-12 items-center justify-center rounded-full bg-success-light text-success-dark">
                {{ ux_icon('tabler:check', {class: 'size-6', 'aria-hidden': 'true'}) }}
            </span>
            <p class="text-fg-secondary">{{ 'dashboard.attention.no_items'|trans }}</p>
        </div>
    {% else %}
        <div class="divide-y divide-line-light">
            {% if overdueInvoices is not empty %}
                <section>
                    <h3 class="{{ heading }} text-danger-dark">
                        {{ ux_icon('tabler:alert-triangle', {class: 'size-4', 'aria-hidden': 'true'}) }}
                        <span>{{ 'dashboard.attention.overdue_invoices'|trans }}</span>
                        {{ section.sectionBadge(overdueInvoices, overdueInvoicesTotal, 'danger') }}
                    </h3>
                    <ul class="divide-y divide-line-light">
                        {% for invoice in overdueInvoices %}
                            <li>
                                <a href="{{ path('_invoices_view', {id: invoice.id}) }}" class="{{ row }}">
                                    <span class="flex min-w-0 items-baseline gap-2">
                                        <span class="tabular font-medium text-fg">#{{ invoice.invoiceId }}</span>
                                        <span class="truncate text-fg-secondary">{{ invoice.client.name }}</span>
                                    </span>
                                    <span class="flex shrink-0 items-baseline gap-3">
                                        {# `overdue` is earned: the section heading says "Overdue Invoices" in words. #}
                                        <twig:Si:Money :amount="invoice.total" :currency="invoice.currency" tone="overdue" />
                                        {% if invoice.due %}
                                            <span class="tabular w-12 text-right text-sm text-danger-dark">{{ invoice.due|date('M j') }}</span>
                                        {% endif %}
                                    </span>
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                    {{ section.truncationNotice(overdueInvoices, overdueInvoicesTotal, '_invoices_index') }}
                </section>
            {% endif %}

            {% if draftInvoices is not empty %}
                <section>
                    <h3 class="{{ heading }} text-warning-dark">
                        {{ ux_icon('tabler:file-text', {class: 'size-4', 'aria-hidden': 'true'}) }}
                        <span>{{ 'dashboard.attention.draft_invoices'|trans }}</span>
                        {{ section.sectionBadge(draftInvoices, draftInvoicesTotal, 'warning') }}
                    </h3>
                    <ul class="divide-y divide-line-light">
                        {% for invoice in draftInvoices %}
                            <li>
                                <a href="{{ path('_invoices_view', {id: invoice.id}) }}" class="{{ row }}">
                                    <span class="flex min-w-0 items-baseline gap-2">
                                        {#
                                         # An unnumbered draft has no ID yet. It renders a translated state
                                         # label, without a `#`: it is a state, not an identifier.
                                         #}
                                        <span class="tabular font-medium text-fg">
                                            {%- if invoice.invoiceId -%}
                                                #{{ invoice.invoiceId }}
                                            {%- else -%}
                                                {{ 'dashboard.attention.draft_label'|trans }}
                                            {%- endif -%}
                                        </span>
                                        <span class="truncate text-fg-secondary">{{ invoice.client.name }}</span>
                                    </span>
                                    {# Neutral: a draft is not money owed, received, or overdue. #}
                                    <twig:Si:Money :amount="invoice.total" :currency="invoice.currency" class="shrink-0" />
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                    {{ section.truncationNotice(draftInvoices, draftInvoicesTotal, '_invoices_index') }}
                </section>
            {% endif %}

            {% if pendingQuotes is not empty %}
                <section>
                    <h3 class="{{ heading }} text-info-dark">
                        {{ ux_icon('tabler:file-description', {class: 'size-4', 'aria-hidden': 'true'}) }}
                        <span>{{ 'dashboard.attention.pending_quotes'|trans }}</span>
                        {{ section.sectionBadge(pendingQuotes, pendingQuotesTotal, 'info') }}
                    </h3>
                    <ul class="divide-y divide-line-light">
                        {% for quote in pendingQuotes %}
                            <li>
                                <a href="{{ path('_quotes_view', {id: quote.id}) }}" class="{{ row }}">
                                    <span class="flex min-w-0 items-baseline gap-2">
                                        <span class="tabular font-medium text-fg">#{{ quote.quoteId }}</span>
                                        <span class="truncate text-fg-secondary">{{ quote.client.name }}</span>
                                    </span>
                                    <span class="flex shrink-0 items-baseline gap-3">
                                        {# Neutral: pending. #}
                                        <twig:Si:Money :amount="quote.total" :currency="quote.currency" />
                                        <span class="tabular w-12 text-right text-sm text-fg-muted">{{ quote.created|date('M j') }}</span>
                                    </span>
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                    {{ section.truncationNotice(pendingQuotes, pendingQuotesTotal, '_quotes_index') }}
                </section>
            {% endif %}

            {% if upcomingRecurring is not empty %}
                <section>
                    <h3 class="{{ heading }} text-primary-dark">
                        {{ ux_icon('tabler:repeat', {class: 'size-4', 'aria-hidden': 'true'}) }}
                        <span>{{ 'dashboard.attention.upcoming_recurring'|trans }}</span>
                        {# `upcomingRecurringTotal` is null by design - see the widget. Falls back to the shown count. #}
                        {{ section.sectionBadge(upcomingRecurring, upcomingRecurringTotal, 'primary') }}
                    </h3>
                    <ul class="divide-y divide-line-light">
                        {% for recurring in upcomingRecurring %}
                            <li>
                                <a href="{{ path('_invoices_view_recurring', {id: recurring.id}) }}" class="{{ row }}">
                                    <span class="truncate text-fg-secondary">{{ recurring.client.name }}</span>
                                    <span class="flex shrink-0 items-baseline gap-3">
                                        {# Neutral: not yet issued. #}
                                        <twig:Si:Money :amount="recurring.total" :currency="recurring.currency" />
                                        <span class="tabular w-12 text-right text-sm text-fg-muted">{{ recurring.dateStart|date('M j') }}</span>
                                    </span>
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                    {{ section.truncationNotice(upcomingRecurring, upcomingRecurringTotal, '_invoices_index') }}
                </section>
            {% endif %}
        </div>
    {% endif %}
</twig:Si:Card>
