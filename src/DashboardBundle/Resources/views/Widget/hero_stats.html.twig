{#
 # Renders a per-currency map of amounts as a single stat value.
 #
 # One currency (the overwhelmingly common case) gets one total, and that is the whole point:
 # the question "how much am I owed?" must be answerable by reading, never by adding. Several
 # currencies cannot be summed, so they are stacked and captioned as separate figures rather
 # than silently listed - the caption is what stops the stack from reading like addends of a
 # total that was left off.
 #
 # `tone` and `size` are the <twig:Si:Money> props. They are passed through `component()`
 # because a macro cannot use the <twig:...> tag syntax with its own arguments.
 #}
{% macro statValue(values, defaultCurrency, tone = 'neutral', size = 'xl') %}
    {% if values|length > 1 %}
        <span class="flex flex-col gap-0.5">
            {% for currency, amount in values %}
                {{ component('Si:Money', {amount: amount, currency: currency, tone: tone, size: size}) }}
            {% endfor %}
        </span>
        <span class="text-sm text-fg-muted">{{ 'dashboard.hero.currency_breakdown'|trans({'%count%': values|length}) }}</span>
    {% else %}
        <span>
            {% for currency, amount in values %}
                {{ component('Si:Money', {amount: amount, currency: currency, tone: tone, size: size}) }}
            {% else %}
                {#
                 # No invoices yet. There is no client to take a currency from, so this falls back
                 # to the company's own currency - the same basis the populated branch would use
                 # for a single-currency account.
                 #}
                {{ component('Si:Money', {amount: 0, currency: defaultCurrency, tone: tone, size: size}) }}
            {% endfor %}
        </span>
    {% endif %}
{% endmacro %}

{% import _self as hero %}
{% set defaultCurrency = defaultCurrency|default(null) %}

<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
    {# Neutral: outstanding is money not yet received. Green here would be a lie. #}
    <div class="rounded-lg border border-line-light bg-surface shadow-sm flex items-center gap-3.5 p-4">
        <span class="flex size-10 shrink-0 items-center justify-center rounded-md bg-primary-light text-primary-dark">
            {{ ux_icon('tabler:file-invoice', {class: 'size-5', 'aria-hidden': 'true'}) }}
        </span>
        <div class="flex min-w-0 flex-col gap-0.5">
            <span class="text-sm text-fg-secondary">{{ 'dashboard.hero.outstanding'|trans }}</span>
            {{ hero.statValue(totalOutstanding, defaultCurrency) }}
        </div>
    </div>

    {#
     # The count is this tile's headline, so the amount stays a smaller figure. The danger tint
     # is conditional: a danger-tinted "0 overdue" would congratulate a healthy account in the
     # colour of a problem. `overdue` tone on the amount is earned - the "Overdue" label beside
     # it is visible and explicit.
     #}
    <div class="rounded-lg border bg-surface shadow-sm flex items-center gap-3.5 p-4 {{ overdueCount > 0 ? 'border-danger/40 bg-danger-light/40' : 'border-line-light' }}">
        <span class="flex size-10 shrink-0 items-center justify-center rounded-md bg-danger-light text-danger-dark">
            {{ ux_icon('tabler:alert-triangle', {class: 'size-5', 'aria-hidden': 'true'}) }}
        </span>
        <div class="flex min-w-0 flex-col gap-0.5">
            <span class="text-sm text-fg-secondary">{{ 'dashboard.hero.overdue'|trans }}</span>
            <span class="tabular text-2xl font-semibold {{ overdueCount > 0 ? 'text-danger-dark' : 'text-fg' }}">{{ overdueCount }}</span>
            {% if overdueAmount is not empty %}
                {{ hero.statValue(overdueAmount, defaultCurrency, 'overdue', 'md') }}
            {% endif %}
        </div>
    </div>

    {# Neutral, not `paid`: the label reads "This Month", not "Paid"; the word carries the meaning. #}
    <div class="rounded-lg border border-line-light bg-surface shadow-sm flex items-center gap-3.5 p-4">
        <span class="flex size-10 shrink-0 items-center justify-center rounded-md bg-success-light text-success-dark">
            {{ ux_icon('tabler:calendar-stats', {class: 'size-5', 'aria-hidden': 'true'}) }}
        </span>
        <div class="flex min-w-0 flex-col gap-0.5">
            <span class="text-sm text-fg-secondary">{{ 'dashboard.hero.this_month'|trans }}</span>
            {{ hero.statValue(paymentsThisMonth, defaultCurrency) }}
        </div>
    </div>

    {# Lifetime revenue mixes paid, part-paid and refunded: an aggregate, not a payment state, so neutral. #}
    <div class="rounded-lg border border-line-light bg-surface shadow-sm flex items-center gap-3.5 p-4">
        <span class="flex size-10 shrink-0 items-center justify-center rounded-md bg-info-light text-info-dark">
            {{ ux_icon('tabler:trending-up', {class: 'size-5', 'aria-hidden': 'true'}) }}
        </span>
        <div class="flex min-w-0 flex-col gap-0.5">
            <span class="text-sm text-fg-secondary">{{ 'dashboard.hero.total_revenue'|trans }}</span>
            {{ hero.statValue(totalRevenue, defaultCurrency) }}
        </div>
    </div>
</div>
