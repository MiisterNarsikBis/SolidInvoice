{#
 # A widget whose query failed. Shared by revenue_chart, invoice_distribution and
 # onboarding_checklist.
 #
 # A failed query used to fall through to the empty state, so a broken dashboard told a paying
 # user they had no invoices. This state must never be mistakable for that one: it uses a
 # different glyph, opens with a title that names the problem, and carries `role="alert"` so
 # the failure is announced and not merely tinted. The retry is a ghost button, not the
 # primary one: blue is the empty state's "Create Invoice" CTA, and spending it here would
 # conflate "you are new" with "this broke". It re-requests the dashboard, which re-runs the
 # query that failed. No JS.
 #}
<div class="flex flex-col items-center gap-2 px-4 py-8 text-center" role="alert">
    <span class="flex size-12 items-center justify-center rounded-full bg-danger-light text-danger-dark">
        {{ ux_icon('tabler:alert-triangle', {class: 'size-6', 'aria-hidden': 'true'}) }}
    </span>
    <p class="font-semibold text-fg">{{ 'dashboard.error.title'|trans }}</p>
    <p class="max-w-sm text-sm text-fg-muted">{{ 'dashboard.error.body'|trans }}</p>
    <twig:Si:Button variant="ghost" size="sm" href="{{ path('_dashboard') }}">
        {{ ux_icon('tabler:refresh', {class: 'size-4', 'aria-hidden': 'true'}) }}
        {{ 'dashboard.error.retry'|trans }}
    </twig:Si:Button>
</div>
