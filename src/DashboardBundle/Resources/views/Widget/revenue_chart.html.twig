<twig:Si:Card title="{{ 'dashboard.charts.revenue_title'|trans }}" subtitle="{{ 'dashboard.charts.revenue_subtitle'|trans }}">
    {# The canvas needs a sized parent: Chart.js is responsive with maintainAspectRatio off. #}
    <div class="relative h-72 p-4">
        {% if hasError %}
            {% include '@SolidInvoiceDashboard/Widget/_error_state.html.twig' %}
        {% elseif not hasData %}
            <div class="flex h-full flex-col items-center justify-center gap-2 text-center">
                {{ ux_icon('tabler:chart-line', {class: 'size-10 text-ink-300', 'aria-hidden': 'true'}) }}
                <p class="font-medium text-fg-secondary">{{ 'dashboard.charts.no_data'|trans }}</p>
                <p class="text-sm text-fg-muted">{{ 'dashboard.charts.no_data_hint'|trans }}</p>
            </div>
        {% else %}
            {{ render_chart(chart, {'class': 'dashboard-revenue-chart'}) }}
        {% endif %}
    </div>
</twig:Si:Card>
