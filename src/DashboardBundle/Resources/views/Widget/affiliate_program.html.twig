{% if show|default(false) %}
    <a href="{{ path('_profile_affiliate', {source: 'dashboard'}) }}" class="flex items-center gap-3 rounded-lg border border-line-light bg-surface px-4 py-3 shadow-sm transition-colors hover:bg-surface-hover">
        <span class="flex size-9 shrink-0 items-center justify-center rounded-md bg-accent-light text-accent-dark">
            {{ ux_icon('tabler:gift', {class: 'size-5', 'aria-hidden': 'true'}) }}
        </span>
        <span class="min-w-0 flex-1">
            <span class="block font-medium text-fg">{{ 'affiliate.card.title'|trans }}</span>
            <span class="block text-sm text-fg-muted">{{ 'affiliate.card.text'|trans({'%earnings%': yearlyEarnings}) }}</span>
        </span>
        {{ ux_icon('tabler:chevron-right', {class: 'size-4 text-fg-muted', 'aria-hidden': 'true'}) }}
    </a>

    {% if showPrompt %}
        {#
         # Shown by the controller once it has checked no dialog is already open; closing it in any
         # way dismisses it for good. It is rendered `hidden`, so nothing flashes before that check.
         # The pitch is inline rather than <twig:AffiliatePitch>: that component is Tabler markup,
         # still used by the Tabler "Refer & earn" page.
         #}
        <div
            hidden
            role="dialog"
            aria-labelledby="affiliate-prompt-title"
            class="fixed bottom-4 right-4 z-50 w-[calc(100vw-2rem)] max-w-sm rounded-lg border border-line bg-surface shadow-lg"
            {{ stimulus_controller('affiliate-prompt', {
                dismissUrl: path('_affiliate_prompt_dismiss'),
                token: csrf_token(constant('SolidInvoice\\UserBundle\\Action\\Affiliate\\DismissPrompt::CSRF_TOKEN_ID')),
            }) }}
        >
            <div class="flex items-center gap-2 border-b border-line-light px-4 py-3">
                <span class="flex size-7 shrink-0 items-center justify-center rounded-md bg-primary-light text-primary-dark">
                    {{ ux_icon('tabler:gift', {class: 'size-4', 'aria-hidden': 'true'}) }}
                </span>
                <strong id="affiliate-prompt-title" class="flex-1 text-base font-semibold text-fg">{{ 'affiliate.pitch.title'|trans({'%earnings%': yearlyEarnings}) }}</strong>
                <button type="button" class="inline-flex size-8 items-center justify-center rounded-md text-fg-muted hover:bg-surface-hover hover:text-fg" data-action="affiliate-prompt#close" aria-label="{{ 'action.close'|trans }}">
                    {{ ux_icon('tabler:x', {class: 'size-4', 'aria-hidden': 'true'}) }}
                </button>
            </div>
            <div class="space-y-3 p-4 text-sm">
                <p class="text-fg-secondary">{{ 'affiliate.pitch.lead'|trans({'%commission%': affiliate_program().commission}) }}</p>
                <ol class="space-y-2 text-fg">
                    <li class="flex items-center gap-2">{{ ux_icon('tabler:user-plus', {class: 'size-4 shrink-0 text-primary', 'aria-hidden': 'true'}) }} {{ 'affiliate.pitch.steps.join'|trans }}</li>
                    <li class="flex items-center gap-2">{{ ux_icon('tabler:link', {class: 'size-4 shrink-0 text-primary', 'aria-hidden': 'true'}) }} {{ 'affiliate.pitch.steps.share'|trans }}</li>
                    <li class="flex items-center gap-2">{{ ux_icon('tabler:coins', {class: 'size-4 shrink-0 text-primary', 'aria-hidden': 'true'}) }} {{ 'affiliate.pitch.steps.earn'|trans({'%commission%': affiliate_program().commission}) }}</li>
                </ol>
                <div class="flex items-center justify-between gap-2 pt-1">
                    <twig:Si:Button size="sm" href="{{ path('_affiliate_join', {source: 'banner'}) }}" target="_blank" rel="noopener" data-action="affiliate-prompt#close">
                        {{ 'affiliate.pitch.cta'|trans }}
                        {{ ux_icon('tabler:external-link', {class: 'size-4', 'aria-hidden': 'true'}) }}
                    </twig:Si:Button>
                    <button type="button" class="rounded-md px-2 py-1 text-fg-muted hover:text-fg" data-action="affiliate-prompt#close">{{ 'affiliate.prompt.not_now'|trans }}</button>
                </div>
            </div>
        </div>
    {% endif %}
{% endif %}
