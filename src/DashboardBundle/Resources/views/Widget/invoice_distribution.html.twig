<twig:Si:Card title="{{ 'dashboard.charts.distribution_title'|trans }}">
    <div class="relative h-64 p-4">
        {% if hasError %}
            {% include '@SolidInvoiceDashboard/Widget/_error_state.html.twig' %}
        {% elseif not hasData %}
            <div class="flex h-full flex-col items-center justify-center gap-3 text-center">
                {{ ux_icon('tabler:chart-donut', {class: 'size-10 text-ink-300', 'aria-hidden': 'true'}) }}
                <p class="font-medium text-fg-secondary">{{ 'dashboard.charts.no_invoices'|trans }}</p>
                <twig:Si:Button size="sm" href="{{ path('_invoices_create') }}">
                    {{ ux_icon('tabler:plus', {class: 'size-4', 'aria-hidden': 'true'}) }}
                    {{ 'dashboard.actions.create_invoice'|trans }}
                </twig:Si:Button>
            </div>
        {% else %}
            <div class="pointer-events-none absolute inset-0 flex flex-col items-center justify-center">
                <span class="tabular text-2xl font-semibold text-fg">{{ total }}</span>
                <span class="text-sm text-fg-muted">{{ 'dashboard.charts.invoices'|trans }}</span>
            </div>
            {{ render_chart(chart, {'class': 'dashboard-donut-chart'}) }}
        {% endif %}
    </div>
</twig:Si:Card>
