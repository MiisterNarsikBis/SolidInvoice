{#
 # Section badge + truncation notice for the Attention Required widget.
 #
 # These live in their own file because the default slot of a component compiles as its own
 # template, so `{% import _self %}` from inside the slot resolves to the slot, which has no
 # macros. Importing a real template by path is the only form that survives the slot boundary.
 #}

{#
 # The badge renders the uncapped total from the widget, and says "5 of 12" with a way out
 # whenever the list is shorter than the truth (twelve overdue invoices must not display as
 # "5"). `total` is null when the widget cannot count honestly (upcoming recurring), in which
 # case the badge falls back to the shown count and no notice is rendered - an unknown total
 # is never invented.
 #}
{% macro sectionBadge(items, total, tone) %}
    {%- set tones = {
        danger: 'bg-danger-light text-danger-dark',
        warning: 'bg-warning-light text-warning-dark',
        info: 'bg-info-light text-info-dark',
        primary: 'bg-primary-light text-primary-dark',
    } -%}
    <span class="inline-flex min-w-5 justify-center rounded-full px-1.5 text-xs font-semibold {{ tones[tone] }}">{{ total ?? items|length }}</span>
{% endmacro %}

{% macro truncationNotice(items, total, route) %}
    {% if total is not null and total > items|length %}
        <div class="flex items-center justify-between gap-2 px-5 py-2">
            <span class="text-sm text-fg-muted">{{ 'dashboard.attention.showing'|trans({'%shown%': items|length, '%total%': total}) }}</span>
            <a href="{{ path(route) }}" class="inline-flex items-center gap-1 rounded-md px-2 py-1 text-sm font-medium text-primary hover:bg-primary-lighter hover:text-primary-dark">
                {{ 'dashboard.attention.view_all'|trans }}
                {{ ux_icon('tabler:arrow-right', {class: 'size-3.5', 'aria-hidden': 'true'}) }}
            </a>
        </div>
    {% endif %}
{% endmacro %}
