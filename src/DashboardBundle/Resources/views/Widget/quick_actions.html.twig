<twig:Si:Card title="{{ 'dashboard.actions.title'|trans }}">
    <div class="grid grid-cols-2 gap-3 p-4">
        {# Every tile is the same neutral weight: four equal doors, no colour hierarchy. #}
        {% set tile = 'flex flex-col items-center gap-2 rounded-lg border border-line px-3 py-4 text-center text-sm font-medium text-fg-secondary transition-colors hover:border-primary-light hover:bg-primary-lighter hover:text-primary-dark' %}

        <a href="{{ path('_invoices_create') }}" class="{{ tile }}">
            {{ ux_icon('tabler:file-plus', {class: 'size-6 text-primary', 'aria-hidden': 'true'}) }}
            {{ 'dashboard.actions.create_invoice'|trans }}
        </a>
        <a href="{{ path('_quotes_create') }}" class="{{ tile }}">
            {{ ux_icon('tabler:file-description', {class: 'size-6 text-primary', 'aria-hidden': 'true'}) }}
            {{ 'dashboard.actions.create_quote'|trans }}
        </a>
        <a href="{{ path('_clients_add') }}" class="{{ tile }}">
            {{ ux_icon('tabler:user-plus', {class: 'size-6 text-primary', 'aria-hidden': 'true'}) }}
            {{ 'dashboard.actions.add_client'|trans }}
        </a>
        <a href="{{ path('_payments_index') }}" class="{{ tile }}">
            {{ ux_icon('tabler:cash', {class: 'size-6 text-primary', 'aria-hidden': 'true'}) }}
            {{ 'dashboard.actions.view_payments'|trans }}
        </a>
    </div>
</twig:Si:Card>
