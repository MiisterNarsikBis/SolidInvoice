{#
 # `show: false` means dismissed or not applicable - render nothing at all.
 #
 # `error` is checked before anything reads `progress`, because on the failure branch the widget
 # returns `['show' => true, 'error' => true]` and `progress` is simply absent. A guard that
 # tested `progress is not null` would silently swallow a failed query into "nothing to show".
 #
 # The checklist panel and the dismiss confirmation are native <dialog> elements driven by the
 # `si-dialog` Stimulus controller (Bootstrap's offcanvas and modal need CSS the Tailwind shell
 # does not load).
 #}
{% if show|default(false) %}
    {% if error|default(false) %}
        <twig:Si:Card class="p-4">
            {% include '@SolidInvoiceDashboard/Widget/_error_state.html.twig' %}
        </twig:Si:Card>
    {% elseif progress.allComplete %}
        <twig:Si:Card class="flex items-start gap-4 border-success/40 p-5">
            <span class="flex size-12 shrink-0 items-center justify-center rounded-full bg-success-light text-success-dark">
                {{ ux_icon('tabler:trophy', {class: 'size-6', 'aria-hidden': 'true'}) }}
            </span>
            <div class="flex-1">
                <h2 class="text-lg font-semibold text-fg">{{ 'dashboard.checklist.success_title'|trans }}</h2>
                <p class="mt-0.5 text-fg-secondary">{{ 'dashboard.checklist.success_message'|trans }}</p>

                <form method="post" action="{{ path('_dashboard_onboarding_dismiss') }}" class="mt-3">
                    <input type="hidden" name="_token" value="{{ csrf_token('dismiss_checklist') }}">
                    <button type="submit" class="text-sm text-fg-muted hover:text-fg hover:underline">{{ 'dashboard.checklist.dismiss'|trans }}</button>
                </form>
            </div>
        </twig:Si:Card>
    {% else %}
        <div data-controller="si-dialog">
            {# In-progress banner: one big button that opens the checklist panel. #}
            <button
                type="button"
                class="block w-full rounded-lg border border-line-light bg-surface p-5 text-left shadow-sm transition-colors hover:bg-surface-hover"
                data-action="si-dialog#open"
                aria-haspopup="dialog"
                aria-label="{{ 'dashboard.checklist.view_progress'|trans }}"
            >
                <span class="flex items-start gap-4">
                    <span class="flex size-12 shrink-0 items-center justify-center rounded-full bg-primary-light text-primary-dark">
                        {{ ux_icon('tabler:rocket', {class: 'size-6', 'aria-hidden': 'true'}) }}
                    </span>
                    <span class="flex-1">
                        <span class="block text-lg font-semibold text-fg">{{ 'dashboard.checklist.banner_title'|trans }}</span>
                        <span class="mt-0.5 block text-fg-secondary">{{ 'dashboard.checklist.tasks_remaining'|trans({'%count%': progress.total - progress.completed}) }}</span>
                        <span class="mt-0.5 block text-sm text-fg-muted">{{ 'dashboard.checklist.banner_description'|trans }}</span>
                    </span>
                </span>

                <span class="mt-4 flex items-center gap-3">
                    <span class="h-2 flex-1 overflow-hidden rounded-full bg-ink-100" role="progressbar" aria-valuenow="{{ progress.percentage }}" aria-valuemin="0" aria-valuemax="100">
                        <span class="block h-full rounded-full bg-primary" style="width: {{ progress.percentage }}%"></span>
                        <span class="sr-only">{{ 'dashboard.checklist.percent_complete'|trans({'%percentage%': progress.percentage}) }}</span>
                    </span>
                    <span class="tabular w-10 text-right text-sm font-semibold text-fg-secondary">{{ progress.percentage }}%</span>
                </span>

                <span class="mt-3 inline-flex items-center gap-1 font-medium text-primary">
                    {{ 'dashboard.checklist.view_checklist'|trans }}
                    {{ ux_icon('tabler:arrow-right', {class: 'size-4', 'aria-hidden': 'true'}) }}
                </span>
            </button>

            {# The checklist panel: a native dialog docked to the right edge. #}
            <dialog
                data-si-dialog-target="dialog"
                data-action="click->si-dialog#closeOnBackdrop"
                aria-labelledby="onboarding-title"
                class="m-0 ml-auto h-dvh max-h-none w-full max-w-md bg-surface p-0 text-fg shadow-lg backdrop:bg-ink-900/55 open:flex open:flex-col"
            >
                <div class="flex items-center gap-3 border-b border-line px-5 py-4">
                    <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-primary text-white">
                        {{ ux_icon('tabler:rocket', {class: 'size-5', 'aria-hidden': 'true'}) }}
                    </span>
                    <div class="min-w-0 flex-1">
                        <h2 id="onboarding-title" class="text-lg font-semibold text-fg">{{ 'dashboard.checklist.title'|trans }}</h2>
                        <p class="text-sm text-fg-muted">{{ 'dashboard.checklist.subtitle'|trans({'%completed%': progress.completed, '%total%': progress.total}) }}</p>
                    </div>
                    <button type="button" class="inline-flex size-9 items-center justify-center rounded-md text-fg-muted hover:bg-surface-hover hover:text-fg" data-action="si-dialog#close" aria-label="{{ 'action.close'|trans }}">
                        {{ ux_icon('tabler:x', {class: 'size-5', 'aria-hidden': 'true'}) }}
                    </button>
                </div>

                <div class="flex-1 space-y-5 overflow-y-auto p-5">
                    <div class="rounded-lg border border-line-light p-4">
                        <div class="mb-3 grid grid-cols-2 text-center">
                            <div>
                                <div class="tabular text-3xl font-semibold text-primary">{{ progress.completed }}</div>
                                <div class="text-xs font-semibold uppercase tracking-wide text-primary-dark">{{ 'dashboard.checklist.completed'|trans }}</div>
                            </div>
                            <div>
                                <div class="tabular text-3xl font-semibold text-fg-secondary">{{ progress.total - progress.completed }}</div>
                                <div class="text-xs font-semibold uppercase tracking-wide text-fg-secondary">{{ 'dashboard.checklist.remaining'|trans }}</div>
                            </div>
                        </div>
                        <div class="h-2 overflow-hidden rounded-full bg-ink-100" role="progressbar" aria-valuenow="{{ progress.percentage }}" aria-valuemin="0" aria-valuemax="100">
                            <div class="h-full rounded-full bg-primary" style="width: {{ progress.percentage }}%"></div>
                        </div>
                    </div>

                    <div>
                        <h3 class="mb-2 text-xs font-semibold uppercase tracking-wide text-fg-muted">{{ 'dashboard.checklist.items_title'|trans }}</h3>
                        <ul class="space-y-2">
                            {#
                             # A completed row is a <span>, not an <a>. It used to be an anchor with
                             # cosmetic `disabled` classes and the href left intact: a screen-reader user
                             # heard a link, activated it, and was navigated away. `disabled` does not
                             # exist on anchors; the fix is to not emit an anchor.
                             #
                             # Done-ness was signalled by an icon swap and a tint, and the icon is
                             # aria-hidden, so the visually-hidden status text below is the only thing
                             # that tells a screen reader which row is which.
                             #}
                            {% for item in progress.items %}
                                {% set tag = item.completed ? 'span' : 'a' %}
                                <li>
                                    <{{ tag }}
                                        class="flex items-start gap-3 rounded-lg border p-3 {{ item.completed ? 'border-line-light bg-canvas' : 'border-line transition-colors hover:border-primary-light hover:bg-primary-lighter' }}"
                                        {% if not item.completed %}href="{{ path(item.route) }}"{% endif %}
                                    >
                                        <span class="mt-0.5 shrink-0 {{ item.completed ? 'text-success' : 'text-ink-300' }}" aria-hidden="true">
                                            {% if item.completed %}
                                                {{ ux_icon('tabler:circle-check-filled', {class: 'size-5'}) }}
                                            {% else %}
                                                {{ ux_icon('tabler:circle', {class: 'size-5'}) }}
                                            {% endif %}
                                        </span>
                                        <span class="min-w-0 flex-1">
                                            <span class="flex items-center gap-2 font-medium {{ item.completed ? 'text-fg-muted line-through' : 'text-fg' }}">
                                                <span class="text-fg-muted" aria-hidden="true">{{ ux_icon(item.icon, {class: 'size-4'}) }}</span>
                                                {{ item.name|trans }}
                                                <span class="sr-only">{{ (item.completed ? 'dashboard.checklist.status.completed' : 'dashboard.checklist.status.not_started')|trans }}</span>
                                            </span>
                                            <span class="mt-0.5 block text-sm text-fg-muted">{{ item.description|trans }}</span>
                                        </span>
                                        {# No arrow on a completed row: there is nowhere for it to point. #}
                                        {% if not item.completed %}
                                            <span class="mt-0.5 shrink-0 text-fg-muted" aria-hidden="true">{{ ux_icon('tabler:arrow-right', {class: 'size-4'}) }}</span>
                                        {% endif %}
                                    </{{ tag }}>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>

                {# Dismiss: a second dialog, nested so it stacks on the panel. #}
                <div class="border-t border-line p-4" data-controller="si-dialog">
                    <twig:Si:Button variant="outline" size="sm" class="w-full" data-action="si-dialog#open" aria-haspopup="dialog">
                        {{ ux_icon('tabler:x', {class: 'size-4', 'aria-hidden': 'true'}) }}
                        {{ 'dashboard.checklist.dismiss'|trans }}
                    </twig:Si:Button>

                    <dialog
                        data-si-dialog-target="dialog"
                        data-action="click->si-dialog#closeOnBackdrop"
                        aria-labelledby="dismiss-checklist-title"
                        class="m-auto w-full max-w-sm rounded-xl bg-surface p-0 text-fg shadow-lg backdrop:bg-ink-900/55"
                    >
                        {#
                         # ChecklistManager::dismiss() writes 'true' and nothing un-writes it, so this
                         # is one-way. The confirmation copy says so in words ("hides the checklist
                         # permanently"). The missing undo is a product gap; no undo route is invented.
                         # The confirm button is `outline`, not `danger`: dismissing an encouraging
                         # checklist destroys nothing, and danger red is reserved for destructive acts.
                         #}
                        <form method="post" action="{{ path('_dashboard_onboarding_dismiss') }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('dismiss_checklist') }}">
                            <div class="space-y-1 p-5">
                                <h2 id="dismiss-checklist-title" class="text-lg font-semibold text-fg">{{ 'dashboard.checklist.dismiss_confirm_title'|trans }}</h2>
                                <p class="text-fg-secondary">{{ 'dashboard.checklist.dismiss_confirm'|trans }}</p>
                            </div>
                            <div class="flex justify-end gap-2 border-t border-line-light px-5 py-3">
                                <twig:Si:Button variant="ghost" data-action="si-dialog#close">{{ 'action.cancel'|trans }}</twig:Si:Button>
                                <twig:Si:Button variant="outline" type="submit">{{ 'dashboard.checklist.dismiss'|trans }}</twig:Si:Button>
                            </div>
                        </form>
                    </dialog>
                </div>
            </dialog>
        </div>
    {% endif %}
{% endif %}
