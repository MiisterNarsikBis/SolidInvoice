{# Migrated to the Tailwind shell (see Layout/shell.html.twig). #}
{% extends '@SolidInvoiceCore/Layout/shell.html.twig' %}

{% block page_title %}{{ 'dashboard.title'|trans }}{% endblock %}

{% block content %}
    <div class="space-y-4">
        {{ render_dashboard_widget('top') }}

        <div class="grid gap-4 lg:grid-cols-3">
            <div class="space-y-4 lg:col-span-2">
                {{ render_dashboard_widget('left_column') }}
            </div>
            <div class="space-y-4">
                {{ render_dashboard_widget('right_column') }}
            </div>
        </div>
    </div>
{% endblock content %}
