{#
 # Why Send is disabled for an unverified user, and how to fix it. The resend button submits
 # resend_form() by id, because the invoice editor's actions sit inside its own <form> and forms
 # cannot nest — render resend_form() once on the page, outside any other form.
 #}
{% macro hint(message = 'invoice.send.verify_hint') %}
    <span class="inline-flex flex-wrap items-center gap-1.5 text-sm text-fg-secondary" id="send-gated-hint">
        {{ ux_icon('tabler:mail-exclamation', {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
        {{ message|trans }}
        <button type="submit" form="resend-verification-email" class="text-primary hover:underline">{{ 'invoice.send.resend_link'|trans }}</button>
    </span>
{% endmacro %}

{% macro resend_form() %}
    <form method="post" action="{{ path('_solidworx_platform_verify_email_resend') }}" id="resend-verification-email" class="hidden">
        <input type="hidden" name="_token" value="{{ csrf_token('resend_verification_email') }}">
    </form>
{% endmacro %}

{# Sends the saved invoice to the user's own inbox, and the email confirms their address. #}
{% macro test_copy(invoice) %}
    <form method="post" action="{{ path('_invoices_send_test_copy', {'id': invoice.id}) }}" class="inline">
        <input type="hidden" name="_token" value="{{ csrf_token('send_test_copy') }}">
        <button type="submit" class="si-btn si-btn--outline si-btn--md">
            {{ ux_icon('tabler:mail-forward', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
            {{ 'invoice.test_copy.button'|trans }}
        </button>
    </form>
{% endmacro %}
