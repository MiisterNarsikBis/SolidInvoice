{% extends "@SolidInvoiceCore/Layout/shell.html.twig" %}

{% block page_title %}{{ (recurring ? "invoice.list.recurring_title" : "invoice.list.title")|trans }}{% endblock page_title %}

{% block page_title_actions %}
    {% if recurring %}
        <twig:Si:Button href="{{ path("_invoices_create_recurring") }}">
            {{ ux_icon('tabler:plus', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
            {{ "invoice.action.create_recurring"|trans }}
        </twig:Si:Button>
    {% else %}
        <twig:Si:Button href="{{ path("_invoices_create") }}">
            {{ ux_icon('tabler:plus', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
            {{ "invoice.action.create"|trans }}
        </twig:Si:Button>
    {% endif %}
{% endblock %}

{% block content %}
    {{ feature_usage_banner('invoices_per_month', invoicesThisMonth) }}

    {% if recurring %}
        <div class="mb-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            <twig:Si:Stat icon="tabler:repeat" label="{{ 'invoice.stats.active_recurring'|trans }}">{{ totalActiveRecurring }}</twig:Si:Stat>
            <twig:Si:Stat icon="tabler:calendar-event" tone="info" label="{{ 'invoice.stats.upcoming_7_days'|trans }}">{{ upcomingIn7Days }}</twig:Si:Stat>
            <twig:Si:Stat icon="tabler:list-check" tone="warning" label="{{ 'invoice.stats.status_breakdown'|trans }}">{{ 'invoice.stats.status_format'|trans({
                '%active%': activeCount,
                '%draft%': draftCount,
                '%paused%': pausedCount
            }) }}</twig:Si:Stat>
            <twig:Si:Stat icon="tabler:file-invoice" tone="success" label="{{ 'invoice.stats.total_generated'|trans }}">{{ totalGeneratedInvoices }}</twig:Si:Stat>
        </div>

        <twig:Si:Card>
            <twig:block name="header">
                <nav class="flex flex-wrap border-b border-line px-2" role="tablist" aria-label="{{ 'invoice.tabs.label'|trans }}">
                    <twig:Si:Tab href="{{ path('_invoices_index_recurring') }}" :active="not isArchived and not isCompleted" icon="tabler:repeat" :count="totalActiveRecurring">{{ 'invoice.tabs.recurring_active'|trans }}</twig:Si:Tab>
                    <twig:Si:Tab href="{{ path('_invoices_index_recurring', {completed: 1}) }}" :active="isCompleted" icon="tabler:check" :count="completeCount">{{ 'invoice.tabs.recurring_completed'|trans }}</twig:Si:Tab>
                    <twig:Si:Tab href="{{ path('_invoices_index_recurring', {archived: 1}) }}" :active="isArchived" icon="tabler:archive" :count="totalArchivedRecurring">{{ 'invoice.tabs.recurring_archived'|trans }}</twig:Si:Tab>
                </nav>
            </twig:block>

            {% if isArchived %}
                <twig:DataGrid name="archived_recurring_invoice_grid" />
            {% elseif isCompleted %}
                <twig:DataGrid name="completed_recurring_invoice_grid" />
            {% else %}
                <twig:DataGrid name="recurring_invoice_grid" />
            {% endif %}
        </twig:Si:Card>
    {% else %}
        <div class="mb-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            <twig:Si:Stat icon="tabler:file-invoice" label="{{ 'invoice.stats.total_invoices'|trans }}">{{ totalActiveInvoices }}</twig:Si:Stat>
            <twig:Si:Stat icon="tabler:clock" tone="warning" label="{{ 'invoice.stats.pending_invoices'|trans }}">
                {{ pendingCount }}
                {% if overdueCount > 0 %}
                    <span class="ml-1 text-base font-medium text-danger-dark">({{ overdueCount }} {{ 'invoice.stats.overdue'|trans }})</span>
                {% endif %}
            </twig:Si:Stat>
            <twig:Si:Stat icon="tabler:cash" tone="success" label="{{ 'invoice.stats.total_income'|trans }}">
                {% for currency, amount in total_income %}
                    <div>{{ amount|formatCurrency(currency) }}</div>
                {% else %}
                    {{ 0|formatCurrency }}
                {% endfor %}
            </twig:Si:Stat>
            <twig:Si:Stat icon="tabler:currency-dollar" tone="danger" label="{{ 'invoice.stats.outstanding_balance'|trans }}">
                {% for currency, amount in total_outstanding %}
                    <div>{{ amount|formatCurrency(currency) }}</div>
                {% else %}
                    {{ 0|formatCurrency }}
                {% endfor %}
            </twig:Si:Stat>
        </div>

        <twig:Si:Card>
            <twig:block name="header">
                <nav class="flex flex-wrap border-b border-line px-2" role="tablist" aria-label="{{ 'invoice.tabs.label'|trans }}">
                    <twig:Si:Tab href="{{ path('_invoices_index') }}" :active="not isArchived" icon="tabler:file-invoice" :count="totalActiveInvoices">{{ 'invoice.tabs.active'|trans }}</twig:Si:Tab>
                    <twig:Si:Tab href="{{ path('_invoices_index', {archived: 1}) }}" :active="isArchived" icon="tabler:archive" :count="totalArchivedInvoices">{{ 'invoice.tabs.archived'|trans }}</twig:Si:Tab>
                </nav>
            </twig:block>

            {% if isArchived %}
                <twig:DataGrid name="archived_invoice_grid" />
            {% else %}
                <twig:DataGrid name="invoice_grid" />
            {% endif %}
        </twig:Si:Card>
    {% endif %}
{% endblock content %}
