{% extends "@SolidInvoiceCore/Layout/shell.html.twig" %}

{% block page_title %}{{ 'invoice.list.recurring_title'|trans }} - {{ invoice.client }}{% endblock page_title %}

{% block page_title_actions %}
    {% set Status = enum('SolidInvoice\\InvoiceBundle\\Enum\\RecurringInvoiceStatus') %}

    <button type="button" onclick="window.print()" class="si-btn si-btn--ghost si-btn--md" title="{{ 'invoice.action.print'|trans }}" aria-label="{{ 'invoice.action.print'|trans }}">
        {{ ux_icon('tabler:printer', {class: 'size-5', 'aria-hidden': 'true'}) }}
    </button>

    <twig:Si:Dropdown label="{{ 'invoice.view.toolbar.more_actions'|trans }}" triggerClass="si-btn si-btn--ghost si-btn--md">
        <twig:block name="trigger">{{ ux_icon('tabler:dots-vertical', {class: 'size-5', 'aria-hidden': 'true'}) }}</twig:block>
        <twig:Si:MenuItem href="{{ path('_invoices_clone_recurring', {'id' : invoice.id}) }}" icon="tabler:copy">{{ "invoice.view.toolbar.clone"|trans }}</twig:Si:MenuItem>

        {% if workflow_can(invoice, 'edit') %}
            <twig:Si:MenuItem href="{{ path('_invoices_edit_recurring', {'id' : invoice.id}) }}" icon="tabler:pencil">{{ "invoice.view.toolbar.edit"|trans }}</twig:Si:MenuItem>
        {% endif %}

        {% if invoice.status == Status.Active %}
            <div class="my-1 h-px bg-line-light" role="separator"></div>
            <twig:Si:MenuItem href="{{ path('_action_recurring_invoice', {'action' : 'pause', 'id' : invoice.id}) }}" icon="tabler:player-pause">{{ "invoice.recurring.pause"|trans }}</twig:Si:MenuItem>
        {% endif %}

        {% if invoice.status == Status.Paused %}
            <div class="my-1 h-px bg-line-light" role="separator"></div>
            <twig:Si:MenuItem href="{{ path('_action_recurring_invoice', {'action' : 'resume', 'id' : invoice.id}) }}" icon="tabler:player-play">{{ "invoice.recurring.resume"|trans }}</twig:Si:MenuItem>
        {% endif %}

        {% if workflow_can(invoice, 'archive') %}
            <div class="my-1 h-px bg-line-light" role="separator"></div>
            <twig:Si:MenuItem href="{{ path('_action_recurring_invoice', {'action' : 'archive', 'id' : invoice.id}) }}" icon="tabler:archive">{{ "invoice.view.toolbar.archive"|trans }}</twig:Si:MenuItem>
        {% endif %}

        {% if workflow_can(invoice, 'cancel') %}
            <div class="my-1 h-px bg-line-light" role="separator"></div>
            <twig:Si:MenuItem href="{{ path('_action_recurring_invoice', {'action' : 'cancel', 'id' : invoice.id}) }}" icon="tabler:x" class="text-danger-dark">{{ "invoice.view.toolbar.cancel"|trans }}</twig:Si:MenuItem>
        {% endif %}
    </twig:Si:Dropdown>

    {% if workflow_can(invoice, 'activate') %}
        <a href="{{ path('_action_recurring_invoice', {'action' : 'activate', 'id' : invoice.id}) }}" class="si-btn si-btn--md bg-success text-white hover:bg-success-dark">
            {{ ux_icon('tabler:check', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
            {{ "invoice.recurring.activate"|trans }}
        </a>
    {% elseif invoice.status == Status.Paused %}
        <a href="{{ path('_action_recurring_invoice', {'action' : 'resume', 'id' : invoice.id}) }}" class="si-btn si-btn--md bg-success text-white hover:bg-success-dark">
            {{ ux_icon('tabler:player-play', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
            {{ "invoice.recurring.resume"|trans }}
        </a>
    {% endif %}
{% endblock page_title_actions %}

{% block content %}
    {% set currency = invoice.currency %}
    {% set Status = enum('SolidInvoice\\InvoiceBundle\\Enum\\RecurringInvoiceStatus') %}

    <div class="-mt-2 mb-5 flex flex-wrap items-center gap-x-4 gap-y-1 text-fg-secondary print:hidden">
        {{ invoice_label(invoice.status) }}
        <span class="inline-flex items-center gap-1.5">
            {{ ux_icon('tabler:building', {class: 'size-3.5', 'aria-hidden': 'true'}) }}
            {{ invoice.client }}
        </span>
        {% if invoice.recurringOptions %}
            <span class="inline-flex items-center gap-1.5">
                {{ ux_icon('tabler:calendar-repeat', {class: 'size-3.5', 'aria-hidden': 'true'}) }}
                {{ recurring_frequency(invoice.recurringOptions) }}
            </span>
        {% endif %}
    </div>

    <div class="grid items-start gap-6 xl:grid-cols-[minmax(0,1fr)_20rem]">
        <div class="min-w-0">
            {% include '@SolidInvoiceCore/Billing/_document.html.twig' with {
                doc: invoice,
                type: 'invoice',
                currency: currency,
                target: enum('SolidInvoice\\CoreBundle\\Enum\\CustomFieldTarget').INVOICE,
            } only %}
        </div>

        {# Sidebar #}
        <div class="space-y-4 print:hidden">
            <twig:Si:Card title="{{ 'invoice.client.title'|trans }}" icon="tabler:building" iconColor="primary" :padded="true">
                <a href="{{ path('_clients_view', {'id': invoice.client.id}) }}" class="font-semibold text-primary hover:underline">{{ invoice.client }}</a>

                {% if invoice.users|length > 0 %}
                    <ul class="mt-3 space-y-2">
                        {% for user in invoice.users %}
                            <li class="text-sm">
                                <div class="text-fg">{{ user }}</div>
                                <div class="flex items-center gap-1 text-fg-muted">
                                    {{ ux_icon('tabler:mail', {class: 'size-3', 'aria-hidden': 'true'}) }}
                                    {{ user.email }}
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </twig:Si:Card>

            {% if invoice.recurringOptions %}
                <twig:Si:Card title="{{ 'invoice.recurring.schedule.title'|trans }}" icon="tabler:repeat" iconColor="primary" status="primary" :padded="true">
                    <dl class="space-y-3 text-sm">
                        <div class="flex justify-between gap-3">
                            <dt class="text-fg-secondary">{{ 'invoice.recurring.frequency'|trans }}</dt>
                            <dd class="text-right text-fg">{{ recurring_frequency(invoice.recurringOptions, false) }}</dd>
                        </div>
                        <div class="flex justify-between gap-3">
                            <dt class="text-fg-secondary">{{ 'invoice.recurring.start_date'|trans }}</dt>
                            <dd class="text-fg">{{ invoice.dateStart|date('M d, Y') }}</dd>
                        </div>
                        {% set endDate = recurring_end_date(invoice.recurringOptions) %}
                        {% if endDate %}
                            <div class="flex justify-between gap-3">
                                <dt class="text-fg-secondary">{{ 'invoice.recurring.end_date'|trans }}</dt>
                                <dd class="text-fg">{{ endDate|date('M d, Y') }}</dd>
                            </div>
                        {% endif %}
                    </dl>
                </twig:Si:Card>
            {% endif %}

            {% if invoice.status == Status.Active and nextOccurrences is defined and nextOccurrences|length > 0 %}
                <twig:Si:Card title="{{ 'invoice.recurring.upcoming'|trans }}" icon="tabler:calendar-event" iconColor="primary" :padded="true">
                    <ul class="space-y-2 text-sm text-fg-secondary">
                        {% for occurrence in nextOccurrences %}
                            <li class="flex items-center gap-2">
                                {{ ux_icon('tabler:calendar', {class: 'size-3.5 text-fg-muted', 'aria-hidden': 'true'}) }}
                                {{ occurrence|date('l, M d, Y') }}
                            </li>
                        {% endfor %}
                    </ul>
                </twig:Si:Card>
            {% endif %}

            {% if generatedInvoices is defined and generatedInvoices|length > 0 %}
                <twig:Si:Card title="{{ 'invoice.recurring.generated'|trans }}" icon="tabler:file-invoice" iconColor="primary" :padded="true">
                    <twig:block name="actions"><twig:Si:Badge tone="primary">{{ totalGenerated }}</twig:Si:Badge></twig:block>
                    <ul class="divide-y divide-line-light">
                        {% for generatedInvoice in generatedInvoices %}
                            <li class="flex items-center justify-between gap-3 py-2 first:pt-0 last:pb-0">
                                <a href="{{ path('_invoices_view', {id: generatedInvoice.id}) }}" class="inline-flex items-center gap-1.5 font-medium text-primary hover:underline">
                                    {{ ux_icon('tabler:file-invoice', {class: 'size-3.5', 'aria-hidden': 'true'}) }}
                                    {{ generatedInvoice.invoiceId }}
                                </a>
                                <span class="flex items-center gap-2 text-sm">
                                    <span class="tabular text-fg-secondary">{{ generatedInvoice.total|formatCurrency(generatedInvoice.currency) }}</span>
                                    {{ invoice_label(generatedInvoice.status) }}
                                </span>
                            </li>
                        {% endfor %}
                    </ul>
                    {% if totalGenerated > 5 %}
                        <p class="mt-3 text-sm">
                            <a href="{{ path('_invoices_index') }}?filter[recurringInvoice]={{ invoice.id }}" class="text-fg-muted hover:text-primary hover:underline">{{ 'invoice.recurring.view_all'|trans({'%count%': totalGenerated}) }}</a>
                        </p>
                    {% endif %}
                </twig:Si:Card>
            {% endif %}

            <twig:Si:Card title="{{ 'invoice.summary'|trans }}" icon="tabler:receipt" iconColor="primary" :padded="true">
                <dl class="space-y-3 text-sm">
                    <div class="flex items-center justify-between gap-3">
                        <dt class="text-fg-secondary">{{ 'invoice.status'|trans }}</dt>
                        <dd>{{ invoice_label(invoice.status) }}</dd>
                    </div>
                    <div class="flex items-center justify-between gap-3">
                        <dt class="text-fg-secondary">{{ 'invoice.total'|trans }}</dt>
                        <dd class="tabular text-base font-semibold text-fg">{{ invoice.total|formatCurrency(currency) }}</dd>
                    </div>
                    <div class="flex items-center justify-between gap-3">
                        <dt class="text-fg-secondary">{{ 'invoice.recurring.start_date'|trans }}</dt>
                        <dd class="text-fg">{{ invoice.dateStart|date('M d, Y') }}</dd>
                    </div>
                    {% if invoice.dateEnd %}
                        <div class="flex items-center justify-between gap-3">
                            <dt class="text-fg-secondary">{{ 'invoice.recurring.end_date'|trans }}</dt>
                            <dd class="text-fg">{{ invoice.dateEnd|date('M d, Y') }}</dd>
                        </div>
                    {% endif %}
                    <div class="flex items-center justify-between gap-3">
                        <dt class="text-fg-secondary">{{ 'invoice.recurring.total_generated'|trans }}</dt>
                        <dd class="text-fg">{{ totalGenerated|default(0) }}</dd>
                    </div>
                </dl>
            </twig:Si:Card>
        </div>
    </div>
{% endblock content %}
