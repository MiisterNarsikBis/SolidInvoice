{% extends "@SolidInvoiceCore/Layout/shell.html.twig" %}

{% block page_title %}{{ "invoice.title"|trans({"%id%" : invoice.invoiceId}) }}{% endblock page_title %}

{% block page_title_actions %}
    {% import '@SolidInvoiceInvoice/Default/_send_gate.html.twig' as send_gate %}
    {% set gated = is_email_verification_gated() %}
    {% set InvoiceStatus = enum('SolidInvoice\\InvoiceBundle\\Enum\\InvoiceStatus') %}
    {% set overdue = invoice.status == InvoiceStatus.Overdue %}

    {# Always available #}
    <button type="button" onclick="window.print()" class="si-btn si-btn--ghost si-btn--md" title="{{ 'invoice.action.print'|trans }}" aria-label="{{ 'invoice.action.print'|trans }}">
        {{ ux_icon('tabler:printer', {class: 'size-5', 'aria-hidden': 'true'}) }}
    </button>
    {# The public page 404s while the company is unverified, and the archivable filter hides archived invoices from it, so only offer a link that works. #}
    {% if not gated and invoice.status not in [InvoiceStatus.Draft, InvoiceStatus.Archived] %}
        <span {{ stimulus_controller('clipboard', {'success-content': 'invoice.view.toolbar.link_copied'|trans}) }}>
            <input type="hidden" value="{{ url('_view_invoice_external', {'uuid': invoice.uuid}) }}" {{ stimulus_target('clipboard', 'source') }}>
            <button type="button" class="si-btn si-btn--ghost si-btn--md" {{ stimulus_target('clipboard', 'button') }} {{ stimulus_action('clipboard', 'copy') }}>
                {{ ux_icon('tabler:link', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
                {{ 'invoice.view.toolbar.copy_link'|trans }}
            </button>
        </span>
    {% endif %}
    {% if can_print_pdf() %}
        <a href="{{ path('_invoices_view', {'id': invoice.id, '_format': 'pdf'}) }}" target="_blank" class="si-btn si-btn--ghost si-btn--md" title="{{ 'invoice.action.pdf'|trans }}" aria-label="{{ 'invoice.action.pdf'|trans }}">
            {{ ux_icon('tabler:file-type-pdf', {class: 'size-5', 'aria-hidden': 'true'}) }}
        </a>
    {% endif %}

    <twig:Si:Dropdown label="{{ 'invoice.view.toolbar.more_actions'|trans }}" triggerClass="si-btn si-btn--ghost si-btn--md">
        <twig:block name="trigger">{{ ux_icon('tabler:dots-vertical', {class: 'size-5', 'aria-hidden': 'true'}) }}</twig:block>
        {% if invoice.quote is not null and invoice.quote.valid %}
            <twig:Si:MenuItem href="{{ path('_quotes_view', {'id' : invoice.quote.id}) }}" icon="tabler:file-text">{{ "invoice.view.toolbar.view_quote"|trans }}</twig:Si:MenuItem>
            <div class="my-1 h-px bg-line-light" role="separator"></div>
        {% endif %}

        <twig:Si:MenuItem href="{{ path('_invoices_clone', {'id' : invoice.id}) }}" icon="tabler:copy">{{ "invoice.view.toolbar.clone"|trans }}</twig:Si:MenuItem>

        {% if invoice.status in [InvoiceStatus.Pending, InvoiceStatus.Overdue] and invoice.users|length > 0 %}
            <div class="my-1 h-px bg-line-light" role="separator"></div>
            <a href="#" role="menuitem" class="flex items-center gap-2 rounded-md px-2.5 py-1.5 text-base text-fg-secondary transition-colors hover:bg-surface-hover hover:text-fg" data-si-modal-open="#send-reminder-modal">
                {{ ux_icon('tabler:bell', {class: 'size-4 shrink-0 text-fg-muted', 'aria-hidden': 'true'}) }}
                {{ "invoice.view.toolbar.send_reminder"|trans }}
            </a>
        {% endif %}

        {% if invoice.status == InvoiceStatus.Paid and invoice.users|length > 0 %}
            <div class="my-1 h-px bg-line-light" role="separator"></div>
            {% if gated %}
                <span class="flex items-center gap-2 px-2.5 py-1.5 text-base text-fg-muted" aria-disabled="true" title="{{ email_verification_message('sending this invoice') }}">
                    {{ ux_icon('tabler:send', {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
                    {{ "invoice.view.toolbar.send"|trans }}
                </span>
            {% else %}
                <a href="#" role="menuitem" class="flex items-center gap-2 rounded-md px-2.5 py-1.5 text-base text-fg-secondary transition-colors hover:bg-surface-hover hover:text-fg" data-si-modal-open="#send-paid-invoice-modal">
                    {{ ux_icon('tabler:send', {class: 'size-4 shrink-0 text-fg-muted', 'aria-hidden': 'true'}) }}
                    {{ "invoice.view.toolbar.send"|trans }}
                </a>
            {% endif %}
        {% endif %}

        {% if workflow_can(invoice, 'edit') %}
            <twig:Si:MenuItem href="{{ path('_invoices_edit', {'id' : invoice.id}) }}" icon="tabler:pencil">{{ "invoice.view.toolbar.edit"|trans }}</twig:Si:MenuItem>
        {% endif %}

        {% if workflow_can(invoice, 'reopen') %}
            <twig:Si:MenuItem href="{{ path('_action_invoice', {'action' : 'reopen', 'id' : invoice.id}) }}" icon="tabler:refresh">{{ "invoice.view.toolbar.reopen"|trans }}</twig:Si:MenuItem>
        {% endif %}

        {% if workflow_can(invoice, 'archive') %}
            <div class="my-1 h-px bg-line-light" role="separator"></div>
            <twig:Si:MenuItem href="{{ path('_action_invoice', {'action' : 'archive', 'id' : invoice.id}) }}" icon="tabler:archive">{{ "invoice.view.toolbar.archive"|trans }}</twig:Si:MenuItem>
        {% endif %}

        {% if workflow_can(invoice, 'cancel') %}
            <div class="my-1 h-px bg-line-light" role="separator"></div>
            <twig:Si:MenuItem href="{{ path('_action_invoice', {'action' : 'cancel', 'id' : invoice.id}) }}" icon="tabler:x" class="text-danger-dark">{{ "invoice.view.toolbar.cancel"|trans }}</twig:Si:MenuItem>
        {% endif %}
    </twig:Si:Dropdown>

    {# The main action depends on where the invoice is in its life #}
    {% if workflow_can(invoice, 'pay') %}
        <twig:Si:Button variant="{{ overdue ? 'danger' : 'primary' }}" href="{{ path('_payments_create', {'uuid' : invoice.uuid}) }}">
            {{ ux_icon('tabler:credit-card', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
            {{ "invoice.view.toolbar.pay_now"|trans }}
        </twig:Si:Button>
        {% if gated %}
            {{ send_gate.hint() }}
            {{ send_gate.test_copy(invoice) }}
            <twig:Si:Button type="button" variant="{{ overdue ? 'danger' : 'primary' }}" disabled aria-describedby="send-gated-hint" data-hero-action>
                {{ ux_icon('tabler:send', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
                {{ "invoice.view.toolbar.send"|trans }}
            </twig:Si:Button>
        {% else %}
            <form method="post" action="{{ path('_send_invoice', {'id' : invoice.id}) }}" class="inline">
                <input type="hidden" name="_token" value="{{ csrf_token('send_invoice') }}">
                <twig:Si:Button type="submit" variant="{{ overdue ? 'danger' : 'primary' }}" data-hero-action>
                    {{ ux_icon('tabler:send', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
                    {{ "invoice.view.toolbar.send"|trans }}
                </twig:Si:Button>
            </form>
        {% endif %}
    {% elseif workflow_can(invoice, 'accept') %}
        {% if gated %}
            {{ send_gate.hint() }}
            {{ send_gate.test_copy(invoice) }}
        {% endif %}
        <div class="inline-flex">
            {% if gated %}
                <twig:Si:Button type="button" class="rounded-r-none" disabled aria-describedby="send-gated-hint" data-hero-action>
                    {{ ux_icon('tabler:send', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
                    {{ 'invoice.save.send'|trans }}
                </twig:Si:Button>
            {% else %}
                <form method="post" action="{{ path('_send_invoice', {'id' : invoice.id}) }}" class="inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('send_invoice') }}">
                    <twig:Si:Button type="submit" class="rounded-r-none" data-hero-action>
                        {{ ux_icon('tabler:send', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
                        {{ 'invoice.save.send'|trans }}
                    </twig:Si:Button>
                </form>
            {% endif %}
            <twig:Si:Dropdown label="{{ 'invoice.view.toolbar.toggle_dropdown'|trans }}" triggerClass="si-btn si-btn--primary si-btn--md rounded-l-none border-l border-white/30 px-2">
                <twig:block name="trigger">{{ ux_icon('tabler:chevron-down', {class: 'size-4', 'aria-hidden': 'true'}) }}</twig:block>
                <twig:Si:MenuItem href="{{ path('_action_invoice', {'action' : 'accept', 'id' : invoice.id}) }}" icon="tabler:check">{{ 'invoice.save.publish_only'|trans }}</twig:Si:MenuItem>
            </twig:Si:Dropdown>
        </div>
    {% endif %}
{% endblock page_title_actions %}

{% block content %}
    {% import '@SolidInvoiceInvoice/Default/_send_gate.html.twig' as send_gate %}
    {% set gated = is_email_verification_gated() %}
    {% set currency = invoice.currency %}
    {% set InvoiceStatus = enum('SolidInvoice\\InvoiceBundle\\Enum\\InvoiceStatus') %}
    {% set PaymentStatus = enum('SolidInvoice\\PaymentBundle\\Enum\\PaymentStatus') %}

    <div class="-mt-2 mb-5 flex flex-wrap items-center gap-x-4 gap-y-1 text-fg-secondary print:hidden">
        {{ invoice_label(invoice.status) }}
        {% if invoice.due is not empty %}
            <span class="inline-flex items-center gap-1.5">
                {{ ux_icon('tabler:calendar', {class: 'size-3.5', 'aria-hidden': 'true'}) }}
                {{ 'invoice.due_date'|trans }}: {{ invoice.due|date('M d, Y') ~ (invoice.paymentTerms.value != 'custom' ? ' · ' ~ invoice.paymentTerms.label|trans : '') }}
            </span>
        {% endif %}
    </div>

    <div class="grid items-start gap-6 xl:grid-cols-[minmax(0,1fr)_20rem]">
        <div class="min-w-0">
            {% if documentTemplate|default(null) is not empty %}
                {% include documentTemplate %}
            {% else %}
                {% include '@SolidInvoiceCore/Billing/_document.html.twig' with {
                    doc: invoice,
                    type: 'invoice',
                    currency: currency,
                    target: enum('SolidInvoice\\CoreBundle\\Enum\\CustomFieldTarget').INVOICE,
                } only %}
            {% endif %}
        </div>

        {# Sidebar #}
        <div class="space-y-4 print:hidden">
            <twig:Si:Card title="{{ 'invoice.client.title'|trans }}" icon="tabler:building" iconColor="primary" :padded="true">
                <a href="{{ path('_clients_view', {'id': invoice.client.id}) }}" class="font-semibold text-primary hover:underline">{{ invoice.client }}</a>

                {% if invoice.users|length > 0 %}
                    <ul class="mt-3 space-y-2">
                        {% for user in invoice.users %}
                            <li class="text-sm">
                                <div class="text-fg">{{ user }}</div>
                                <div class="flex items-center gap-1 text-fg-muted">
                                    {{ ux_icon('tabler:mail', {class: 'size-3', 'aria-hidden': 'true'}) }}
                                    {{ user.email }}
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </twig:Si:Card>

            <twig:Si:Card title="{{ 'invoice.summary'|trans }}" icon="tabler:receipt" iconColor="primary" :padded="true">
                <dl class="space-y-3 text-sm">
                    <div class="flex items-center justify-between gap-3">
                        <dt class="text-fg-secondary">{{ 'invoice.status'|trans }}</dt>
                        <dd>{{ invoice_label(invoice.status) }}</dd>
                    </div>
                    <div class="flex items-center justify-between gap-3">
                        <dt class="text-fg-secondary">{{ 'invoice.total'|trans }}</dt>
                        <dd class="tabular text-base font-semibold text-fg">{{ invoice.total|formatCurrency(currency) }}</dd>
                    </div>
                    {% if invoice.payments|length > 0 and not invoice.balance.isZero %}
                        <div class="flex items-center justify-between gap-3">
                            <dt class="text-fg-secondary">{{ 'invoice.balance'|trans }}</dt>
                            <dd class="tabular font-semibold text-warning-dark">{{ invoice.balance|formatCurrency(currency) }}</dd>
                        </div>
                    {% endif %}
                    <div class="flex items-center justify-between gap-3">
                        <dt class="text-fg-secondary">{{ 'invoice.date'|trans }}</dt>
                        <dd class="text-fg">{{ invoice.invoiceDate|date('M d, Y') }}</dd>
                    </div>
                    {% if invoice.due is not empty %}
                        <div class="flex items-center justify-between gap-3">
                            <dt class="text-fg-secondary">{{ 'invoice.due_date'|trans }}</dt>
                            <dd class="{{ invoice.status == InvoiceStatus.Overdue ? 'font-semibold text-danger-dark' : 'text-fg' }}">{{ invoice.due|date('M d, Y') ~ (invoice.paymentTerms.value != 'custom' ? ' · ' ~ invoice.paymentTerms.label|trans : '') }}</dd>
                        </div>
                    {% endif %}
                    {% if invoice.paidDate is not empty %}
                        <div class="flex items-center justify-between gap-3">
                            <dt class="text-fg-secondary">{{ 'invoice.paid_date'|trans }}</dt>
                            <dd class="text-success-dark">{{ invoice.paidDate|date('M d, Y') }}</dd>
                        </div>
                    {% endif %}
                </dl>
            </twig:Si:Card>

            {% if payments|length > 0 %}
                <twig:Si:Card title="{{ 'invoice.view.payments'|trans }}" icon="tabler:credit-card" iconColor="primary" :padded="true">
                    <ul class="space-y-3">
                        {% for payment in payments %}
                            <li class="rounded-md border border-line-light border-l-4 p-3 {{ payment.status == PaymentStatus.Captured ? 'border-l-success' : 'border-l-ink-300' }}">
                                <div class="mb-1.5 flex items-center justify-between gap-2">
                                    <span class="tabular font-semibold text-fg">{{ payment.totalAmount|formatCurrency(currency) }}</span>
                                    {{ payment_label(payment.status) }}
                                </div>
                                <div class="space-y-1 text-sm text-fg-secondary">
                                    {% if payment.method is not empty %}
                                        <div class="flex items-center gap-1.5">{{ ux_icon('tabler:credit-card', {class: 'size-3.5 text-fg-muted', 'aria-hidden': 'true'}) }}{{ payment.method }}</div>
                                    {% endif %}
                                    {% if payment.completed is not empty %}
                                        <div class="flex items-center gap-1.5">{{ ux_icon('tabler:calendar', {class: 'size-3.5 text-fg-muted', 'aria-hidden': 'true'}) }}{{ payment.completed|date('M d, Y') }}</div>
                                    {% endif %}
                                    {% if payment.message is not empty %}
                                        <p class="text-fg-muted">{{ payment.message }}</p>
                                    {% endif %}
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                </twig:Si:Card>
            {% endif %}

            {% if invoice.quote is not null and invoice.quote.valid %}
                <twig:Si:Card title="{{ 'invoice.view.related_quote'|trans }}" icon="tabler:file-text" :padded="true">
                    <a href="{{ path('_quotes_view', {'id' : invoice.quote.id}) }}" class="inline-flex items-center gap-1 font-medium text-primary hover:underline">
                        {{ ux_icon('tabler:external-link', {class: 'size-3.5', 'aria-hidden': 'true'}) }}
                        {{ 'quote.title'|trans({'%id%': invoice.quote.quoteId}) }}
                    </a>
                </twig:Si:Card>
            {% endif %}
        </div>
    </div>

    {# Confirm sending a reminder #}
    {% if invoice.status in [InvoiceStatus.Pending, InvoiceStatus.Overdue] and invoice.users|length > 0 %}
        <twig:Si:Modal id="send-reminder-modal" title="{{ 'invoice.modal.send_reminder.title'|trans }}" size="sm">
            <div class="py-3 text-center">
                {{ ux_icon('tabler:bell', {class: 'mx-auto mb-3 size-12 text-primary', 'aria-hidden': 'true'}) }}
                <h3 class="mb-1 text-lg font-semibold text-fg">{{ 'invoice.modal.send_reminder.heading'|trans }}</h3>
                <p class="text-fg-muted">{{ 'invoice.modal.send_reminder.message'|trans({'%invoice_id%': invoice.invoiceId}) }}</p>

                <p class="mt-3 mb-1 text-sm text-fg-muted">{{ 'invoice.modal.send_reminder.recipients'|trans }}</p>
                <ul class="space-y-1 text-sm text-fg-secondary">
                    {% for user in invoice.users %}
                        <li class="flex items-center justify-center gap-1.5">{{ ux_icon('tabler:mail', {class: 'size-3.5', 'aria-hidden': 'true'}) }}{{ user.email }}</li>
                    {% endfor %}
                </ul>
            </div>

            <twig:block name="footer">
                <twig:Si:Button type="button" variant="ghost" data-si-modal-close>{{ 'invoice.view.toolbar.cancel'|trans }}</twig:Si:Button>
                <form method="post" action="{{ path('_send_manual_reminder', {'id': invoice.id}) }}" class="inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('send_manual_reminder') }}">
                    <twig:Si:Button type="submit">
                        {{ ux_icon('tabler:send', {class: 'size-4', 'aria-hidden': 'true'}) }}
                        {{ 'invoice.modal.send_reminder.confirm'|trans }}
                    </twig:Si:Button>
                </form>
            </twig:block>
        </twig:Si:Modal>
    {% endif %}

    {# Confirm sending a paid invoice #}
    {% if invoice.status == InvoiceStatus.Paid and invoice.users|length > 0 %}
        <twig:Si:Modal id="send-paid-invoice-modal" title="{{ 'invoice.modal.send_paid.title'|trans }}" size="sm">
            <div class="py-3 text-center">
                {{ ux_icon('tabler:send', {class: 'mx-auto mb-3 size-12 text-primary', 'aria-hidden': 'true'}) }}
                <h3 class="mb-1 text-lg font-semibold text-fg">{{ 'invoice.modal.send_paid.heading'|trans }}</h3>
                <p class="text-fg-muted">{{ 'invoice.modal.send_paid.message'|trans({'%invoice_id%': invoice.invoiceId}) }}</p>

                <p class="mt-3 mb-1 text-sm text-fg-muted">{{ 'invoice.modal.send_paid.recipients'|trans }}</p>
                <ul class="space-y-1 text-sm text-fg-secondary">
                    {% for user in invoice.users %}
                        <li class="flex items-center justify-center gap-1.5">{{ ux_icon('tabler:mail', {class: 'size-3.5', 'aria-hidden': 'true'}) }}{{ user.email }}</li>
                    {% endfor %}
                </ul>
            </div>

            <twig:block name="footer">
                <twig:Si:Button type="button" variant="ghost" data-si-modal-close>{{ 'invoice.view.toolbar.cancel'|trans }}</twig:Si:Button>
                <form method="post" action="{{ path('_send_invoice', {'id': invoice.id}) }}" class="inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('send_invoice') }}">
                    <twig:Si:Button type="submit">
                        {{ ux_icon('tabler:send', {class: 'size-4', 'aria-hidden': 'true'}) }}
                        {{ 'invoice.modal.send_paid.confirm'|trans }}
                    </twig:Si:Button>
                </form>
            </twig:block>
        </twig:Si:Modal>
    {% endif %}

    {% if gated %}
        {{ send_gate.resend_form() }}
    {% endif %}
{% endblock content %}
