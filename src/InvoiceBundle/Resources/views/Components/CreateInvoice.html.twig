{# The add / edit invoice form (a Live Component). The page heading belongs to the page. #}
{% form_theme form '@SolidInvoiceCore/Form/tailwind.html.twig' %}

<div {{ attributes }}>
    {% import '@SolidInvoiceInvoice/Default/_send_gate.html.twig' as send_gate %}
    {% set gated = is_email_verification_gated() %}
    {# Macros are not visible inside a component slot, so the hint is rendered here. #}
    {% set gate_hint = gated ? send_gate.hint() : '' %}
    {% set currency = dto.client ? dto.client.currency : null %}
    {% set hasTax = this.hasTax %}
    {% set hasTermsOrNotes = this.hasTermsOrNotes %}
    {% set discountAmount = this.discountAmount %}

    {{ form_start(form) }}

    {% if not isEdit %}
        <p class="-mt-2 mb-5 text-fg-muted">{{ 'invoice.create.subtitle'|trans }}</p>
    {% endif %}

    <div class="space-y-6">
        {# Client, invoice number, dates and discount #}
        <section class="grid gap-6 rounded-lg border border-line-light bg-surface p-5 shadow-sm md:grid-cols-2">
            <div class="space-y-4">
                {# Client #}
                <div class="client-selection">
                    <div class="client-mode-toggle mb-3{{ not this.hasClients() ? ' hidden' }}">
                        {{ form_row(form.clientMode, {'attr': {'class': 'flex flex-wrap gap-x-5 gap-y-1'}}) }}
                    </div>

                    {% set mode = form.clientMode.vars.data %}

                    {% if mode.value == 'existing' %}
                        <div{{ form.client is defined and form.client.vars.data is not empty ? ' class="hidden"' }}>
                            {% if form.client is defined %}
                                {{ form_row(form.client, {attr: {'data-action': 'live#$render'}}) }}
                            {% endif %}
                        </div>
                        {% if form.client is defined and form.client.vars.data %}
                            {% include "@SolidInvoiceClient/Ajax/info.html.twig" with {'client': form.client.vars.data, 'form': form} %}
                        {% endif %}
                    {% else %}
                        <div class="inline-client-form rounded-lg border border-line bg-canvas p-4">
                            <h3 class="mb-3 flex items-center gap-2 text-base font-semibold text-fg">
                                {{ ux_icon('tabler:user-plus', {class: 'size-5 text-primary', 'aria-hidden': 'true'}) }}
                                {{ 'invoice.client.create_new'|trans }}
                            </h3>

                            <div class="grid gap-x-3 md:grid-cols-2">
                                <div class="md:col-span-2">{{ form_row(form.newClientName) }}</div>
                                <div>{{ form_row(form.newContactFirstName) }}</div>
                                <div>{{ form_row(form.newContactLastName) }}</div>
                                <div class="md:col-span-2">{{ form_row(form.newContactEmail) }}</div>
                            </div>

                            <twig:Si:Alert type="info">{{ 'invoice.client.inline.currency_note'|trans }}</twig:Si:Alert>
                        </div>
                    {% endif %}
                </div>

                {# Invoice number #}
                {% include '@SolidInvoiceCore/Billing/_billing_id.html.twig' with {
                    id_field: form.invoiceId,
                    label: 'invoice.label'|trans,
                    editLabel: 'invoice.id.edit'|trans,
                    saveLabel: 'invoice.id.save'|trans,
                    cancelLabel: 'invoice.id.cancel'|trans,
                    canEdit: editInvoiceId is not defined or editInvoiceId is not same as(false),
                } only %}
            </div>

            <div>
                <div class="invoice-dates-row grid gap-x-3 sm:grid-cols-3">
                    <div>{{ form_row(form.invoiceDate) }}</div>
                    <div>{{ form_row(form.paymentTerms) }}</div>
                    {# A preset term owns the due date; only Custom lets the user pick it. #}
                    <div>
                        {{ form_row(form.due, form.paymentTerms.vars.value == 'custom' ? {} : {
                            attr: {readonly: true},
                            help: 'invoice.payment_terms.due_help',
                        }) }}
                    </div>
                </div>
                {{ form_row(form.discount) }}
            </div>
        </section>

        {# Line items and totals #}
        <div class="grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_20rem]">
            {% include '@SolidInvoiceCore/Billing/_form_lines.html.twig' with {form: form, prefix: 'invoice', currency: currency, hasTax: hasTax} only %}
            {% include '@SolidInvoiceCore/Billing/_form_totals.html.twig' with {dto: dto, prefix: 'invoice', currency: currency, hasTax: hasTax, discountAmount: discountAmount} only %}
        </div>

        {% include '@SolidInvoiceCore/Billing/_form_extras.html.twig' with {form: form, prefix: 'invoice', customFieldsLabel: 'invoice.custom_fields', hasTermsOrNotes: hasTermsOrNotes} only %}
    </div>

    {# Hidden fields #}
    {{ form_widget(form.total) }}
    {{ form_widget(form.baseTotal) }}
    {{ form_widget(form.tax) }}

    <twig:Si:FormActions width="max-w-none">
        <twig:Si:Button variant="ghost" href="{{ path('_invoices_index') }}">
            {{ ux_icon('tabler:arrow-left', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
            {{ 'invoice.save.cancel'|trans }}
        </twig:Si:Button>

        <div class="flex flex-wrap items-center justify-end gap-2">
            {{ gate_hint }}

            <button type="button" class="si-btn si-btn--outline si-btn--md" {{ live_action(isEdit ? 'saveUpdate:prevent' : 'saveDraft:prevent') }}>
                {{ ux_icon('tabler:device-floppy', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
                {{ (isEdit ? 'invoice.save.update' : 'invoice.save.draft')|trans }}
            </button>

            {# Send, with publishing only in the caret menu #}
            <div class="save-button-group inline-flex">
                <button type="button" class="btn-save-primary si-btn si-btn--primary si-btn--md rounded-r-none" {{ live_action('saveSend:prevent') }}{% if gated %} disabled aria-describedby="send-gated-hint"{% endif %}>
                    {{ ux_icon('tabler:send', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
                    {{ 'invoice.save.send'|trans }}
                </button>
                <twig:Si:Dropdown label="{{ 'invoice.view.toolbar.toggle_dropdown'|trans }}" up triggerClass="si-btn si-btn--primary si-btn--md rounded-l-none border-l border-white/30 px-2">
                    <twig:block name="trigger">{{ ux_icon('tabler:chevron-up', {class: 'size-4', 'aria-hidden': 'true'}) }}</twig:block>
                    <button type="button" role="menuitem" class="flex w-full items-center gap-2 rounded-md px-2.5 py-1.5 text-left text-base text-fg-secondary hover:bg-surface-hover hover:text-fg" {{ live_action('savePublish:prevent') }}>
                        {{ ux_icon('tabler:check', {class: 'size-4 text-fg-muted', 'aria-hidden': 'true'}) }}
                        {{ 'invoice.save.publish_only'|trans }}
                    </button>
                </twig:Si:Dropdown>
            </div>
        </div>
    </twig:Si:FormActions>

    {{ form_end(form) }}

    {% if gated %}
        {{ send_gate.resend_form() }}
    {% endif %}
</div>
