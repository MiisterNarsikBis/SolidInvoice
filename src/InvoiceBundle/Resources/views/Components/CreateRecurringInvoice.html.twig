{# The add / edit recurring invoice form (a Live Component). The page heading belongs to the page. #}
{% form_theme form '@SolidInvoiceCore/Form/tailwind.html.twig' %}

<div {{ attributes }}>
    {% set currency = invoice.client ? invoice.client.currency : null %}
    {% set hasTermsOrNotes = invoice.terms or invoice.notes %}
    {% set discountAmount = discount(invoice) %}

    {{ form_start(form) }}

    {% if not isEdit %}
        <p class="-mt-2 mb-5 text-fg-muted">{{ 'invoice.recurring.create.subtitle'|trans }}</p>
    {% endif %}

    <div class="space-y-6">
        {# Client and discount (a recurring invoice has no dates of its own) #}
        <section class="grid gap-6 rounded-lg border border-line-light bg-surface p-5 shadow-sm md:grid-cols-2">
            <div class="client-selection">
                <div{{ form.client.vars.data is not empty ? ' class="hidden"' }}>
                    {{ form_row(form.client, {attr: {'data-action': 'live#$render'}}) }}
                </div>
                {% if form.client.vars.data %}
                    {% include "@SolidInvoiceClient/Ajax/info.html.twig" with {'client': form.client.vars.data, 'form': form} %}
                {% endif %}
            </div>

            <div>
                {{ form_row(form.discount) }}
            </div>
        </section>

        {# Line items and totals #}
        <div class="grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_20rem]">
            {% include '@SolidInvoiceCore/Billing/_form_lines.html.twig' with {form: form, prefix: 'invoice', currency: currency, hasTax: hasTax} only %}
            {% include '@SolidInvoiceCore/Billing/_form_totals.html.twig' with {dto: invoice, prefix: 'invoice', currency: currency, hasTax: hasTax, discountAmount: discountAmount} only %}
        </div>

        {# Schedule #}
        <twig:Si:FormSection title="{{ 'invoice.recurring.schedule.title'|trans }}" description="{{ 'invoice.recurring.schedule.description'|trans }}" icon="tabler:repeat" class="recurring-schedule-section">
            {# The current frequency, in words #}
            {% set frequency = recurring_frequency(invoice.recurringOptions) %}
            {% if frequency is not empty %}
                <div class="mb-4 flex items-center gap-3 rounded-md bg-primary-lighter px-4 py-3 text-primary-dark">
                    {{ ux_icon('tabler:calendar-repeat', {class: 'size-5 shrink-0', 'aria-hidden': 'true'}) }}
                    <strong>{{ frequency }}</strong>
                </div>
            {% endif %}

            {{ form_row(form.date_start) }}

            {# DynamicFormBuilder renders every field of the recurrence #}
            <div class="recurring-options-wrapper">
                {{ form_row(form.recurringOptions) }}
            </div>

            {{ form_row(form.paymentTerms) }}

            {# What the variables in a line or a description do #}
            <details class="group rounded-md border border-line-light bg-canvas">
                <summary class="flex cursor-pointer list-none items-center gap-2 px-4 py-2.5 text-primary [&::-webkit-details-marker]:hidden">
                    {{ ux_icon('tabler:info-circle', {class: 'size-4', 'aria-hidden': 'true'}) }}
                    <span>{{ 'invoice.recurring.variables.help_button'|trans }}</span>
                </summary>
                <div class="border-t border-line-light px-4 py-3 text-sm text-fg-secondary">
                    <p class="mb-2">{{ 'invoice.recurring.variables.text'|trans }}</p>
                    <ul class="mb-3 space-y-1">
                        {% for variable in [
                            {code: '{day}', text: 'invoice.recurring.variables.day'|trans},
                            {code: '{day_name}', text: 'invoice.recurring.variables.day_name'|trans},
                            {code: '{month}', text: 'invoice.recurring.variables.month'|trans({"%month%": 'now'|date('F')})},
                            {code: '{year}', text: 'invoice.recurring.variables.year'|trans({"%year%": 'now'|date('Y')})},
                        ] %}
                            <li class="flex flex-wrap items-baseline gap-2">
                                <code class="rounded bg-ink-100 px-1.5 py-0.5 text-fg">{{ variable.code }}</code>
                                <span>{{ variable.text }}</span>
                            </li>
                        {% endfor %}
                    </ul>
                    <p>
                        <strong>{{ 'invoice.recurring.variables.example_label'|trans }}:</strong>
                        "{{ 'invoice.recurring.variables.example_input'|trans }}" → "{{ 'invoice.recurring.variables.example_output'|trans({"%month%": 'now'|date('F')}) }}"
                    </p>
                </div>
            </details>
        </twig:Si:FormSection>

        {% include '@SolidInvoiceCore/Billing/_form_extras.html.twig' with {form: form, prefix: 'invoice', customFieldsLabel: 'invoice.custom_fields', hasTermsOrNotes: hasTermsOrNotes} only %}
    </div>

    {# Hidden fields #}
    {{ form_widget(form.total) }}
    {{ form_widget(form.baseTotal) }}
    {{ form_widget(form.tax) }}

    <twig:Si:FormActions width="max-w-none">
        <twig:Si:Button variant="ghost" href="{{ path('_invoices_index_recurring') }}">
            {{ ux_icon('tabler:arrow-left', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
            {{ 'invoice.save.cancel'|trans }}
        </twig:Si:Button>

        <div class="save-button-group inline-flex">
            <button type="submit" class="btn-save-primary si-btn si-btn--primary si-btn--md{{ isEdit ? '' : ' rounded-r-none' }}" name="save" value="save">
                {{ ux_icon('tabler:device-floppy', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
                {{ (isEdit ? 'invoice.save.update' : 'invoice.save.draft')|trans }}
            </button>
            {% if not isEdit %}
                <twig:Si:Dropdown label="{{ 'invoice.view.toolbar.toggle_dropdown'|trans }}" up triggerClass="si-btn si-btn--primary si-btn--md rounded-l-none border-l border-white/30 px-2">
                    <twig:block name="trigger">{{ ux_icon('tabler:chevron-up', {class: 'size-4', 'aria-hidden': 'true'}) }}</twig:block>
                    <button type="submit" role="menuitem" class="flex w-full items-center gap-2 rounded-md px-2.5 py-1.5 text-left text-base text-fg-secondary hover:bg-surface-hover hover:text-fg" name="save" value="publish">
                        {{ ux_icon('tabler:check', {class: 'size-4 text-fg-muted', 'aria-hidden': 'true'}) }}
                        {{ 'invoice.recurring.activate_start'|trans }}
                    </button>
                </twig:Si:Dropdown>
            {% endif %}
        </div>
    </twig:Si:FormActions>

    {{ form_end(form) }}
</div>
