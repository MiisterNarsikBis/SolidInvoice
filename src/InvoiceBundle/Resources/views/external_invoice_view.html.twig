{% set currency = invoice.currency %}

{% embed '@SolidInvoiceCore/Billing/_external_page.html.twig' with {type: 'invoice', pdfUrl: path('_view_invoice_external', {'uuid': invoice.uuid, '_format': 'pdf'})} %}
    {% block actions %}
        {% if not invoice.paid and payments_configured(false) > 0 %}
            <twig:Si:Button variant="{{ invoice.status == enum('SolidInvoice\\InvoiceBundle\\Enum\\InvoiceStatus').Overdue ? 'danger' : 'primary' }}" href="{{ path('_payments_create', {'uuid': invoice.uuid}) }}">
                {{ ux_icon('tabler:credit-card', {class: 'size-[1.125rem]', 'aria-hidden': 'true'}) }}
                {{ 'invoice.action.pay_now'|trans }}
            </twig:Si:Button>
        {% endif %}
    {% endblock actions %}

    {% block document %}
        {% if documentTemplate|default(null) is not empty %}
            {% include documentTemplate %}
        {% else %}
            {% include '@SolidInvoiceCore/Billing/_document.html.twig' with {
                doc: invoice,
                type: 'invoice',
                currency: currency,
                target: enum('SolidInvoice\\CoreBundle\\Enum\\CustomFieldTarget').INVOICE,
                external: true,
            } only %}
        {% endif %}
    {% endblock document %}
{% endembed %}
